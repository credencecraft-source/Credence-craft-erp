					{
						custom deluge script
						(
											disable Po_Sub_Form.Gross_Amount;
										disable Po_Sub_Form.After_Discount;
										disable Po_Sub_Form.Total_With_Tax;
										disable Po_Sub_Form.Grand_Toltal;
										disable Po_Sub_Form.IGST;
										disable Po_Sub_Form.SGST;
										disable Po_Sub_Form.CGST;
