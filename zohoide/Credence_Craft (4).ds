			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 5'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Employee_Id_Card'\n\t\ttarget = 'same-window'\n\tcolor = 'theme'\n\tsize = '16px'\n    borderColor = '#149954'\n    borderWidth = '0px'\n\ttext ='Employee Id Card'\n\t\tbgColor = 'theme:3'\n\t\tcornerRadius = '3px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='24%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'New_Join'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;New Join&quot;'\n\t  value = 'thisapp.Employee_Name.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'New Join'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Active'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Active&quot;'\n\t  value = 'thisapp.Employee_Name.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Active'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='26%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Long_Absent'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Long Absent&quot;'\n\t  value = 'thisapp.Employee_Name.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Long Absent'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'In_Active'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;In-Active&quot;'\n\t  value = 'thisapp.Employee_Name.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'In Active'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet4' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet4()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\n/* Hide Creator default buttons */\n.form-action-container{\n    display:none;\n}\n\n.tabs{\n    display:block;\n    height:100vh;\n    position:relative;\n    font-family:Arial, sans-serif;\n}\n\n.tabs .tab{\n    float:left;\n    display:block;\n}\n\n/* Hide radio buttons */\n.tabs .tab &gt; input[type=&quot;radio&quot;]{\n    position:absolute;\n    top:-9999px;\n    left:-9999px;\n}\n\n/* Tab labels */\n.tabs .tab &gt; label{\n    display:block;\n    padding:6px 28px;\n    font-size:13px;\n    text-transform:uppercase;\n    cursor:pointer;\n    font-weight:bold;\n    color:#303030;\n    position:relative;\n}\n\n/* Active underline */\n.tabs .tab &gt; label::after{\n    content:&quot;&quot;;\n    position:absolute;\n    left:0;\n    bottom:0;\n    width:0;\n    height:3px;\n    background:green;\n    transition:width 0.3s ease;\n}\n\n/* Active tab */\n.tabs &gt; .tab &gt; input:checked + label::after{\n    width:100%;\n}\n\n/* Content */\n.tabs .content{\n    position:absolute;\n    top:27px;\n    left:0;\n    width:100%;\n    height:calc(100vh - 27px);\n    opacity:0;\n    z-index:0;\n    transition:opacity 300ms ease;\n}\n\n/* Show active */\n.tabs &gt; .tab &gt; input:checked ~ .content{\n    opacity:1;\n    z-index:1;\n}\n\n/* iframe */\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n  &lt;!-- NEW JOIN (FIRST &amp; ACTIVE DEFAULT) --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;status_tabs&quot; checked id=&quot;status_tab0&quot;&gt;\n    &lt;label for=&quot;status_tab0&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-user-plus&quot;&gt;&lt;/i&gt; New Join\n    &lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/New_Join?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ACTIVE --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;status_tabs&quot; id=&quot;status_tab1&quot;&gt;\n    &lt;label for=&quot;status_tab1&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-circle-check&quot;&gt;&lt;/i&gt; Active\n    &lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Active?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- LONG ABSENT --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;status_tabs&quot; id=&quot;status_tab2&quot;&gt;\n    &lt;label for=&quot;status_tab2&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-user-clock&quot;&gt;&lt;/i&gt; Long Absent\n    &lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Long_Absent?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- IN ACTIVE --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;status_tabs&quot; id=&quot;status_tab3&quot;&gt;\n    &lt;label for=&quot;status_tab3&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-user-slash&quot;&gt;&lt;/i&gt; In Active\n    &lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/In_Active?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n&lt;/ul&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Support
		{
			displayname = "Support"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenPage'\n\t\tcomponentLinkName = 'Credence_Craft_Learning_Series'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '20px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Credence Craft Learning series'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '17px'\n\tbgColor = '#0B6E4F'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenURL'\n\t\turl = 'https://credencecraft.zohobookings.in/#/credencecraft' \n\t\ttarget = 'popup'\n\t\tpopupWidth = '500px'\n\t  \tpopupHeight = '1000px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='Talk to an  Expert'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '6px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#0B6E4F'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '17px'\n\tbgColor = '#0B6E4F'\n\n\t\twidth = '50%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Create_Support_Ticket'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '500px'\n\t  \tpopupHeight = '1000px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='Create Ticket'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '6px' \n/>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '17px'\n\tbgColor = 'transparent'\n\n\t\twidth = '50%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Support_Tickets'\n\t\ttarget = 'same-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='View Tickets'\n\t\tbgColor = 'transparent'\n            bgColorType = 'noFill'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Credence_Craft_Learning_Series
		{
