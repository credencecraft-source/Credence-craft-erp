				{
				condition = (Owner == "My Order")
				fields = [Owner]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (Owner == "Customer Order")
				fields = [Owner]
				format = "color:#ffffff;background-color:#f6abab;"
				}
			)
		}
		default list fynora_Report
		{
			displayName = "fynora Report"
			show all rows from fynora    
			(
				fynora_id as "fynora id"
			)
		}
		default list Online_Leads1
		{
			displayName = "Online Leads"
			show all rows from Online_Leads    
			(
				Owner
				Style_Name as "Style Name"
				Colors
				Customer_Name as "Customer Name"
				Customer_Order_No as "Customer Order No"
				Customer_Work_Order_No as "Customer Work Order No"
				Brand
				Qty
				Pricing_Type as "Pricing Type"
				Price
				Date_Time as "Date-Time"
				Hsn_Code as "Hsn Code"
				Gst
				Product_Master as "Product Master"
				Products
				Volum
				Complexity
			)
		}
		default list Online_Leads_Finished_goods_Report
		{
			displayName = "Online Leads Finished goods Report"
			show all rows from Online_Leads_Finished_goods    
			(
				Size as "Size "
				Qty
				Excess
				Total
				Online_Leads as "Online Leads"
			)
		}
		default list Online_leads_RM_Report
		{
			displayName = "Online leads RM Report"
			show all rows from Online_leads_RM    
			(
				Rawmateril
				Size
				Con
				Req2 as "Required"
				Online_Leads as "Online Leads"
			)
		}
	}
