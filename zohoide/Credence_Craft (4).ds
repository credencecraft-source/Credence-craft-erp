										master_list.add(467);
										master_list.add(468);
										master_list.add(469);
										master_list.add(470);
										master_list.add(471);
										master_list.add(472);
										master_list.add(473);
										master_list.add(474);
										master_list.add(475);
										master_list.add(476);
										master_list.add(477);
										master_list.add(478);
										master_list.add(479);
										master_list.add(480);
										master_list.add(481);
										master_list.add(482);
										master_list.add(483);
										master_list.add(484);
										master_list.add(485);
										master_list.add(486);
										master_list.add(487);
										master_list.add(488);
										master_list.add(489);
										master_list.add(490);
										master_list.add(491);
										master_list.add(492);
										master_list.add(493);
										master_list.add(494);
										master_list.add(495);
										master_list.add(496);
										master_list.add(497);
										master_list.add(498);
										master_list.add(499);
										master_list.add(500);
										// -------------------------------------------------------------------------
										// prepare summary container
										summary_list = list();
										// main processing
										if(bulk_order_id != null && input.Eo_No_Sub_Form != null && input.Eo_No_Sub_Form.count() > 0)
										{
											for each  row in input.Eo_No_Sub_Form
											{
												if(row.Gold_Seal != null)
												{
													// requested repeat_count (default 1)
													repeat_count = 1;
													if(row.No_Of_Style != null)
													{
														repeat_count = row.No_Of_Style;
													}
													if(repeat_count <= 0)
													{
														repeat_count = 1;
													}
													// cap to master_list length
													max_allowed = master_list.size();
													if(repeat_count > max_allowed)
													{
														repeat_count = max_allowed;
													}
													// count existing rows
													existing_count = 0;
													for each  e in Excell_Order_Entry[Bulk_Order == bulk_order_id && Gold_Seal == row.Gold_Seal]
													{
														existing_count = existing_count + 1;
													}
													// compute how many new records to create
													to_create = repeat_count - existing_count;
													if(to_create < 0)
													{
														to_create = 0;
													}
													// create required new records (no per-insert logs)
													created = 0;
													if(to_create > 0)
													{
														for each  n in master_list
														{
															if(n <= to_create)
															{
																insert into Excell_Order_Entry
																[
																	Bulk_Order=bulk_order_id
																	Gold_Seal=row.Gold_Seal
																	Added_User=zoho.loginuser
																]
																created = created + 1;
															}
														}
													}
													// add final summary string for this row
													summary_list.add("Gold_Seal " + row.Gold_Seal + " | Requested Styles = " + repeat_count + " | Existing = " + existing_count + " | Newly Created = " + created);
												}
												else
												{
													summary_list.add("Gold_Seal (null) | Skipped - Gold_Seal was null");
												}
											}
										}
										else
										{
											summary_list.add("No Bulk_Order or Subform rows found — nothing processed.");
										}
										// print only final summary lines
										for each  s in summary_list
										{
											info s;
										}
					)
					}
				}
			}
