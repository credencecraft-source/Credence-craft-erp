				type =  form
				form = Work_Order_New

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  each_work_order in input.Work_Order_Size_Wise_Qty
										{
											sum_of_work_order_qty = Wo_Order_Size_Wise_Qty[Finished_Goods_Size_ID == each_work_order.ID && Work_Order_No != null].sum(Work_Order_Qty);
											sum_of_work_order_qty = sum_of_work_order_qty + ifnull(each_work_order.Work_Order_Qty,0);
