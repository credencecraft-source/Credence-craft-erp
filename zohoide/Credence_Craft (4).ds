		form Packing_List
		{
			displayname = "Packing List"
			success message = "Packing List Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Brand1
			(
				type = picklist	
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			OUTER_CARTON1
			(
				type = picklist	
				displayname = "OUTER_CARTON"
				values  = OUTER_CARTON.ID
    			displayformat = [Outer_Carton_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size
			(
				type = picklist
				maxchar = 100
				values = {"Same Size","Mixed Size"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size_Detail
			(
    			type = text
				displayname = "Size Detail"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Qty
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Packing_List_Header
			(
				type = picklist	
				displayname = "Packing List Header"
				values  = Packing_List_Header.ID
    			bidirectional = SubForm
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Details
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Outer_Carton
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Packing_List_Header
		{
			displayname = "Packing List Header"
			success message = "Packing List Header Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Delivery_Challan
			(
				type = picklist	
				displayname = "Delivery Challan"
				values  = GRN_Delivery.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Brand11
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_of_carton
			(
				type = number
				displayname = "Number of carton"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Dc Created"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity_Name
			(
				type = picklist	
				displayname = "Entity Name"
				values  = Entity_Name.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			OUTER_CARTON
			(
				type = list	
				values  = OUTER_CARTON.ID
    			displayformat = [Outer_Carton_No]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Qty
			(
				type = number
	 			row = 1
	 			column = 2   
				width = medium
			)
			SubForm
			(
				type = grid
				values  = Packing_List.ID
    			bidirectional = Packing_List_Header
	 			row = 2
	 			column = 1   
				width = medium
			)
			Backend
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Packing_List_No
			(
    			type = formula
				displayname = "Packing List "
				value =  "PACK" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			Created_On
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
