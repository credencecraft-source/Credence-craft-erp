			Create_Eo_No_Edit_Onload as "Create Eo No (Edit)-Onload"
			{
				type =  form
				form = Bulk_Order

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											get_order = Create_Order[Eo_No_and_Name == input.ID];
										if(get_order.ID != null)
