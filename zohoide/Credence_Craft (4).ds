			Otp as "Otp"
			{
				type =  form
				form = Pricing

				record event = on add or edit

				on user input of OTP
				{
					actions 
					{
						custom deluge script
						(
											if(!isNull(input.OTP))
										{
											backend = input.BackendOTP;
											if(!isNull(backend))
											{
												otp_list = backend.toList(",");
												valid = false;
												for each  otp_value in otp_list
												{
													if(otp_value.trim() == input.OTP.trim())
													{
														valid = true;
														parts = otp_value.toList("-");
														plan_part = parts.get(parts.size() - 1);
														input.Plan_Features = null;
														// FREE
														if(plan_part == "FREE_25")
														{
															input.Maximum = 25;
															free_plan = Plan_Master[Plan_Name == "Free"];
															if(free_plan.count() > 0)
															{
																for each  fp in free_plan
																{
																	input.Plan_Features = fp.ID;
																}
															}
														}
														// BASIC
														else if(plan_part.isNumber())
														{
															input.Maximum = plan_part.toLong();
															basic_plan = Plan_Master[Plan_Name == "Basic"];
															if(basic_plan.count() > 0)
															{
																for each  bp in basic_plan
																{
																	input.Plan_Features = bp.ID;
																}
															}
														}
														// PROFESSIONAL
														else if(plan_part.contains("PROFESSIONAL_ACCESS"))
														{
															trans_value = plan_part.replaceAll("_PROFESSIONAL_ACCESS","");
															input.Maximum = trans_value.toLong();
															pro_plan = Plan_Master[Plan_Name == "Professional"];
															if(pro_plan.count() > 0)
															{
																for each  pp in pro_plan
																{
																	input.Plan_Features = pp.ID;
																}
															}
														}
														// ENTERPRISE
														else if(plan_part.contains("FULL_ENTERPRISE_ACCESS"))
														{
															trans_value = plan_part.replaceAll("_FULL_ENTERPRISE_ACCESS","");
															if(trans_value == "UNLIMITED")
															{
																input.Maximum = 99999999;
															}
															else
															{
																input.Maximum = trans_value.toLong();
															}
															ent_plan = Plan_Master[Plan_Name == "Enterprises"];
															if(ent_plan.count() > 0)
															{
																for each  ep in ent_plan
																{
																	input.Plan_Features = ep.ID;
																}
															}
														}
														break;
													}
												}
												if(!valid)
												{
													alert "Invalid OTP entered.";
													input.OTP = null;
													input.Maximum = null;
													input.Plan_Features = null;
												}
											}
											else
											{
												alert "OTP NOT VALID.";
											}
										}
						)
					}
				}

			}
			Order_No2 as "Order No"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Sales_Invoice_Subform.Order_No
				{
					actions 
					{
						custom deluge script
						(
											// Default function header
										// Triggered when Order_No is selected in Sales_Invoice_Subform
										// --- 1) Auto-populate fields from Create_Order ---
										for each  subRow in input.Sales_Invoice_Subform
										{
											if(subRow.Order_No != null)
											{
												orderRecord = Create_Order[ID == subRow.Order_No];
												if(orderRecord.count() > 0)
												{
													subRow.Style_Name=orderRecord.Style_Name;
													subRow.Price=orderRecord.Fob;
													subRow.Qty=orderRecord.Order_Qty;
													subRow.Gst=orderRecord.Gst;
													subRow.Hsn_Code=orderRecord.Hsn_Code;
												}
												else
												{
													subRow.Style_Name=null;
													subRow.Price=null;
													subRow.Qty=null;
													subRow.Gst=null;
													subRow.Hsn_Code=null;
												}
											}
										}
										// --- 2) ROW-LEVEL & HEADER-LEVEL CALCULATION ---
										header_total = 0;
										header_tax = 0;
										header_cgst = 0;
										header_sgst = 0;
										header_igst = 0;
										for each  srow in input.Sales_Invoice_Subform
										{
											srow.Total=ifnull(srow.Qty,0) * ifnull(srow.Price,0);
											gst_percent = 0;
											if(srow.Gst != null)
											{
												gst_rec = Gst[ID == srow.Gst];
												if(gst_rec.count() > 0)
												{
													gst_percent = ifnull(gst_rec.Gst,0);
												}
											}
											srow.Tax=(srow.Total * gst_percent) / 100;
											srow.With_Gst=srow.Total + srow.Tax;
											vendor_gst_type = "";
											if(input.Customer_Name != null)
											{
												vendor_rec = Vendor1[ID == input.Customer_Name];
												if(vendor_rec.count() > 0)
												{
													vendor_gst_type = vendor_rec.New_GST_Type.gst_type;
												}
											}
											if(vendor_gst_type == "CGST & SGST")
											{
												srow.CGST=srow.Tax / 2;
												srow.SGST=srow.Tax / 2;
												srow.IGST=0;
											}
											else if(vendor_gst_type == "IGST")
											{
												srow.CGST=0;
												srow.SGST=0;
												srow.IGST=srow.Tax;
											}
											else
											{
												srow.CGST=0;
												srow.SGST=0;
												srow.IGST=0;
											}
											header_total = header_total + ifnull(srow.Total,0);
											header_tax = header_tax + ifnull(srow.Tax,0);
											header_cgst = header_cgst + ifnull(srow.CGST,0);
											header_sgst = header_sgst + ifnull(srow.SGST,0);
											header_igst = header_igst + ifnull(srow.IGST,0);
										}
										input.Total = header_total;
										input.Total_Tax = header_tax;
										input.CGST = header_cgst;
										input.SGST = header_sgst;
										input.IGST = header_igst;
										other_charges = ifnull(input.Other_Charges,0);
										input.Grand_Total = header_total + header_tax + other_charges;
						)
					}
				}

			}
