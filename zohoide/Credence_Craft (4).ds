			displayname = "Q-App-outPut"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Board'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenPage'\n\t\tcomponentLinkName = 'manpower_efficiency'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Manpower Efficiency'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='39%'\n   \t>\n\t<panel elementName='Board'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '17px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '64%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n\tcolor = '#FFFFFF'\n\tsize = '14px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Coming Soon'\n\t\tbgColor = '#FF4C2F'\n\t\tcornerRadius = '6px' \n/>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '36%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Batch_Efficiencies'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Batch Efficiency'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='28%'\n   \t>\n\t<panel elementName='Board'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Daily_Outputs'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Q-app Out Put'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet7' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet7()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n.form-action-container{display:none;}\n\n.tabs{\n    display:block;\n    height:100vh;\n    position:relative;\n    font-family:Arial, sans-serif;\n}\n.tabs .tab{float:left;display:block;}\n\n.tabs .tab &gt; input[type=&quot;radio&quot;]{\n    position:absolute;\n    top:-9999px;\n    left:-9999px;\n}\n\n.tabs .tab &gt; label{\n    display:block;\n    padding:6px 24px;\n    font-size:13px;\n    text-transform:uppercase;\n    cursor:pointer;\n    position:relative;\n    font-weight:bold;\n    color:#303030;\n}\n\n.tabs .tab &gt; label::after{\n    content:&quot;&quot;;\n    position:absolute;\n    left:0;\n    bottom:0;\n    width:0;\n    height:3px;\n    background:green;\n    transition:width 0.3s ease;\n}\n\n.tabs &gt; .tab &gt; input:checked + label::after{width:100%;}\n\n.tabs .content{\n    position:absolute;\n    top:27px;\n    left:0;\n    width:100%;\n    height:calc(100vh - 27px);\n    opacity:0;\n    z-index:0;\n    transition:opacity 300ms ease;\n}\n\n.tabs &gt; .tab &gt; input:checked ~ .content{\n    opacity:1;\n    z-index:1;\n}\n\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n\n  &lt;!-- TASK --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;prod_tabs&quot; id=&quot;prod_tab3&quot;&gt;\n    &lt;label for=&quot;prod_tab3&quot;&gt;&lt;i class=&quot;fa-solid fa-calendar-day&quot;&gt;&lt;/i&gt; Task&lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/All_Daily_Task_Line_Plans?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- Q-APP (PAGE) --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;prod_tabs&quot; id=&quot;prod_tab4&quot;&gt;\n    &lt;label for=&quot;prod_tab4&quot;&gt;&lt;i class=&quot;fa-solid fa-mobile-screen&quot;&gt;&lt;/i&gt; Q-App&lt;/label&gt;\n    &lt;div class=&quot;content&quot;&gt;\n      &lt;iframe zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;page-embed/Q_APP?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- Q-APP OUTPUT --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;prod_tabs&quot; id=&quot;prod_tab5&quot;&gt;\n    &lt;label for=&quot;prod_tab5&quot;&gt;&