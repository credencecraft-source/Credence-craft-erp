										hide Po_Sub_Form.Grn_Line_Status;
										hide Po_Sub_Form.Sum_Of_Accepted_Qty1;
										hide Po_Sub_Form.Sum_Of_Invoice_Qty;
										disable Po_Sub_Form.Hsn_Code;
										disable Po_Sub_Form.Subcategory1;
										hide Po_Sub_Form.Order_Raw_Material_ID;
										if(input.Vendor_Name != null && input.Vendor_Name.New_GST_Type != null && input.Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
										{
											hide IGST1;
											hide Po_Sub_Form.IGST;
										}
										else
										{
											hide CGST1;
											hide SGST1;
											hide Po_Sub_Form.SGST;
											hide Po_Sub_Form.CGST;
										}
										if(input.Master_Group_ID.size() > 0)
										{
											disable Item_Nature;
											disable Po_Sub_Form.Raw_Material1;
											disable Po_Sub_Form.Po_Price;
											disable Po_Sub_Form.Po_Qty;
											disable Po_Sub_Form.Subcategory1;
											disable Po_Sub_Form.Uom;
										}
										if(Po_Type == "General")
										{
										}
						)
					}
				}

