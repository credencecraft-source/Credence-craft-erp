    			type = text
				displayname = "No Of Bags"
	 			row = 1
	 			column = 3   
				width = medium
			)
			No_of_Carton
			(
    			type = text
				displayname = "No of Carton"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Gate_Entry_Subfrom
			(
				type = grid
				displayname = "Gate Entry Subfrom"
				values  = Gate_Entry_Subform.ID
    			bidirectional = Gate_Entry_No1
				auto width = false
