			Insert_Record as "Insert Record"
			{
				type =  form
				form = Validate_Job_Work_GRN
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						// Insert new GRN record
										new_grn = insert into Job_Work_GRN
										[
											Added_User=zoho.loginuser
											Order_No=input.Create_Order
											Create_Order=input.Create_Order
											Process_Master=input.Process_Name
											Operation=input.Operation
											Vendor=input.Vendor
											Employee_Name=input.Employee_Name
											Price=input.Price
											Fresh_Grn=input.Qty
											Source=input.Source
											Bundle_nolookup=if(input.Bundling_ID != null,Bundle_transfer_GRN_subform[ID == input.Bundling_ID.toLong()],null)
											Bundle_No=input.Bundle_No
										];
										// Safely get inserted record ID (map key)
										new_grn_id = new_grn.get("ID");
										// Fetch the record properly using ID
										if(new_grn_id != null)
										{
											new_grn_rec = Job_Work_GRN[ID == new_grn_id];
											if(new_grn_rec.count() > 0)
											{
												thisapp.jobWork.recalculateGRNBalance(new_grn_rec);
											}
										}
										// Update Bundling Header linked record
										if(input.Bundling_ID != null)
										{
											bundling_id_num = input.Bundling_ID.toLong();
											bundling_rec = Bundle_transfer_GRN_subform[ID == bundling_id_num];
											if(bundling_rec.count() > 0)
											{
												bundling_rec.Grn_Status="Submitted";
											}
										}
										// Redirect to Bundling Header Report
										openUrl("#Report:Bundled_Header_Level","parent window");
					)
					}
				}
			}
			Load_of_the_form as "Load of the form"
			{
				type =  form
				form = Validate_Job_Work_GRN

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Create_Order != null && input.Process_Name != null && input.Operation != null)
										{
											// Fetch existing GRN records for this combination
											job_records = Job_Work_GRN[Order_No == input.Create_Order && Process_Master == input.Process_Name && Operation == input.Operation];
											total_fresh_grn = 0;
											for each  rec in job_records
											{
												total_fresh_grn = total_fresh_grn + ifnull(rec.Fresh_Grn,0);
											}
											input.Already_Grn_Done_Fresh = total_fresh_grn;
										}
										else
										{
											input.Already_Grn_Done_Fresh = 0;
										}
						)
					}
				}

			}
