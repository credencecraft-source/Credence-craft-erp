				Status
				Vendors1.Status as "Delivery Status"
				custom action "Verify Returnable "
				(
	  			workflow = Verify_Returnable_
				show action in edit record menu = true
				column header = "Verify Returnable "
				)
				Process_Bundle_Movement as "Process Bundle Movement"
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Is_this_Returnable == false)
				fields = [Is_this_Returnable]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (Is_this_Returnable == true)
				fields = [Is_this_Returnable]
				format = "color:#ffffff;background-color:#cc1111;"
				}
				"New Formatting"
				{
				condition = (Source == "Job Order")
				fields = [Source]
				format = "color:#ffffff;background-color:#f27d9b;"
				}
				"New Formatting"
				{
				condition = (Source == "Work order style")
				fields = [Source]
				format = "color:#000000;background-color:#d27df2;"
				}
				"New Formatting"
				{
				condition = (Source == "Sales Invoice")
				fields = [Source]
				format = "color:#ffffff;background-color:#85adf5;"
				}
				"New Formatting"
				{
				condition = (Source == "Direct")
				fields = [Source]
				format = "color:#000000;background-color:#7ddaf2;"
				}
			)
		}
