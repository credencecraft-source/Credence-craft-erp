			Order_Raw_Material_Status as "Order Raw Material Status Update"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  rec in input.Order_No
										{
											getOrder = Order_Raw_material[Order_No == rec];
											interCon = (getOrder.Raw_material_Status.getall()).distinct();
											fetchOrder = Create_Order[ID == rec];
											if(!interCon.contains("Draft"))
											{
												fetchOrder.Raw_material_Status="Approved";
											}
											if(interCon.contains("Draft") && interCon.contains("Approved"))
											{
												fetchOrder.Final_Status="Work in Progress";
											}
											else if(interCon.contains("Approved"))
											{
												fetchOrder.Final_Status="Approved";
											}
										}
						)
					}
				}

			}
			Update_Body_fabric_in_Ord as "Update Body fabric in Order"
			{
				type =  form
				form = Add_Quick_RawMaterial

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											getRaw = Order_Raw_material[Order_No == input.Order_No && Subcategory.Subcategory_Name == "Body Fabric"];
										if(getRaw.count() > 0)
										{
											getOrder = Create_Order[ID == input.Order_No && Body_Fabric1 == null];
