			on_submit2 as "on submit"
			{
				type =  form
				form = Job_Order_Bill

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											allGRNs = Job_Work_GRN[ID != null];
										for each  grn in allGRNs
										{
											allBillSubs = job_order_bill_subform[Job_Work_GRN_ID == grn.ID];
											totalBilled = 0;
											for each  sb in allBillSubs
											{
												totalBilled = totalBilled + ifnull(sb.Total,0);
											}
											grn.Fresh_Billed=totalBilled;
											grn.Balance_fresh_Yet_to_Bill=ifnull(grn.Fresh_Grn,0) - totalBilled;
											grn.Bill_Status=if(grn.Balance_fresh_Yet_to_Bill == 0,"Fully Billed","Draft");
										}
										info "? GRN billing recalculated successfully.";
						)
					}
				}

			}
			On_delete1 as "On delete"
			{
				type =  form
				form = Job_Order_Bill

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ? Job Order Bill Deletion Logic
										// Purpose: When a Job Order Bill is deleted, unlink all associated GRNs and recalculate balances.
										// 1️⃣ Collect distinct GRN IDs from subform rows for this bill
										subRecs = job_order_bill_subform[Job_Order_Bill == input.ID];
										grnIds = list();
										if(subRecs.count() > 0)
										{
											for each  sr in subRecs
											{
												if(sr.Job_Work_GRN_ID != null && !grnIds.contains(sr.Job_Work_GRN_ID.ID))
												{
													grnIds.add(sr.Job_Work_GRN_ID.ID);
												}
											}
										}
										info "? GRN IDs found: " + grnIds;
										// 2️⃣ Delete subform rows for this bill (cleanup)
										delete from job_order_bill_subform[Job_Order_Bill == input.ID];
										delete from job_order_bill_subform[Job_Order_Bill == null];
										// 3️⃣ For each GRN ID: unlink the Job_Order_Bill and recalculate GRN balances
										if(grnIds.size() > 0)
										{
											for each  gid in grnIds
											{
												grnRec = Job_Work_GRN[ID == gid];
												if(grnRec.ID != null)
												{
													// Unlink bill reference
													grnRec.Job_Order_Bill=null;
													// Call your existing GRN recalculation function
													thisapp.jobWork.recalculateGRNBalance(grnRec);
													info "✅ GRN " + gid + " unlinked & recalculated.";
												}
												else
												{
													info "⚠️ GRN " + gid + " not found.";
												}
											}
										}
										else
										{
											info "ℹ️ No GRN IDs found in subform for this bill.";
										}
										info "? Job Order Bill deletion completed successfully.";
						)
					}
				}

			}
			on_delete2 as "on delete"
			{
				type =  form
				form = Job_Order_Bill

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// On Successful Delete of Job Order Bill
										subRecs = job_order_bill_subform[Job_Order_Bill == input.ID];
										for each  sub in subRecs
										{
											if(sub.Bundle_No != null)
											{
												// Convert Bundle_No to number (because GRN form uses numeric)
												bundleNum = sub.Bundle_No.toLong();
												// Use the converted numeric variable here
												grnList = Job_Work_GRN[BundleID == bundleNum];
												for each  grn in grnList
												{
													thisapp.jobWork.recalculateGRNBalance(grn);
												}
											}
										}
						)
					}
				}

			}
