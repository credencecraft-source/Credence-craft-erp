				 void createBasicShirtProcessTemplate()
                 {
                 	processList = List();
                 	processList.add("Cutting");
                 	processList.add("Parts");
                 	processList.add("Assembly");
                 	processList.add("KajaButtoning");
                 	processList.add("Embroidery");
                 	processList.add("Washing");
                 	processList.add("Finishing");
                 	pm = Product_Master[Product_Master_name == "Shirt"];
                 	p = Products[Product == "Full Sleeve Shirt"];
                 	firstProc = Process_Master[Process_Name == "Cutting"];
                 	lastProc = Process_Master[Process_Name == "Finishing"];
                 	rowList = List();
                 	i = 1;
                 	for each  pName in processList
                 	{
                 		proc = Process_Master[Process_Name == pName];
                 		opTemp = Operation_Template[Operation_Template_Name == pName + " Basic"];
                 		row = Map();
                 		row.put("Process_No",i);
                 		row.put("Process",proc.ID);
                 		row.put("Operation_Template",opTemp.ID);
                 		rowList.add(row);
                 		i = i + 1;
                 	}
                 	insert into Process_Template
                 	[
                 		Product_Master=pm.ID
                 		Products=p.ID
                 		Template_Name1="Basic Shirt"
                 		First_Process=firstProc.ID
                 		Last_Process=lastProc.ID
                 		SubForm=rowList
                 		Added_User=zoho.loginuser
                 	]
                 }
				 void createBatchEfficiencyWithTodayOperationFromGRN()
                 {
                 	todayDate = zoho.currentdate;
                 	yesterdayDate = zoho.currentdate.subDay(1);
                 	lastBatchEfficiencyDate = Batch_Efficiency[ID != 0].maximum(Date_field);
                 	if(lastBatchEfficiencyDate == null)
                 	{
                 		startDate = Process_Bundle_GRN[ID != 0].minimum(Date_field1);
                 	}
                 	else
                 	{
                 		startDate = lastBatchEfficiencyDate;
                 		if(startDate > yesterdayDate)
                 		{
                 			startDate = yesterdayDate;
                 		}
                 	}
                 	if(startDate == null)
                 	{
                 		return;
                 	}
                 	keyList = List();
                 	dateMap = Map();
                 	batchMap = Map();
                 	grnList = Process_Bundle_GRN[Date_field1 >= startDate && Date_field1 <= todayDate];
                 	for each  grn in grnList
                 	{
                 		if(grn.Date_field1 != null && grn.Batch != null)
                 		{
                 			grnDate = grn.Date_field1;
                 			grnBatch = grn.Batch;
                 			key = grnDate.toString("yyyy-MM-dd") + "_" + grnBatch.toString();
                 			if(!keyList.contains(key))
                 			{
                 				keyList.add(key);
                 				dateMap.put(key,grnDate);
                 				batchMap.put(key,grnBatch);
                 			}
                 		}
                 	}
                 	for each  key in keyList
                 	{
                 		p_Date = dateMap.get(key);
                 		p_Batch = batchMap.get(key);
                 		batchEffID = null;
                 		existingBatchEff = Batch_Efficiency[Date_field == p_Date && Batch == p_Batch];
                 		for each  batchEffRec in existingBatchEff
                 		{
                 			batchEffID = batchEffRec.ID;
                 			break;
                 		}
                 		if(batchEffID == null)
                 		{
                 			batchEffID = insert into Batch_Efficiency
                 			[
                 				Added_User=zoho.loginuser
                 				Date_field=p_Date
                 				Batch=p_Batch
                 			];
                 		}
                 		thisapp.populateTodayOperationForOneBatchEfficiency(batchEffID);
                 	}
                 }
				 void CreateDefaultSettingRecord()
                 {
                 	existing = Setting[ID != 0];
                 	if(existing.count() == 0)
                 	{
                 		insert into Setting
                 		[
                 			Entity_Name=Entity_Name[Entity_Name == "CREDENCE CRAFT"].ID
                 			Back_Dated_Po="Allow"
                 			Vender_Lock_For_Statement="Dont Lock"
                 			PO_Approval="Auto Approve"
                 			Allocation_Mandatory_For_Work_Order_Approval="All Mandatory"
                 			Create_Auto_Job_Order="Auto"
                 			Validate_General_Po_Budget="Dont validate"
                 			Vender_Lock_Gst="Lock the Vender"
                 			Approve_Consemption="Auto Approve"
                 			Style_Wise_Allocation="Auto"
                 			Delete_Not_Purchased_RM_After_Ship="Delete"
                 			Create_Auto_Work_Order="Auto"
                 			Validate_Costing_In_Master_Po="Auto Approve"
                 			Added_User=zoho.loginuser
                 		]
                 		info "Default Setting Record Created Successfully.";
                 	}
                 	else
                 	{
                 		info "Setting Record Already Exists.";
                 	}
                 }
				 void createEmployeeIfNotExists(int attendanceLogId)
                 {
                 	// ================= GET ATTENDANCE =================
                 	att = Attendance_Logs[ID == attendanceLogId];
                 	if(att.ID == null)
                 	{
                 		return;
                 	}
                 	if(att.Employee_Id == null || att.Employee_Id <= 0)
                 	{
                 		return;
                 	}
                 	// ================= CHECK EMPLOYEE =================
                 	emp = Employee_Name[Employee_No == att.Employee_Id];
                 	if(emp.ID == null)
                 	{
                 		// ---------- CREATE EMPLOYEE ----------
                 		newEmpId = insert into Employee_Name
                 		[
                 			Employee_No=att.Employee_Id
                 			Added_User=zoho.loginuser
                 		];
                 		// ---------- CREATE SALARY MASTER ----------
                 		insert into Salary_Master
                 		[
                 			Added_User=zoho.loginuser
                 			Employee_Rec_ID=newEmpId
                 		]
                 		emp = Employee_Name[ID == newEmpId];
                 	}
                 	// ================= CHECK ATTENDANCE RULE =================
                 	if(emp.Attendance_Rule == null)
                 	{
                 		att.Employee_Status="Onboarding Pending";
                 		return;
                 	}
                 	// ================= CHECK SALARY MASTER =================
                 	sal = Salary_Master[Employee_Rec_ID == emp.ID];
                 	if(sal.Payment_Type == null)
                 	{
                 		att.Employee_Status="Salary Pending";
                 	}
                 	else
                 	{
                 		att.Employee_Status="Employee Exists";
                 	}
                 }
				 void createOpenStock(int rawMaterialId)
                 {
                 	try 
                 	{
                 		rm = Raw_Material1[ID == rawMaterialId];
                 		if(rm == null)
                 		{
                 			info "Raw Material not found.";
                 			return;
                 		}
                 		if(ifnull(rm.Open_Stock,0) <= 0)
                 		{
                 			info "Open Stock must be greater than 0.";
                 			return;
                 		}
                 		// Remove existing opening stock record (if any)
                 		delete from Excess_Inventory[Raw_Material1 == rawMaterialId];
                 		// Create Opening Stock
                 		insert into Excess_Inventory
                 		[
                 			Added_User=zoho.loginuser
                 			Raw_Material1=rm.ID
                 			Raw_Material_No=rm.RM_No
                 			Category1=rm.Category
                 			Subcategory1=rm.Subcategory
                 			Stock_Uom=rm.Stock_Uom1
                 			Source="Direct"
                 			Fresh_Excess=rm.Open_Stock
                 			Rejected_Excess=0
                 			Total_Qty=rm.Open_Stock
                 			Po_Price=rm.Open_Stock_Price
                 			Invoice_Price=rm.Open_Stock_Price
                 		]
                 		// Clear opening stock fields after successful creation
                 		update Raw_Material1[ID == rawMaterialId]
                 		[
                 			Open_Stock=null
                 			Open_Stock_Price=null
                 			Create_open_stock="No"
                 		];
                 		info "Opening Stock created successfully.";
                 	}	catch (e)
                 	{
                 		info e.toString();
                 	}
                 }
				 void createOrderFromOnlineOrder(int onlineOrderId)
                 {
                 	onlineOrder = Online_Order_Create_order[ID == onlineOrderId];
                 	if(onlineOrder == null)
                 	{
                 		info "Online Order not found";
                 		return;
                 	}
                 	//========================================================
                 	// BUYER
                 	//========================================================
                 	buyerId = null;
                 	if(onlineOrder.Entity1 != null && onlineOrder.Entity1 != "")
                 	{
                 		buyerRec = Buyer1[Buyer_Name == onlineOrder.Entity1];
                 		if(buyerRec.ID != null)
                 		{
                 			buyerId = buyerRec.ID;
                 		}
                 		else
                 		{
                 			buyerId = insert into Buyer1
                 			[
                 				Buyer_Name=onlineOrder.Entity1
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 	}
                 	//========================================================
                 	// BRAND
                 	//========================================================
                 	brandId = null;
                 	if(onlineOrder.Brand != null && onlineOrder.Brand != "")
                 	{
                 		brandRec = Brand1[Brand == onlineOrder.Brand];
                 		if(brandRec.ID != null)
                 		{
                 			brandId = brandRec.ID;
                 		}
                 		else
                 		{
                 			brandId = insert into Brand1
                 			[
                 				Brand=onlineOrder.Brand
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 	}
                 	//========================================================
                 	// PRODUCT MASTER
                 	//========================================================
                 	productMasterId = null;
                 	if(onlineOrder.Product_Master != null)
                 	{
                 		productMasterId = onlineOrder.Product_Master;
                 	}
                 	if(productMasterId == null)
                 	{
                 		info "Please select Product Master in Online Order";
                 		return;
                 	}
                 	//========================================================
                 	// PRODUCT (NEW LOOKUP FIELD : Products)
                 	//========================================================
                 	productId = null;
                 	if(onlineOrder.Products != null)
                 	{
                 		productId = onlineOrder.Products;
                 	}
                 	if(productId == null)
                 	{
                 		info "Please select Product in Online Order";
                 		return;
                 	}
                 	//========================================================
                 	// COLOR
                 	//========================================================
                 	colorId = null;
                 	if(onlineOrder.Colors != null)
                 	{
                 		colorId = onlineOrder.Colors;
                 	}
                 	if(colorId == null)
                 	{
                 		info "Please select Color in Online Order";
                 		return;
                 	}
                 	//========================================================
                 	// GST
                 	//========================================================
                 	if(onlineOrder.Gst == null)
                 	{
                 		info "Please select GST in Online Order";
                 		return;
                 	}
                 	//========================================================
                 	// HSN
                 	//========================================================
                 	if(onlineOrder.Hsn_Code == null)
                 	{
                 		info "Please select HSN in Online Order";
                 		return;
                 	}
                 	//========================================================
                 	// CREATE ORDER
                 	//========================================================
                 	orderId = insert into Create_Order
                 	[
                 		Style_Name=ifnull(onlineOrder.Style_Name,"")
                 		Buyer1=buyerId
                 		Brand=brandId
                 		Catagery=productMasterId
                 		Sub_Catagery=productId
                 		Colors=colorId
                 		Order_Qty=ifnull(onlineOrder.Qty,0)
                 		Order_Qty_with_out_Excess=ifnull(onlineOrder.Qty,0)
                 		Fob=ifnull(onlineOrder.Price,0)
                 		Channeal="Online"
                 		Order_volume=ifnull(onlineOrder.Volum,"Small")
                 		Gst=onlineOrder.Gst
                 		Hsn_Code=onlineOrder.Hsn_Code
                 		Final_Status="Draft"
                 		Process_Status="Draft"
                 		Work_Order_Status="Not Create"
                 		Raw_material_Status="Not Approved"
                 		Check_List_Status="Draft"
                 		Added_User=zoho.loginuser
                 	];
                 	info "Order Created : " + orderId;
                 	//========================================================
                 	// SIZE WISE
                 	//========================================================
                 	for each  sizeRec in Online_Order_Size_Wise[Online_Order_Create_order == onlineOrder.ID]
                 	{
                 		sizeId = null;
                 		if(sizeRec.Size != null && sizeRec.Size != "")
                 		{
                 			sizeMaster = Size[Size == sizeRec.Size];
                 			if(sizeMaster.ID != null)
                 			{
                 				sizeId = sizeMaster.ID;
                 			}
                 			else
                 			{
                 				sizeId = insert into Size
                 				[
                 					Size=sizeRec.Size
                 					Added_User=zoho.loginuser
                 				];
                 			}
                 		}
                 		insert into Finished_Goods_Size_wise
                 		[
                 			Order_No=orderId
                 			Buyer_Size=sizeId
                 			Size=sizeId
                 			Before_Excess_Qty=ifnull(sizeRec.Qty,0)
                 			Excess=ifnull(sizeRec.Excess,0)
                 			Excess_Qty=ifnull(sizeRec.Excess,0)
                 			Total_Qty=ifnull(sizeRec.Total,0)
                 			Plan_Qty=ifnull(sizeRec.Total,0)
                 			Style_Name=ifnull(onlineOrder.Style_Name,"")
                 			Buyer1=buyerId
                 			Brand1=brandId
                 			Work_Order_Status="Not Create"
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	//========================================================
                 	// UPDATE ONLINE ORDER
                 	//========================================================
                 	onlineOrder.Order_No=orderId;
                 	onlineOrder.Order_Status1="Order Created";
                 	info "Order Created Successfully";
                 }
				 void createPackingList(OUTER_CARTON cartons)
                 {
                 	// ===============================
                 	// SAFETY CHECK
                 	// ===============================
                 	if(cartons == null || cartons.count() == 0)
                 	{
                 		info "Select at least one Outer Carton";
                 		return;
                 	}
                 	// ===============================
                 	// VALIDATION : Already packed
                 	// ===============================
                 	for each  c in cartons
                 	{
                 		if(c.Packing_Created == true)
                 		{
                 			info "Packing List already created for one or more selected Outer Cartons";
                 			return;
                 		}
                 	}
                 	totalQty = 0;
                 	brandVal = null;
                 	// ===============================
                 	// HEADER CALCULATION
                 	// ===============================
                 	for each  c in cartons
                 	{
                 		totalQty = totalQty + ifnull(c.Total_Qty,0);
                 		if(brandVal == null)
                 		{
                 			brandVal = c.Brand1;
                 		}
                 	}
                 	// ===============================
                 	// CREATE PACKING LIST HEADER
                 	// ===============================
                 	plHeader = insert into Packing_List_Header
                 	[
                 		Brand11=brandVal
                 		Number_of_carton=cartons.count()
                 		Qty=totalQty
                 		Created_On=zoho.currentdate
                 		Added_User=zoho.loginuser
                 	];
                 	// ===============================
                 	// CREATE PACKING LIST LINES
                 	// + UPDATE OUTER CARTON HEADER
                 	// ===============================
                 	for each  c in cartons
                 	{
                 		detailText = "";
                 		for each  r in c.SubForm
                 		{
                 			if(r.Size != null && r.Qty != null)
                 			{
                 				orderNo = "";
                 				styleName = "";
                 				sizeName = "";
                 				if(r.Order_No != null)
                 				{
                 					orderNo = r.Order_No.Order_No;
                 				}
                 				if(r.Style_Name != null)
                 				{
                 					styleName = r.Style_Name.Style_Name;
                 				}
                 				sizeName = r.Size.Size;
                 				lineText = orderNo + " - " + styleName + " - Size " + sizeName + " = " + r.Qty + " pcs";
                 				if(detailText == "")
                 				{
                 					detailText = lineText;
                 				}
                 				else
                 				{
                 					detailText = detailText + "\n" + lineText;
                 				}
                 			}
                 		}
                 		// ===============================
                 		// INSERT PACKING LIST LINE
                 		// ===============================
                 		insert into Packing_List
                 		[
                 			Packing_List_Header=plHeader
                 			OUTER_CARTON1=c
                 			Qty=c.Total_Qty
                 			Size=c.Type_field
                 			Details=detailText
                 			Brand1=c.Brand1
                 			Added_User=zoho.loginuser
                 		]
                 		// ===============================
                 		// UPDATE OUTER CARTON (HEADER)
                 		// ===============================
                 		c.Packing_List_Header=plHeader;
                 		c.Packing_Created=true;
                 	}
                 	info "Packing List created successfully";
                 }
				 void createPayrollFromAttendance(int attendanceId)
                 {
                 	// ================= GET ATTENDANCE =================
                 	att = Attendance_Master[ID == attendanceId];
                 	if(att == null || att.Employee_No1 == null || att.Month_Master == null || att.Yearmasterlookup == null)
                 	{
                 		return;
                 	}
                 	// ================= GET EMPLOYEE =================
                 	emp = Employee_Name[ID == att.Employee_No1];
                 	if(emp == null)
                 	{
                 		return;
                 	}
                 	// ================= EMPLOYEE STATUS VALIDATION =================
                 	// Allow Active & Inactive, block only Permanently Inactive
                 	if(emp.Status == "Permanently Inactive")
                 	{
                 		return;
                 	}
                 	// ================= GET MONTH =================
                 	month_rec = Month_Master[ID == att.Month_Master];
                 	if(month_rec == null)
                 	{
                 		return;
                 	}
                 	// ================= GET YEAR =================
                 	yearId = att.Yearmasterlookup;
                 	if(yearId == null)
                 	{
                 		return;
                 	}
                 	// ================= CHECK IF PAYROLL EXISTS =================
                 	existing = Payroll[Employee_Id == emp.ID && Month_Master == month_rec.ID && Year_form == yearId];
                 	if(existing.count() > 0)
                 	{
                 		att.Payroll_Status=existing.ID;
                 		return;
                 	}
                 	// ================= CREATE PAYROLL =================
                 	payroll_id = insert into Payroll
                 	[
                 		Added_User=zoho.loginuser
                 		Employee_Id=emp.ID
                 		Employee_Name=emp.ID
                 		Month_Master=month_rec.ID
                 		Year_form=yearId
                 		Absent=att.Grand_Total_Absent1
                 		Present=att.Grand_Total_Present1
                 		Total_Days=att.Total_Number_of_days
                 		Total_Working_Duration1=ifnull(att.Total_Duration2,0)
                 		Payroll_Status="Created"
                 	];
                 	// ================= LINK BACK =================
                 	if(payroll_id != null)
                 	{
                 		att.Payroll_Status=payroll_id;
                 	}
                 }
