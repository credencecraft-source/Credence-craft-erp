		form Quotation1
		{
			displayname = "Quotation(forword Booking )"
			success message = "Sale Order Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Entity_Name
			(
				type = picklist	
				displayname = "Entity Name"
				values  = Entity_Name.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
				type = picklist	
				displayname = "Customer Name"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			QuotationNo
			(
    			type = formula
				displayname = "Quotation No"
				value =  "QO" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 1
	 			column = 1   
				width = medium
			)
			Order_No
			(
				type = list	
				displayname = "Order No"
				values  = Create_Order.ID
    			displayformat = [Order_No + " - " + Style_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Qty
			(
				type = number
				displayname = "Total Qty"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
			Payment_Terms
			(
				type = picklist	
				displayname = "Payment Terms"
				values  = Payment_Terms.ID
    			displayformat = [Payment_Terms]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			User
			(
				type = picklist	
				values  = User.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			SubForm
			(
				type = grid
				values  = Quoation_Subform.ID
    			bidirectional = Quoation
				auto width = false
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
				Quotation
				{
