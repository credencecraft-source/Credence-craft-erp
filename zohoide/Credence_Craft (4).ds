			Create_Order_C_E_Validati as "Create Order (C/E)-Validation"
			{
				type =  form
				form = Create_Order

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Article.Status != "Approved")
										{
											alert "The Gold Seal is not Approved..!";
											cancel submit;
										}
										else if(input.Brand.Status != "Approved")
										{
											alert "The Brand is not Approved..!";
											cancel submit;
										}
										else if(input.Size_Group.Status != "Approved")
										{
											alert "The Size Group is not Approved..!";
											cancel submit;
										}
										else if(input.Buyer1.Status != "Approved")
										{
											alert "The Buyer is not Approved..!";
											cancel submit;
										}
										else if(input.Season.Status != "Approved")
										{
											alert "The Season is not Approved..!";
											cancel submit;
										}
										if(input.Finished_Goods_Size_wise.count() > 0)
										{
											for each  each_sis in input.Finished_Goods_Size_wise
											{
												if(each_sis.Size.status != "Approved")
												{
													alert "The size (" + each_sis.Size.Size + ") is not Approved..!";
													cancel submit;
													break;
												}
											}
										}
						)
					}
				}

			}
			Order_Raw_Materil_C_E_Fie as "Order Raw Materil (C/E)-Field Rules"
