			Validate_Best_Consumption as "Validate Best Consumption in Approve Interal"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add

				on user input of Validate_Buyer_Consumption
				{
					actions 
					{
						custom deluge script
						(
											if(input.Validate_Buyer_Consumption == true)
										{
											//alert "Test" ;
											for each  each_itme in input.Approve_Consumption_and_price
											{
												get_all_order_internal_consumption = Order_Raw_material[Raw_Material_Name == input.Raw_Material && Gold_Seal == each_itme.Gold_Seal && Order_No != input.Order_No && Buyer_Consumption > each_itme.Buyer_Consumption1 && Buyer_Consumption_Status == "Approved" && Placements == each_itme.Placements];
												if(get_all_order_internal_consumption.ID != null)
												{
													each_itme.Buyer_Best_Consumption="Better Consumption Available";
												}
												else
												{
													each_itme.Buyer_Best_Consumption="Yes";
												}
											}
										}
										else
										{
											for each  each_itme in input.Approve_Consumption_and_price
											{
												each_itme.Buyer_Best_Consumption="";
											}
										}
						)
					}
				}

			}
