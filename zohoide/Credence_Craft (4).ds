			Gst_fetch as "Gst fetch"
			{
				type =  form
				form = Vendor1

				record event = on add or edit

				on user input of Fetch_Address
				{
					actions 
					{
						custom deluge script
						(
											if(input.Fetch_Address == true)
										{
											// ===== DAILY LIMIT VALIDATION =====
											todayDate = zoho.currentdate;
											if(input.Fetch_Date != todayDate)
											{
												input.Fetch_Count = 0;
												input.Fetch_Date = todayDate;
											}
											// ===== SHOW COUNT =====
											info "ℹ️ GST Fetch Used Today: " + input.Fetch_Count + " / 5";
											if(input.Fetch_Count >= 5)
											{
												info "❌ Daily GST fetch limit (5) reached";
												input.Fetch_Address = false;
												return;
											}
											if(input.Gst_No != null)
											{
												if(input.Gst_No.length() == 15)
												{
													resp = invokeurl
													[
														url :"https://sheet.gstincheck.co.in/check/866b7fa68c374dce92f9e5d02583661f/" + input.Gst_No
														type :GET
													];
													if(resp.get("flag") == true)
													{
														data = resp.get("data");
														// ===== NAME =====
														if(data.get("tradeNam") != null && data.get("tradeNam") != "")
														{
															input.Vendor_Name = data.get("tradeNam");
														}
														pradr = data.get("pradr");
														if(pradr != null)
														{
															fullAddr = pradr.get("adr");
															if(fullAddr != null)
															{
																addrList = fullAddr.toList(",");
																line1 = "";
																line2 = "";
																count = 0;
																for each  item in addrList
																{
																	if(count <= 2)
																	{
																		line1 = line1 + item.trim() + ", ";
																	}
																	else
																	{
																		line2 = line2 + item.trim() + ", ";
																	}
																	count = count + 1;
																}
																line1 = line1.trim();
																if(line1.length() > 2)
																{
																	line1 = line1.subString(0,line1.length() - 2);
																}
																line2 = line2.trim();
																if(line2.length() > 2)
																{
																	line2 = line2.subString(0,line2.length() - 2);
																}
																input.Vendor_Registered_GST_Address.address_line_1 = line1;
																input.Vendor_Registered_GST_Address.address_line_2 = line2;
															}
															addr = pradr.get("addr");
															if(addr != null)
															{
																input.Vendor_Registered_GST_Address.district_city = addr.get("dst");
																input.Vendor_Registered_GST_Address.state_province = addr.get("stcd");
																input.Vendor_Registered_GST_Address.postal_Code = addr.get("pncd");
																input.Vendor_Registered_GST_Address.country = "India";
																input.City1 = addr.get("dst");
																// ===== STATE LOOKUP =====
																stateName = addr.get("stcd");
																if(stateName != null)
																{
																	stateRec = customer_s_registered_Gst_State[customer_s_registered_Gst_State == stateName];
																	if(stateRec != null)
																	{
																		input.Registered_Gst_State = stateRec.ID;
																	}
																	else
																	{
																		info "⚠️ State not found: " + stateName;
																	}
																}
															}
														}
														// ===== GST TYPE AUTO =====
														if(input.Entity_Name != null && input.Registered_Gst_State != null)
														{
															entityRec = Entity_Name[ID == input.Entity_Name];
															if(entityRec != null && entityRec.Entity_Gst_Registered_State != null)
															{
																if(entityRec.Entity_Gst_Registered_State.ID == input.Registered_Gst_State)
																{
																	gstTypeRec = GST_TYPE[gst_type == "CGST & SGST"];
																}
																else
																{
																	gstTypeRec = GST_TYPE[gst_type == "IGST"];
																}
																if(gstTypeRec != null)
																{
																	input.New_GST_Type = gstTypeRec.ID;
																}
															}
														}
														// ===== DEFAULT CURRENCY =====
														currencyRec = Currency_Type[Currency == "INR"];
														if(currencyRec != null)
														{
															input.Currency_Type = currencyRec.ID;
														}
														// ===== INCREMENT COUNT =====
														input.Fetch_Count = input.Fetch_Count + 1;
														info "✅ GST FETCH SUCCESS | Used: " + input.Fetch_Count + " / 5";
													}
													else
													{
														info "❌ GST NOT FOUND";
														info resp;
													}
													// ===== DISABLE BUTTON =====
													input.Fetch_Address = false;
												}
											}
										}
						)
					}
				}

			}
