			Order_Raw_Material_Edit_V as "Order Raw Material (Edit)-Validation"
			{
				type =  form
				form = Order_Raw_material

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grouping_raw_material = Grouping_Subform[Order_Raw_material_ID == input.ID && Grouping_Purchase_Request_ID != null];
										if(get_grouping_raw_material.ID != null)
										{
											if(old.Internal_Consumption > input.Internal_Consumption)
											{
												alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Internal Consumption.";
												cancel submit;
											}
											else if(old.Item_Wise_Excess_qty > input.Item_Wise_Excess_qty)
											{
												alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Item Wise Excess_qty.";
												cancel submit;
											}
											else if(old.Sum_of_Size_wise_qty > input.Sum_of_Size_wise_qty)
											{
												alert "The grouping has been partially or fully completed; therefore, the system does not allow change size.";
												cancel submit;
											}
											else if(old.Total_Required_Qty > input.Total_Required_Qty)
											{
												alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Total Required Qty.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Create_Order_Edit_Validat as "Create Order (Edit)-Validation"
			{
				type =  form
				form = Create_Order

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grouping_subform = Grouping_Subform[Order_Raw_material_ID.Order_No == input.ID && Grouping_Purchase_Request_ID != null];
										if(get_grouping_subform.ID != null)
										{
											for each  eahc_size in input.Finished_Goods_Size_wise
											{
												get_old_size = Finished_Goods_Size_wise[ID == eahc_size.ID];
												if(get_old_size.ID != null)
												{
													if(get_old_size.Excess > eahc_size.Excess)
													{
														alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Excess.";
														cancel submit;
														break;
													}
													else if(get_old_size.Before_Excess_Qty > eahc_size.Before_Excess_Qty)
													{
														alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Before Excess Qty.";
														cancel submit;
														break;
													}
												}
											}
										}
						)
					}
				}

			}
