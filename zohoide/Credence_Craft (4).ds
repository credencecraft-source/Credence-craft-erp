			Delete_Validate2 as "Delete Validate"
			{
				type =  form
				form = RM_PICK_BOX

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  rec in input.SubForm
										{
											getPickLIst = Centralized_Pick_list[ID == rec.Pick_ID];
											getPickLIst.Boxed_Qty=ifnull(getPickLIst.Boxed_Qty,0) - rec.Packed;
											getPickLIst.Balance_to_Create_Box=getPickLIst.Balance_to_Create_Box + rec.Packed;
											if(ifnull(getPickLIst.Boxed_Qty,0) == 0)
											{
												getPickLIst.Box_Status="Draft";
											}
											else if(ifnull(getPickLIst.Boxed_Qty,0) < ifnull(getPickLIst.Requested,0))
											{
												getPickLIst.Box_Status="Partially Created";
											}
											else if(ifnull(getPickLIst.Boxed_Qty,0) == ifnull(getPickLIst.Requested,0))
											{
												getPickLIst.Box_Status="Fully Boxed";
											}
										}
						)
					}
				}

			}
			On_Delete as "On Delete"
			{
				type =  form
				form = Centralized_Pick_list

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ---- Get Style Inventory FIRST ----
										getStyle = Style_Wise_Inventory[Order_No1 == input.Order_No && Raw_Material1 == input.Raw_Material1];
										// ---- Delete Picks ----
										thisapp.work_order_controllar.DeletePick(input.WO_No);
										for each  rec in Pick_List_Subform[Picked == null]
										{
											delete from Pick_List_Subform[ID == rec.ID];
										}
										for each  rec2 in Style_wise_inventory_Subfrom_out_word[Centralized_Pick_list == null]
										{
											delete from Style_wise_inventory_Subfrom_out_word[ID == rec2.ID];
										}
										// ---- Update Style Inventory ONLY if exists ----
										if(getStyle.ID != null)
										{
											thisapp.work_order_controllar.Wo_Style_Wise_Inveroey(getStyle.ID);
										}
										// ---- Update WO Status ----
										thisapp.work_order_controllar.woStatus(input.WO_No);
						)
					}
				}

			}
			Subscription_Validation as "Subscription Validation"
			{
				type =  form
				form = Purchase_Order

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Get current month and year
										current_year = year(zoho.currentdate);
										current_month = month(zoho.currentdate);
										// Fetch the Pricing record for current month and year
										pricing_records = Pricing[Year_field == current_year && Month_field == current_month];
										if(pricing_records.count() > 0)
										{
											for each  p in pricing_records
											{
												// Check if total count exceeds Maximum
												if(p.Count_field >= p.Maximum)
												{
													alert "You are reaching your limit, please upgrade your plan!";
													cancel submit;
													// stops form submission safely
												}
											}
										}
										else
										{
											alert "No Pricing record found for current month/year!";
											cancel submit;
											// stops form submission safely
										}
						)
					}
				}

			}
