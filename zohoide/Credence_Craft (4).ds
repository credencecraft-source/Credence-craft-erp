			Approve_Internal_Consumpt8 as "Approve Internal Consumption Price (C/E)-Success"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Type_field == "Consumption")
										{
											for each  each_item in input.Approve_Consumption_and_price
											{
												get_order_raw = Order_Raw_material[ID == input.Order_Raw_material && Buyer_Consumption == each_item.Buyer_Consumption1 && Placements == each_item.Placements];
												for each  rec in get_order_raw
												{
													if(each_item.Internal_Best_Consumption == "Yes")
													{
														rec.Internal_Consumption_Status="Approved";
														rec.Internal_Consumption=each_item.Internal_Consumption;
														rec.Internal_Price=each_item.Internal_Price;
														each_item.Internal_Consumption_Approve_Status="Approved";
													}
													if(each_item.Buyer_Best_Consumption == "Yes")
													{
														rec.Buyer_Consumption_Status="Approved";
														rec.Buyer_Consumption=each_item.Buyer_Consumption1;
														rec.Buyer_Price=each_item.Buyer_Price;
														each_item.Buyer_Consumption_Approve_Status="Approved";
													}
													if(rec.Internal_Consumption_Status == "Approved" && rec.Buyer_Consumption_Status == "Approved" && rec.Price_Status == "Approved")
													{
														rec.Raw_material_Status="Approved";
														rec.Value_Per_Garment_Rm=ifnull(rec.Internal_Consumption,0) * ifnull(rec.Internal_Price,0);
													}
													else
													{
														rec.Raw_material_Status="Draft";
													}
													thisapp.order_controllar.order_raw_material_field_calculate(rec.ID);
												}
											}
										}
										else
										{
											for each  each_item in input.Approve_Consumption_and_price
											{
												get_order_raw = Order_Raw_material[ID == input.Order_Raw_material && Buyer_Price == each_item.Buyer_Price];
												getCount = get_order_raw.count();
												for each  orderRaw in get_order_raw
												{
													orderRaw.Internal_Price=each_item.Internal_Price;
													if(orderRaw.Internal_Price <= orderRaw.Buyer_Price)
													{
														orderRaw.Price_Status="Approved";
														orderRaw.Internal_Vendor=each_item.Internal_Vendor;
													}
													else
													{
														orderRaw.Price_Status="Awaiting for Approval";
														createApprove = insert into Approve_Internal_Consumption_Subform
														[
															Added_User=zoho.loginuser
															Order_No=orderRaw.Order_No
															Internal_Price=each_item.Internal_Price
															Buyer_Price=each_item.Buyer_Price
															Raw_Material1=each_item.Raw_Material1
															Price_Status="Awaiting for Approval"
														];
													}
													if(orderRaw.Internal_Consumption_Status == "Approved" && orderRaw.Buyer_Consumption_Status == "Approved" && orderRaw.Price_Status == "Approved")
													{
														orderRaw.Raw_material_Status="Approved";
														orderRaw.Value_Per_Garment_Rm=ifnull(orderRaw.Internal_Consumption,0) * ifnull(orderRaw.Internal_Price,0);
													}
												}
											}
										}
										openUrl("#Script:page.parent.refresh","same window");
										// ✅ Refresh page
										//openurl("#Script:page.parent.refresh","same window");
						)
					}
				}

			}
			Grouping_Purchase_Request1 as "Grouping Purchase Request (C)-Onload"
			{
				type =  form
				form = Grouping_Purchase_Request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Order_Raw_Material_ID.size() > 0)
										{
											sum_of_qty = 0;
											for each  each_order_raw_material in input.Order_Raw_Material_ID
											{
												sum_of_already_gorupped = Grouping_Subform[Order_Raw_material_ID == each_order_raw_material.ID && Grouping_Purchase_Request_ID != null].sum(Grouped_Qty);
												get_atcual_req_qty = ifnull(each_order_raw_material.Required_Qty,0) - sum_of_already_gorupped;
												if(get_atcual_req_qty > 0)
												{
													row2 = Grouping_Purchase_Request.Grouping_Subform();
													row2.Raw_Material1=each_order_raw_material.Raw_Material_Name;
													row2.Create_Order=each_order_raw_material.Order_No;
													row2.Subform_Catagery=each_order_raw_material.Category_Master;
													row2.Gold_Seal=each_order_raw_material.Gold_Seal;
													row2.Style_No=each_order_raw_material.Style_Name;
													row2.Vendor1=each_order_raw_material.Vendor_Master;
													row2.Create_Eo_No=each_order_raw_material.Order_No.Eo_No_and_Name;
													row2.Required_Qty=get_atcual_req_qty;
													row2.Internal_Price_bom=each_order_raw_material.Internal_Price;
													row2.Order_Raw_material_ID=each_order_raw_material.ID;
													rows1 = Collection();
													rows1.insert(row2);
													input.Grouping_Subform.insert(rows1);
													sum_of_qty = sum_of_qty + ifnull(get_atcual_req_qty,0);
												}
											}
											input.Total_Required_Qty_Raw_Material = sum_of_qty;
											input.Order_Number = (input.Order_Raw_Material_ID.Order_No.getall()).tolist().distinct();
											Create_Eo_No = input.Order_Number.Eo_No_and_Name;
											input.Eo_No = input.Order_Number.Eo_No_and_Name;
											input.Gold_Seal = input.Order_Number.Article;
											input.Raw_Material1 = input.Order_Raw_Material_ID.Raw_Material_Name;
											input.Total_Grouped_Qty = sum_of_qty;
											input.Subcategory1 = input.Order_Raw_Material_ID.Subcategory;
											//input.Gst_No_Need = input.Subcategory1.Gst;
											//input.Hsn_Code_no_need = input.Subcategory1.Hsn_Code;
											input.Category_Type1 = input.Order_Raw_Material_ID.Category_Type_Master;
											input.Category1 = input.Order_Raw_Material_ID.Category_Master;
											input.Brand1 = input.Order_Raw_Material_ID.Brand1;
											input.Stock_Uom = input.Raw_Material1.Stock_Uom1;
											input.No_of_Styles = input.Grouping_Subform.count();
											//sum_of_excess_qty = Excess_Inventory[Raw_Material1 == input.Raw_Material1 && Gate_Entry != null].sum(Fresh_Excess);
											sum_of_excess_qty = Excess_Inventory[Raw_Material1 == input.Raw_Material1].sum(Fresh_Excess);
											input.plain = "<p style='color: green; font-weight: bold;'>The available excess stock quantity is " + sum_of_excess_qty + ".</p>";
										}
										if(input.No_of_Styles != null && input.No_of_Styles > 10)
										{
											alert "Maximum 10 styles are allowed.";
											input.No_of_Styles = 10;
										}
										input.Vendor1 = input.Order_Raw_Material_ID.Vendor_Master;
										if(ifnull(input.Category_Type1.Category_Type_Name,"").toLowerCase() == "service")
										{
											enable Grouping_Subform.Grouped_Qty;
											disable Total_Grouped_Qty;
										}
						)
					}
				}

			}
			Copy_Brand_Value_to_Inter as "Copy Brand Value to Internal Values"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on user input of Copy_Consumption
				{
					actions 
					{
						custom deluge script
						(
											if(input.Copy_Consumption == true)
										{
											for each  rec in input.Approve_Consumption_and_price
											{
												rec.Internal_Consumption=rec.Buyer_Consumption1;
											}
											enable Validate_Internal_Consumption;
										}
										else
										{
											for each  rec2 in input.Approve_Consumption_and_price
											{
												rec2.Internal_Consumption=0;
											}
											input.Validate_Internal_Consumption = false;
											disable Validate_Internal_Consumption;
										}
						)
					}
				}

			}
			Total_Grouped_Qty_In_Grou as "Total Grouped Qty In Grouping Purchase Request"
			{
				type =  form
				form = Grouping_Purchase_Request

				record event = on add or edit

				on user input of Total_Grouped_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Category_Type1.Category_Type_Name,"").toLowerCase() != "service")
										{
											if(input.Total_Grouped_Qty <= 0)
											{
												alert "Please enter the valid Total Grouped Qty..!";
												input.Total_Grouped_Qty = null;
											}
											else if(input.Total_Required_Qty_Raw_Material < input.Total_Grouped_Qty)
											{
												alert "Grouped quantity cannot exceed the total required quantity of raw material (" + input.Total_Required_Qty_Raw_Material + ").";
												input.Total_Grouped_Qty = null;
											}
											// if(input.No_Need == true)
											// {
											// 	input.Buying_Qty_after_round_off_No_Need = ifnull(input.Buying_Qty_No_Need,0).ceil();
											// }
											// else
											// {
											// 	input.Buying_Qty_after_round_off_No_Need = input.Buying_Qty_No_Need;
											// }
											// if(input.Buying_Qty_No_Need != input.Buying_Qty_after_round_off_No_Need)
											// {
											// 	get_convert_value_round_off = ifnull(input.Buying_Qty_after_round_off_No_Need,0) * ifnull(input.Convert_Value,0);
											// 	input.Round_oF_qty = get_convert_value_round_off - ifnull(input.Total_Grouped_Qty,0);
											// }
											// else
											// {
											// 	input.Round_oF_qty = 0;
											// }
											// input.Total_Extra = ifnull(input.Round_oF_qty,0) + ifnull(input.Moq_No_Need,0);
											// input.Po_Qty_No_Need = ifnull(input.Total_Grouped_Qty,0) + ifnull(input.Total_Extra,0);
											// if(input.Convert_Value > 0)
											// {
											// 	input.Buying_Po_Qty_No_Need = ifnull(input.Po_Qty_No_Need,0) / ifnull(input.Convert_Value,0);
											// }
											// else
											// {
											// 	input.Buying_Po_Qty_No_Need = 0;
											// }
											/*if(input.Total_Grouped_Qty > input.Total_Required_Qty_Raw_Material)
																															{
																																input.Total_Moq = ifnull(input.Total_Grouped_Qty,0) - ifnull(input.Total_Required_Qty_Raw_Material,0);
																															}
																															else
																															{
																																input.Total_Moq = 0;
																															}*/
											input.Per_Order_Moq = ifnull(input.Total_Extra,0) / ifnull(input.Grouping_Subform.count(),0);
											get_total_goruping_qty = input.Total_Grouped_Qty;
											for each  each_goring_qty in input.Grouping_Subform
											{
												if(each_goring_qty.Required_Qty < get_total_goruping_qty)
												{
													get_gropped_qty = each_goring_qty.Required_Qty;
												}
												else
												{
													get_gropped_qty = get_total_goruping_qty;
												}
												each_goring_qty.Grouped_Qty=get_gropped_qty;
												each_goring_qty.Moq_Alloation=input.Per_Order_Moq;
												get_total_goruping_qty = get_total_goruping_qty - each_goring_qty.Grouped_Qty;
												get_actual_qty = ifnull(each_goring_qty.Moq_Alloation,0) + ifnull(each_goring_qty.Grouped_Qty,0);
												each_goring_qty.Total_Spend_With_Other_Charges=get_actual_qty * ifnull(each_goring_qty.Vender_Price_Other_Charges,0);
												each_goring_qty.Total_Spend_With_out_Other_Charges=get_actual_qty * ifnull(each_goring_qty.Vender_price_per_order_per_ps_Stock_Uom1,0);
											}
										}
						)
					}
				}

			}
