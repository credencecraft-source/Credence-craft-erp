			Raw_Material_C_E_Validati as "Raw Material (C/E)-Validation"
			{
				type =  form
				form = Raw_Material1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Is_this_Specific_for_a_Brand == true)
										{
											if(input.Brand1 == null)
											{
												alert "Please select the Brand..!";
												cancel submit;
											}
										}
										for each  each_raw_material in input.Vendor_Wise_Price_List
										{
											if(each_raw_material.Buying_in_different_UOM == true)
											{
												if(each_raw_material.Buying_In == null)
												{
													alert "Please select the Buying In";
													cancel submit;
													break;
												}
											}
										}
						)
					}
				}

			}
