			Download1 as "Download"
			{
				type =  functions
				form = Bulk_Order
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// ==================================================
										// FINAL: Full script (no intermediate logs) - up to 500 repeats
										// Outputs only final per-Gold_Seal info lines
										// ==================================================
										eo_value_text = input.EO_No;
										// fetch bulk_order_id
