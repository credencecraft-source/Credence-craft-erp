			Extra_In_Buing_UOM as "Extra In Buing UOM"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Extra_In_Buying_Uom
				{
					actions 
					{
						custom deluge script
						(
											for each  each_grouping in input.Master_Group_Subform
										{
											each_grouping.Total_Extra=(ifnull(input.Extra_In_Buying_Uom,0) * ifnull(input.Convert_Value,0)).round(0) / input.No_of_Group;
										}
						)
					}
				}

			}
			Vendor_Price_in_Master_Gr as "Vendor Price in Master Group"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Vendor_Price_INR
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Price_INR < 0)
										{
											alert "Please enter the valid vendor price..!";
											input.Vendor_Price_INR = null;
										}
										for each  each_item in input.Master_Group_Subform
										{
											each_item.Vendor_Price=input.Vendor_Price_INR;
										}
						)
					}
				}

			}
			Other_Charges_in_Master_G as "Other Charges in Master Group"
			{
