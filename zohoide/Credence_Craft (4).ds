			Verification_Allocated_in as "Verification Allocated in GRN Verification"
			{
				type =  form
				form = GRN_Verification

				record event = on add

				on user input of Verification.Verification_Allocated
				{
					actions 
					{
						custom deluge script
						(
											// ================= ROW LEVEL VALIDATION =================
										if(row.Total_Grouped_Qty < row.Verification_Allocated || row.Verification_Allocated < 0)
										{
											alert "Please enter valid verification allocated qty.";
											row.Verification_Allocated=null;
											return;
										}
										// ================= BALANCE =================
										row.Balance_to_Allocate1=ifnull(row.Total_Grouped_Qty,0) - ifnull(row.Verification_Allocated,0);
										// ================= RECALCULATE TOTALS =================
										sum_of_grupped_allocate = 0;
										sum_of_balance_group_allocate = 0;
										for each  each_verication in input.Verification
										{
											sum_of_grupped_allocate = sum_of_grupped_allocate + ifnull(each_verication.Verification_Allocated,0);
											sum_of_balance_group_allocate = sum_of_balance_group_allocate + ifnull(each_verication.Balance_to_Allocate1,0);
										}
										input.Grouped_Allocated = sum_of_grupped_allocate;
										input.Grouped_Balance_to_allocate = sum_of_balance_group_allocate;
										// ================= SYNC HEADER =================
										input.Available_To_Allocate = input.Grouped_Allocated;
						)
					}
				}

			}
