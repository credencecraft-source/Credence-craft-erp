				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = medium
			)
			Qty
			(
				type = number
	 			row = 1
	 			column = 2   
				width = medium
			)
			ZohoBooks_Invoice_ID
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Sales_For_the_Month_of
			(
				type = picklist	
				displayname = "Sales For the Month of"
				values  = Month_Master.ID
    			displayformat = [Month_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Eway_Bill_Number
			(
    			type = text
				displayname = "Eway_Bill_Number "
	 			row = 1
	 			column = 3   
				width = medium
			)
			Eway_Bill_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 3   
				width = medium
			)
			Place_of_Delivery
			(
				type = picklist	
				displayname = "Place of Delivery"
				values  = customer_s_registered_Gst_State.ID
    			displayformat = [customer_s_registered_Gst_State]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			Vehicle_No
			(
    			type = text
				displayname = "Vehicle_No "
	 			row = 1
	 			column = 3   
				width = medium
			)
			Distance_KM
			(
    			type = text
				displayname = "Distance_KM "
	 			row = 1
	 			column = 3   
				width = medium
			)
			Transporter_Name
			(
    			type = text
				displayname = "Transporter_Name "
	 			row = 1
	 			column = 3   
				width = medium
			)
			Eway_Valid_Till
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 3   
				width = medium
			)
			Show_Tax
			(
    			type = checkbox
				displayname = "Show Tax"
				initial value = false
	 			row = 1
	 			column = 3   
				width = medium
			)
			CGST
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			SGST
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			IGST
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			Sales_Invoice_Subform
			(
				type = grid
				displayname = "Sales Invoice Subform"
				values  = Sales_Invoice_Subform.ID
				auto width = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			EInvoice_Generated
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			E_Invoice_No
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			EInvoice_Status
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			E_Invoice
			(
				type = picklist	
				displayname = "E-Invoice"
				values  = E_Invoice.ID
    			bidirectional = Invoice
    			displayformat = [ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Decision_box
			(
    			type = checkbox
				displayname = "Decision box"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Eway_Vehicle_No
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
			Eway_Bill_Expiry_DateTime
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Invoice_No_Auto
			(
    			type = formula
				displayname = "Invoice No-Auto"
				value =  "INV" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			Signed_QR_Code1
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
