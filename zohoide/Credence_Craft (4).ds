			Allocate_in_GRN_Allocatio as "Allocate in GRN Allocation"
			{
				type =  form
				form = GRN_Allocation

				record event = on add or edit

				on user input of Material_Allocation.Allocate
				{
					actions 
					{
						custom deluge script
						(
											if(row.Allocate < 0)
										{
											alert "Please enter the valid Allocate Qty.";
											row.Allocate=null;
										}
										sum_allocate = 0;
										for each  each_qty in input.Material_Allocation
										{
											sum_allocate = sum_allocate + ifnull(each_qty.Allocate,0);
										}
										input.Allocated_Qty = sum_allocate;
										if(input.Allocated_Qty > input.Verification_Allocated)
										{
											alert "Allocated quantity exceeds verification quantity.";
											row.Allocate=null;
										}
						)
					}
				}

			}
