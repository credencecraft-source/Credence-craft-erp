				 void auto_create_first_process_movement(int workOrderID)
                 {
                 	woRec = Work_Order_New[ID == workOrderID];
                 	if(woRec == null)
                 	{
                 		return;
                 	}
                 	orderRec = Create_Order[ID == woRec.Create_Order];
                 	if(orderRec == null)
                 	{
                 		return;
                 	}
                 	templateRec = Process_Template[ID == orderRec.Process_Template];
                 	if(templateRec == null)
                 	{
                 		return;
                 	}
                 	firstProcessRec = Process_Master[ID == templateRec.First_Process];
                 	if(firstProcessRec == null)
                 	{
                 		return;
                 	}
                 	qty = woRec.Work_Order_Qty;
                 	// -------- BUILD SUBFORM ----------
                 	rows = Collection();
                 	tasks = Wo_Making_Charges_Subform[Order_No == woRec.Create_Order && Process_Name == firstProcessRec];
                 	for each  t in tasks
                 	{
                 		row = Process_Bundle_Movement.Operation_Wise_Bundles();
                 		row.Order_No=t.Order_No;
                 		row.Brand1=t.Brand1;
                 		row.Style_No=t.Style_Name;
                 		row.Date_field=zoho.currentdate;
                 		row.Employee_Name=null;
                 		row.Process_Name=t.Process_Name;
                 		row.Operation=t.Operation;
                 		row.Qty_To_be_Produced=toLong(ifnull(t.Operation_Wise_Qty_To_be_Produced,0));
                 		rows.insert(row);
                 	}
                 	// -------- INSERT MOVEMENT ----------
                 	movementID = insert into Process_Bundle_Movement
                 	[
                 		Order_No=woRec.Create_Order
                 		Work_Order_New=woRec.ID
                 		Process_Master=firstProcessRec.ID
                 		firstprocess=true
                 		From=firstProcessRec.ID
                 		To=firstProcessRec.ID
                 		Issued=qty
                 		GRN_Qty=0
                 		Bundle_Receaved_Date_And_Time=zoho.currenttime
                 		Receaved_IssuedDate_and_Time=zoho.currenttime
                 		Added_User=zoho.loginuser
                 		Operation_Wise_Bundles=rows
                 	];
                 	insert into Process_Bundle_GRN
                 	[
                 		Bundle_Transfer_No=movementID
                 		Work_Order_New=woRec.ID
                 		Create_Order=woRec.Create_Order
                 		Received_Qty=qty
                 		From=firstProcessRec.ID
                 		firstprocess=true
                 		To=firstProcessRec.ID
                 		Received_Date=zoho.currenttime
                 		Bundle_Receaved_user_email1=zoho.loginuserid
                 		Added_User=zoho.loginuser
                 	]
                 	// -------- UPDATE START TIME BASED ON GRN TIME ----------
                 	woProcList = Wo_Making_Charges[Work_Order == woRec.ID && Process_Name.ID == firstProcessRec.ID];
                 	for each  procRec in woProcList
                 	{
                 		if(procRec.E == null)
                 		{
                 			procRec.E=zoho.currenttime;
                 		}
                 	}
                 	grnQty = qty;
                 	bundleRec = Process_Bundle_Movement[ID == movementID];
                 	if(bundleRec == null)
                 	{
                 		return;
                 	}
                 	// Update OUTPUT only if From != To
                 	if(bundleRec.From != null && bundleRec.From != bundleRec.To)
                 	{
                 		woFromList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.From.ID];
                 		for each  woRec1 in woFromList
                 		{
                 			woRec1.Out_Put=ifnull(woRec1.Out_Put,0) + grnQty;
                 			thisapp.updateWOProcessStatusByQty(woRec1.ID);
                 		}
                 	}
                 	// Update INPUT
                 	woToList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.To.ID];
                 	for each  woRec2 in woToList
                 	{
                 		woRec2.In_Put=ifnull(woRec2.In_Put,0) + grnQty;
                 		thisapp.updateWOProcessStatusByQty(woRec2.ID);
                 	}
                 	thisapp.syncWOToOrder(bundleRec.Order_No.ID);
                 	bundleRec.GRN_Qty=ifnull(bundleRec.GRN_Qty,0) + grnQty;
                 	if(bundleRec.GRN_Qty > bundleRec.Issued)
                 	{
                 		info "GRN exceeds Issued Qty";
                 	}
                 }
				 void Auto_Create_Size_Items(int raw_material_id)
                 {
                 	raw_mat = Raw_Material1[ID == raw_material_id];
                 	if(raw_mat != null && raw_mat.Is_This_Size_wise != null)
                 	{
                 		get_sizes = Size[Size_Group_ID == raw_mat.Is_This_Size_wise];
                 		if(get_sizes.count() > 0)
                 		{
                 			base_name = raw_mat.Raw_Material_Name;
                 			first_size = null;
                 			for each  s in get_sizes
                 			{
                 				first_size = s;
                 				break;
                 			}
                 			// ===== UPDATE CURRENT RECORD TO FIRST SIZE =====
                 			raw_mat.Raw_Material_Name=base_name + "-" + first_size.Size;
                 			// ===== CREATE OTHER SIZE RECORDS =====
                 			for each  size_rec in get_sizes
                 			{
                 				if(size_rec.ID != first_size.ID)
                 				{
                 					new_name = base_name + "-" + size_rec.Size;
                 					check_exist = Raw_Material1[Raw_Material_Name == new_name];
                 					if(check_exist.count() == 0)
                 					{
                 						insert into Raw_Material1
                 						[
                 							Raw_Material_Name=new_name
                 							Is_This_Size_wise=raw_mat.Is_This_Size_wise
                 							Stock_Uom1=raw_mat.Stock_Uom1
                 							Create_open_stock=raw_mat.Create_open_stock
                 							Open_Stock=raw_mat.Open_Stock
                 							Open_Stock_Price=raw_mat.Open_Stock_Price
                 							Category=raw_mat.Category
                 							Subcategory=raw_mat.Subcategory
                 							Category_Type=raw_mat.Category_Type
                 							Show_All1=raw_mat.Show_All1
                 							Is_this_Specific_for_a_Brand=raw_mat.Is_this_Specific_for_a_Brand
                 							Brand1=raw_mat.Brand1
                 							Colour=raw_mat.Colour
                 							Item_Code=raw_mat.Item_Code
                 							Buyer_Item_Code=raw_mat.Buyer_Item_Code
                 							Image_Url=raw_mat.Image_Url
                 							Workdrive_Image_ID=raw_mat.Workdrive_Image_ID
                 							Image=raw_mat.Image
                 							Status=raw_mat.Status
                 							Added_User=zoho.loginuser
                 						]
                 					}
                 				}
                 			}
                 			// ===== SYNC ALL SIZE RECORDS ON EDIT =====
                 			all_sizes = Raw_Material1[Raw_Material_Name.startsWith(base_name)];
                 			for each  rec in all_sizes
                 			{
                 				rec.Is_This_Size_wise=raw_mat.Is_This_Size_wise;
                 				rec.Stock_Uom1=raw_mat.Stock_Uom1;
                 				rec.Create_open_stock=raw_mat.Create_open_stock;
                 				rec.Open_Stock=raw_mat.Open_Stock;
                 				rec.Open_Stock_Price=raw_mat.Open_Stock_Price;
                 				rec.Category=raw_mat.Category;
                 				rec.Subcategory=raw_mat.Subcategory;
                 				rec.Category_Type=raw_mat.Category_Type;
                 				rec.Show_All1=raw_mat.Show_All1;
                 				rec.Is_this_Specific_for_a_Brand=raw_mat.Is_this_Specific_for_a_Brand;
                 				rec.Brand1=raw_mat.Brand1;
                 				rec.Colour=raw_mat.Colour;
                 				rec.Item_Code=raw_mat.Item_Code;
                 				rec.Buyer_Item_Code=raw_mat.Buyer_Item_Code;
                 				rec.Image_Url=raw_mat.Image_Url;
                 				rec.Workdrive_Image_ID=raw_mat.Workdrive_Image_ID;
                 				rec.Image=raw_mat.Image;
                 				rec.Status=raw_mat.Status;
                 			}
                 		}
                 	}
                 }
				 void bodyFabricOnlyApproved(Order_Raw_material rawMaterialID)
                 {
                 	getStatus = (rawMaterialID.Verification_Status.getall()).distinct();
                 	if(getStatus.contains("Approved"))
                 	{
                 		info "Please Select Only Draft Records";
                 	}
                 	else
                 	{
                 		for each  rec in rawMaterialID
                 		{
                 			rec.Verification_Status="Approved";
                 		}
                 	}
                 	getRawMaterial = (rawMaterialID.Raw_Material_Name.getall()).distinct();
                 	getEO = rawMaterialID.Order_No.Eo_No_and_Name;
                 	for each  rec2 in getRawMaterial
                 	{
                 		thisapp.Fabric_Module.Create_Fab_Module(rec2,getEO);
                 	}
                 }
