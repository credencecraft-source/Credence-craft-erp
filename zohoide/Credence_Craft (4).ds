				 void generateSimpleOTP(int rec_id)
                 {
                 	random_str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
                 	len = random_str.length().toLong();
                 	now_ms = zoho.currenttime.toLong();
                 	plan_list = {"100","100_PROFESSIONAL_ACCESS","100_FULL_ENTERPRISE_ACCESS","200","200_PROFESSIONAL_ACCESS","200_FULL_ENTERPRISE_ACCESS","UNLIMITED_FULL_ENTERPRISE_ACCESS"};
                 	otp_list = "";
                 	counter = 0;
                 	for each  plan in plan_list
                 	{
                 		seed = now_ms + counter * 173;
                 		i1 = ((seed + 5) % len).toLong();
                 		i2 = ((seed + 19) % len).toLong();
                 		i3 = ((seed + 31) % len).toLong();
                 		i4 = ((seed + 47) % len).toLong();
                 		i5 = ((seed + 59) % len).toLong();
                 		i6 = ((seed + 73) % len).toLong();
                 		i7 = ((seed + 89) % len).toLong();
                 		i8 = ((seed + 101) % len).toLong();
                 		block1 = random_str.substring(i1,i1 + 1) + random_str.substring(i2,i2 + 1) + random_str.substring(i3,i3 + 1) + random_str.substring(i4,i4 + 1);
                 		block2 = random_str.substring(i5,i5 + 1) + random_str.substring(i6,i6 + 1) + random_str.substring(i7,i7 + 1) + random_str.substring(i8,i8 + 1);
                 		full_otp = block1 + "-" + block2 + "-" + plan;
                 		if(counter == 0)
                 		{
                 			otp_list = full_otp;
                 		}
                 		else
                 		{
                 			otp_list = otp_list + "," + full_otp;
                 		}
                 		counter = counter + 1;
                 	}
                 	rec = Pricing[ID == rec_id];
                 	if(rec != null)
                 	{
                 		rec.BackendOTP=otp_list;
                 		info "✅ OTPs Generated Successfully (100, 200, Unlimited Plans)";
                 	}
                 	else
                 	{
                 		info "⚠️ Record not found for ID: " + rec_id;
                 	}
                 }
