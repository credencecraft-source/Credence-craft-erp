		{
			displayName = "Delivery Challan"
			template = Delivery_Challan
			print template = Delivery_Challan
			show all rows from GRN_Delivery    
			(
				Date_field as "Date"
				Vendors1 as "Vendor"
				Is_this_Returnable as "Is this Returnable"
				(
						displaytrue = "Returnable"
						displayfalse = "Non Returnable"
				)
				Expected_Return_Date as "Expected Return Date"
				Source
				Auto_Number as "Auto Number"
				DC_NO as "DC NO"
				Entity_Name as "Entity Name"
				ZohoBooks_DC_ID
				Added_User as "Added User"
				Added_Time as "Added Time"
				Total_Qty as "Total Qty"
				CGST
				SGST
				IGST
				Total_Before_Gst as "Total Before Gst"
				Total_Tax as "Total Tax"
				Total_With_Tax as "Total With Tax"
				Other_Charges as "Other Charges"
				Grand_Total as "Grand Total"
				Status
				Vendors1.Status as "Delivery Status"
				custom action "Verify Returnable "
				(
	  			workflow = Verify_Returnable_
				show action in edit record menu = true
				column header = "Verify Returnable "
				)
				Process_Bundle_Movement as "Process Bundle Movement"
				Category_Type1 as "Category Type"
				GST_TYPE as "GST_TYPE "
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Is_this_Returnable == false)
				fields = [Is_this_Returnable]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (Is_this_Returnable == true)
				fields = [Is_this_Returnable]
				format = "color:#ffffff;background-color:#cc1111;"
				}
				"New Formatting"
				{
				condition = (Source == "Job Order")
				fields = [Source]
				format = "color:#ffffff;background-color:#f27d9b;"
				}
				"New Formatting"
				{
				condition = (Source == "Work order style")
				fields = [Source]
				format = "color:#000000;background-color:#d27df2;"
				}
				"New Formatting"
				{
				condition = (Source == "Sales Invoice")
				fields = [Source]
				format = "color:#ffffff;background-color:#85adf5;"
				}
				"New Formatting"
				{
				condition = (Source == "Direct")
				fields = [Source]
				format = "color:#000000;background-color:#7ddaf2;"
				}
			)
		}
