			Before_Excess_Qty_in_Crea as "Before Excess Qty in Create Order"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Before_Excess_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(row.Before_Excess_Qty < 0)
										{
											alert "Please enter the valid Before Excess Qty..!";
											row.Before_Excess_Qty=null;
										}
										row.Excess_Qty=ifnull(row.Before_Excess_Qty,0) * ifnull(row.Excess,0) / 100;
										row.Total_Qty=ifnull(row.Excess_Qty,0) + ifnull(row.Before_Excess_Qty,0);
										sum_order_qty = 0;
										sum_before_excess_qty = 0;
										for each  each_size in input.Finished_Goods_Size_wise
										{
											sum_order_qty = sum_order_qty + ifnull(each_size.Total_Qty,0);
											sum_before_excess_qty = sum_before_excess_qty + ifnull(each_size.Before_Excess_Qty,0);
										}
										input.Order_Qty = sum_order_qty;
										input.Order_Qty_with_out_Excess = sum_before_excess_qty;
										// <-- HEADER FIELD
										input.Order_Value = ifnull(input.Fob,0) * ifnull(input.Order_Qty,0);
						)
					}
				}

			}
			Qty_In_Create_Order as "Qty In Create Order"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Excess_Qty
