			Price_Approval_Check as "Price Approval Check"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Type_field == "Price")
										{
											for each  rec in input.Approve_Consumption_and_price
											{
												if(ifnull(rec.Internal_Price,0) == 0)
