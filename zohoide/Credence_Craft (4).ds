				 void outerbox(Inner_Carton recs)
                 {
                 	// ===============================
                 	// SAFETY CHECK
                 	// ===============================
                 	if(recs == null || recs.count() == 0)
                 	{
                 		info "Select at least one Inner Carton";
                 		return;
                 	}
                 	// ===============================
                 	// VALIDATION 1 : Already boxed
                 	// ===============================
                 	for each  rec in recs
                 	{
                 		if(rec.RM_Box_Created == true)
                 		{
                 			info "Some records are already allocated to an Outer Carton";
                 			return;
                 		}
                 	}
                 	// ===============================
                 	// VALIDATION 2 : Status check
                 	// ===============================
                 	for each  rec in recs
                 	{
                 		if(rec.Status == null || rec.Status == "Draft")
                 		{
                 			info "Only Picked records are allowed";
                 			return;
                 		}
                 	}
                 	// ===============================
                 	// VALIDATION 3 : Single Brand
                 	// ===============================
                 	brandList = List();
                 	for each  rec in recs
                 	{
                 		if(rec.Brand1 != null)
                 		{
                 			brandList.add(rec.Brand1);
                 		}
                 	}
                 	brandList = brandList.distinct();
                 	if(brandList.size() > 1)
                 	{
                 		info "Multiple Brands are not allowed in one Outer Carton";
                 		return;
                 	}
                 	// ===============================
                 	// CALCULATIONS
                 	// ===============================
                 	totalQty = 0;
                 	sizeList = List();
                 	for each  rec in recs
                 	{
                 		totalQty = totalQty + ifnull(rec.Qty,0);
                 		if(rec.Size != null)
                 		{
                 			sizeList.add(rec.Size);
                 		}
                 	}
                 	sizeList = sizeList.distinct();
                 	typeValue = if(sizeList.size() > 1,"Mixed","Same Size");
                 	// ===============================
                 	// CREATE OUTER CARTON HEADER
                 	// ===============================
                 	createBox = insert into OUTER_CARTON
                 	[
                 		Added_User=zoho.loginuser
                 		Created=zoho.currentdate
                 		Brand1=brandList.get(0)
                 		Total_Qty=totalQty
                 		Type_field=typeValue
                 	];
                 	// ===============================
                 	// SUBFORM + FLAG UPDATE
                 	// ===============================
                 	for each  rec in recs
                 	{
                 		insert into Outer_box_Subform
                 		[
                 			OUTER_CARTON=createBox
                 			Inner_Carton=rec.ID
                 			Order_No=rec.Order_No
                 			Style_Name=rec.Style_No
                 			Size=rec.Size
                 			Qty=rec.Qty
                 			Added_User=zoho.loginuser
                 		]
                 		rec.RM_Box_Created=true;
                 	}
                 }
				 void Payrollrefresh(int payrollId)
                 {
                 	pay = Payroll[ID == payrollId];
                 	if(pay == null || pay.ID == null || pay.Employee_Id == null)
                 	{
                 		return;
                 	}
                 	// ===== SALARY MASTER =====
                 	salary_rec = Salary_Master[Employee_ID.Employee_No == pay.Employee_Id.Employee_No];
                 	if(salary_rec == null || salary_rec.ID == null)
                 	{
                 		return;
                 	}
                 	// ===== SALARY STRUCTURE =====
                 	structure = null;
                 	if(salary_rec.Salary_structure_Master != null)
                 	{
                 		structure = Salary_structure_Earnings[ID == salary_rec.Salary_structure_Master.ID];
                 	}
                 	// ===== PAYMENT TYPE =====
                 	pay.Payment_Type=salary_rec.Payment_Type;
                 	// ================= IF HOURLY → ZERO ALL MONTHLY COMPONENTS =================
                 	if(pay.Payment_Type != "Monthly")
                 	{
                 		pay.Fixed_Basic_Da_month=0;
                 		pay.Per_Day_basic_Da=0;
                 		pay.effective_Basic_DA=0;
                 		pay.HRA=0;
                 		pay.Special_allowance1=0;
                 		pay.Fixed_Salary=0;
                 		pay.Hour_Salary1=salary_rec.Hour_Salary1;
                 		pay.Total_Working_Duration1=ifnull(pay.Total_Working_Duration1,0);
                 		pay.Net_Earning_Hourly=pay.Hour_Salary1 * pay.Total_Working_Duration1;
                 		pay.Total_To_be_Paid=pay.Net_Earning_Hourly;
                 	}
                 	else
                 	{
                 		// ================= MONTHLY LOGIC =================
                 		pay.Fixed_Salary=salary_rec.Monthly_Salary;
                 		pay.Hour_Salary1=0;
                 		// ===== EFFECTIVE DAYS =====
                 		pay.Effective_working_days=ifnull(pay.Total_Days,0);
                 		// ===== DAY SALARY =====
                 		if(pay.Fixed_Salary > 0 && pay.Effective_working_days > 0)
                 		{
                 			pay.Day_Salary=pay.Fixed_Salary / pay.Effective_working_days;
                 		}
                 		else
                 		{
                 			pay.Day_Salary=0;
                 		}
                 		// ===== EARNED GROSS =====
                 		pay.Earned_Gross=ifnull(pay.Day_Salary,0) * ifnull(pay.Present,0);
                 		// ===== BASIC (MONTH) =====
                 		basicMonth = 0;
                 		if(structure != null)
                 		{
                 			if(structure.Select_Basic_Salary_entry_method == "In Rupee")
                 			{
                 				basicMonth = ifnull(structure.Basic_In_Rupee,0);
                 			}
                 			else if(structure.Select_Basic_Salary_entry_method == "Percentage of CTC")
                 			{
                 				basicMonth = (ifnull(salary_rec.Monthly_Salary,0) * ifnull(structure.Basic_In_Percent_of_CTC,0)) / 100;
                 			}
                 		}
                 		pay.Fixed_Basic_Da_month=basicMonth;
                 		// ===== PER DAY BASIC =====
                 		if(basicMonth > 0 && pay.Effective_working_days > 0)
                 		{
                 			pay.Per_Day_basic_Da=basicMonth / pay.Effective_working_days;
                 		}
                 		else
                 		{
                 			pay.Per_Day_basic_Da=0;
                 		}
                 		// ===== EFFECTIVE BASIC =====
                 		pay.effective_Basic_DA=ifnull(pay.Per_Day_basic_Da,0) * ifnull(pay.Present,0);
                 		// ===== HRA (CALCULATED) =====
                 		hraCalc = 0;
                 		if(structure != null)
                 		{
                 			if(structure.Select_HRA_entry_method == "In Rupee")
                 			{
                 				hraCalc = ifnull(structure.HRA_In_Rupee,0);
                 			}
                 			else if(structure.Select_HRA_entry_method == "Percentage of fixed gross")
                 			{
                 				hraCalc = (ifnull(pay.Fixed_Salary,0) * ifnull(structure.HRA_In_Percent_of_fixed_gross,0)) / 100;
                 			}
                 		}
                 		// ===== BALANCE CONTROL =====
                 		remaining = ifnull(pay.Earned_Gross,0);
                 		// 1. BASIC
                 		if(pay.effective_Basic_DA <= remaining)
                 		{
                 			remaining = remaining - pay.effective_Basic_DA;
                 		}
                 		else
                 		{
                 			pay.effective_Basic_DA=remaining;
                 			remaining = 0;
                 		}
                 		// 2. HRA
                 		if(hraCalc <= remaining)
                 		{
                 			pay.HRA=hraCalc;
                 			remaining = remaining - hraCalc;
                 		}
                 		else
                 		{
                 			pay.HRA=remaining;
                 			remaining = 0;
                 		}
                 		// 3. SPECIAL ALLOWANCE
                 		if(remaining > 0)
                 		{
                 			pay.Special_allowance1=remaining;
                 		}
                 		else
                 		{
                 			pay.Special_allowance1=0;
                 		}
                 		// ===== GRAND / NET =====
                 		pay.Grand_Total1=pay.Earned_Gross + ifnull(pay.Total_Other_Earnings,0);
                 		pay.Net_Earning_Monthely=pay.Grand_Total1 - ifnull(pay.Total_Other_Deduction,0);
                 		pay.Net_Earning_Hourly=0;
                 		pay.Total_To_be_Paid=pay.Net_Earning_Monthely;
                 	}
                 	// ================= HR PAYOUT =================
                 	totalRequested = 0;
                 	totalPayoutCount = 0;
                 	paidPayoutCount = 0;
                 	for each  mp in Payout
                 	{
                 		if(mp.Source != "Hr")
                 		{
                 			continue;
                 		}
                 		for each  line in mp.Payout_Lines
                 		{
                 			if(line.Reference_ID == pay.ID.toString())
                 			{
                 				totalRequested = totalRequested + ifnull(line.Requested,0);
                 				totalPayoutCount = totalPayoutCount + 1;
                 				if(mp.Status == "Paid")
                 				{
                 					paidPayoutCount = paidPayoutCount + 1;
                 				}
                 			}
                 		}
                 	}
                 	pay.Payment_Requested=totalRequested;
                 	pay.Balanace_to_be_Requested=ifnull(pay.Total_To_be_Paid,0) - totalRequested;
                 	if(totalRequested <= 0)
                 	{
                 		pay.Request_Status="Not Requested";
                 	}
                 	else if(pay.Balanace_to_be_Requested > 0)
                 	{
                 		pay.Request_Status="Partially Requested";
                 	}
                 	else
                 	{
                 		pay.Request_Status="Fully Requested";
                 	}
                 	if(paidPayoutCount <= 0)
                 	{
                 		pay.Payment_Status1="Not Paid";
                 	}
                 	else if(paidPayoutCount < totalPayoutCount)
                 	{
                 		pay.Payment_Status1="Partially Paid";
                 	}
                 	else
                 	{
                 		pay.Payment_Status1="Fully Paid";
                 	}
                 }
				 void populateTodayOperationForOneBatchEfficiency(int p_BatchEfficiencyID)
                 {
                 	batchEff = Batch_Efficiency[ID == p_BatchEfficiencyID];
                 	if(batchEff.ID == null)
                 	{
                 		return;
                 	}
                 	if(batchEff.Date_field == null || batchEff.Batch == null)
                 	{
                 		return;
                 	}
                 	p_Date = batchEff.Date_field;
                 	p_Batch = batchEff.Batch;
                 	qtyMap = Map();
                 	orderMap = Map();
                 	processMap = Map();
                 	movementMap = Map();
                 	keyList = List();
                 	for each  grn in Process_Bundle_GRN[Date_field1 == p_Date && Batch == p_Batch]
                 	{
                 		if(grn.Create_Order != null && grn.To != null)
                 		{
                 			orderId = grn.Create_Order;
                 			processId = grn.To;
                 			movementId = grn.Bundle_Transfer_No;
                 			key = orderId.toString() + "_" + processId.toString();
                 			if(!keyList.contains(key))
                 			{
                 				keyList.add(key);
                 				qtyMap.put(key,0);
                 				orderMap.put(key,orderId);
                 				processMap.put(key,processId);
                 				movementMap.put(key,movementId);
                 			}
                 			qtyMap.put(key,ifnull(qtyMap.get(key),0) + ifnull(grn.Received_Qty,0));
                 		}
                 	}
                 	batchEff.Today_Operation.clear();
                 	headerCompletedQty = 0;
                 	headerTargetAuto = 0;
                 	for each  key in keyList
                 	{
                 		orderId = orderMap.get(key);
                 		processId = processMap.get(key);
                 		movementId = movementMap.get(key);
                 		totalQty = qtyMap.get(key);
                 		orderQty = 0;
                 		targetAuto = 0;
                 		orderRec = Create_Order[ID == orderId];
                 		if(orderRec.ID != null)
                 		{
                 			orderQty = ifnull(orderRec.Order_volume,0);
                 		}
                 		batchRec = Batch[ID == p_Batch];
                 		if(batchRec.ID != null && orderQty > 0)
                 		{
                 			for each  benchRow in batchRec.SubForm
                 			{
                 				if(benchRow.From_Qty <= orderQty && benchRow.To_Qty >= orderQty)
                 				{
                 					targetAuto = ifnull(benchRow.Target_Qty,0);
                 					break;
                 				}
                 			}
                 		}
                 		newRow = Batch_Efficiency.Today_Operation();
                 		newRow.Date_fieldDate_field=p_Date;
                 		newRow.Order_No=orderId;
                 		newRow.Style_Wise=orderId;
                 		newRow.Order_volume=orderId;
                 		newRow.Complexity=orderId;
                 		newRow.Process_Bundle_Movement=movementId;
                 		newRow.Batch=p_Batch;
                 		newRow.Process_Master=processId;
                 		newRow.Wo_Qty=orderQty;
                 		newRow.Target_Auto=targetAuto;
                 		newRow.Completed_Qty=totalQty;
                 		batchEff.Today_Operation.insert(newRow);
                 		headerCompletedQty = headerCompletedQty + ifnull(totalQty,0);
                 		headerTargetAuto = headerTargetAuto + ifnull(targetAuto,0);
                 	}
                 	batchEff.Completed_Qty=headerCompletedQty;
                 	batchEff.Target_Auto=headerTargetAuto;
                 }
