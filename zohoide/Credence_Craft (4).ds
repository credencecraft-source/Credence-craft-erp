			Purchase_Bill_C_validatio as "Purchase Bill (C)-validation"
			{
				type =  form
				form = Purchase_Bill

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ============================
										// PREVENT DUPLICATE GATE ENTRY
										// ============================
										for each  each_grn in input.Gate_Entry
										{
											existing_bill = Purchase_Bill[Gate_Entry.contains(each_grn.ID) && ID != input.ID];
											if(existing_bill.ID != null)
											{
												alert "Gate Entry (" + each_grn.GRN_No + ") already used in Purchase Bill: " + existing_bill.Bill_No;
												cancel submit;
											}
										}
						)
					}
				}

			}
			Purchase_Bill_Deleted_Val as "Purchase Bill (Deleted)-Validation"
			{
				type =  form
				form = Purchase_Bill

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											delete from Bill_Subform[Purchase_Bill_No == input.ID];
										delete from Bill_Subform[Purchase_Bill_No == null];
										get_purchase_bill = Purchase_Bill[ID == input.ID];
										if(get_purchase_bill.ID != null)
										{
											get_purchase_bill.Delete_Falg=true;
											for each  each_grn in input.Gate_Entry
											{
												thisapp.bill_controllar.purchase_bill_status_update(each_grn.ID);
											}
										}
						)
					}
				}

			}
			Gate_Entry_edit_Validatio as "Gate Entry (edit)-Validation"
			{
				type =  form
				form = Gate_Entry

				record event = on edit

