			GRN_Verification_Subform_1 as "GRN Verification Subform (C/E)-Field Rules"
			{
				type =  form
				form = GRN_Yet_to_Allocate

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Balance_to_Allocate1,GRN_Verification_ID,Grouping_No,Total_Grouped_Qty,Verification_Allocated;
