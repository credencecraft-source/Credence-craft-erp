			Other_Charger_in_Per_Item as "Other Charger in Per Item"
			{
				type =  form
				form = Grouping_Purchase_Request

				record event = on add or edit

				on user input of Other_Charges_Per_item
				{
					actions 
					{
						custom deluge script
						(
											if(input.Other_Charges_Per_item < 0)
										{
											alert "Please enter the valid Other Charges (per item)..!";
											input.Other_Charges_Per_item = null;
										}
										if(input.Convert_Value > 0)
										{
											input.Other_charges_per_order_per_pcs_stock_uom = ifnull(input.Other_Charges_Per_item,0) / input.Convert_Value;
										}
										else
										{
											input.Other_charges_per_order_per_pcs_stock_uom = 0;
										}
										input.Vender_Price_Other_Charges = ifnull(input.Vender_Price_per_order_per_pcs_stock_uom,0) + ifnull(input.Other_charges_per_order_per_pcs_stock_uom,0);
										//input.Grand_Total_no_need = ifnull(input.Total_With_Gst,0) + ifnull(input.Other_Charges_Per_item,0);
						)
					}
				}

			}
