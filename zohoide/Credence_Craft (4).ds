			Size_wise as "Size wise"
			{
				type =  form
				form = Process_Bundle_Movement

				record event = on add or edit

				on user input of Size_wise
				{
					actions 
					{
						custom deluge script
						(
											if(input.Size_wise == "Yes" && input.Size_Group != null)
										{
											show SubForm;
											clear SubForm;
											get_sizes = Size_Group_Subform[Size_Group_ID == input.Size_Group] sort by Sort_No asc;
											for each  each_size in get_sizes
											{
												newrow = Process_Bundle_Movement.SubForm();
												newrow.Size=each_size.Size_No;
												input.SubForm.insert(newrow);
											}
										}
										else
										{
											hide SubForm;
										}
						)
					}
				}

			}
			pk_grn as "pk grn"
