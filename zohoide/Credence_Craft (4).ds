			on_delete4 as "on delete"
			{
				type =  form
				form = Payout

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYOUT – ON DELETE (FINAL)
										// =====================================
										// -------------------------------
										// HR / PAYROLL REFRESH
										// -------------------------------
										if(input.Source == "Hr")
										{
											processedPayroll = List();
											for each  line in input.Payout_Lines
											{
												if(line.Reference_ID != null && line.Reference_ID != "")
												{
													if(!processedPayroll.contains(line.Reference_ID))
													{
														processedPayroll.add(line.Reference_ID);
														thisapp.Payrollrefresh(line.Reference_ID.toLong());
													}
												}
											}
										}
										// -------------------------------
										// PURCHASE BILL REFRESH
										// -------------------------------
										else if(input.Source == "Purchase bill")
										{
											processedBills = List();
											for each  line in input.Payout_Lines
											{
												if(line.Reference_ID != null && line.Reference_ID != "")
												{
													if(!processedBills.contains(line.Reference_ID))
													{
														processedBills.add(line.Reference_ID);
														thisapp.PurchaseBillRefresh(line.Reference_ID.toLong());
													}
												}
											}
										}
						)
					}
				}

			}
			after_submit as "after submit"
			{
				type =  form
				form = Payout

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYOUT – AFTER SUBMIT (FINAL)
										// =====================================
										// -------------------------------
										// HR / PAYROLL REFRESH
										// -------------------------------
										if(input.Source == "Hr")
										{
											processedPayroll = List();
											for each  line in input.Payout_Lines
											{
												if(line.Reference_ID != null && line.Reference_ID != "")
												{
													if(!processedPayroll.contains(line.Reference_ID))
													{
														processedPayroll.add(line.Reference_ID);
														thisapp.Payrollrefresh(line.Reference_ID.toLong());
													}
												}
											}
											// Redirect to Payroll report
											openUrl("#Report:Payroll1","parent window");
										}
										// -------------------------------
										// PURCHASE BILL REFRESH
										// -------------------------------
										else if(input.Source == "Purchase bill")
										{
											processedBills = List();
											for each  line in input.Payout_Lines
											{
												if(line.Reference_ID != null && line.Reference_ID != "")
												{
													if(!processedBills.contains(line.Reference_ID))
													{
														processedBills.add(line.Reference_ID);
														thisapp.PurchaseBillRefresh(line.Reference_ID.toLong());
													}
												}
											}
											// Redirect to Purchase Bill report
											openUrl("#Report:Purchase_Bill_Report","parent window");
										}
						)
					}
				}

			}
