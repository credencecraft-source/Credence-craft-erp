			EXCHANGE_PRICE1 as "EXCHANGE PRICE"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Exchange_Price
				{
					actions 
					{
						custom deluge script
						(
											if(row.Buyer_Po_Price != null && row.Exchange_Price != null)
										{
											row.Price_In_INR=row.Buyer_Po_Price * row.Exchange_Price;
										}
						)
					}
				}

			}
			Buyer_Po_price as "Buyer Po price"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Buyer_Po_Price
				{
					actions 
					{
						custom deluge script
						(
											// --- Calculate current row Price In INR ---
										if(row.Buyer_Po_Price != null && row.Exchange_Price != null)
										{
											row.Price_In_INR=row.Buyer_Po_Price * row.Exchange_Price;
										}
										else
										{
											row.Price_In_INR=0;
										}
										// --- Copy price to empty rows ---
										for each  r in input.Finished_Goods_Size_wise
										{
											if(r.Buyer_Po_Price == null)
											{
												r.Buyer_Po_Price=row.Buyer_Po_Price;
												r.Exchange_Price=row.Exchange_Price;
												r.Price_In_INR=row.Price_In_INR;
											}
										}
										// --- Recalculate header totals ---
										sum_order_qty = 0;
										sum_order_value = 0;
										for each  each_row in input.Finished_Goods_Size_wise
										{
											sum_order_qty = sum_order_qty + ifnull(each_row.Total_Qty,0);
											row_value = ifnull(each_row.Price_In_INR,0) * ifnull(each_row.Total_Qty,0);
											sum_order_value = sum_order_value + row_value;
										}
										input.Order_Qty = sum_order_qty;
										input.Order_Value = sum_order_value;
										// --- Recalculate FOB ---
										if(input.Order_Qty != null && input.Order_Qty != 0)
										{
											input.Fob = input.Order_Value / input.Order_Qty;
										}
										else
										{
											input.Fob = 0;
										}
						)
					}
				}

			}
			Excess as "Excess"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Exces
				{
					actions 
					{
						custom deluge script
						(
											brand_rec = Brand1[ID == input.Brand];
										if(brand_rec != null)
										{
											max_excess = ifnull(brand_rec.Maximum_Allowed_Excess1,0);
											if(input.Exces < 0 || input.Exces > max_excess)
											{
												alert "Maximum allowed excess for this Brand is " + max_excess + "%";
												input.Exces = null;
												return;
											}
										}
										sum_order_qty = 0;
										for each  rec in input.Finished_Goods_Size_wise
										{
											rec.Excess=input.Exces;
											rec.Excess_Qty=(ifnull(rec.Before_Excess_Qty,0) * ifnull(input.Exces,0)) / 100;
											rec.Total_Qty=ifnull(rec.Before_Excess_Qty,0) + ifnull(rec.Excess_Qty,0);
											sum_order_qty = sum_order_qty + ifnull(rec.Total_Qty,0);
										}
										input.Order_Qty = sum_order_qty;
										input.Order_Value = ifnull(input.Fob,0) * ifnull(input.Order_Qty,0);
						)
					}
				}

			}
