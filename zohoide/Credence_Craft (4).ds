			Send_Email as "Send Email"
			{
				type =  functions
				form = Quotation1
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						emailMessage = "<div style='font-family:Arial;'>" + "<div style='font-size:18px;font-weight:bold;'>Dear " + input.Customer_Name.Vendor_Name + ",</div><br>" + "<div style='font-size:14px;'>Greetings from <b>Credence Craft</b>.</div><br>" + "<div style='font-size:14px;'>" + "<b>Quotation No:</b> " + input.QuotationNo + "<br>" + "<b>Date:</b> " + input.Date_field + "<br>" + "<b>Total Qty:</b> " + input.Total_Qty + "<br>" + "<b>Grand Total:</b> <span style='color:green;font-weight:bold;'>" + input.Total + "</span>" + "</div><br>" + "<table style='border-collapse:collapse;width:100%;font-size:12px;' border='1'>" + "<tr style='background:#f2f2f2;font-weight:bold;'>" + "<th>Order No</th>" + "<th>Style</th>" + "<th>Colour</th>" + "<th>Qty</th>" + "<th>Price</th>" + "<th>Total</th>" + "</tr>";
										// loop
										for each  row in input.SubForm
										{
											emailMessage = emailMessage + "<tr>" + "<td>" + row.Order_No1.Order_No + "</td>" + "<td>" + row.Style_No.Style_Name + "</td>" + "<td>" + row.Colors.Colors + "</td>" + "<td>" + row.Qty + "</td>" + "<td>" + row.Price + "</td>" + "<td>" + row.Total + "</td>" + "</tr>";
										}
										emailMessage = emailMessage + "</table><br>" + "<div style='font-size:14px;'>.</div><br>" + "<div style='font-size:14px;'><b>Regards,</b><br>Credence Craft</div>" + "</div>";
										sendmail
										[
											from :zoho.adminuserid
											to :input.Email
											subject :"Quotation - " + input.QuotationNo
											message :emailMessage
										]
					)
					}
				}
			}
			Create_Po as "Create Po"
			{
				type =  functions
				form = Bananaclub_Rm_Po
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						bcRec = Bananaclub_Rm_Po[ID == input.ID];
										checkName = bcRec.Item_Description.trim();
										// --- FETCH REQUIRED LOOKUPS ---
										catRec = Category1[Category_Name == "Fabric And Interlining"];
										subcatRec = Subcategory1[Subcategory_Name == "Main Label"];
										uomRec = Stock_Uom[Stock_Uom == "Mtr"];
										catTypeRec = Category_Type1[Category_Type_Name == "Item"];
										// --- CHECK EXIST ---
										rmRec = Raw_Material1[Raw_Material_Name == checkName];
										// --- CREATE IF NOT FOUND ---
										if(rmRec.ID == null)
										{
											rmRec = insert into Raw_Material1
											[
												Raw_Material_Name=checkName
												Category=catRec.ID
												Subcategory=subcatRec.ID
												Stock_Uom1=uomRec.ID
												Category_Type=catTypeRec.ID
												Status="Draft"
												Added_User=zoho.loginuser
											];
											info "Created RM : " + rmRec.ID;
										}
										else
										{
											info "RM Exists : " + rmRec.ID;
										}
					)
					}
				}
			}
			Create_Request as "Create Request"
			{
				type =  functions
				form = Bananaclub_Rm_Po
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						bcRec = Bananaclub_Rm_Po[ID == input.ID];
										checkName = bcRec.Item_Description.trim();
										// --- FETCH RM ---
										rmRec = Raw_Material1[Raw_Material_Name == checkName];
										// --- FETCH REQUIRED LOOKUPS ---
										catRec = Category1[Category_Name == "Fabric And Interlining"];
										subcatRec = Subcategory1[Subcategory_Name == "Main Label"];
										uomRec = Stock_Uom[Stock_Uom == "Mtr"];
										// --- INSERT PR ---
										insert into Purchase_Request
										[
											Raw_Material1=rmRec.ID
											Uom=uomRec.ID
											Category1=catRec.ID
											Subcategory1=subcatRec.ID
											Qty=bcRec.Order_Qty
											Price=bcRec.Item_Rate
											Remarks=bcRec.Narration
											PO_Created=false
											Added_User=zoho.loginuser
										]
					)
					}
				}
			}
