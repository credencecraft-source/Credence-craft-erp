			GRN_Verification_C_Onload as "GRN Verification (C)-Onload"
			{
				type =  form
				form = GRN_Verification

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Grn_No = input.Rm_Unique_Id.Gate_Entry_No1;
										input.Master_Group1 = input.Rm_Unique_Id.Master_Group;
										input.Raw_Material1 = input.Rm_Unique_Id.Raw_Material1;
										input.Master_Group_Req_Qty_With_Round_of = ifnull(input.Master_Group1.Grouped_Qty,0);
										input.Warehouse = input.Grn_No.Delivery_Address;
										get_master_group = Master_Group_Subform[Master_Group_ID == input.Master_Group1];
										sum_of_grn_groupped_qty = 0;
										if(get_master_group.ID != null)
										{
											for each  each_master_group in get_master_group
											{
												sum_of_aleady_vertify_qty = GRN_Yet_to_Allocate[Grouping_No == each_master_group.Grouping_Purchase_Request && GRN_Verification_ID != null].sum(Verification_Allocated);
												row1 = GRN_Verification.Verification();
												row1.Grouping_No=each_master_group.Grouping_Purchase_Request;
												row1.Total_Grouped_Qty=ifnull(each_master_group.Grouped_Qty,0) - sum_of_aleady_vertify_qty;
												row1.Balance_to_Allocate1=ifnull(each_master_group.Grouped_Qty,0) - sum_of_aleady_vertify_qty;
												sum_of_grn_groupped_qty = sum_of_grn_groupped_qty + ifnull(row1.Total_Grouped_Qty,0);
												rows = Collection();
												rows.insert(row1);
												input.Verification.insert(rows);
											}
										}
										input.Grouped_Qty_GRN = sum_of_grn_groupped_qty;
										hide Verification;
						)
					}
				}

			}
			GRN_Verification_C_E_Fiel as "GRN Verification (C/E)-Field Rules"
			{
				type =  form
				form = GRN_Verification

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Master_Group1,Grn_No,Purchase_Order,Raw_Material1,Rm_Unique_Id,Master_Group_Req_Qty_With_Round_of,Rejected_Qty,Total_Excess,Available_To_Allocate,Grouped_Allocated,Grouped_Balance_to_allocate,Grouped_Qty_GRN,Warehouse,Fresh_Excess;
					}
					actions 
					{
					hide add row of Verification;
					}
					actions 
					{
					hide delete row of Verification;
					}
				}

			}
			Verified_Qty_in_GRN_Verif as "Verified Qty in GRN Verification"
			{
				type =  form
				form = GRN_Verification

				record event = on add

				on user input of Verified_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(input.Verified_Qty < 0)
										{
											alert "Please enter the valid verified qty.";
											input.Verified_Qty = null;
										}
										input.Rejected_Qty = ifnull(input.Verified_Qty,0) - ifnull(input.Approved_Qty,0);
										if(input.Verified_Qty > input.Grouped_Qty_GRN)
										{
											Excess = ifnull(input.Verified_Qty,0) - ifnull(input.Grouped_Qty_GRN,0);
										}
										else
										{
											Excess = 0;
										}
										input.Available_To_Allocate = ifnull(input.Verified_Qty,0) - ifnull(Excess,0);
						)
					}
				}

			}
			Approved_Qty_in_GRN_Verif as "Approved Qty in GRN Verification"
			{
				type =  form
				form = GRN_Verification

				record event = on add

				on user input of Approved_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(input.Approved_Qty < 0)
										{
											alert "Please enter the valid approved qty.";
											input.Approved_Qty = null;
										}
										else if(input.Verified_Qty < input.Approved_Qty)
										{
											alert "Approved qty should less the verified qty.!";
											input.Approved_Qty = null;
										}
										input.Rejected_Qty = ifnull(input.Verified_Qty,0) - ifnull(input.Approved_Qty,0);
										input.Fresh_Excess = max(ifnull(input.Approved_Qty,0) - ifnull(input.Grouped_Qty_GRN,0),0);
										input.Total_Excess = ifnull(input.Fresh_Excess,0) + ifnull(input.Rejected_Qty,0);
										input.Available_To_Allocate = ifnull(input.Verified_Qty,0) - ifnull(input.Total_Excess,0);
						)
					}
				}

			}
			Purchase_Order_Edit_Onloa as "Purchase Order (Edit)-Onload"
			{
				type =  form
				form = Purchase_Order

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Po_Type = input.Po_Type;
										get_grn = Gate_Entry[Po_Number == input.ID];
										if(get_grn.ID != null)
										{
											disable Payment_Terms;
											disable Entity_Delivery_Address;
											disable Vendor_Name;
											disable Delivery_Date;
										}
						)
					}
				}

			}
			Grn_Verification_C_Succes as "Grn Verification (C)-Success"
			{
				type =  form
				form = GRN_Verification

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// FINAL SAFETY RECALC (AUTO-POPULATION SAFE)
										// ======================================================
										final_grouped_total = 0;
										for each  row in input.Verification
										{
											final_grouped_total = final_grouped_total + ifnull(row.Verification_Allocated,0);
										}
										input.Grouped_Allocated = final_grouped_total;
										input.Available_To_Allocate = final_grouped_total;
										get_veriifocation = Gate_Entry_Subform[ID == input.Rm_Unique_Id];
										if(get_veriifocation.ID != null)
										{
											sum_of_allocated_qty_veridy = GRN_Yet_to_Allocate[GRN_Verification_ID == input.ID].sum(Verification_Allocated);
											get_veriifocation.Verified_Qty=input.Verified_Qty;
											get_veriifocation.Approved_Qty=input.Approved_Qty;
											get_veriifocation.Rejected_Qty=input.Rejected_Qty;
											get_veriifocation.Fresh_Excess=input.Fresh_Excess;
											get_veriifocation.Verified_User_Id=zoho.loginuserid;
											get_veriifocation.Allocated=input.Grouped_Allocated;
											get_veriifocation.Excess_General=input.Total_Excess;
											get_veriifocation.Verification_Status="Verified";
											get_veriifocation.Stock_Available_in_Allocated=input.Grouped_Allocated;
											get_veriifocation.Stock_Available_in_Excess_General=input.Total_Excess;
											get_veriifocation.Stock_Available_in_Rejected_qty=input.Rejected_Qty;
											get_veriifocation.Total_Stock=ifnull(get_veriifocation.Stock_Available_in_Allocated,0) + ifnull(get_veriifocation.Stock_Available_in_Excess_General,0);
											get_veriifocation.Stock_Value_Excess_General=ifnull(get_veriifocation.Stock_Available_in_Excess_General,0) * ifnull(get_veriifocation.Po_Price,0);
											get_veriifocation.Stock_Value_Allocated=ifnull(get_veriifocation.Stock_Available_in_Allocated,0) * ifnull(get_veriifocation.Po_Price,0);
											get_veriifocation.Rejected_Stock_Value=ifnull(get_veriifocation.Stock_Available_in_Rejected_qty,0) * ifnull(get_veriifocation.Po_Price,0);
											get_veriifocation.Stock_Value_Total=ifnull(get_veriifocation.Stock_Value_Excess_General,0) + ifnull(get_veriifocation.Stock_Value_Allocated,0);
											get_veriifocation.Warehouse=input.Warehouse;
											get_veriifocation.Sub_Location=input.Sub_Location;
											get_veriifocation.Rack=input.Rack;
											get_veriifocation.Rack_Bin=input.Rack_Bin;
											thisapp.grn_controllar.update_po_qty_in_verification(get_veriifocation.Grn_Status_Item_Wise);
											if(input.Total_Excess > 0)
											{
												thisapp.excess_invenory_controllar.create_excess_from_verification(get_veriifocation.ID);
												get_purchase_request_raw_material = Po_Subform[ID == input.Rm_Unique_Id.Grn_Status_Item_Wise];
												if(get_purchase_request_raw_material.ID != null)
												{
													for each  each_order_raw_material_id in get_purchase_request_raw_material.Order_Raw_Material_ID
													{
														thisapp.order_controllar.excess_status_update(each_order_raw_material_id.ID);
													}
												}
											}
											thisapp.debit_note_controllar.create_debite_notes(input.Rm_Unique_Id);
										}
										delete from GRN_Yet_to_Allocate[GRN_Verification_ID == null];
										openUrl("#Script:page.parent.refresh ","same window");
						)
					}
				}

			}
			GRN_Verification_C_E_Onlo as "GRN Verification (C/E)-Onload"
			{
				type =  form
				form = GRN_Verification

				record event = on add or edit

				on load
				{
