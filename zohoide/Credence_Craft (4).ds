		form Gate_Entry
		{
			displayname = "Gate Entry"
			success message = "Gate Entry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Po_Number
			(
				type = picklist	
				displayname = "Po Number"
				values  = Purchase_Order[Po_Status == "Approved" || Po_Status == "Issued" && GRN_Status != "Received"].ID
    			displayformat = [PO_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			PO_Type
			(
				type = picklist
				displayname = "PO Type"
				maxchar = 100
				values = {"Against Order","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Driver_Contact
			(
    			type = phonenumber
				displayname = "Driver Contact"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
