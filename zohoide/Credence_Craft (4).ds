				 void import_attendance_from_machine()
                 {
                 	machineList = List();
                 	for each  t in Biometric_Machine_Template[ID != 0]
                 	{
                 		for each  m in t.Biometric_Machine
                 		{
                 			machineList.add(m.Biometric_Machine);
                 		}
                 	}
                 	if(machineList.isEmpty())
                 	{
                 		info "No Template Configured. Please setup Biometric Serial Number in Master";
                 		return;
                 	}
                 	url = "https://attendance.echovaclinic.com/attendance-api.php";
                 	response = invokeurl
                 	[
                 		url :url
                 		type :GET
                 	];
                 	records = response.get("attendance");
                 	count = 0;
                 	for each  rec in records
                 	{
                 		if(count >= 5)
                 		{
                 			break;
                 		}
                 		if(rec.get("user_id") != "0" && rec.get("date") != "-0001-11-30")
                 		{
                 			sn_val = rec.get("sn");
                 			machineRec = Biometric_Machine[Biometric_Machine == sn_val];
                 			if(machineRec != null && machineList.contains(sn_val))
                 			{
                 				dateVal = rec.get("date").toDate();
                 				timeText = rec.get("time");
                 				timeConverted = (dateVal.toString("yyyy-MM-dd") + " " + timeText).toTime();
                 				insert into Attedence_Machine_Logs
                 				[
                 					sn=sn_val
                 					user_id=rec.get("user_id")
                 					date_field1=dateVal
                 					time=timeConverted
                 					Biometric_Machine=machineRec.ID
                 					Added_User=zoho.loginuser
                 				]
                 				count = count + 1;
                 			}
                 		}
                 	}
                 	info count + " Attendance Imported";
                 }
				 void insertMonthlyAttendanceMasterBasic(int attendanceLogId)
                 {
                 	// ================= FETCH LOG =================
                 	log = Attendance_Logs[ID == attendanceLogId];
                 	if(log == null)
                 	{
                 		return;
                 	}
                 	// ================= VALIDATION =================
                 	if(log.Employee_Id == null || log.Month_No == null || log.Year_Master == null)
                 	{
                 		return;
                 	}
                 	// ================= RESOLVE EMPLOYEE USING NUMBER =================
                 	empRec = Employee_Name[Employee_No == log.Employee_Id];
                 	if(empRec == null)
                 	{
                 		return;
                 	}
                 	// ================= DUPLICATE CHECK =================
                 	exists = Attendance_Master[Employee_No1 == empRec.ID && Month_Master == log.Month_No && Yearmasterlookup == log.Year_Master].count();
                 	if(exists > 0)
                 	{
                 		return;
                 	}
                 	// ================= INSERT MASTER =================
                 	attId = insert into Attendance_Master
                 	[
                 		Added_User=zoho.loginuser
                 		Employee_No1=empRec.ID
                 		Employee_ID1=empRec.ID
                 		Employee_Name1=empRec.ID
                 		Month_Master=log.Month_No
                 		Yearmasterlookup=log.Year_Master
                 	];
                 	//================= AUTO CREATE PAYROLL =================
                 	//if(attId != null)
                 	//{
                 	//	thisapp.createPayrollFromAttendance(attId);
                 	//}
                 }
				 bool isUnlimitedUser()
                 {
                 	curr_month = month(zoho.currentdate);
                 	curr_year = year(zoho.currentdate);
                 	rec = Pricing[Month_field == curr_month && Year_field == curr_year];
                 	if(rec.count() > 0)
                 	{
                 		for each  r in rec
                 		{
                 			if(r.Transaction_Plan == "UNLIMITED" || r.Maximum >= 99999999)
                 			{
                 				return true;
                 			}
                 		}
                 	}
                 	return false;
                 }
