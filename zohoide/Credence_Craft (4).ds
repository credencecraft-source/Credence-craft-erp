			Add_Vehicle as "Add Vehicle"
			{
				type =  functions
				form = Invoice
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Generate_ewaybill?Invoice_ID=" + input.ID,"popup window");
					)
					}
				}
			}
			Generate_Ewaybill as "Generate Ewaybill"
			{
				type =  functions
				form = Invoice
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						ewayRec = Generate_ewaybill[Invoice_ID == input.ID];
										if(ewayRec == null)
										{
											info "Generate Eway Bill record not found";
											return;
										}
										if(input.Eway_Bill_Number != null && input.Eway_Bill_Number != "")
										{
											info "E-Way Bill already generated. EWB No : " + input.Eway_Bill_Number;
											return;
										}
										result = thisapp.books.generateEwayBill(ewayRec.ID);
										if(result == true)
										{
											info "E-Way Bill Generated Successfully";
										}
										else
										{
											info "E-Way Bill Generation Failed";
										}
					)
					}
				}
			}
