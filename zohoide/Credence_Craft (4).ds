					{
						custom deluge script
						(
											exchange_val = ifnull(input.Exchange_Price,1);
										other_val = ifnull(input.Other_Charges_INR,0);
										if(input.Import_From_Other_Country == true)
										{
											input.Vendor_Price_INR = ifnull(input.Vendor_Price,0) * exchange_val + other_val;
										}
										else
										{
											input.Vendor_Price_INR = ifnull(input.Vendor_Price,0) + other_val;
										}
						)
					}
				}

			}
