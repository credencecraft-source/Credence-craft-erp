lor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Yet To Pick'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Rm_Pick_Box'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Yet To Create DC'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Rm_Pick_Box'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Delivery Challan'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet91' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet91()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{margin:0;padding:0;box-sizing:border-box;}\n.form-action-container{display:none;}\n\n.tabs{\n    height:100vh;\n    font-family:Arial, sans-serif;\n}\n\n.tabs .tab{\n    float:left;\n}\n\n.tabs input[type=&quot;radio&quot;]{\n    display:none;\n}\n\n/* BIGGER TABS */\n.tabs label{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 28px;          /* BIGGER */\n    font-size:16px;             /* BIGGER */\n    cursor:pointer;\n    font-weight:bold;\n    color:#333;\n    border-bottom:4px solid transparent;\n    transition:0.3s;\n}\n\n.tabs label i{\n    font-size:18px;             /* BIGGER ICON */\n}\n\n.tabs label:hover{\n    background:#f2f2f2;\n}\n\n.tabs input:checked + label{\n    color:#0a7a35;\n    border-bottom:4px solid #0a7a35;\n    background:#eef8f1;\n}\n\n.tabs .content{\n    position:absolute;\n    top:50px;   /* match bigger tab height */\n    left:0;\n    width:100%;\n    height:calc(100vh - 50px);\n    opacity:0;\n    z-index:0;\n}\n\n.tabs input:checked ~ .content{\n    opacity:1;\n    z-index:1;\n}\n\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n&lt;!-- REQUEST --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; checked id=&quot;rm_tab1&quot;&gt;\n&lt;label for=&quot;rm_tab1&quot;&gt;\n&lt;i class=&quot;fa-solid fa-file-circle-check&quot;&gt;&lt;/i&gt; Request\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Plan_Rm?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- PICK --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; id=&quot;rm_tab2&quot;&gt;\n&lt;label for=&quot;