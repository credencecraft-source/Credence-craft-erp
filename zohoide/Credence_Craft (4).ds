			Vendor_Deleted_Validation as "Vendor (Deleted)-Validation"
			{
				type =  form
				form = Vendor1

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// 1️⃣ BLOCK IF ORDER RAW MATERIAL EXISTS
										// =====================================
										get_order_raw_material = Order_Raw_material[Vendor_Master == input.ID];
										if(get_order_raw_material.ID != null)
										{
											alert "Found an Order Raw Material associated with this Vendor.\nPlease delete the Order Raw Material first.";
											cancel delete;
										}
										// =====================================
										// 2️⃣ BLOCK IF VENDOR PRICE LIST EXISTS
										// =====================================
										get_vendor_price_list = Vendor_Wise_Price_List[Vendor_Master == input.ID];
										if(get_vendor_price_list.ID != null)
										{
											alert "Found a Vendor Price List associated with this Vendor.\nPlease delete the Vendor Price List first.";
											cancel delete;
										}
										// =====================================
										// 3️⃣ BLOCK IF UNPAID PAYOUT EXISTS
										// =====================================
										refList = List();
										for each  p in Payout
										{
											// Only Purchase Bill payouts not yet Paid
											if(p.Source != "Purchase bill" || p.Status == "Paid")
											{
												continue;
											}
											for each  line in p.Payout_Lines
											{
												if(line.Reference_ID != null)
												{
													pb = Purchase_Bill[ID == line.Reference_ID.toLong()];
													if(pb.ID != null && pb.Vendor1 == input.ID)
													{
														refList.add("Payout ID : " + p.ID);
														break;
													}
												}
											}
										}
										if(refList.size() > 0)
										{
											msg = "Cannot delete Vendor.\nPending payout requests exist:\n";
											for each  r in refList.distinct()
											{
												msg = msg + r + "\n";
											}
											alert msg;
											cancel delete;
										}
						)
					}
				}

			}
			Raw_Material_C_E_Success as "Raw Material (C/E)-Success"
			{
				type =  form
				form = Raw_Material1

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											// ==============================
											// BRAND LINKING LOGIC
											// ==============================
											if(input.Is_this_Specific_for_a_Brand == true)
											{
												// keep selected brands (do nothing)
											}
											else
											{
												allBrands = Brand1[ID != null].ID.getAll();
												update Raw_Material1[ID == input.ID]
												[
													Brand1=allBrands
												];
											}
											// ==============================
											// AUTO CREATE SIZE ITEMS
											// ==============================
											if(input.Is_This_Size_wise != null)
											{
												get_sizes = Size[Size_Group_ID == input.Is_This_Size_wise];
												for each  size_rec in get_sizes
												{
													check_exist = Raw_Material1[Raw_Material_Name == input.Raw_Material_Name + "-" + size_rec.Size];
													if(check_exist.count() == 0)
													{
														insert into Raw_Material1
														[
															Raw_Material_Name=input.Raw_Material_Name + "-" + size_rec.Size
															Is_This_Size_wise=input.Is_This_Size_wise
															Stock_Uom1=input.Stock_Uom1
															Category=input.Category
															Subcategory=input.Subcategory
															Category_Type=input.Category_Type
															Item_Code=input.Item_Code + "-" + size_rec.Size
															Status="Draft"
															Added_User=zoho.loginuser
														]
													}
												}
											}
										}catch (e)
										{
											info e.toString();
										}
						)
					}
				}

			}
			Raw_Material_C_E_Field_Ru as "Raw Material (C/E)-Field Rules"
			{
				type =  form
				form = Raw_Material1

