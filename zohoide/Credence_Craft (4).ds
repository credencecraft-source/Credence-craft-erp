			Add_Quick_RawMaterial_C_S as "Add Quick RawMaterial (C)-Success"
			{
				type =  form
				form = Add_Quick_RawMaterial

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// CALCULATE SIZE WISE CONSUMPTION ORDER WISE BEFORE INSERT
										for each  each_row in input.Raw_Material_List
										{
											if(each_row.Size_Wise_Consemption_Master != null)
											{
												total_required_consumption = 0.0;
												total_order_qty = 0.0;
												for each  each_order in input.Order_No
												{
													order_avg_consumption = thisapp.order_controllar.calculate_size_wise_consumption(each_order.ID,each_row.Size_Wise_Consemption_Master.ID);
													order_qty = 0.0;
													get_order_sizes = Finished_Goods_Size_wise[Order_No == each_order.ID];
													for each  each_size in get_order_sizes
													{
														order_qty = order_qty + ifnull(each_size.Total_Qty,0);
													}
													total_required_consumption = total_required_consumption + order_qty * order_avg_consumption;
													total_order_qty = total_order_qty + order_qty;
												}
												if(total_order_qty > 0)
												{
													each_row.Consumption=total_required_consumption / total_order_qty;
												}
											}
										}
										// YOUR ORIGINAL CODE
										thisapp.order_controllar.insert_raw_material_from_quick_raw_materil(input.ID);
										delete from Add_Quick_Raw_Material_Subform[ID != 0];
										delete from Add_Quick_RawMaterial[ID != 0];
										openUrl("#Script:page.parent.refresh","same window");
						)
					}
				}

			}
			Create_Order_C_E_Field_Ru as "Create Order (C/E)-Field Rules"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Backend_Data;
					}
					actions  (Type_field == "Direct")
					{
						hide Eo_No_and_Name;
					}
				}

			}
			Size_Group_in_Create_Orde as "Size Group in Create Order"
			{
				type =  form
				form = Create_Order

				record event = on add

				on user input of Size_Group
				{
					actions 
					{
						custom deluge script
						(
											// Only proceed if Type_field is Direct or Bulk
										if(input.Type_field == "Direct" || input.Type_field == "Bulk")
										{
											if(input.Size_Group != null)
											{
												show Finished_Goods_Size_wise;
												clear Finished_Goods_Size_wise;
												currency_value = null;
												exchange_value = null;
												if(input.Buyer1 != null)
												{
													buyer_rec = Buyer1[ID == input.Buyer1];
													if(buyer_rec.Currency_Type != null)
													{
														currency_value = buyer_rec.Currency_Type;
														currency_rec = Currency_Type[ID == buyer_rec.Currency_Type];
														exchange_value = currency_rec.Exchange_Price;
													}
												}
												if(input.Import != null)
												{
													source_order = Create_Order[ID == input.Import.ID];
												}
												get_size_all = Size_Group_Subform[Size_Group_ID == input.Size_Group] sort by Sort_No asc;
												for each  each_size in get_size_all
												{
													newrow = Create_Order.Finished_Goods_Size_wise();
													newrow.Size=each_size.Size_No;
													newrow.Buyer_Size=each_size.Size_No;
													newrow.Brand1=input.Brand;
													newrow.Buyer1=input.Buyer1;
													newrow.Season=input.Season;
													newrow.Gold_Seal=input.Article;
													newrow.Colors=input.Colors;
													newrow.Currency_Type=currency_value;
													newrow.Exchange_Price=exchange_value;
													newrow.Price_In_INR=input.Fob;
													newrow.Bulk_Order=input.Eo_No_and_Name;
													newrow.Excess=input.Exces;
													before_qty = 0;
													buyer_price = null;
													if(input.Import != null)
													{
														for each  ref_row in source_order.Finished_Goods_Size_wise
														{
															if(ref_row.Size == each_size.Size_No)
															{
																before_qty = ref_row.Before_Excess_Qty;
																buyer_price = ref_row.Buyer_Po_Price;
																break;
															}
														}
													}
													newrow.Before_Excess_Qty=before_qty;
													newrow.Buyer_Po_Price=buyer_price;
													total_qty = ifnull(before_qty,0);
													excess_qty = 0;
													if(input.Exces != null)
													{
														excess_qty = (total_qty * input.Exces) / 100;
														total_qty = total_qty + excess_qty;
													}
													newrow.Excess_Qty=excess_qty;
													newrow.Total_Qty=total_qty;
													input.Finished_Goods_Size_wise.insert(newrow);
												}
												total_order_qty = 0;
												total_order_value = 0;
												for each  r in input.Finished_Goods_Size_wise
												{
													qty = ifnull(r.Total_Qty,0);
													price = ifnull(r.Buyer_Po_Price,0);
													total_order_qty = total_order_qty + qty;
													total_order_value = total_order_value + qty * price;
												}
												input.Order_Qty = total_order_qty;
												input.Order_Value = total_order_value;
											}
											else
											{
												hide Finished_Goods_Size_wise;
											}
										}
						)
					}
				}

			}
