			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		}
		form Bulk_Order
		{
			displayname = "Bulk Order"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have EO_No
			(
    			type = text
				displayname = "EO No"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Buyer1
			(
				type = picklist	
				displayname = "Buyer"
				values  = Buyer1.ID
    			displayformat = [Buyer_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Template_File
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Season
			(
				type = picklist	
				values  = Season.ID
    			displayformat = [Seasi]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_field
			(
    			type = text
				displayname = "Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			No_Of_Pcs_Order_Entry
			(
				type = number
				displayname = "No Of Pcs Order Entry"
	 			row = 1
	 			column = 2   
				width = medium
			)
			No_of_Styles_Order_Entry
			(
				type = number
				displayname = "No of Styles Order Entry"
	 			row = 1
	 			column = 2   
				width = medium
			)
			No_of_Gold_Seal
			(
				type = number
				displayname = "No of Gold Seal"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Products
			(
				type = picklist	
				values  = Products.ID
    			displayformat = [Product]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Size_Group
			(
				type = picklist	
				displayname = "Size Group"
				values  = Size_Group.ID
    			displayformat = [Size_Group]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			No_of_Pcs_customer
			(
				type = number
				displayname = "No of Pcs (customer)"
	 			row = 1
	 			column = 3   
				width = medium
			)
			No_of_Styles_customer
			(
				type = number
				displayname = "No of Styles (customer)"
	 			row = 1
	 			column = 3   
				width = medium
			)
			Finished_Goods_Size_wise
			(
				type = list	
				displayname = "Finished Goods Size wise"
				values  = Finished_Goods_Size_wise.ID
    			displayformat = [ID]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 3   
				width = medium
			)
			must have Eo_No_Sub_Form
			(
				type = grid
				displayname = "Eo No Sub Form"
				values  = Eo_Number_Subform.ID
    			bidirectional = Eo_No
				auto width = false
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
				Sales_Order
				{
