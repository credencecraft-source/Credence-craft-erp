											{
												sum_of_already_allocate = Style_Wise_Inventory[Grouping_Subform_ID == each_verification.ID && GRN_Allocation_ID != null].sum(Allocate);
												row1 = GRN_Allocation.Material_Allocation();
												row1.Grouping_Purchase_Request=input.Grouping_Purchase_Request;
												row1.Order_No1=each_verification.Create_Order;
												row1.Style_No=each_verification.Style_No;
												row1.Already_Allocated=sum_of_already_allocate;
												row1.Balance_To_Allocate=ifnull(each_verification.Grouped_Qty,0) - sum_of_already_allocate;
												row1.Grouped=each_verification.Grouped_Qty;
												row1.Grouping_Subform_ID=each_verification.ID;
												row1.GRN_Verification_ID=input.GRN_Verification;
												row1.Raw_Material1=each_verification.Raw_Material1;
												row1.RM_Uniqie_Code=RM_Uniqie_Code;
												row1.Entity_Delivery_Address=input.GRN_Verification_Subform_ID.Entity_Delivery_Address;
												row1.Warehouse_Location=input.GRN_Verification_Subform_ID.Warehouse_Location;
												row1.Rack=input.GRN_Verification_Subform_ID.Rack;
												row1.Rack_Bin1=input.GRN_Verification_Subform_ID.Rack_Bin;
												// 		rows = Collection();
												// 		rows.insert(row1);
												input.Material_Allocation.insert(row1);
												//sum_of_allocate_qty = sum_of_allocate_qty + ifnull(row1.Allocate,0);
											}
											//input.Allocated_Qty = sum_of_allocate_qty;
										}
						)
					}
