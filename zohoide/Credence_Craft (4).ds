				 void create_grn_from_delivery_challan(int dcID)
                 {
                 	dcRec = GRN_Delivery[ID == dcID];
                 	if(dcRec == null)
                 	{
                 		return;
                 	}
                 	rows = Delivery_Challan_Subform[Delivery_Challan == dcRec.ID];
                 	for each  r in rows
                 	{
                 		if(r.Process_Bundle_Movement1 != null)
                 		{
                 			bundleRec = Process_Bundle_Movement[ID == r.Process_Bundle_Movement1];
                 			if(bundleRec != null)
                 			{
                 				grnCheck = Process_Bundle_GRN[Bundle_Transfer_No == bundleRec.ID];
                 				if(grnCheck.count() == 0)
                 				{
                 					insert into Process_Bundle_GRN
                 					[
                 						Bundle_Transfer_No=bundleRec.ID
                 						Work_Order_New=bundleRec.Work_Order_New
                 						Create_Order=bundleRec.Order_No
                 						Received_Qty=r.Requested_Qty
                 						From=bundleRec.From
                 						To=bundleRec.To
                 						Batch=bundleRec.Batch
                 						Received_Date=zoho.currenttime
                 						Bundle_Receaved_user_email1=zoho.loginuserid
                 						Added_User=zoho.loginuser
                 					]
                 					grnQty = ifnull(r.Requested_Qty,0);
                 					bundleRec.GRN_Qty=ifnull(bundleRec.GRN_Qty,0) + grnQty;
                 					if(bundleRec.GRN_Qty > bundleRec.Issued)
                 					{
                 						info "GRN exceeds Issued Qty";
                 					}
                 					// update process controller OUTPUT
                 					if(bundleRec.From != null && bundleRec.From != bundleRec.To)
                 					{
                 						woFromList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.From.ID];
                 						for each  woRec1 in woFromList
                 						{
                 							woRec1.Out_Put=ifnull(woRec1.Out_Put,0) + grnQty;
                 							thisapp.updateWOProcessStatusByQty(woRec1.ID);
                 						}
                 					}
                 					// update process controller INPUT
                 					woToList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.To.ID];
                 					for each  woRec2 in woToList
                 					{
                 						woRec2.In_Put=ifnull(woRec2.In_Put,0) + grnQty;
                 						thisapp.updateWOProcessStatusByQty(woRec2.ID);
                 					}
                 					thisapp.syncWOToOrder(bundleRec.Order_No.ID);
                 				}
                 			}
                 		}
                 	}
                 }
				 void create_online_order_from_work_order(int wo_id)
                 {
                 	wo_rec = Work_Order_New[ID == wo_id];
                 	if(wo_rec.ID == null)
                 	{
                 		info "Work Order not found.";
                 		return;
                 	}
                 	existing_online_order = Online_Order_Create_order[Work_Order_New == wo_rec.ID];
                 	if(existing_online_order.ID != null)
                 	{
                 		info "Online Order already created for this Work Order.";
                 		return;
                 	}
                 	order_rec = Create_Order[ID == wo_rec.Create_Order];
                 	if(order_rec.ID == null)
                 	{
                 		info "Order not found.";
                 		return;
                 	}
                 	online_order_id = insert into Online_Order_Create_order
                 	[
                 		Added_User=zoho.loginuser
                 		Owner="My Order"
                 		Style_Name=ifnull(wo_rec.Style_Name,"")
                 		Order_No=wo_rec.Create_Order
                 		Work_Order_New=wo_rec.ID
                 		Colors=order_rec.Colors
                 		Customer_Work_Order_No1=ifnull(wo_rec.Work_Order_No,"")
                 		Customer_Order_No=""
                 		Channeal="Online"
                 		Entity1=ifnull(order_rec.Entity_Name.Entity_Name,"")
                 		Brand=ifnull(wo_rec.Brand1.Brand,"")
                 		Qty=ifnull(wo_rec.Work_Order_Qty,0)
                 		Pricing_Type="Fob"
                 		Price=ifnull(wo_rec.Price,ifnull(order_rec.Fob,0))
                 		Changes_Availale=false
                 		Date_Time=zoho.currenttime
                 		Hsn_Code=order_rec.Hsn_Code
                 		Gst=order_rec.Gst
                 		Order_Status1=ifnull(wo_rec.Wo_Status,"")
                 		Product_Master=order_rec.Catagery
                 		Products=order_rec.Sub_Catagery
                 		Volum=ifnull(order_rec.Order_volume,"Small")
                 	];
                 	for each  size_row in Wo_Order_Size_Wise_Qty[Work_Order_No == wo_rec.ID]
                 	{
                 		insert into Online_Order_Size_Wise
                 		[
                 			Added_User=zoho.loginuser
                 			Online_Order_Create_order=online_order_id
                 			Size=size_row.Size.Size
                 			Qty=ifnull(size_row.Work_Order_Qty,0)
                 			Excess=0
                 			Total=ifnull(size_row.Work_Order_Qty,0)
                 		]
                 	}
                 	for each  rm_row in Work_Order_Rawmateril[Work_Order_No == wo_rec.ID]
                 	{
                 		insert into Online_Order_Order_Rawmateril
                 		[
                 			Added_User=zoho.loginuser
                 			Online_Order_Create_order=online_order_id
                 			Catagery_Type=ifnull(rm_row.Category_Type1.Category_Type_Name,"")
                 			Catagery=ifnull(rm_row.cen.Category_Name,"")
                 			Subcatagery=ifnull(rm_row.Subcategory1.Subcategory_Name,"")
                 			Rawmateril=ifnull(rm_row.Raw_Materil_Name.Raw_Material_Name,"")
                 			Consemption=ifnull(rm_row.Work_order_Consemption,0)
                 			Required=ifnull(rm_row.Wo_Required,0)
                 			Excess=0
                 			Required_with_Excess=ifnull(rm_row.Wo_Required,0)
                 			Allocated_Stock_local=ifnull(rm_row.Order_Allocated_Qty,0)
                 			Allocated_Stock_partner=0
                 			Effective_allocated=ifnull(rm_row.Order_Allocated_Qty,0)
                 		]
                 	}
                 	info "Online Order created successfully.";
                 }
				 void create_order_processes(int order_id)
                 {
                 	get_order = Create_Order[ID == order_id];
                 	if(get_order.count() == 0)
                 	{
                 		return;
                 	}
                 	// ? Validation: check if Work Order exists
                 	existing_wo = Work_Order_New[Create_Order == order_id];
                 	if(existing_wo.count() > 0)
                 	{
                 		info "Process cannot be changed. Work order is already created.\n\nPlease delete the work order to change the process.";
                 		return;
                 	}
                 	// ? Delete old processes
                 	old_process = Order_Process_Controler[Order_No == order_id];
                 	if(old_process.count() > 0)
                 	{
                 		for each  rec in old_process
                 		{
                 			delete from Order_Process_Controler[ID == rec.ID];
                 		}
                 	}
                 	get_template = Process_Template[ID == get_order.Process_Template];
                 	if(get_template.count() == 0)
                 	{
                 		return;
                 	}
                 	template_process_list = Process_Templated_Subform[Process_Template == get_template.ID];
                 	for each  tp in template_process_list
                 	{
                 		op_list = List();
                 		templateRec = null;
                 		if(tp.Operation_Template != null)
                 		{
                 			templateRec = Operation_Template[ID == tp.Operation_Template];
                 			if(templateRec != null && templateRec.Operation1 != null)
                 			{
                 				op_list = templateRec.Operation1;
                 			}
                 		}
                 		insert into Order_Process_Controler
                 		[
                 			Order_No=get_order.ID
                 			Process_Name=tp.Process.ID
                 			Process_No=tp.Process_No
                 			Block_By=tp.Block_By
                 			Operation_Template=tp.Operation_Template
                 			Operation=op_list
                 			Status="Pending"
                 			Style_Name=get_order.Style_Name
                 			Eo_No_and_Name=get_order.Eo_No_and_Name
                 			Delivery_Date=get_order.Delivery_Date
                 			Costing_ID=get_order.Costing_ID
                 			Order_Qty=get_order.Order_Qty
                 			Brand1=get_order.Brand
                 			Added_User=zoho.loginuser
                 		]
                 		new_proc = Order_Process_Controler[Order_No == get_order.ID && Process_Name == tp.Process.ID];
                 		if(templateRec != null && templateRec.Operation1 != null)
                 		{
                 			for each  proc in new_proc
                 			{
                 				rows = Collection();
                 				for each  opId in templateRec.Operation1
                 				{
                 					newrow = Order_Process_Controler.job_order();
                 					newrow.Order_No=get_order.ID;
                 					newrow.Style_Name=get_order.Style_Name;
                 					newrow.Brand1=get_order.Brand;
                 					newrow.Process_Name=tp.Process.ID;
                 					newrow.Operation=opId;
                 					newrow.Order_Qty=get_order.Order_Qty;
                 					rows.insert(newrow);
                 				}
                 				proc.job_order.insert(rows);
                 			}
                 		}
                 	}
                 }
				 void create_po(Master_Group get_maseter_group)
                 {
                 	get_all_raw_material = get_maseter_group.Raw_Material.getall();
                 	get_all_vendor = get_maseter_group.Vendor.getall();
                 	if(get_all_raw_material.size() != get_all_raw_material.tolist().distinct().size())
                 	{
                 		info "The system does not allow duplicate raw material..!";
                 	}
                 	else if(get_all_vendor.tolist().distinct().size() > 1)
                 	{
                 		info "The system does not allow duplicate vendor..!";
                 	}
                 	else
                 	{
                 		get_all_master_id = get_maseter_group.ID.getall();
                 		openUrl("#Form:Purchase_Order?Master_Group_ID=" + get_all_master_id,"popup window","height=100%,width=100%");
                 	}
                 }
				 void create_subform_for_process(int order_process_id)
                 {
                 	info "Subform creation started for process: " + order_process_id;
                 	get_process = Order_Process_Controler[ID == order_process_id];
                 	if(get_process.count() > 0)
                 	{
                 		// 1) Remove existing subform rows for this parent record
                 		delete from Order_Job_Order_New[PrID == get_process.ID];
                 		// 2) Fetch operations for the process
                 		operation_list = Operation[Process_Master == get_process.Process_Name];
                 		if(operation_list.count() > 0)
                 		{
                 			// 3) Insert a subform row for each operation
                 			for each  op in operation_list
                 			{
                 				insert into Order_Job_Order_New
                 				[
                 					PrID=get_process.ID
                 					Process_Name=get_process.Process_Name
                 					Style_Name=get_process.Style_Name
                 					Operation=op.ID
                 					Order_No=get_process.Order_No
                 					Brand1=get_process.Brand1
                 					Added_User=zoho.loginuser
                 				]
                 			}
                 			info "Subform rows created successfully for process: " + order_process_id;
                 		}
                 		else
                 		{
                 			info "No operations found for process: " + get_process.Process_Name;
                 		}
                 	}
                 	else
                 	{
                 		info "Invalid process record ID: " + order_process_id;
                 	}
                 	info "Subform creation completed for process: " + order_process_id;
                 }
				 void create_work_order_processes(int work_order_id)
                 {
                 	woRec = Work_Order_New[ID == work_order_id];
                 	if(woRec.count() == 0)
                 	{
                 		return;
                 	}
                 	orderRec = Create_Order[ID == woRec.Create_Order];
                 	if(orderRec.count() == 0)
                 	{
                 		return;
                 	}
                 	orderProcesses = Order_Process_Controler[Order_No == orderRec.ID];
                 	for each  op in orderProcesses
                 	{
                 		existingProcess = Wo_Making_Charges[Work_Order == woRec.ID && Process_Name == op.Process_Name];
                 		if(existingProcess.count() == 0)
                 		{
                 			newWOProcess = insert into Wo_Making_Charges
                 			[
                 				Work_Order=woRec.ID
                 				Order_No=orderRec.ID
                 				Process_Name=op.Process_Name
                 				Process_No=op.Process_No
                 				Operation_Template=op.Operation_Template
                 				Status="Pending"
                 				Wo_Qty=woRec.Work_Order_Qty
                 				Order_Qty=orderRec.Order_Qty
                 				In_Put=0
                 				Out_Put=0
                 				WIP_or_Missing1=0
                 				Added_User=zoho.loginuser
                 			];
                 			parentID = newWOProcess;
                 			// ? Insert Template Operations into Subform
                 			if(op.Operation_Template != null)
                 			{
                 				templateRec = Operation_Template[ID == op.Operation_Template];
                 				if(templateRec != null && templateRec.Operation1 != null)
                 				{
                 					for each  opId in templateRec.Operation1
                 					{
                 						insert into Wo_Making_Charges_Subform
                 						[
                 							Work_Order_Process_Controller=parentID
                 							Operation=opId
                 							Order_No=orderRec.ID
                 							Style_Name=orderRec.Style_Name
                 							Brand1=orderRec.Brand
                 							Process_Name=op.Process_Name
                 							Added_User=zoho.loginuser
                 						]
                 					}
                 				}
                 			}
                 		}
                 	}
                 }
