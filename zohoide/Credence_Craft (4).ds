			displayname = "RM-Plan"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFC1BE'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Material Movement Management (MMM)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='24%'\n   \t>\n\t<panel elementName='Board'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Plan_Rm'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Request RM'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'RM_ISSUE'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Yet To Pick'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Rm_Pick_Box'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Yet To Create DC'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Rm_Pick_Box'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Delivery Challan'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet9' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet9()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{margin:0;padding:0;box-sizing:border-box;}\n.form-action-container{display:none;}\n\n.tabs{\n    height:100vh;\n    font-family:Arial, sans-serif;\n}\n\n.tabs .tab{\n    float:left;\n}\n\n.tabs input[type=&quot;radio&quot;]{\n    display:none;\n}\n\n/* BIGGER TABS */\n.tabs label{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 28px;          /* BIGGER */\n    font-size:16px;             /* BIGGER */\n    cursor:pointer;\n    font-weight:bold;\n    color:#333;\n    border-bottom:4px solid transparent;\n    transition:0.3s;\n}\n\n.tabs label i{\n    font-size:18px;             /* BIGGER ICON */\n}\n\n.tabs label:hover{\n    background:#f2f2f2;\n}\n\n.tabs input:checked + label{\n    color:#0a7a35;\n    border-bottom:4px solid #0a7a35;\n    background:#eef8f1;\n}\n\n.tabs .content{\n    position:absolute;\n    top:50px;   /* match bigger tab height */\n    left:0;\n    width:100%;\n    height:calc(100vh - 50px);\n    opacity:0;\n    z-index:0;\n}\n\n.tabs input:checked ~ .content{\n    opacity:1;\n    z-index:1;\n}\n\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n&lt;!-- REQUEST --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; checked id=&quot;rm_tab1&quot;&gt;\n&lt;label for=&quot;rm_tab1&quot;&gt;\n&lt;i class=&quot;fa-solid fa-file-circle-check&quot;&gt;&lt;/i&gt; Request\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Plan_Rm?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- PICK --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; id=&quot;rm_tab2&quot;&gt;\n&lt;label for=&quot;rm_tab2&quot;&gt;\n&lt;i class=&quot;fa-solid fa-hand-holding-box&quot;&gt;&lt;/i&gt; Pick\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Centralized_Pick_list_Report?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- PACK --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; id=&quot;rm_tab3&quot;&gt;\n&lt;label for=&quot;rm_tab3&quot;&gt;\n&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;/i&gt; Pack\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/All_Rm_Pick_Box?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- SHIP --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;rm_tabs&quot; id=&quot;rm_tab4&quot;&gt;\n&lt;label for=&quot;rm_tab4&quot;&gt;\n&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;/i&gt; Ship\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Delivery_Challan1?zc_Header=false&quot;&gt;&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;/ul&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Q_APP(string TaskID)
		{
			displayname = "Q-APP"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Daily_Task_Line_Plans'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'ExecuteFunction'\n\n\t\tparameters = 'Daily Task Line Plan.Task.id' \n\t\tfunctionName = 'Q_app.qapp_approve'  \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tpadding = '0px'\n\tcolor = '#FEC9D6'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n\n\t  value = 'Approved'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='29%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FF4C2F'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#0FBB51'\n    borderWidth = '0px'\n\n\t  value = '13'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tpadding = '0px'\n\tcolor = '#FEC9D6'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Alter'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='38%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FF0048'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#0FBB51'\n    borderWidth = '0px'\n\n\t  value = '120'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tpadding = '0px'\n\tcolor = '#FEC9D6'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Rejected'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Post__Production
		{
			displayname = "Post Production"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='28%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '17px'\n\tbgColor = '#0B6E4F'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenPage'\n\t\tcomponentLinkName = 'Post_Production'\n\t\ttarget = 'same-window'\n\tcolor = 'theme'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='Scan Pack'\n\t\tbgColor = '#FFFFFF'\n\t\tcornerRadius = '6px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='39%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '17px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenPage'\n\t\tcomponentLinkName = 'Truck_Out'\n\t\ttarget = 'same-window'\n\tcolor = 'theme'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='Truck Out'\n\t\tbgColor = '#FFFFFF'\n\t\tcornerRadius = '6px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Invoices'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FEC9D6'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Invoice'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Employes
		{
