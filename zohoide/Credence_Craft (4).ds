			Create_Order_in_Work_Orde as "Create Order in Work Order New"
			{
				type =  form
				form = Work_Order_New

				record event = on add

				on user input of Create_Order
				{
					actions 
					{
						custom deluge script
						(
											if(input.Create_Order != null)
										{
											if(input.Create_Order.Process_Status != "Approved")
											{
												info "Your Process Template is not approved.";
												input.Create_Order = null;
												return;
											}
											process_rec = Order_Process_Controler[Order_No == input.Create_Order];
											if(process_rec.count() == 0)
											{
												info "Your Process Template is not approved.";
												input.Create_Order = null;
												return;
											}
											process_not_approved = false;
											missing_operation_template = false;
											for each  proc in process_rec
											{
												if(proc.Status != "Approved")
												{
													process_not_approved = true;
													break;
												}
												if(proc.Operation_Template == null)
												{
													missing_operation_template = true;
													break;
												}
											}
											if(process_not_approved)
											{
												info "Your Process Template is not approved.";
												input.Create_Order = null;
												return;
											}
											if(missing_operation_template)
											{
												info "Your Making Charges is not approved.";
												input.Create_Order = null;
												return;
											}
										}
										clear Work_Order_Size_Wise_Qty;
										clear Work_Order_Raw_materil;
										input.Style_Name = input.Create_Order.Style_Name;
										input.Buyer1 = input.Create_Order.Buyer1;
										input.Brand1 = input.Create_Order.Brand;
										Gold_Seal = input.Create_Order.Article;
										input.Delivery_Date = input.Create_Order.Delivery_Date;
										Body_Fabric1 = input.Create_Order.Body_Fabric1;
										Create_Eo_No = input.Create_Order.Eo_No_and_Name;
										input.Merchant = input.Create_Order.Merchandiser;
										get_order_size = Finished_Goods_Size_wise[Order_No == input.Create_Order && Work_Order_Status != "Fully Created"];
										for each  each_work_order in get_order_size
										{
											already_created_work_order = Wo_Order_Size_Wise_Qty[Finished_Goods_Size_ID == each_work_order.ID].sum(Work_Order_Qty);
											balance_available_qty = ifnull(each_work_order.Total_Qty,0) - already_created_work_order;
											if(balance_available_qty > 0)
											{
												row2 = Work_Order_New.Work_Order_Size_Wise_Qty();
												row2.Size=each_work_order.Size;
												row2.Order_Qty1=each_work_order.Total_Qty;
												row2.Balance_To_Create_Work_order=balance_available_qty;
												row2.Work_Order_Qty=balance_available_qty;
												row2.Finished_Goods_Size_ID=each_work_order.ID;
												rows1 = Collection();
												rows1.insert(row2);
												input.Work_Order_Size_Wise_Qty.insert(rows1);
											}
										}
										get_order_raw_material = Order_Raw_material[Order_No == input.Create_Order];
										if(get_order_raw_material.ID != null)
										{
											total_work_order_qty = input.Work_Order_Size_Wise_Qty.sum(Work_Order_Qty);
											for each  each_order_meterial in get_order_raw_material
											{
												row3 = Work_Order_New.Work_Order_Raw_materil();
												row3.Order_No=each_order_meterial.Order_No;
												row3.Style_Name=input.Create_Order.Style_Name;
												row3.cen=each_order_meterial.Category_Master;
												row3.Category_Type1=each_order_meterial.Category_Type_Master;
												row3.Subcategory1=each_order_meterial.Subcategory;
												row3.Brand=each_order_meterial.Brand1;
												row3.RM_No=each_order_meterial.Raw_Material_Name.RM_No;
												row3.Raw_Materil_Name=each_order_meterial.Raw_Material_Name;
												row3.Stock_Uom1=each_order_meterial.Raw_Material_Name.Stock_Uom1;
												row3.Size=each_order_meterial.Size;
												row3.Order_Raw_material_ID=each_order_meterial.ID;
												row3.Is_Size_Mapped=each_order_meterial.Is_Size_Mapped;
												row3.Work_order_Consemption=each_order_meterial.Internal_Consumption;
												final_qty_for_calculation = 0;
												if(each_order_meterial.Is_Size_Mapped == true)
												{
													total_qty_for_mapped_sizes = 0;
													for each  each_work_order_size in input.Work_Order_Size_Wise_Qty
													{
														if(each_order_meterial.Size.contains(each_work_order_size.Size))
														{
															total_qty_for_mapped_sizes = total_qty_for_mapped_sizes + each_work_order_size.Work_Order_Qty;
														}
													}
													final_qty_for_calculation = total_qty_for_mapped_sizes;
												}
												else
												{
													final_qty_for_calculation = total_work_order_qty;
												}
												row3.Work_Order_Qty_Rawmateril_Level=final_qty_for_calculation;
												row3.Wo_Required=final_qty_for_calculation * each_order_meterial.Internal_Consumption;
												rows1 = Collection();
												rows1.insert(row3);
												input.Work_Order_Raw_materil.insert(rows1);
											}
										}
										total_qty = 0;
										for each  row in input.Work_Order_Size_Wise_Qty
										{
											total_qty = total_qty + ifnull(row.Work_Order_Qty,0);
										}
										input.Work_Order_Qty = total_qty;
						)
					}
				}

			}
			Work_Order_New_C_Validati as "Work Order New (C)-Validation"
			{
				type =  form
				form = Work_Order_New

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  each_work_order in input.Work_Order_Size_Wise_Qty
										{
											sum_of_work_order_qty = Wo_Order_Size_Wise_Qty[Finished_Goods_Size_ID == each_work_order.ID && Work_Order_No != null].sum(Work_Order_Qty);
											sum_of_work_order_qty = sum_of_work_order_qty + ifnull(each_work_order.Work_Order_Qty,0);
											if(sum_of_work_order_qty > each_work_order.Finished_Goods_Size_ID.Total_Qty)
											{
												alert "Work order is already fully created for this size (" + each_work_order.Finished_Goods_Size_ID.Size.Size + "). Please refresh and check it.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Consemption_User_Input as "Consemption User Input"
			{
				type =  form
				form = Work_Order_New

				record event = on add or edit

