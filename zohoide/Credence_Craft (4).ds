			Validate_Internal_Consump as "Validate Internal Consumption in Approve Price"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add

				on user input of Validate_Internal_Consumption
				{
					actions 
					{
						custom deluge script
						(
											if(input.Validate_Internal_Consumption == true)
										{
											//alert "Test" ;
											for each  each_itme in input.Approve_Consumption_and_price
											{
												get_all_order_internal_consumption = Order_Raw_material[Raw_Material_Name == input.Raw_Material && Gold_Seal == each_itme.Gold_Seal && Order_No != input.Order_No && Internal_Consumption < each_itme.Internal_Consumption && Internal_Consumption_Status == "Approved" && Placements == each_itme.Placements];
												if(get_all_order_internal_consumption.ID != null)
												{
													each_itme.Internal_Best_Consumption="Better Consumption Available";
												}
												else
												{
													each_itme.Internal_Best_Consumption="Yes";
												}
											}
										}
										else
										{
											for each  each_itme in input.Approve_Consumption_and_price
											{
												each_itme.Internal_Best_Consumption="";
											}
										}
						)
					}
				}

			}
