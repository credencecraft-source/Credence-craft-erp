		form Order_Raw_material
		{
			title 
    		{
				displayname = "Order Raw material"
    			on add = "Order Based Raw material"
   	 			on edit = "Order Based Raw material"
			}
			success message = "Data Added Successfully!"
			Order_Details
			(
				type = section
				displayname = "Order Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Order_No
			(
				type = picklist	
				displayname = "Order No"
				values  = Create_Order.ID
    			bidirectional = Order_Raw_material
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Style_Name
			(
				type = picklist	
				displayname = "Style Name"
				values  = Create_Order.ID
    			displayformat = [Style_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Season
			(
				type = picklist	
				values  = Season.ID
    			displayformat = [Seasi]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			Gold_Seal
			(
				type = picklist	
				displayname = "Gold Seal"
				values  = Gold_Seal.ID
    			displayformat = [Gold_Seal_No]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			Raw_material_Details
			(
				type = section
				displayname = "Raw-material Details "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Category_Type_Master
			(
				type = picklist	
				displayname = "Category Type Master"
				values  = Category_Type1.ID
    			displayformat = [Category_Type_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Category_Master
			(
				type = picklist	
				displayname = "Category Master"
				values  = Category1[Status == "Approved"].ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Subcategory
			(
				type = picklist	
				values  = Subcategory1[Status == "Approved"].ID
    			displayformat = [Subcategory_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Products
			(
				type = picklist	
				values  = Products.ID
    			displayformat = [Product]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Raw_Material_Name
			(
				type = picklist	
				displayname = "Raw Material Name"
				values  = Raw_Material1[Status == "Approved" && Category.Category_Name != "General Goods - Consumables" && Category.Category_Name != "General Goods - Non Consumables"].ID
    			displayformat = [Raw_Material_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Item_Code
			(
				type = picklist	
				displayname = "Item Code"
				values  = Raw_Material1.ID
    			displayformat = [Item_Code]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Size
			(
				type = list	
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Placements
			(
				type = picklist	
				values  = Placements.ID
    			displayformat = [Placements]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Vendor_Master
			(
				type = picklist	
				displayname = "Vendor Master"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 2
	 			column = 3   
				width = medium
			)
			Raw_material_Status
			(
				type = picklist
				displayname = "Raw material Status"
				maxchar = 100
				values = {"Approved","Draft"}
				initial value = "Draft"
				sortorder = ascending
	 			row = 2
	 			column = 3   
				width = medium
			)
			Internal_Vendor
			(
				type = picklist	
				displayname = "Internal Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 2
	 			column = 3   
				width = medium
			)
			Consumption_And_price
			(
				type = section
				displayname = "Consumption And price"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Buyer_Consumption
			(
				type = decimal
				displayname = "Buyer Consumption"
				decimalplace = 4
	 			row = 3
	 			column = 1   
				width = medium
			)
			Buyer_Price
			(
				type = decimal
				displayname = "Buyer Price"
				decimalplace = 4
	 			row = 3
	 			column = 1   
				width = medium
			)
			Internal_Price
			(
				displayname = "Internal Price"
				type = INR
				format = commadotindian
				decimalplace = 4
	 			row = 3
	 			column = 2   
				width = medium
			)
			must have Internal_Consumption
			(
				type = decimal
				displayname = "Internal Consumption"
				decimalplace = 4
	 			row = 3
	 			column = 2   
				width = medium
			)
			Value_Per_Garment_Rm
			(
				displayname = "Value/Per Garment (I RM)"
				type = INR
				format = commadotindian
				decimalplace = 4
	 			row = 3
	 			column = 3   
				width = medium
			)
			Value_garment_B_Rm
			(
				displayname = "Value /garment (B Rm)"
				type = INR
				format = commadotindian
				decimalplace = 4
	 			row = 3
	 			column = 3   
				width = medium
			)
			Rawmateril_Requirment
			(
				type = section
				displayname = "Raw material Requirement "
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Is_Size_Mapped
			(
    			type = checkbox
				displayname = "Is size mapped"
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Sum_of_Size_wise_qty
			(
				type = number
				displayname = "Order Qty"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Required_Qty
			(
				type = decimal
				displayname = "Required Qty"
    			description
    			[
    				type = tooltip
    			 	message = "Required Qty With  header level Excess   Required qty =  order qty * internal consumption"
    			]
	 			row = 4
	 			column = 2   
				width = medium
			)
			Item_Wise_Excess_Persentage1
			(
    			type = percentage
				displayname = "Item Wise Excess Percentage"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Item_Wise_Excess_qty
			(
				type = decimal
				displayname = "Item Wise Excess qty"
    			description
    			[
    				type = tooltip
    			 	message = "each item wise excess percentage"
    			]
	 			row = 4
	 			column = 3   
				width = medium
			)
			Groupping
			(
				type = section
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Total_Required_Qty
			(
				type = decimal
				displayname = "Total Required Qty"
    			description
    			[
    				type = tooltip
    			 	message = "Total  required qty = required qty + item wise excess"
    			]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Rejected_Qty
			(
				type = decimal
				displayname = "Rejected Qty"
	 			row = 5
	 			column = 1   
				width = medium
			)
			To_be_Purchase
			(
				type = decimal
				displayname = "To be Required"
	 			row = 5
	 			column = 1   
				width = medium
			)
