: none\">&nbsp;<\/span><\/b><br /><\/td>\n     <\/tr>\n     <tr>\n      <td\n          style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\"\n          width=\"16%\">STYLE NAME<\/td>\n      <td\n          style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\"\n            width=\"16%\"><span>${Style_Name}<\/span><span\n          style=\"color: rgb(34, 35, 38); font-family: Lato, Arimo, sans-serif; font-size: 14px; font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><br /><\/td>\n      <td\n          style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\"\n          width=\"16%\">Order Qty<\/td>\n      <td width=\"16%\"\n            style=\"border-bottom: 1px solid rgb(51, 51, 51)\"><span>${Order_Qty_with_out_Excess}<\/span><span\n          style=\"color: rgb(34, 35, 38); font-family: Lato, Arimo, sans-serif; font-size: 14px; font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><br /><\/td>\n     <\/tr>\n     <tr>\n      <td\n          style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\">Brand<\/td>\n      <td\n            style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\"><span>${Brand}<\/span><span\n          style=\"color: rgb(34, 35, 38); font-family: Lato, Arimo, sans-serif; font-size: 14px; font-weight: 400; font-style: normal; text-decoration: none\">&nbsp;<\/span><br /><\/td>\n      <td\n          style=\"border-right: 1px solid rgb(51, 51, 51); border-bottom: 1px solid rgb(51, 51, 51)\">With Excess<\/td>\n      <td\n              style=\"border-bottom: 1px solid rgb(51, 51, 51)\"><b><span>${Order_Qty}<\/span><span\n          style=\"color: rgb(34, 35, 38); font-family: Lato, Arimo, sans-serif; font-size: 14px; font-style: normal; text-decoration: none\">&nbsp;<\/span><\/b><br /><\/td>\n     <\/tr>\n     <tr>\n      <td\n    