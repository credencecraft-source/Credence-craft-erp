				 void order_controllar.insert_raw_material_from_quick_raw_materil(int quick_raw_materil_id)
                 {
                 	get_qucik_rawmaterial = Add_Quick_RawMaterial[ID == quick_raw_materil_id];
                 	if(get_qucik_rawmaterial.ID != null)
                 	{
                 		// ✅ Get Approve Setting
                 		get_setting = Setting[ID != 0];
                 		auto_approve = if(get_setting.Approve_Consemption == "Auto Approve",true,false);
                 		for each  each_order in get_qucik_rawmaterial.Order_No
                 		{
                 			get_raw_materil_quick = Add_Quick_Raw_Material_Subform[Add_Quick_RawMaterial_ID == get_qucik_rawmaterial.ID];
                 			for each  each_quick_material in get_raw_materil_quick
                 			{
                 				// ✅ Calculate sum order qty
                 				if(each_quick_material.Size.size() > 0)
                 				{
                 					get_size_mapped = true;
                 					sum_order_qty = Finished_Goods_Size_wise[Order_No == each_order.ID && Size == each_quick_material.Size].sum(Total_Qty);
                 				}
                 				else
                 				{
                 					get_size_mapped = false;
                 					sum_order_qty = Finished_Goods_Size_wise[Order_No == each_order.ID].sum(Total_Qty);
                 				}
                 				// ✅ Default internal consumption & calculations
                 				get_internal_consum = 0;
                 				// ✅ Size Wise Consumption Order Wise Calculation
                 				if(each_quick_material.Size_Wise_Consemption_Master != null)
                 				{
                 					get_internal_consum = thisapp.order_controllar.calculate_size_wise_consumption(each_order.ID,each_quick_material.Size_Wise_Consemption_Master.ID);
                 				}
                 				else
                 				{
                 					get_internal_consum = ifnull(each_quick_material.Consumption,0);
                 				}
                 				get_req_qty = sum_order_qty * get_internal_consum;
                 				get_exess_qty = (get_req_qty * ifnull(each_quick_material.Excess,0)) / 100;
                 				// ✅ Insert raw material
                 				insert_order_raw_materil = insert into Order_Raw_material
                 				[
                 					Raw_Material_Name=each_quick_material.Raw_Material_Name
                 					Order_No=each_order.ID
                 					Style_Name=each_order.ID
                 					Item_Code=each_quick_material.Raw_Material_Name
                 					Vendor_Master=each_quick_material.Vendor1
                 					Gold_Seal=each_order.Article
                 					Season=each_order.Season
                 					Brand1=each_order.Brand
                 					Value_Per_Garment_Rm=0
                 					Subcategory=each_quick_material.Subcategory1
                 					Category_Master=each_quick_material.Category
                 					Category_Type_Master=each_quick_material.Category_Type1
                 					Buyer_Consumption=get_internal_consum
                 					Buyer_Price=each_quick_material.Buyer_Price
                 					Internal_Consumption=get_internal_consum
                 					Item_Wise_Excess_Persentage1=each_quick_material.Excess
                 					Item_Wise_Excess_qty=get_exess_qty
                 					Total_Required_Qty=get_req_qty + get_exess_qty
                 					Required_Qty=get_req_qty
                 					Grouped_Qty=0
                 					Balance_to_Groupe=get_req_qty
                 					Size=each_quick_material.Size
                 					Is_Size_Mapped=get_size_mapped
                 					Sum_of_Size_wise_qty=sum_order_qty
                 					Internal_Price=if(auto_approve,each_quick_material.Buyer_Price,0)
                 					Internal_Consumption_Status=if(auto_approve,"Approved","Draft")
                 					Buyer_Consumption_Status=if(auto_approve,"Approved","Draft")
                 					Raw_material_Status=if(auto_approve,"Approved","Draft")
                 					Price_Status=if(auto_approve,"Approved","Draft")
                 					Verification_Status=if(auto_approve,"Approved","Draft")
                 					Stock_Confirmation_status=if(auto_approve,"Approved","Yet To Check Stock")
                 					Grouping_Status=if(auto_approve,"Approved","Not Grouped")
                 					Products=each_quick_material.Products
                 					Added_User=zoho.loginuser
                 				];
                 				// ✅ After insert → call raw material calculation
                 				if(auto_approve)
                 				{
                 					thisapp.order_controllar.order_raw_material_field_calculate(insert_order_raw_materil);
                 				}
                 			}
                 		}
                 	}
                 }
				 void order_controllar.order_dele_update_eo_no_level(int eo_id, int gold_seal_id, int order_id)
                 {
                 	get_eo_order = Bulk_Order[ID == eo_id];
                 	if(get_eo_order.ID != null)
                 	{
                 		get_eo_no_order_subform = Eo_Number_Subform[Eo_No == get_eo_order.ID && Gold_Seal == gold_seal_id];
                 		if(get_eo_no_order_subform.ID != null)
                 		{
                 			get_eo_no_order_count = Create_Order[Article == get_eo_no_order_subform.Gold_Seal && Eo_No_and_Name == get_eo_order.ID && ID != order_id].count();
                 			sum_order_qty = Create_Order[Article == get_eo_no_order_subform.Gold_Seal && Eo_No_and_Name == get_eo_order.ID && ID != order_id].sum(Order_Qty);
                 			get_eo_no_order_subform.No_of_Styles_Created=get_eo_no_order_count;
                 			get_eo_no_order_subform.No_of_Pcs_Created=sum_order_qty;
                 		}
                 		get_eo_no_order_subform1 = Eo_Number_Subform[Eo_No == get_eo_order.ID];
                 		get_eo_order.No_Of_Pcs_Order_Entry=ifnull(get_eo_no_order_subform1.sum(No_of_Pcs_Created),0);
                 		get_eo_order.No_of_Styles_Order_Entry=ifnull(get_eo_no_order_subform1.sum(No_of_Styles_Created),0);
                 		get_eo_order.No_of_Gold_Seal=get_eo_no_order_subform1.count();
                 	}
                 }
				 void order_controllar.order_raw_material_field_calculate(int order_raw_material_id)
                 {
                 	get_order_raw_material = Order_Raw_material[ID == order_raw_material_id];
                 	if(get_order_raw_material.ID != null)
                 	{
                 		get_order_raw_material.Is_Size_Mapped=false;
                 		if(get_order_raw_material.Order_No != null)
                 		{
                 			if(get_order_raw_material.Size.Size() > 0)
                 			{
                 				sum_order_qty = Finished_Goods_Size_wise[Order_No == get_order_raw_material.Order_No && Size == get_order_raw_material.Size].sum(Total_Qty);
                 				get_order_raw_material.Is_Size_Mapped=true;
                 			}
                 			else
                 			{
                 				brand_rec = Brand1[ID == get_order_raw_material.Brand1];
                 				if(brand_rec.Auto_add_Excess_to_RM == true)
                 				{
                 					sum_order_qty = get_order_raw_material.Order_No.Order_Qty;
                 				}
                 				else
                 				{
                 					sum_order_qty = get_order_raw_material.Order_No.Order_Qty_with_out_Excess;
                 				}
                 			}
                 		}
                 		else
                 		{
                 			sum_order_qty = 0;
                 		}
                 		get_order_raw_material.Sum_of_Size_wise_qty=sum_order_qty;
                 		get_order_raw_material.Required_Qty=ifnull(get_order_raw_material.Internal_Consumption,0) * ifnull(get_order_raw_material.Sum_of_Size_wise_qty,0);
                 		get_order_raw_material.Item_Wise_Excess_qty=ifnull(get_order_raw_material.Required_Qty,0) * ifnull(get_order_raw_material.Item_Wise_Excess_Persentage1,0) / 100;
                 		get_order_raw_material.Total_Required_Qty=ifnull(get_order_raw_material.Item_Wise_Excess_qty,0) + ifnull(get_order_raw_material.Required_Qty,0);
                 		get_order_raw_material.Value_Per_Garment_Rm=ifnull(get_order_raw_material.Internal_Consumption,0) * ifnull(get_order_raw_material.Internal_Price,0);
                 		thisapp.groping_controllar.update_group_status_in_order_raw_material(get_order_raw_material.ID);
                 	}
                 }
				 void order_controllar.syncOnlineOrderChanges(INT online_order_id)
                 {
                 	// -------------------------------
                 	// FETCH ONLINE ORDER
                 	// -------------------------------
                 	online_rec = Online_Order_Create_order[ID == online_order_id];
                 	if(online_rec.ID == null)
                 	{
                 		info "Online Order not found. Unable to apply changes.";
                 		return;
                 	}
                 	// -------------------------------
                 	// FETCH CREATE ORDER
                 	// -------------------------------
                 	get_order = Create_Order[ID == online_rec.Order_No];
                 	if(get_order.ID == null)
                 	{
                 		info "Create Order not found. Unable to apply changes.";
                 		return;
                 	}
                 	// -------------------------------
                 	// FETCH WORK ORDER (DERIVED)
                 	// -------------------------------
                 	get_wo = Work_Order_New[Create_Order == get_order.ID];
                 	if(get_wo.ID == null)
                 	{
                 		info "Work Order not found. Unable to apply changes.";
                 		return;
                 	}
                 	// -------------------------------
                 	// APPLY CREATE ORDER HEADER
                 	// -------------------------------
                 	online_rec.Price=get_order.Fob;
                 	online_rec.Entity1=get_order.Entity_Name.Entity_Name;
                 	online_rec.Style_Name=get_order.Style_Name;
                 	online_rec.Qty=get_order.Order_Qty;
                 	// -------------------------------
                 	// APPLY SIZE-WISE QTY
                 	// -------------------------------
                 	online_rec.SubForm.clear();
                 	sizeColl = Collection();
                 	for each  ws in Wo_Order_Size_Wise_Qty[Work_Order_No == get_wo.ID]
                 	{
                 		sizeSub = Online_Order_Create_order.SubForm();
                 		sizeSub.Size=ws.Size.Size;
                 		sizeSub.Qty=ws.Work_Order_Qty;
                 		sizeSub.Excess=0;
                 		sizeSub.Total=ws.Work_Order_Qty;
                 		sizeColl.insert(sizeSub);
                 	}
                 	if(sizeColl.size() > 0)
                 	{
                 		online_rec.SubForm.insert(sizeColl);
                 	}
                 	// -------------------------------
                 	// APPLY RAW MATERIAL
                 	// -------------------------------
                 	online_rec.SubForm1.clear();
                 	rmColl = Collection();
                 	for each  rm in Order_Raw_material[Order_No == get_order.ID]
                 	{
                 		rmSub = Online_Order_Create_order.SubForm1();
                 		rmSub.Catagery_Type=if(rm.Category_Type_Master != null,rm.Category_Type_Master.Category_Type_Name,"");
                 		rmSub.Catagery=if(rm.Category_Master != null,rm.Category_Master.Category_Name,"");
                 		rmSub.Subcatagery=if(rm.Subcategory != null,rm.Subcategory.Subcategory_Name,"");
                 		rmSub.Rawmateril=if(rm.Raw_Material_Name != null,rm.Raw_Material_Name.Raw_Material_Name,"");
                 		rmSub.Consemption=rm.Internal_Consumption;
                 		rmSub.Required=rm.Required_Qty;
                 		rmSub.Excess=rm.Item_Wise_Excess_qty;
                 		rmSub.Required_with_Excess=rm.Total_Required_Qty;
                 		rmSub.Allocated_Stock_local=rm.Allocated;
                 		rmSub.Allocated_Stock_partner=0;
                 		rmSub.Effective_allocated=rm.Allocated;
                 		rmColl.insert(rmSub);
                 	}
                 	if(rmColl.size() > 0)
                 	{
                 		online_rec.SubForm1.insert(rmColl);
                 	}
                 	// -------------------------------
                 	// RESET STATUS
                 	// -------------------------------
                 	online_rec.Changes_Availale=false;
                 	online_rec.Date_Time=zoho.currenttime;
                 	info "Changes approved and Online Order updated successfully.";
                 }
				 void order_controllar.sync_rawmaterial_high_risk()
                 {
                 	for each  orm in Order_Raw_material
                 	{
                 		// ================= Validation =================
                 		if(orm.Order_No == null || orm.Raw_Material_Name == null)
                 		{
                 			continue;
                 		}
                 		// ================= Get High Risk Record =================
                 		hr = Rawmateril_High_Risk[Order_No == orm.Order_No && Raw_Material1 == orm.Raw_Material_Name && Size == orm.Size];
                 		if(hr.ID == null)
                 		{
                 			continue;
                 		}
                 		// ================= Values =================
                 		balanceToGroup = ifnull(orm.Balance_to_Groupe,0);
                 		// ✅ CORRECT FIELD NAME
                 		balanceToAllocate = ifnull(hr.Balance_to_allocate,0);
                 		totalQty = ifnull(hr.Total_Required_Qty,0);
                 		status = "";
                 		// ================= STATUS LOGIC =================
                 		// 1️⃣ PO NOT CREATED
                 		if(balanceToGroup > 0)
                 		{
                 			status = "PO Not Created";
                 		}
                 		else
                 		{
                 			// 2️⃣ PO CREATED → CHECK MATERIAL STATUS
                 			if(balanceToAllocate == totalQty)
                 			{
                 				status = "PO Created – Material Not Allocated";
                 			}
                 			else if(balanceToAllocate > 0 && balanceToAllocate < totalQty)
                 			{
                 				status = "Material Partially Received";
                 			}
                 			else if(balanceToAllocate == 0)
                 			{
                 				status = "Material Fully Received";
                 			}
                 		}
                 		// ================= UPDATE =================
                 		hr.Po_Status=status;
                 	}
                 }
				 void order_controllar.update_eo_no_level(int eo_id, int gold_seal_id)
                 {
                 	get_eo_order = Bulk_Order[ID == eo_id];
                 	if(get_eo_order.ID != null)
                 	{
                 		get_eo_no_order_subform = Eo_Number_Subform[Eo_No == get_eo_order.ID && Gold_Seal == gold_seal_id];
                 		if(get_eo_no_order_subform.ID != null)
                 		{
                 			get_eo_no_order_count = Create_Order[Article == get_eo_no_order_subform.Gold_Seal && Eo_No_and_Name == get_eo_order.ID].count();
                 			sum_order_qty = Create_Order[Article == get_eo_no_order_subform.Gold_Seal && Eo_No_and_Name == get_eo_order.ID].sum(Order_Qty);
                 			get_eo_no_order_subform.No_of_Styles_Created=get_eo_no_order_count;
                 			get_eo_no_order_subform.No_of_Pcs_Created=sum_order_qty;
                 		}
                 		get_eo_no_order_subform1 = Eo_Number_Subform[Eo_No == get_eo_order.ID];
                 		get_eo_order.No_Of_Pcs_Order_Entry=ifnull(get_eo_no_order_subform1.sum(No_of_Pcs_Created),0);
                 		get_eo_order.No_of_Styles_Order_Entry=ifnull(get_eo_no_order_subform1.sum(No_of_Styles_Created),0);
                 		get_eo_order.No_of_Gold_Seal=get_eo_no_order_subform1.count();
                 	}
                 }
				 void order_controllar.update_raw_material_allocation(int raw_material_id)
                 {
                 	get_raw_material = Order_Raw_material[ID == raw_material_id];
                 	if(get_raw_material.ID != null)
                 	{
                 		sum_of_allocated_qty = Style_Wise_Inventory[Grouping_Subform_ID.Order_Raw_material_ID == get_raw_material.ID && GRN_Allocation_ID != null].sum(Allocate);
                 		get_raw_material.Allocated=sum_of_allocated_qty;
                 		get_raw_material.Balance_To_Allocate=ifnull(get_raw_material.Total_Required_Qty,0) - sum_of_allocated_qty;
                 	}
                 }
				 void order_controllar.work_order_status_update(int order_id)
                 {
                 	get_order = Create_Order[ID == order_id];
                 	if(get_order.ID != null)
                 	{
                 		get_finished_item_style_count = Finished_Goods_Size_wise[Order_No == get_order].count();
                 		get_finsished_item_style_work_order_completed_count = Finished_Goods_Size_wise[Order_No == get_order && Work_Order_Status == "Fully Created"].count();
                 		if(get_finished_item_style_count > 0 && get_finished_item_style_count == get_finsished_item_style_work_order_completed_count)
                 		{
                 			get_order.Work_Order_Status="Fully Created";
                 		}
                 		else
                 		{
                 			get_finsished_item_style_work_order_partially_completed_count = Finished_Goods_Size_wise[Order_No == get_order && Work_Order_Status == {"Fully Created","Partially Created"}].count();
                 			if(get_finsished_item_style_work_order_partially_completed_count > 0)
                 			{
                 				get_order.Work_Order_Status="Partially Created";
                 			}
                 			else
                 			{
                 				get_order.Work_Order_Status="Not Create";
                 			}
                 		}
                 	}
                 }
				 list Page_status_call.get_orders_by_status(string status_text)
                 {
                 	status_input = input.status_text;
                 	// Fetch records based on Final_Status
                 	recs = Create_Order[Final_Status == status_input];
                 	// Prepare list to return
                 	resp_list = List();
                 	for each  rec in recs
                 	{
                 		row = Map();
                 		row.put("Order_No",rec.Order_No);
                 		row.put("Buyer",if(rec.Buyer1 != null,rec.Buyer1.Buyer_Name,""));
                 		row.put("Order_Qty",ifnull(rec.Order_Qty,0));
                 		row.put("Delivery_Date",if(rec.Delivery_Date != null,rec.Delivery_Date.toString("dd-MMM-yyyy"),""));
                 		row.put("Final_Status",rec.Final_Status);
                 		resp_list.add(row);
                 	}
                 	return resp_list;
                 }
