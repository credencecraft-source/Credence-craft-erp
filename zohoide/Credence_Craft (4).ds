			On_Form_Submission as "On Form Submission"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// On Add -> On Validate
										// Count the total allocated samples for the requested date by looping through records
										allocated_count = 0;
										// Find all records for the requested date
										all_requests = Sample_Allocation_Request[Requested_Date == input.Requested_Date];
										// Loop through each found record
										for each  request in all_requests
										{
											// Add the quantity of each request to the total count
											allocated_count = allocated_count + request.Requested_Quantity;
										}
										// Set the default capacity from the lookup field
										default_capacity = input.Batch_Name.Capacity_Per_Day;
										// Check if the new request will exceed the total capacity
										if(allocated_count + input.Requested_Quantity > default_capacity)
										{
											alert "Sorry, there is not enough capacity. Available for this date: " + (default_capacity - allocated_count) + " pcs.";
											cancel submit;
										}
						)
					}
				}

			}
			User_Input_of_date as "User Input of date"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on add or edit

				on user input of Requested_Date
				{
					actions 
					{
						custom deluge script
						(
											// On User Input of "Requested Date" field
										// Get all the records for the selected date
										all_requests = Sample_Allocation_Request[Requested_Date == input.Requested_Date];
										// Calculate the total booked quantity
										allocated_count = 0;
										for each  request in all_requests
										{
											allocated_count = allocated_count + request.Requested_Quantity;
										}
										// Check if a Batch has been selected
										if(input.Batch_Name != null)
										{
											// Set the capacity from the lookup field
											default_capacity = input.Batch_Name.Capacity_Per_Day;
											// Calculate the remaining capacity
											remaining_capacity = default_capacity - allocated_count;
											// Display the number of available items
											input.Balance_Available = remaining_capacity;
										}
										else
										{
											// If Batch_Name is not selected, clear the balance field
											input.Balance_Available = null;
											// Show an information message to the user
											info "Please select a Batch first to see the available capacity.";
										}
						)
					}
				}

			}
			Requested_Qty as "Requested Qty"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on add or edit

				on user input of Requested_Quantity
				{
					actions 
					{
						custom deluge script
						(
											// On User Input of "Requested Quantity" field
										// Set the default capacity
										default_capacity = 30;
										// Get the total booked quantity for the requested date
										// NOTE: This assumes the "Requested_Date" field has been filled
										booked_count = 0;
										all_requests = Sample_Allocation_Request[Requested_Date == input.Requested_Date];
										for each  request in all_requests
										{
											booked_count = booked_count + request.Requested_Quantity;
										}
										// Calculate the remaining capacity
										remaining_capacity = default_capacity - booked_count;
										// Check if the requested quantity exceeds the remaining capacity
										if(input.Requested_Quantity > remaining_capacity)
										{
											// If the request is too large, show an alert and reset the quantity field
											alert "Sorry, the requested quantity exceeds the remaining balance of " + remaining_capacity + " pcs.";
											input.Requested_Quantity = null;
											// Clear the field
										}
						)
					}
				}

			}
			Delete_Validate1 as "Delete Validate"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// On Delete Script
										// Get the date and quantity of the deleted record
										deleted_date = input.Requested_Date;
										deleted_quantity = input.Requested_Quantity;
										// Get all remaining records for the same date after the deletion
										remaining_requests = Sample_Allocation_Request[Requested_Date == deleted_date];
										// Recalculate the total allocated count for that date
										allocated_count = 0;
										for each  request in remaining_requests
										{
											allocated_count = allocated_count + request.Requested_Quantity;
										}
										// You can now update the "Balance_Available" field if needed, but the validation script will handle it on the next new request.
										// The main fix is ensuring your validation script now correctly recalculates the total count.
										// The existing validation script already does this, so no change is needed there.
						)
					}
				}

			}
			on_edit_validation as "on edit validation"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// On Edit of the Sample Allocation Request Form
										// Check if the Status is being changed to "Approved"
										if(input.Indent_Status == "Approved" && Indent_Status != "Approved")
										{
											// Set the default capacity to 30
											default_capacity = 30;
											// Count the total of all already approved requests for the assigned date
											// Note: Use the assigned date, not the requested date.
											allocated_count = 0;
											all_approved_requests = Sample_Allocation_Request[Assigned_Date == input.Assigned_Date && Indent_Status == "Approved" && ID != input.ID];
											for each  approved_request in all_approved_requests
											{
												allocated_count = allocated_count + approved_request.Assigned_Quantity;
											}
											// Check if the new approval exceeds the total capacity
											if(allocated_count + input.Assigned_Quantity > default_capacity)
											{
												alert "Sorry, not enough capacity. Available for this date: " + (default_capacity - allocated_count) + " pcs.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			On_load1 as "On load"
			{
				type =  form
				form = Sample_Allocation_Request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sample_Request_id != null)
										{
											req = Sample_Request[ID == input.Sample_Request_id];
											if(req.count() > 0)
											{
												Vendor = req.Vendor_Name;
												input.Garment_Type = req.Garment_Type;
												input.Requested_Quantity = req.Requested_Quantity;
												//input.Requested_Date = req.Requested_Date;
												input.Batch_Name = req.Sampling_Capacity1;
												input.Notes_Comments = req.Notes_Comments;
												input.Indent_Status = req.Status;
											}
										}
						)
					}
				}

			}
