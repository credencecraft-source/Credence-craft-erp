			Work_Order_New_C_E_Succes as "Work Order New (C/E)-Success"
			{
				type =  form
				form = Work_Order_New

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ✅ CALCULATE TOTAL WORK ORDER QTY
										totalQty = 0;
										for each  each_size in input.Work_Order_Size_Wise_Qty
										{
											totalQty = totalQty + ifnull(each_size.Work_Order_Qty,0);
										}
										input.Work_Order_Qty = totalQty;
										// ✅ EXISTING FLOW (UNCHANGED)
										for each  each_size in input.Work_Order_Size_Wise_Qty
										{
											thisapp.work_order_controllar.finished_item_work_order_status_update(each_size.Finished_Goods_Size_ID);
										}
										thisapp.order_controllar.work_order_status_update(input.Create_Order);
										// ✅ SAME STYLE AS ABOVE
										thisapp.order_controllar.detectOnlineOrderChanges(input.ID);
						)
					}
				}

			}
			Work_Order_New_Deleted_Va as "Work Order New (Deleted)-Validation"
			{
				type =  form
				form = Work_Order_New

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											info "---- WORK ORDER DELETE START ----";
										woID = input.ID;
										// ======================================================
										// ? RESET SIZE QTY
										// ======================================================
										get_work_order_size = Wo_Order_Size_Wise_Qty[Work_Order_No == woID];
										for each  each_size in get_work_order_size
										{
											each_size.Work_Order_Qty=0;
											thisapp.work_order_controllar.finished_item_work_order_status_update(each_size.Finished_Goods_Size_ID);
										}
										thisapp.order_controllar.work_order_status_update(input.Create_Order);
										delete from Wo_Order_Size_Wise_Qty[Work_Order_No == woID];
										delete from Wo_Order_Size_Wise_Qty[Work_Order_No == null];
										delete from Work_Order_Rawmateril[Work_Order_No == woID];
										delete from Work_Order_Rawmateril[Work_Order_No == null];
										// ======================================================
										// ? DELETE BUNDLE MOVEMENT + GRN
										// ======================================================
										info "Deleting Bundle Movements...";
										delete from Process_Bundle_Movement[Work_Order_New == woID];
										info "Deleting Bundle GRN Records...";
										delete from Process_Bundle_GRN[Work_Order_New == woID];
										// ======================================================
										// ? DELETE WORK ORDER JOB + PROCESS
										// ======================================================
										woProcesses = Wo_Making_Charges[Work_Order == woID];
										for each  proc in woProcesses
										{
											delete from Wo_Making_Charges_Subform[Work_Order_Process_Controller == proc.ID];
										}
										delete from Wo_Making_Charges[Work_Order == woID];
										// ======================================================
										// ? CLEAN ORPHAN RECORDS
										// ======================================================
										delete from Wo_Making_Charges_Subform[Work_Order_Process_Controller == null];
										delete from Wo_Making_Charges[Work_Order == null];
										delete from Process_Bundle_Movement[Work_Order_New == null];
										delete from Process_Bundle_GRN[Work_Order_New == null];
										info "---- WORK ORDER DELETE END ----";
						)
					}
				}

			}
