			success message = "Purchase Order Added Successfully"
			feature property = 512
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Entity_Name
			(
				type = picklist	
				displayname = "Entity Name"
				values  = Entity_Name.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Nature
			(
				type = picklist	
				displayname = "Item Nature"
				values  = Category_Type1.ID
    			displayformat = [Category_Type_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Month_Master
			(
				type = picklist	
				displayname = "Month Master"
				values  = Month_Master.ID
    			displayformat = [Month_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Year_form
			(
				type = picklist	
				displayname = "Year"
				values  = Year_form.ID
    			displayformat = [Year_field]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Date
			(
    			type = date
				displayname = "Delivery Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor_Name
			(
				type = picklist	
				displayname = "Vendor Name"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Tax
			(
				displayname = "Total Tax"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			CGST1
			(
				displayname = "CGST"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			SGST1
			(
				displayname = "SGST"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			IGST1
			(
				displayname = "IGST"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			Show_All1
			(
    			type = checkbox
				displayname = "Show All"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Other_Charges
			(
				displayname = "Other Charges "
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 3   
				width = medium
			)
			Grand_Total
			(
				displayname = "Grand Total"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 3   
				width = medium
			)
			PI_No
			(
    			type = text
				displayname = "PI No"
	 			row = 1
	 			column = 3   
				width = medium
			)
			File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 3   
				width = medium
			)
			Entity_Delivery_Address
			(
				type = picklist	
				displayname = "Entity-Delivery Address"
				values  = Entity_Delivery_Address.ID
    			displayformat = [Warehouse]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			Payment_Terms
			(
				type = picklist	
				displayname = "Payment Terms"
				values  = Payment_Terms.ID
    			displayformat = [Payment_Terms]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			must have Po_Sub_Form
			(
				type = grid
				displayname = "Po-Sub Form"
				values  = Po_Subform.ID
    			bidirectional = Purchase_Order_ID
				auto width = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Po_Terms
			(
    			type = textarea
				displayname = "Po Terms"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Backend_Data
			(
				type = section
				displayname = "Backend Data"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			PO_Support_No
			(
    			type = autonumber
				displayname = "PO Support No"
				start index = 1
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approved_Date_and_Time
			(
    			type = datetime
				displayname = "Approved Date and Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approved_By
			(
    			type = email
				displayname = "Approved By"
				maxchar = 80
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			PO_Number
			(
    			type = formula
				displayname = "PO Number"
				value =  "PO00" + input.PO_Support_No
				visibility = false
				display type = text
				format = plaintext
	 			row = 4
	 			column = 1   
				width = medium
			)
			Issued_Date_And_Time
			(
    			type = date
				displayname = "Issued Date And Time"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Master_Group_ID
			(
				type = list	
				displayname = "Master Group ID"
				values  = Master_Group.ID
    			displayformat = [Auto_Number]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Po_Status
			(
				type = picklist
				displayname = "Po Status"
				maxchar = 100
				values = {"Draft","Approved","Issued","Closed"}
				initial value = "Draft"
	 			row = 4
	 			column = 2   
				width = medium
			)
			must have Po_Type
			(
				type = picklist
				displayname = "Po Type"
				maxchar = 100
				values = {"Against Order","General"}
				initial value = "General"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Po_Created
			(
    			type = date
				displayname = "Po Created"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
			GpoID
			(
				type = list	
				values  = Purchase_Request.ID
    			bidirectional = PO_ID
    			displayformat = [ID]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			must have GRN_Status
			(
				type = picklist
				displayname = "GRN Status"
				maxchar = 100
				values = {"Received","Partially Received","Not Received"}
				initial value = "Not Received"
	 			row = 4
	 			column = 3   
				width = medium
			)
			Vender_Email
			(
    			type = email
				displayname = "Vender Email"
				maxchar = 80
	 			row = 4
	 			column = 3   
				width = medium
				personal data = true
			)
			Budget_Error_Message
			(
    			type = text
	 			row = 4
	 			column = 3   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
				PO
				{
