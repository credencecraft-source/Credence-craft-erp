			GRN_Verification_C_E_Vali as "GRN Verification (C/E)-Validation"
			{
				type =  form
				form = GRN_Verification

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Purchase_Order.Po_Type == "Against Order")
										{
											if(input.Master_Group1 == null)
											{
												alert "Please select master group.";
												cancel submit;
											}
											else if(input.Verification.count() == 0)
											{
												alert "Please select the verification item.";
												cancel submit;
											}
											else
											{
												if(input.ID == null)
												{
													for each  each_item in input.Verification
													{
														sum_of_already_verifyed_qy = GRN_Yet_to_Allocate[Grouping_No == each_item.Grouping_No && GRN_Verification_ID != null].sum(Verification_Allocated);
														total_sum_of_already_verified_qty = sum_of_already_verifyed_qy + ifnull(each_item.Verification_Allocated,0);
														if(total_sum_of_already_verified_qty > each_item.Grouping_No.Total_Grouped_Qty)
														{
															balance_allocate_qty = ifnull(each_item.Grouping_No.Total_Grouped_Qty,0) - sum_of_already_verifyed_qy;
															alert "Sorry, The purchase grouping available to allocate qty is " + balance_allocate_qty;
															cancel submit;
															break;
														}
														if(Grouped_Allocated != Available_To_Allocate)
														{
															alert "Available To Allocate and Grouped Allocated should be equal.";
															cancel submit;
															break;
														}
													}
												}
											}
										}
						)
					}
				}

			}
