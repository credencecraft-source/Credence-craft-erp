			On_validate as "On validate"
			{
				type =  form
				form = Employee_Name

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID != null)
										{
											refList = List();
											for each  p in Payout
											{
												if(p.Source != "Hr" || p.Status == "Paid")
												{
													continue;
												}
												for each  line in p.Payout_Lines
												{
													if(line.Reference_ID != null)
													{
														pr = Payroll[ID == line.Reference_ID.toLong()];
														if(pr.ID != null && pr.Employee_Name == input.ID)
														{
															refList.add("Payout ID : " + p.ID);
															break;
														}
													}
												}
											}
											if(refList.size() > 0)
											{
												msg = "Cannot edit Account No / IFSC.\nPending payout requests:\n";
												for each  r in refList.distinct()
												{
													msg = msg + r + "\n";
												}
												alert msg;
												cancel submit;
											}
										}
						)
					}
				}

			}
			On_Validate_on_Submit as "On Validate on Submit"
			{
				type =  form
				form = Employee_Name

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											refList = List();
										for each  p in Payout
										{
											if(p.Source != "Hr" || p.Status == "Paid")
											{
												continue;
											}
											for each  line in p.Payout_Lines
											{
												if(line.Reference_ID != null)
												{
													pr = Payroll[ID == line.Reference_ID.toLong()];
													if(pr.ID != null && pr.Employee_Name == input.ID)
													{
														refList.add("Payout ID : " + p.ID);
														break;
													}
												}
											}
										}
										if(refList.size() > 0)
										{
											msg = "Cannot delete Employee.\nPending payout requests:\n";
											for each  r in refList.distinct()
											{
												msg = msg + r + "\n";
											}
											alert msg;
											cancel delete;
										}
						)
					}
				}

			}
