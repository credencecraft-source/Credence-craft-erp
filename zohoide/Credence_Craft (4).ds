			Auto_Fill_Excess as "Auto Fill Excess"
			{
				type =  form
				form = Create_Order

				record event = on add

				on user input of Exces
				{
					actions 
					{
						custom deluge script
						(
											brand_rec = Brand1[ID == input.Brand];
										max_excess = 0;
										if(brand_rec != null)
										{
											max_excess = ifnull(brand_rec.Maximum_Allowed_Excess1,0);
										}
										if(input.Exces < 0 || input.Exces > max_excess)
										{
											alert "Maximum allowed excess for this Brand is " + max_excess + "%";
											input.Exces = null;
											return;
										}
										sum_order_qty = 0;
										for each  rec in input.Finished_Goods_Size_wise
										{
											rec.Excess=input.Exces;
											rec.Excess_Qty=(ifnull(rec.Before_Excess_Qty,0) * ifnull(rec.Excess,0)) / 100;
											rec.Total_Qty=ifnull(rec.Before_Excess_Qty,0) + ifnull(rec.Excess_Qty,0);
											sum_order_qty = sum_order_qty + ifnull(rec.Total_Qty,0);
										}
										input.Order_Qty = sum_order_qty;
										input.Order_Value = ifnull(input.Fob,0) * ifnull(input.Order_Qty,0);
						)
					}
				}

			}
