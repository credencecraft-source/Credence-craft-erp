				 void fetchGSTDetails(map rec)
                 {
                 	if(rec.get("Fetch_Address") == true)
                 	{
                 		if(rec.get("Gst_No") != null && rec.get("Gst_No").length() == 15)
                 		{
                 			resp = invokeurl
                 			[
                 				url :"https://sheet.gstincheck.co.in/check/866b7fa68c374dce92f9e5d02583661f/" + rec.get("Gst_No")
                 				type :GET
                 			];
                 			if(resp != null && resp.get("flag") == true)
                 			{
                 				data = resp.get("data");
                 				if(data.get("tradeNam") != null && data.get("tradeNam") != "")
                 				{
                 					rec.put("Vendor_Name",data.get("tradeNam"));
                 				}
                 				pradr = data.get("pradr");
                 				if(pradr != null)
                 				{
                 					fullAddr = pradr.get("adr");
                 					if(fullAddr != null)
                 					{
                 						addrList = fullAddr.toList(",");
                 						line1 = "";
                 						line2 = "";
                 						count = 0;
                 						for each  item in addrList
                 						{
                 							if(count <= 2)
                 							{
                 								line1 = line1 + item.trim() + ", ";
                 							}
                 							else
                 							{
                 								line2 = line2 + item.trim() + ", ";
                 							}
                 							count = count + 1;
                 						}
                 						line1 = line1.trim();
                 						if(line1.length() > 2)
                 						{
                 							line1 = line1.subString(0,line1.length() - 2);
                 						}
                 						line2 = line2.trim();
                 						if(line2.length() > 2)
                 						{
                 							line2 = line2.subString(0,line2.length() - 2);
                 						}
                 						addrMap = Map();
                 						addrMap.put("address_line_1",line1);
                 						addrMap.put("address_line_2",line2);
                 						addr = pradr.get("addr");
                 						if(addr != null)
                 						{
                 							addrMap.put("district_city",addr.get("dst"));
                 							addrMap.put("state_province",addr.get("stcd"));
                 							addrMap.put("postal_Code",addr.get("pncd"));
                 							addrMap.put("country","India");
                 							rec.put("City1",addr.get("dst"));
                 							stateName = addr.get("stcd");
                 							if(stateName != null)
                 							{
                 								stateRec = customer_s_registered_Gst_State[customer_s_registered_Gst_State == stateName];
                 								if(stateRec != null)
                 								{
                 									rec.put("Registered_Gst_State",stateRec.ID);
                 								}
                 								else
                 								{
                 									info "⚠️ State not found: " + stateName;
                 								}
                 							}
                 						}
                 						rec.put("Vendor_Registered_GST_Address",addrMap);
                 					}
                 				}
                 				if(rec.get("Entity_Name") != null && rec.get("Registered_Gst_State") != null)
                 				{
                 					entityRec = Entity_Name[ID == rec.get("Entity_Name")];
                 					if(entityRec != null && entityRec.Entity_Gst_Registered_State != null)
                 					{
                 						if(entityRec.Entity_Gst_Registered_State.ID == rec.get("Registered_Gst_State"))
                 						{
                 							gstTypeRec = GST_TYPE[gst_type == "CGST & SGST"];
                 						}
                 						else
                 						{
                 							gstTypeRec = GST_TYPE[gst_type == "IGST"];
                 						}
                 						if(gstTypeRec != null)
                 						{
                 							rec.put("New_GST_Type",gstTypeRec.ID);
                 						}
                 					}
                 				}
                 				info "✅ GST + GST TYPE FILLED";
                 			}
                 			else
                 			{
                 				info "❌ GST NOT FOUND";
                 				info resp;
                 			}
                 			rec.put("Fetch_Address",false);
                 		}
                 	}
                 }
				 string filterRawMaterial(bool branded, int subcatId, int brandId)
                 {
                 	if(branded)
