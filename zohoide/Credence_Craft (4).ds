			Subcategory_Deleted_Valid as "Subcategory (Deleted)-Validation"
			{
				type =  form
				form = Subcategory1

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_raw_material = Raw_Material1[Subcategory == input.ID];
										get_order_costin = Order_Raw_material[Subcategory == input.ID];
										get_price_list_vendor = Vendor_Wise_Price_List[Subcategory_Name == input.ID];
										if(get_raw_material.ID != null)
										{
											alert "Found a Raw Material associated with this Subcategory so, please delete the Raw Material first.";
											cancel delete;
										}
										if(get_price_list_vendor.ID != null)
										{
											alert "Found a Vendor Price List associated with this Subcategory so, please delete the Vendor Price List first.";
											cancel delete;
										}
										else if(get_order_costin.ID != null)
										{
											alert "Found a Costing associated with this Subcategory so, please delete the Costing first.";
											cancel delete;
										}
						)
					}
				}

			}
