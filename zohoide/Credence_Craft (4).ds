											{
												row.Stock_UOM_Price=ifnull(row.Price,0) / ifnull(row.Buying_In.Convert,0);
											}
											else
											{
												row.Stock_UOM_Price=0;
											}
										}
										else
										{
											row.Stock_UOM_Price=row.Price;
										}
						)
					}
				}

			}
