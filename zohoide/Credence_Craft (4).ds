			Ratio as "Ratio"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Ratio
				{
					actions 
					{
						custom deluge script
						(
											if(input.Size_Group != null && input.Ratio_Order_Qty != null)
										{
											total_ratio = 0;
											for each  r1 in input.Finished_Goods_Size_wise
											{
												total_ratio = total_ratio + ifnull(r1.Ratio,0);
											}
											if(total_ratio == 0)
											{
												return;
											}
											unit_qty = input.Ratio_Order_Qty / total_ratio;
											for each  r2 in input.Finished_Goods_Size_wise
											{
												before_qty = (ifnull(r2.Ratio,0) * unit_qty).toLong();
												r2.Before_Excess_Qty=before_qty;
												excess_qty = 0;
												total_qty = before_qty;
												if(input.Exces != null)
												{
													excess_qty = ((before_qty * input.Exces) / 100).toLong();
													total_qty = before_qty + excess_qty;
												}
												r2.Excess_Qty=excess_qty;
												r2.Total_Qty=total_qty;
											}
											total_order_qty = 0;
											total_before_qty = 0;
											for each  fg in input.Finished_Goods_Size_wise
											{
												total_order_qty = total_order_qty + ifnull(fg.Total_Qty,0);
												total_before_qty = total_before_qty + ifnull(fg.Before_Excess_Qty,0);
											}
											input.Order_Qty = total_order_qty;
											input.Order_Qty_with_out_Excess = total_before_qty;
										}
						)
					}
				}

			}
			on_input as "on input"
			{
				type =  form
				form = Vendor1

				record event = on add or edit

				on user input of Gst_No
				{
					actions 
					{
						custom deluge script
						(
											if(input.Fetch_Address == true && input.Gst_No != null && input.Gst_No.length() == 15)
										{
											resp = invokeurl
											[
												url :"https://sheet.gstincheck.co.in/check/866b7fa68c374dce92f9e5d02583661f/" + input.Gst_No
												type :GET
											];
											if(resp.get("flag") == true)
											{
												data = resp.get("data");
												// NAME
												if(data.get("tradeNam") != null)
												{
													input.Vendor_Name = data.get("tradeNam");
												}
												pradr = data.get("pradr");
												if(pradr != null)
												{
													fullAddr = pradr.get("adr");
													if(fullAddr != null)
													{
														addrList = fullAddr.toList(",");
														// ===== LINE 1 =====
														if(addrList.size() > 0)
														{
															input.Vendor_Registered_GST_Address.address_line_1 = addrList.get(0).trim();
														}
														// ===== LINE 2 =====
														if(addrList.size() > 1)
														{
															line2 = "";
															for each  item in addrList.subList(1,addrList.size())
															{
																line2 = line2 + item.trim() + ", ";
															}
															input.Vendor_Registered_GST_Address.address_line_2 = line2.trim();
														}
													}
													addr = pradr.get("addr");
													if(addr != null)
													{
														input.Vendor_Registered_GST_Address.district_city = addr.get("dst");
														input.Vendor_Registered_GST_Address.state_province = addr.get("stcd");
														input.Vendor_Registered_GST_Address.postal_Code = addr.get("pncd");
														input.Vendor_Registered_GST_Address.country = "India";
														input.City1 = addr.get("dst");
													}
												}
												info "✅ ADDRESS SPLIT + FILLED";
											}
											input.Fetch_Address = false;
										}
						)
					}
				}

			}
