			Order_No_In_Order_Raw_Mat as "Order No In Order Raw Materail"
			{
				type =  form
				form = Order_Raw_material

				record event = on add or edit

				on user input of Order_No
				{
					actions 
					{
						custom deluge script
						(
											input.Season = input.Order_No.Season;
										input.Gold_Seal = input.Order_No.Article;
										input.Brand1 = input.Order_No.Brand;
										input.Style_Name = input.Order_No;
										input.Is_Size_Mapped = false;
										if(input.Order_No != null)
										{
											if(input.Size.Size() > 0)
											{
												sum_order_qty = Finished_Goods_Size_wise[Order_No == input.Order_No && Size == input.Size].sum(Total_Qty);
											}
											else
											{
												sum_order_qty = input.Order_No.Order_Qty;
											}
										}
										else
										{
											sum_order_qty = 0;
										}
										input.Sum_of_Size_wise_qty = sum_order_qty;
										input.Required_Qty = ifnull(input.Internal_Consumption,0) * ifnull(input.Sum_of_Size_wise_qty,0);
										input.Item_Wise_Excess_qty = ifnull(input.Required_Qty,0) * ifnull(input.Item_Wise_Excess_Persentage1,0) / 100;
										input.Total_Required_Qty = ifnull(input.Item_Wise_Excess_qty,0) + ifnull(input.Required_Qty,0);
						)
					}
				}

			}
			Size_in_Order_Raw_Materia as "Size in Order Raw Material"
			{
				type =  form
				form = Order_Raw_material

				record event = on add or edit

				on user input of Size
				{
					actions 
					{
						custom deluge script
						(
											input.Is_Size_Mapped = false;
										if(input.Order_No != null)
										{
											if(input.Size.Size() > 0)
											{
												sum_order_qty = Finished_Goods_Size_wise[Order_No == input.Order_No && Size == input.Size].sum(Total_Qty);
												input.Is_Size_Mapped = true;
											}
											else
											{
												sum_order_qty = input.Order_No.Order_Qty;
											}
										}
										else
										{
											sum_order_qty = 0;
										}
										input.Sum_of_Size_wise_qty = sum_order_qty;
										input.Required_Qty = ifnull(input.Internal_Consumption,0) * ifnull(input.Sum_of_Size_wise_qty,0);
										input.Item_Wise_Excess_qty = ifnull(input.Required_Qty,0) * ifnull(input.Item_Wise_Excess_Persentage1,0) / 100;
										input.Total_Required_Qty = ifnull(input.Item_Wise_Excess_qty,0) + ifnull(input.Required_Qty,0);
						)
					}
				}

			}
