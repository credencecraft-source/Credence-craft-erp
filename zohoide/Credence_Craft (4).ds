			Show_Tax as "Show Tax"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Show_Tax
				{
					actions 
					{
						custom deluge script
						(
											// On User Input of Show_Tax (checkbox in main form)
										if(input.Show_Tax == true)
										{
											gst_type = "";
											if(input.Customer_Name != null)
											{
												vendor_rec = Vendor1[ID == input.Customer_Name];
												if(vendor_rec.count() > 0)
												{
													gst_type = vendor_rec.New_GST_Type.gst_type;
												}
											}
											if(gst_type == "CGST & SGST")
											{
												// --- Subform fields ---
												show Sales_Invoice_Subform.CGST;
												show Sales_Invoice_Subform.SGST;
												hide Sales_Invoice_Subform.IGST;
												show Sales_Invoice_Subform.Tax;
												// --- Header fields ---
												show CGST;
												show SGST;
												hide IGST;
												show Total_Tax;
											}
											else if(gst_type == "IGST")
											{
												// --- Subform fields ---
												hide Sales_Invoice_Subform.CGST;
												hide Sales_Invoice_Subform.SGST;
												show Sales_Invoice_Subform.IGST;
												show Sales_Invoice_Subform.Tax;
												// --- Header fields ---
												hide CGST;
												hide SGST;
												show IGST;
												show Total_Tax;
											}
											else
											{
												// --- Subform fields ---
												show Sales_Invoice_Subform.CGST;
												show Sales_Invoice_Subform.SGST;
												show Sales_Invoice_Subform.IGST;
												show Sales_Invoice_Subform.Tax;
												// --- Header fields ---
												show CGST;
												show SGST;
												show IGST;
												show Total_Tax;
											}
										}
										else
										{
											// --- Subform fields ---
											hide Sales_Invoice_Subform.CGST;
											hide Sales_Invoice_Subform.SGST;
											hide Sales_Invoice_Subform.IGST;
											hide Sales_Invoice_Subform.Tax;
											// --- Header fields ---
											hide CGST;
											hide SGST;
											hide IGST;
											hide Total_Tax;
										}
						)
					}
				}

			}
