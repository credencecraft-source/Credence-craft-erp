			User_Input as "User Input"
			{
				type =  form
				form = Process_Bundle_Movement

				record event = on add

				on user input of Process_Master
				{
					actions 
					{
						custom deluge script
						(
											// Clear subform & header qty
										clear Operation_Wise_Bundles;
										input.Issued = 0;
										// From = current process
										input.From = input.Process_Master;
										// Safety check
										if(input.Order_No == null || input.Process_Master == null)
										{
											return;
										}
										// -------- FIND NEXT PROCESS USING Process_No ----------
										currProcRec = Order_Process_Controler[Order_No == input.Order_No && Process_Name == input.Process_Master];
										if(currProcRec != null)
										{
											currSL = currProcRec.Process_No;
											nextSL = currSL + 1;
											nextProcRec = Order_Process_Controler[Order_No == input.Order_No && Process_No == nextSL];
											if(nextProcRec != null)
											{
												input.To = nextProcRec.Process_Name;
											}
										}
										// -------- FETCH FROM JOB ORDER (SUBFORM ONLY) ----------
										totalQty = 0;
										tasks = Wo_Making_Charges_Subform[Order_No == input.Order_No && Process_Name == input.Process_Master];
										for each  t in tasks
										{
											row = Process_Bundle_Movement.Operation_Wise_Bundles();
											row.Order_No=t.Order_No;
											row.Brand1=t.Brand1;
											row.Style_No=t.Style_Name;
											row.Date_field=zoho.currentdate;
											row.Employee_Name=null;
											row.Process_Name=t.Process_Name;
											row.Operation=t.Operation;
											// Qty from Job Order
											row.Qty_To_be_Produced=toLong(ifnull(t.Operation_Wise_Qty_To_be_Produced,0));
											// ----- YOUR CODE ADDED -----
											row.Vendor=input.Vendor1;
											row.Bundles_From=input.From;
											row.Bundles_To=input.To;
											row.Issued=input.Issued;
											// ---------------------------
											row.Process_Bundle_Movement=input.ID;
											rows = Collection();
											rows.insert(row);
											input.Operation_Wise_Bundles.insert(rows);
											totalQty = totalQty + toLong(ifnull(t.Operation_Wise_Qty_To_be_Produced,0));
										}
										// Header qty = sum of subform
										input.Issued = totalQty;
						)
					}
				}

			}
