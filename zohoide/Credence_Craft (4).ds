			Purchase_Order_C_E_Field_ as "Purchase Order (C/E)-Field Rules"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Po_Status,Total,Tax,Grand_Total,IGST1,CGST1,SGST1,Other_Charges,Po_Type;
					}
					actions 
					{
						hide Backend_Data;
