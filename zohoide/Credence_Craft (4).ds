		form Job_Order_Bill
		{
			displayname = "Job Order Bill"
			success message = "Job Order Bill Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Approved"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Created_date
			(
    			type = date
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Name
			(
				type = picklist	
				displayname = "Employee Name"
				values  = Employee_Name.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Job_Order_Bill
			(
				type = picklist	
				displayname = "Job Order Bill"
				values  = Job_Order_Bill.ID
    			displayformat = [JOBBILL]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			JOBBILL
			(
    			type = formula
				value =  "JOBILL" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 2
	 			column = 1   
				width = medium
			)
			SubForm
			(
				type = grid
				values  = job_order_bill_subform.ID
    			bidirectional = Job_Order_Bill
				auto width = false
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form job_order_bill_subform
		{
			displayname = "job order bill subform"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Bundle_No
			(
				type = picklist	
				displayname = "Bundle No"
				values  = Bundle_transfer_GRN_subform.ID
    			displayformat = [Bundle_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 100px
			)
			Order_No
			(
				type = picklist	
				displayname = "Order No"
				values  = Create_Order.ID
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Style_name
			(
				type = picklist	
				displayname = "Style"
				values  = Create_Order.ID
    			displayformat = [Style_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Process_Master
			(
				type = picklist	
				displayname = "Process Master"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Operation
			(
				type = picklist	
				values  = Operation.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Job_Work_GRN_ID
			(
				type = picklist	
				values  = Job_Work_GRN.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Job_Order_Bill
			(
				type = picklist	
				displayname = "Job Order Bill"
				values  = Job_Order_Bill.ID
    			bidirectional = SubForm
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Total
			(
				type = number
				displayname = "Qty"
	 			row = 1
	 			column = 2   
				width = 80px
			)
			Price
			(
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = 80px
			)
			Total_Before_Gst1
			(
				displayname = "Total Before Gst"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = medium
			)
			GST_Percentage
			(
				type = picklist	
				values  = Gst.ID
    			displayformat = [Gst]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_With_Gst
			(
				displayname = "Total With Gst"
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = medium
			)
			Bill_Ref_ID
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Work_GRN
		{
			displayname = "Job Work GRN"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			GRN
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Order_No
			(
				type = picklist	
				displayname = "Order No"
				values  = Create_Order.ID
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Create_Order
			(
				type = picklist	
				values  = Create_Order.ID
    			displayformat = [Style_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			GST_Percentage
			(
				type = picklist	
				displayname = "GST_Percentage "
				values  = Gst.ID
    			displayformat = [Gst]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Vendor
			(
				type = picklist	
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Employee_Name
			(
				type = picklist	
				displayname = "Employee Name"
				values  = Employee_Name.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Process_Master
			(
				type = picklist	
				displayname = "Process Master"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Operation
			(
				type = picklist	
				values  = Operation.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Price
			(
				type = USD
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = medium
			)
			Cut_Qty
			(
				type = number
				displayname = "Cut Qty"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 2   
				width = medium
			)
			JOBGRN
			(
    			type = formula
				value =  "JOBGRN" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 2
