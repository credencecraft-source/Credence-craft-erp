			On_load_New as "On load New"
			{
				type =  form
				form = Create_Order

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ===== DEFAULT MORE UNCHECK =====
										input.More = false;
										hide Process_Template;
										hide Access_Size_Wise_Excess;
										hide Exces;
										hide Fob;
										hide Fob_Not_Finalized;
										hide Order_volume;
										hide Import;
										hide Buyer_Po_Date1;
										hide Buyer_Po_No1;
										hide Gst;
										hide QR_Code;
										hide Order_Qty_with_out_Excess;
										hide Hsn_Code;
										hide Image;
										hide Order_Value;
										// ===== EXISTING CODE =====
										if(input.Import != null)
										{
											input.Type_field = input.Import.Type_field;
											input.Entity_Name = input.Import.Entity_Name;
											input.Brand = input.Import.Brand;
											input.Buyer1 = input.Import.Buyer1;
											input.Season = input.Import.Season;
											input.Article = input.Import.Article;
											input.Delivery_Date = input.Import.Delivery_Date;
											input.Style_Name = input.Import.Style_Name;
											input.Catagery = input.Import.Catagery;
											input.Sub_Catagery = input.Import.Sub_Catagery;
											input.Process_Template = input.Import.Process_Template;
											//input.Size_Group = input.Import.Size_Group;
											input.Fob = input.Import.Fob;
											input.Fob_Not_Finalized = input.Import.Fob_Not_Finalized;
											input.Order_Value = input.Import.Order_Value;
											input.Order_Qty = input.Import.Order_Qty;
											input.Order_Qty_with_out_Excess = input.Import.Order_Qty_with_out_Excess;
											input.Exces = input.Import.Exces;
											input.Merchandiser = input.Import.Merchandiser;
											input.Order_volume = input.Import.Order_volume;
											input.Gst = input.Import.Gst;
											input.Hsn_Code = input.Import.Hsn_Code;
											input.Show_all = false;
											disable Finished_Goods_Size_wise.Excess_Qty;
											disable Finished_Goods_Size_wise.Total_Qty;
											disable Finished_Goods_Size_wise.Currency_Type;
										}
										/* Ratio Field Control */
										if(input.have_Size_Ratio == true)
										{
											show Ratio_Order_Qty;
										}
										else
										{
											hide Ratio_Order_Qty;
											input.Ratio_Order_Qty = null;
										}
						)
					}
				}

			}
			Type_workflow as "Type"
			{
				type =  form
				form = Create_Order

				record event = on add
					status = inactive

				on user input of Type_field
				{
					actions 
					{
						custom deluge script
						(
											// ===== Reset (Hide & Disable All First) =====
										disable Order_Qty;
										disable Order_Value;
										disable Brand;
										disable Buyer1;
										disable Fob;
										hide Order_Value;
										hide Order_Qty;
										hide Article;
										hide Brand;
										hide Buyer1;
										hide Season;
										hide Import;
										hide Eo_No_and_Name;
										hide Fob;
										hide Fob_Not_Finalized;
										hide Style_Name;
										hide Delivery_Date;
										hide Merchandiser;
										hide Size_Group;
										hide Sub_Catagery;
										hide Exces;
										hide Access_Size_Wise_Excess;
										hide Finished_Goods_Size_wise;
										//clear Gold_Seal;
										// ===== Conditional Rules =====
										// If Direct
										if(input.Type_field == "Direct")
										{
											// Disable type field after selection
											disable Type_field;
											show Brand;
											show Buyer1;
											show Delivery_Date;
											show Exces;
											show Fob;
											show Fob_Not_Finalized;
											show Article;
											show Import;
											show Order_Qty;
											show Order_Value;
											show Style_Name;
											show Size_Group;
											show Access_Size_Wise_Excess;
											show Merchandiser;
											show Sub_Catagery;
											show Season;
											enable Buyer1;
											enable Brand;
											enable Article;
											enable Season;
											// Show Finished Goods subform ONLY if Size Group selected
											if(input.Size_Group != null)
											{
												show Finished_Goods_Size_wise;
											}
										}
										// If Bulk
										if(input.Type_field == "Bulk")
										{
											// Disable type field after selection
											disable Type_field;
											show Brand;
											show Buyer1;
											show Delivery_Date;
											show Eo_No_and_Name;
											show Exces;
											show Fob;
											show Fob_Not_Finalized;
											show Article;
											show Import;
											show Order_Qty;
											show Order_Value;
											show Style_Name;
											show Size_Group;
											show Access_Size_Wise_Excess;
											show Merchandiser;
											show Sub_Catagery;
											show Season;
											// Show Finished Goods subform ONLY if Size Group selected
											if(input.Size_Group != null)
											{
												show Finished_Goods_Size_wise;
											}
										}
						)
					}
				}

			}
