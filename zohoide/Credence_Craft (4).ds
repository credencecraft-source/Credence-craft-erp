			Item_Name_Auto_Creation as "Item Name Auto Creation"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  row in input.Sales_Invoice_Subform
										{
											text_val = "";
											// Order No (display value from lookup)
											if(row.Order_No != null)
											{
												text_val = row.Order_No.Order_No;
											}
											// Style Name
											if(row.Style_Name != null)
											{
												if(text_val != "")
												{
													text_val = text_val + " - ";
												}
												text_val = text_val + row.Style_Name;
											}
											// Remarks
											if(row.Remarks != null)
											{
												if(text_val != "")
												{
													text_val = text_val + " - ";
												}
												text_val = text_val + row.Remarks;
											}
											row.Item=text_val;
										}
						)
					}
				}

			}
