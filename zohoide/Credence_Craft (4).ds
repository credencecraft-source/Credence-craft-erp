			Price as "Price"
			{
				type =  form
				form = Invoice

				record event = on add or edit

				on user input of Sales_Invoice_Subform.Price
				{
					actions 
					{
						custom deluge script
						(
											// --- ROW LEVEL CALCULATION ---
										// 1) Calculate row total
										row.Total=ifnull(row.Qty,0) * ifnull(row.Price,0);
										// 2) Fetch GST percent from lookup
										gst_percent = 0;
										if(row.Gst != null)
										{
											gst_rec = Gst[ID == row.Gst];
											if(gst_rec.count() > 0)
											{
												gst_percent = ifnull(gst_rec.Gst,0);
											}
										}
										// 3) Row Tax & With GST
										row.Tax=(row.Total * gst_percent) / 100;
										row.With_Gst=row.Total + row.Tax;
										// 4) Vendor GST type from header
										vendor_gst_type = "";
										if(input.Customer_Name != null)
										{
											vendor_rec = Vendor1[ID == input.Customer_Name];
											if(vendor_rec.count() > 0)
											{
												vendor_gst_type = vendor_rec.New_GST_Type.gst_type;
											}
										}
										// 5) Split Tax based on GST type
										if(vendor_gst_type == "CGST & SGST")
										{
											row.CGST=row.Tax / 2;
											row.SGST=row.Tax / 2;
											row.IGST=0;
										}
										else if(vendor_gst_type == "IGST")
										{
											row.CGST=0;
											row.SGST=0;
											row.IGST=row.Tax;
										}
										else
										{
											row.CGST=0;
											row.SGST=0;
											row.IGST=0;
										}
										// --- HEADER LEVEL CALCULATION ---
										// Reset totals
										header_total = 0;
										header_tax = 0;
										header_cgst = 0;
										header_sgst = 0;
										header_igst = 0;
										// Loop through all subform rows
										for each  subrow in input.Sales_Invoice_Subform
										{
											header_total = header_total + ifnull(subrow.Total,0);
											header_tax = header_tax + ifnull(subrow.Tax,0);
											header_cgst = header_cgst + ifnull(subrow.CGST,0);
											header_sgst = header_sgst + ifnull(subrow.SGST,0);
											header_igst = header_igst + ifnull(subrow.IGST,0);
										}
										// Push to header fields
										input.Total = header_total;
										input.Total_Tax = header_tax;
										input.CGST = header_cgst;
										input.SGST = header_sgst;
										input.IGST = header_igst;
										// Add Other_Charges (entered by user at header)
										other_charges = ifnull(input.Other_Charges,0);
										// Final Grand Total
										input.Grand_Total = header_total + header_tax + other_charges;
						)
					}
				}

			}
