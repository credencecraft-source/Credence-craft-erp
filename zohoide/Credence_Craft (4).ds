			Costing_Deleted_Validatio as "Costing (Deleted)-Validation"
			{
				type =  form
				form = Costing

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_purchase_grpup = Grouping_Purchase_Request[Order_Number.contains(input.ID)];
										if(get_purchase_grpup.ID != null)
										{
											alert "Found a Purchase Grouping associated with this Costing so, please delete the Purchase Grouping first.";
											cancel delete;
										}
										else
										{
											delete from Order_Cost_Center[Costing_ID == input.ID];
											delete from Order_Cost_Center[Costing_ID == null];
											delete from Costing_History[Costing_ID == input.ID];
											delete from Costing_History[Costing_ID == null];
											delete from Increase_Cost_Subform[In_Crease_Budgeted_Cost_Sunform_ID.Create_Order == input.Order_No];
											delete from In_Crease_Budgeted_Cost[Create_Order == input.Order_No];
											delete from In_Crease_Budgeted_Cost[Create_Order == null];
											delete from Increase_Cost_Subform[In_Crease_Budgeted_Cost_Sunform_ID.Create_Order == null];
										}
						)
