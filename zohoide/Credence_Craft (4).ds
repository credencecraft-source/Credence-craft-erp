		form PACKING_LIST_GRN_SUBFORM
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity_Delivery_Address
			(
				type = picklist	
				displayname = "Entity-Delivery Address"
				values  = Entity_Delivery_Address.ID
    			displayformat = [" " + Entity_Delivery_Address.address_line_1 + " " + Entity_Delivery_Address.address_line_2 + " " + Entity_Delivery_Address.district_city + " " + Entity_Delivery_Address.state_province]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Warehouse_Location
