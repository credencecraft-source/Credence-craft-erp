				type =  form
				form = PK_GRN

				record event = on add

				on user input of Packing_List_Header
				{
					actions 
					{
						custom deluge script
						(
											if(input.Packing_List_Header != null)
										{
											// clear old rows
											input.SubForm.clear();
											// fetch packing list rows
											rows = Packing_List[Packing_List_Header == input.Packing_List_Header];
											newRows = Collection();
											for each  r in rows
											{
												row = PK_GRN.SubForm();
												row.Packing_List_Header=r.Packing_List_Header;
												row.Vendor1=r.Packing_List_Header.Vendor1;
												row.OUTER_CARTON=r.OUTER_CARTON1;
												row.SIZE=r.Size;
												row.size_details=r.Size_Detail;
												row.Qty=r.Qty;
												newRows.insert(row);
											}
											input.SubForm.insert(newRows);
										}
						)
					}
				}

			}
			Size_wise_concemption as "Size wise concemption"
			{
				type =  form
				form = Add_Quick_RawMaterial

				record event = on add or edit

				on user input of Raw_Material_List.Raw_Material_Name
				{
					actions 
					{
						custom deluge script
						(
											if(row.Raw_Material_Name != null && row.Raw_Material_Name.Size_Wise_Concemption == true)
										{
											show row.Size_Wise_Consemption_Master;
											category_id = 0;
											subcategory_id = 0;
											is_first = true;
											for each  each_order in input.Order_No
											{
												get_order = Create_Order[ID == each_order.ID];
												if(is_first)
												{
													category_id = get_order.Catagery.ID;
													subcategory_id = get_order.Sub_Catagery.ID;
													is_first = false;
												}
												else
												{
													if(category_id != get_order.Catagery.ID || subcategory_id != get_order.Sub_Catagery.ID)
													{
														alert "Selected Orders must have same Category and Sub Category for Size Wise Consumption Raw Materials.";
														row.Raw_Material_Name=null;
														hide row.Size_Wise_Consemption_Master;
														break;
													}
												}
											}
										}
										else
										{
											hide row.Size_Wise_Consemption_Master;
										}
						)
					}
				}

			}
			Size_wise_consemption as "Size wise consemption"
			{
				type =  form
				form = Add_Quick_RawMaterial

				record event = on add or edit

				on user input of Raw_Material_List.Size_Wise_Consemption_Master
				{
					actions 
					{
						custom deluge script
						(
											if(row.Raw_Material_Name != null)
										{
											get_rm = Raw_Material1[ID == row.Raw_Material_Name];
											if(get_rm.Size_Wise_Concemption == true)
											{
												row.Size_Wise_Consemption_Master=get_rm.Size_Wise_Consemption_Master;
												if(row.Size_Wise_Consemption_Master != null)
												{
													category_id = 0;
													subcategory_id = 0;
													is_first = true;
													for each  each_order in input.Order_No
													{
														get_order = Create_Order[ID == each_order.ID];
														if(is_first)
														{
															category_id = get_order.Catagery.ID;
															subcategory_id = get_order.Sub_Catagery.ID;
															is_first = false;
														}
														else
														{
															if(category_id != get_order.Catagery.ID || subcategory_id != get_order.Sub_Catagery.ID)
															{
																alert "Selected Orders must have same Category and Sub Category for Size Wise Consumption Raw Materials.";
																row.Size_Wise_Consemption_Master=null;
																break;
															}
														}
													}
													if(row.Size_Wise_Consemption_Master != null)
													{
														get_bom = Size_Wise_Consemption_Master[ID == row.Size_Wise_Consemption_Master];
														total_consumption = 0;
														size_count = 0;
														for each  each_row in get_bom.SubForm
														{
															total_consumption = total_consumption + each_row.Consemption;
															size_count = size_count + 1;
														}
														if(size_count > 0)
														{
															row.Consumption=total_consumption / size_count;
														}
													}
												}
											}
											else
											{
												row.Size_Wise_Consemption_Master=null;
											}
										}
						)
					}
				}

			}
