			UOM_Convert_in_Master_Gro as "UOM Convert in Master Group"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Uom_Convert
				{
					actions 
					{
						custom deluge script
						(
											input.Convert_Value = input.Uom_Convert.Convert;
										if(input.Convert_Value > 0)
										{
											input.Buying_Qty1 = ifnull(input.Grouped_Qty,0) / ifnull(input.Convert_Value,0);
											if(input.Round_of == true)
											{
												input.After_Round_Of = input.Buying_Qty1.ceil();
											}
											else
											{
												input.After_Round_Of = input.Buying_Qty1;
											}
											input.Difference_Round_Off_Buying_Qty = ifnull(input.After_Round_Of,0) - ifnull(input.Buying_Qty1,0);
											input.MOQ_Buying = ifnull(input.Moq_stock_Uom,0) / ifnull(input.Convert_Value,0);
											input.Extra_In_Buying_Uom = ifnull(input.MOQ_Buying,0) + ifnull(input.Difference_Round_Off_Buying_Qty,0);
											input.Buying_Qty_Total = ifnull(input.Buying_Qty1,0) + ifnull(input.Extra_In_Buying_Uom,0);
										}
						)
					}
				}

			}
			Round_of_in_Master_Group as "Round of in Master Group"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Round_of
				{
					actions 
					{
						custom deluge script
						(
											if(input.Round_of == true)
										{
											input.After_Round_Of = input.Buying_Qty1.ceil();
										}
										else
										{
											input.After_Round_Of = input.Buying_Qty1;
										}
										input.Difference_Round_Off_Buying_Qty = ifnull(input.After_Round_Of,0) - ifnull(input.Buying_Qty1,0);
										if(input.Convert_Value > 0)
										{
											input.MOQ_Buying = ifnull(input.Moq_stock_Uom,0) / ifnull(input.Convert_Value,0);
										}
										else
										{
											input.MOQ_Buying = 0;
										}
										input.Extra_In_Buying_Uom = ifnull(input.MOQ_Buying,0) + ifnull(input.Difference_Round_Off_Buying_Qty,0);
										input.Buying_Qty_Total = ifnull(input.Buying_Qty1,0) + ifnull(input.Extra_In_Buying_Uom,0);
						)
					}
				}

			}
