		form Raw_Material1
		{
			title 
    		{
				displayname = "Raw Material"
    			on add = "Raw Material Master"
   	 			on edit = "Raw Material Master"
			}
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Raw_Material_Name
			(
    			type = text
				displayname = " Raw Material Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Category1.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Subcategory
			(
				type = picklist	
				values  = Subcategory1[Category_Master.ID == input.Category].ID
    			displayformat = [Subcategory_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Stock_Uom1
			(
				type = picklist	
				displayname = "Stock Uom"
				values  = Stock_Uom.ID
    			displayformat = [Stock_Uom]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category_Type
			(
				type = picklist	
				displayname = "Category Type"
				values  = Category_Type1.ID
    			displayformat = [Category_Type_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_this_Specific_for_a_Brand
			(
    			type = checkbox
