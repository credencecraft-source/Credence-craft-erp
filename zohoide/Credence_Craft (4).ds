                 		}
                 	}
                 }
				 bool books.cancelEwayBill(int ewayFormId)
                 {
                 	info "========== CANCEL EWAY BILL START ==========";
                 	rec = Generate_ewaybill[ID == ewayFormId];
                 	if(rec == null)
                 	{
                 		info "Generate Eway Bill record not found";
                 		return false;
                 	}
                 	inv = Invoice[ID == rec.Invoice_ID];
                 	if(inv == null)
                 	{
                 		info "Invoice not found";
                 		return false;
                 	}
                 	if(rec.Zoho_EwayBill_ID == null || rec.Zoho_EwayBill_ID == "")
                 	{
                 		info "Zoho Eway Bill ID missing";
                 		return false;
                 	}
                 	orgRec = Zoho_Books_Setting[ID != null];
                 	if(orgRec == null || orgRec.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Settings missing";
                 		return false;
                 	}
                 	orgId = orgRec.Zoho_Books_Organization_ID;
                 	cancelMap = Map();
                 	cancelMap.put("cancel_reason","Cancelled by user");
                 	cancelMap.put("cancel_remarks","Eway bill cancelled from Creator");
                 	reqMap = Map();
                 	reqMap.put("JSONString",cancelMap.toString());
                 	info "========== CANCEL REQUEST ==========";
                 	info reqMap;
                 	urlStr = "https://www.zohoapis.in/books/v3/ewaybills/" + rec.Zoho_EwayBill_ID + "/cancel?organization_id=" + orgId;
                 	resp = invokeurl
                 	[
                 		url :urlStr
                 		type :POST
                 		parameters:reqMap
                 		connection:"zoho_books_connection"
                 	];
                 	info "========== CANCEL RESPONSE ==========";
                 	info resp;
                 	if(resp != null && resp.containKey("code") && resp.get("code") == 0)
                 	{
                 		info "E-WAY BILL CANCELLED SUCCESSFULLY";
                 		cancelStatus = "Cancelled";
                 		if(resp.containKey("ewaybill"))
                 		{
                 			ewayMap = resp.get("ewaybill");
                 			if(ewayMap.containKey("ewaybill_status"))
                 			{
                 				cancelStatus = ewayMap.get("ewaybill_status").toString();
                 			}
                 		}
                 		// Only update status. Do not reset other Eway Bill fields.
                 		rec.Eway_Bill_Status=cancelStatus;
                 		inv.Eway_Bill_Status=cancelStatus;
                 		info "Invoice Eway Bill Status updated : " + inv.Eway_Bill_Status;
                 		info "Generate Eway Bill Status updated : " + rec.Eway_Bill_Status;
                 		info "========== CANCEL EWAY BILL END ==========";
                 		return true;
                 	}
                 	else
                 	{
                 		info "E-WAY BILL CANCELLATION FAILED";
                 		if(resp != null && resp.containKey("message"))
                 		{
                 			info "Error Message : " + resp.get("message");
                 		}
                 		if(resp != null && resp.containKey("error_info"))
                 		{
                 			info "Error Info : " + resp.get("error_info");
                 		}
                 		info "========== CANCEL EWAY BILL END ==========";
                 		return false;
                 	}
                 }
				 void books.createOrUpdateCustomerInBooks(int vendorId)
                 {
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null || intg.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Organization ID missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	v = Vendor1[ID == vendorId];
                 	if(v == null)
                 	{
                 		info "Vendor not found";
                 		return;
                 	}
                 	if(v.is_This_Customer != true)
                 	{
                 		info "Checkbox not selected as Customer";
                 		return;
                 	}
                 	// SEARCH EXISTING CONTACT BY GST
                 	searchResp = zoho.books.getRecords("contacts",orgId,"gst_no=" + v.Gst_No,"zoho_books_connection");
                 	if(searchResp != null && searchResp.get("code") == 0 && searchResp.get("contacts") != null && searchResp.get("contacts").size() > 0)
                 	{
                 		contact = searchResp.get("contacts").get(0);
                 		contact_id = contact.get("contact_id");
                 		// FORCE UPDATE TO CUSTOMER
                 		updateMap = Map();
                 		updateMap.put("contact_type","customer");
                 		updateResp = zoho.books.updateRecord("contacts",orgId,contact_id,updateMap,"zoho_books_connection");
                 		if(updateResp.get("code") == 0)
                 		{
                 			v.Zoho_Books_Vendor_ID=contact_id;
                 			info "Updated as Customer in Books";
                 			return;
                 		}
                 		else
                 		{
                 			info updateResp;
                 			return;
                 		}
                 	}
                 	// CREATE NEW CUSTOMER
                 	contactMap = Map();
                 	contactMap.put("contact_name",v.Vendor_Name);
                 	contactMap.put("gst_no",v.Gst_No);
                 	contactMap.put("contact_type","customer");
                 	// Billing Address
                 	if(v.Vendor_Registered_GST_Address != null)
                 	{
                 		addr = Map();
                 		addr.put("address",v.Vendor_Registered_GST_Address.address_line_1);
                 		addr.put("city",v.Vendor_Registered_GST_Address.district_city);
                 		addr.put("state",v.Vendor_Registered_GST_Address.state_province);
                 		addr.put("zip",v.Vendor_Registered_GST_Address.postal_Code);
                 		addr.put("country",v.Vendor_Registered_GST_Address.country);
                 		contactMap.put("billing_address",addr);
                 	}
                 	createResp = zoho.books.createRecord("contacts",orgId,contactMap,"zoho_books_connection");
                 	if(createResp != null && createResp.get("code") == 0)
                 	{
                 		contact_id = createResp.get("contact").get("contact_id");
                 		v.Zoho_Books_Vendor_ID=contact_id;
                 		info "Customer Created in Books";
                 	}
                 	else
                 	{
                 		info createResp;
                 	}
                 }
				 void books.createOrUpdateVendorInBooks(int vendorId)
                 {
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null || intg.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Organization ID missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	v = Vendor1[ID == vendorId];
                 	if(v == null)
                 	{
                 		info "Vendor not found";
                 		return;
                 	}
                 	searchResp = zoho.books.getRecords("contacts",orgId,"gst_no=" + v.Gst_No,"zoho_books_connection");
                 	if(searchResp != null && searchResp.get("code") == 0 && searchResp.get("contacts") != null && searchResp.get("contacts").size() > 0)
                 	{
                 		contact = searchResp.get("contacts").get(0);
                 		contact_id = contact.get("contact_id");
                 		updateMap = Map();
                 		updateMap.put("contact_type","vendor");
                 		if(v.Vendor_Registered_GST_Address != null)
                 		{
                 			addr = Map();
                 			addr.put("address",v.Vendor_Registered_GST_Address.address_line_1);
                 			addr.put("city",v.Vendor_Registered_GST_Address.district_city);
                 			addr.put("state",v.Vendor_Registered_GST_Address.state_province);
                 			addr.put("zip",v.Vendor_Registered_GST_Address.postal_Code);
                 			addr.put("country",v.Vendor_Registered_GST_Address.country);
                 			updateMap.put("billing_address",addr);
                 			// API equivalent of "Copy billing address"
                 			ship = Map();
                 			ship.put("attention",v.Vendor_Name);
                 			ship.put("address",v.Vendor_Registered_GST_Address.address_line_1);
                 			ship.put("city",v.Vendor_Registered_GST_Address.district_city);
                 			ship.put("state",v.Vendor_Registered_GST_Address.state_province);
                 			ship.put("zip",v.Vendor_Registered_GST_Address.postal_Code);
                 			ship.put("country",v.Vendor_Registered_GST_Address.country);
                 			updateMap.put("shipping_address",ship);
                 		}
                 		updateResp = zoho.books.updateRecord("contacts",orgId,contact_id,updateMap,"zoho_books_connection");
                 		if(updateResp.get("code") == 0)
                 		{
                 			v.Zoho_Books_Vendor_ID=contact_id;
                 			info "Updated as Vendor in Books";
                 			return;
                 		}
                 		else
                 		{
                 			info updateResp;
                 			return;
                 		}
                 	}
                 	contactMap = Map();
                 	contactMap.put("contact_name",v.Vendor_Name);
                 	contactMap.put("gst_no",v.Gst_No);
                 	contactMap.put("contact_type","vendor");
                 	if(v.Vendor_Registered_GST_Address != null)
                 	{
                 		addr = Map();
                 		addr.put("address",v.Vendor_Registered_GST_Address.address_line_1);
                 		addr.put("city",v.Vendor_Registered_GST_Address.district_city);
                 		addr.put("state",v.Vendor_Registered_GST_Address.state_province);
                 		addr.put("zip",v.Vendor_Registered_GST_Address.postal_Code);
                 		addr.put("country",v.Vendor_Registered_GST_Address.country);
                 		contactMap.put("billing_address",addr);
                 		// Copy billing → shipping
                 		ship = Map();
                 		ship.put("attention",v.Vendor_Name);
                 		ship.put("address",v.Vendor_Registered_GST_Address.address_line_1);
                 		ship.put("city",v.Vendor_Registered_GST_Address.district_city);
                 		ship.put("state",v.Vendor_Registered_GST_Address.state_province);
                 		ship.put("zip",v.Vendor_Registered_GST_Address.postal_Code);
                 		ship.put("country",v.Vendor_Registered_GST_Address.country);
                 		contactMap.put("shipping_address",ship);
                 	}
                 	createResp = zoho.books.createRecord("contacts",orgId,contactMap,"zoho_books_connection");
                 	if(createResp != null && createResp.get("code") == 0)
                 	{
                 		contact_id = createResp.get("contact").get("contact_id");
                 		v.Zoho_Books_Vendor_ID=contact_id;
                 		info "Vendor Created in Books";
                 	}
                 	else
                 	{
                 		info createResp;
                 	}
                 }
				 bool books.fetchEwayBillDetails(int ewayFormId)
                 {
                 	info "========== FETCH EWAY BILL DETAILS START ==========";
                 	rec = Generate_ewaybill[ID == ewayFormId];
                 	if(rec == null)
                 	{
                 		info "Generate Eway Bill record not found";
                 		return false;
                 	}
                 	if(rec.Zoho_EwayBill_ID == null || rec.Zoho_EwayBill_ID == "")
                 	{
                 		info "Zoho Eway Bill ID missing";
                 		return false;
                 	}
                 	inv = Invoice[ID == rec.Invoice_ID];
                 	if(inv == null)
                 	{
                 		info "Invoice not found";
                 		return false;
                 	}
                 	orgRec = Zoho_Books_Setting[ID != null];
                 	if(orgRec == null || orgRec.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Settings missing";
                 		return false;
                 	}
                 	orgId = orgRec.Zoho_Books_Organization_ID;
                 	urlStr = "https://www.zohoapis.in/books/v3/ewaybills/" + rec.Zoho_EwayBill_ID + "?organization_id=" + orgId;
                 	resp = invokeurl
                 	[
                 		url :urlStr
                 		type :GET
                 		connection:"zoho_books_connection"
                 	];
                 	info "========== FETCH EWAY BILL RESPONSE ==========";
                 	info resp;
                 	if(resp == null)
                 	{
                 		info "Fetch response is null";
                 		return false;
                 	}
                 	if(!resp.containKey("code") || resp.get("code") != 0)
                 	{
                 		info "Fetch Eway Bill failed";
                 		if(resp.containKey("message"))
                 		{
                 			info "Error Message : " + resp.get("message");
                 		}
                 		if(resp.containKey("error_info"))
                 		{
                 			info "Error Info : " + resp.get("error_info");
                 		}
                 		return false;
                 	}
                 	if(!resp.containKey("ewaybill"))
                 	{
                 		info "Eway Bill data missing in response";
                 		return false;
                 	}
                 	ewayMap = resp.get("ewaybill");
                 	if(ewayMap.containKey("ewaybill_number"))
                 	{
                 		rec.Eway_Bill_Number=ewayMap.get("ewaybill_number").toString();
                 		inv.Eway_Bill_Number=ewayMap.get("ewaybill_number").toString();
                 		info "Eway Bill Number updated : " + inv.Eway_Bill_Number;
                 	}
                 	if(ewayMap.containKey("ewaybill_id"))
                 	{
                 		rec.Zoho_EwayBill_ID=ewayMap.get("ewaybill_id").toString();
                 	}
                 	if(ewayMap.containKey("distance"))
                 	{
                 		rec.Eway_Distance=ewayMap.get("distance").toString();
                 	}
                 	if(ewayMap.containKey("ewaybill_status"))
                 	{
                 		rec.Eway_Bill_Status=ewayMap.get("ewaybill_status").toString();
                 		inv.Eway_Bill_Status=ewayMap.get("ewaybill_status").toString();
                 		info "Eway Bill Status updated : " + inv.Eway_Bill_Status;
                 	}
                 	if(ewayMap.containKey("ewaybill_date"))
                 	{
                 		try 
                 		{
                 			rec.Eway_Bill_Generated_DateTime=ewayMap.get("ewaybill_date").toDateTime("yyyy-MM-dd HH:mm");
                 			inv.Eway_Bill_Date=rec.Eway_Bill_Generated_DateTime;
                 		}		catch (e)
                 		{
                 			info "Eway Bill Date Parse Failed";
                 			info e;
                 		}
                 	}
                 	if(ewayMap.containKey("ewaybill_expiry_date"))
                 	{
                 		try 
                 		{
                 			rec.Eway_Bill_Expiry_DateTime=ewayMap.get("ewaybill_expiry_date").toDateTime("yyyy-MM-dd HH:mm");
                 			inv.Eway_Bill_Expiry_DateTime=rec.Eway_Bill_Expiry_DateTime;
                 		}		catch (e)
                 		{
                 			info "Eway Bill Expiry Date Parse Failed";
                 			info e;
                 		}
                 	}
                 	if(ewayMap.containKey("vehicle_number"))
                 	{
                 		rec.Vehicle_No=ewayMap.get("vehicle_number").toString();
                 		inv.Eway_Vehicle_No=ewayMap.get("vehicle_number").toString();
                 	}
                 	else
                 	{
                 		inv.Eway_Vehicle_No=rec.Vehicle_No;
                 	}
                 	// Your QR_Code field displays this source value:
                 	// QR_Code value = ${Eway_Bill_QR_Code}
                 	if(ewayMap.containKey("qr_code"))
                 	{
                 		rec.Eway_Bill_QR_Code=ewayMap.get("qr_code").toString();
                 		info "QR updated from qr_code";
                 	}
                 	else if(ewayMap.containKey("qr_link"))
                 	{
                 		rec.Eway_Bill_QR_Code=ewayMap.get("qr_link").toString();
                 		info "QR updated from qr_link";
                 	}
                 	else if(ewayMap.containKey("ewaybill_qr_code"))
                 	{
                 		rec.Eway_Bill_QR_Code=ewayMap.get("ewaybill_qr_code").toString();
                 		info "QR updated from ewaybill_qr_code";
                 	}
                 	else if(ewayMap.containKey("ewaybill_number"))
                 	{
                 		rec.Eway_Bill_QR_Code=ewayMap.get("ewaybill_number").toString();
                 		info "QR updated using ewaybill_number";
                 	}
                 	else
                 	{
                 		info "QR value not found in fetch response";
                 	}
                 	info "Eway Bill details fetched and updated successfully";
                 	info "========== FETCH EWAY BILL DETAILS END ==========";
                 	return true;
                 }
				 void books.generateEInvoice(int invoiceId)
                 {
                 	info "========== E-INVOICE START ==========";
                 	inv = Invoice[ID == invoiceId];
                 	if(inv == null)
                 	{
                 		info "Invoice not found";
                 		return;
                 	}
                 	if(inv.ZohoBooks_Invoice_ID == null || inv.ZohoBooks_Invoice_ID == "")
                 	{
                 		info "Zoho Books Invoice ID missing";
                 		return;
                 	}
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null || intg.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Organization ID missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	booksInvoiceId = inv.ZohoBooks_Invoice_ID;
                 	// ================= GENERATE E-INVOICE =================
                 	einvoiceResp = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/books/v3/invoices/" + booksInvoiceId + "/einvoice/push?organization_id=" + orgId
                 		type :POST
                 		connection:"zoho_books_connection"
                 	];
                 	info "========== E-INVOICE RESPONSE ==========";
                 	info einvoiceResp;
                 	if(einvoiceResp == null)
                 	{
                 		info "E-Invoice response is null";
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		return;
                 	}
                 	if(!einvoiceResp.containKey("code") || einvoiceResp.get("code") != 0)
                 	{
                 		info "E-Invoice API Error";
                 		info einvoiceResp;
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		// Create or update local E_Invoice failure record
                 		existingEInvList = E_Invoice[Invoice == inv.ID];
                 		if(existingEInvList.count() > 0)
                 		{
                 			for each  existingEInv in existingEInvList
                 			{
                 				existingEInv.EInvoice_Status="Failed";
                 				existingEInv.EInvoice_Generated=false;
                 				existingEInv.EInvoice_Response=einvoiceResp.toString();
                 			}
                 		}
                 		else
                 		{
                 			eInv = insert into E_Invoice
                 			[
                 				Invoice=inv.ID
                 				EInvoice_Status="Failed"
                 				EInvoice_Generated=false
                 				EInvoice_Response=einvoiceResp.toString()
                 				Added_User=zoho.loginuser
                 			];
                 			info "E-Invoice Failure Record Created : " + eInv;
                 		}
                 		return;
                 	}
                 	// ================= CHECK INNER IRP ERRORS =================
                 	errorMsg = "";
                 	if(einvoiceResp.containKey("data"))
                 	{
                 		dataMap = einvoiceResp.get("data");
                 		if(dataMap != null && dataMap.containKey("errors"))
                 		{
                 			errorList = dataMap.get("errors");
                 			if(errorList != null && errorList.size() > 0)
                 			{
                 				firstError = errorList.get(0);
                 				if(firstError != null && firstError.containKey("message"))
                 				{
                 					errorMsg = firstError.get("message").toString();
                 				}
                 				else
                 				{
                 					errorMsg = "E-Invoice failed. IRP returned error.";
                 				}
                 			}
                 		}
                 	}
                 	if(errorMsg != "")
                 	{
                 		info "E-Invoice generation failed from IRP";
                 		info "Error Message : " + errorMsg;
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		// Create or update local E_Invoice failure record
                 		existingEInvList = E_Invoice[Invoice == inv.ID];
                 		if(existingEInvList.count() > 0)
                 		{
                 			for each  existingEInv in existingEInvList
                 			{
                 				existingEInv.EInvoice_Status="Failed";
                 				existingEInv.EInvoice_Generated=false;
                 				existingEInv.EInvoice_Response=einvoiceResp.toString();
                 			}
                 		}
                 		else
                 		{
                 			eInv = insert into E_Invoice
                 			[
                 				Invoice=inv.ID
                 				EInvoice_Status="Failed"
                 				EInvoice_Generated=false
                 				EInvoice_Response=einvoiceResp.toString()
                 				Added_User=zoho.loginuser
                 			];
                 			info "E-Invoice Failure Record Created : " + eInv;
                 		}
                 		info "========== E-INVOICE END ==========";
                 		return;
                 	}
                 	// ================= MARK AS SENT ONLY AFTER NO IRP ERROR =================
                 	sendResp = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/books/v3/invoices/" + booksInvoiceId + "/status/sent?organization_id=" + orgId
                 		type :POST
                 		connection:"zoho_books_connection"
                 	];
                 	info "========== MARK AS SENT RESPONSE ==========";
                 	info sendResp;
                 	if(sendResp == null || !sendResp.containKey("code") || sendResp.get("code") != 0)
                 	{
                 		info "Invoice generated but status update failed";
                 		info sendResp;
                 	}
                 	// ================= FETCH INVOICE DETAILS =================
                 	invoiceResp = zoho.books.getRecordsByID("invoices",orgId,booksInvoiceId,"zoho_books_connection");
                 	info "========== INVOICE DETAILS ==========";
                 	info invoiceResp;
                 	if(invoiceResp == null)
                 	{
                 		info "Invoice details response is null";
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		return;
                 	}
                 	if(!invoiceResp.containKey("code") || invoiceResp.get("code") != 0)
                 	{
                 		info "Unable to fetch updated invoice details";
                 		info invoiceResp;
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		return;
                 	}
                 	invoiceData = invoiceResp.get("invoice");
                 	if(invoiceData == null)
                 	{
                 		info "Invoice data missing in Books response";
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		return;
                 	}
                 	einvoiceDetails = invoiceData.get("einvoice_details");
                 	if(einvoiceDetails == null)
                 	{
                 		info "E-Invoice details missing in Books response";
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		return;
                 	}
                 	// ================= READ E-INVOICE DETAILS =================
                 	irnNo = ifnull(einvoiceDetails.get("inv_ref_num"),"");
                 	ackNo = ifnull(einvoiceDetails.get("ack_number"),"");
                 	ackDateText = ifnull(einvoiceDetails.get("ack_date"),"");
                 	signedQrCode = ifnull(einvoiceDetails.get("qr_link"),"");
                 	booksEInvoiceStatus = ifnull(einvoiceDetails.get("status"),"");
                 	info "IRN Number From Books : " + irnNo;
                 	info "Books E-Invoice Status : " + booksEInvoiceStatus;
                 	if(irnNo == "")
                 	{
                 		info "IRN Number is blank. E-Invoice not treated as generated.";
                 		inv.EInvoice_Status="Failed";
                 		inv.EInvoice_Generated=false;
                 		existingEInvList = E_Invoice[Invoice == inv.ID];
                 		if(existingEInvList.count() > 0)
                 		{
                 			for each  existingEInv in existingEInvList
                 			{
                 				existingEInv.EInvoice_Status="Failed";
                 				existingEInv.EInvoice_Generated=false;
                 				existingEInv.EInvoice_Response=invoiceResp.toString();
                 			}
                 		}
                 		else
                 		{
                 			eInv = insert into E_Invoice
                 			[
                 				Invoice=inv.ID
                 				EInvoice_Status="Failed"
                 				EInvoice_Generated=false
                 				EInvoice_Response=invoiceResp.toString()
                 				Added_User=zoho.loginuser
                 			];
                 			info "E-Invoice Failure Record Created : " + eInv;
                 		}
                 		info "========== E-INVOICE END ==========";
                 		return;
                 	}
                 	eInvoiceStatus = "Generated";
                 	ackDateValue = null;
                 	if(ackDateText != "")
                 	{
                 		try 
                 		{
                 			ackDateValue = ackDateText.toDateTime("yyyy-MM-dd HH:mm:ss");
                 		}		catch (e)
                 		{
                 			info "Ack Date Parse Failed : " + ackDateText;
                 			info e;
                 		}
                 	}
                 	// ================= CREATE OR UPDATE E_INVOICE RECORD SAFELY =================
                 	existingEInvList = E_Invoice[Invoice == inv.ID];
                 	if(existingEInvList.count() > 0)
                 	{
                 		for each  existingEInv in existingEInvList
                 		{
                 			existingEInv.IRN_Number=irnNo;
                 			existingEInv.Ack_No=ackNo;
                 			if(ackDateValue != null)
                 			{
                 				existingEInv.Ack_Date=ackDateValue;
                 				existingEInv.IRN_Generated_Date=ackDateValue;
                 			}
                 			existingEInv.EInvoice_Status=eInvoiceStatus;
                 			existingEInv.Signed_QR_Code=signedQrCode;
                 			existingEInv.EInvoice_Response=invoiceResp.toString();
                 			existingEInv.EInvoice_Generated=true;
                 			info "E-Invoice Record Updated : " + existingEInv.ID;
                 		}
                 	}
                 	else
                 	{
                 		eInv = insert into E_Invoice
                 		[
                 			Invoice=inv.ID
                 			IRN_Number=irnNo
                 			Ack_No=ackNo
                 			Ack_Date=ackDateValue
                 			IRN_Generated_Date=ackDateValue
                 			EInvoice_Status=eInvoiceStatus
                 			Signed_QR_Code=signedQrCode
                 			EInvoice_Response=invoiceResp.toString()
                 			EInvoice_Generated=true
                 			Added_User=zoho.loginuser
                 		];
                 		info "E-Invoice Record Created : " + eInv;
                 	}
                 	// ================= UPDATE IMPORTANT DATA TO INVOICE =================
                 	inv.E_Invoice_No=irnNo;
                 	inv.Signed_QR_Code1=signedQrCode;
                 	inv.EInvoice_Status=eInvoiceStatus;
                 	inv.EInvoice_Generated=true;
                 	info "Invoice Updated With E-Invoice No : " + inv.E_Invoice_No;
                 	info "E-Invoice generated and updated successfully";
                 	info "========== E-INVOICE END ==========";
                 }
				 bool books.generateEwayBill(int ewayFormId)
                 {
                 	info "========== EWAY BILL START ==========";
                 	rec = Generate_ewaybill[ID == ewayFormId];
                 	if(rec == null)
                 	{
                 		info "Generate Eway Bill record not found";
                 		return false;
                 	}
                 	inv = Invoice[ID == rec.Invoice_ID];
                 	if(inv == null)
                 	{
                 		info "Invoice not found";
                 		return false;
                 	}
                 	if(inv.ZohoBooks_Invoice_ID == null || inv.ZohoBooks_Invoice_ID == "")
                 	{
                 		info "Invoice not pushed to Zoho Books";
                 		return false;
                 	}
                 	orgRec = Zoho_Books_Setting[ID != null];
                 	if(orgRec == null || orgRec.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Settings missing";
                 		return false;
                 	}
                 	orgId = orgRec.Zoho_Books_Organization_ID;
                 	if(rec.Vehicle_No == null || rec.Vehicle_No.trim() == "")
                 	{
                 		info "Vehicle Number Missing";
                 		return false;
                 	}
                 	transMode = "road";
                 	if(rec.Mode_of_Transportation == "Rail")
                 	{
                 		transMode = "rail";
                 	}
                 	else if(rec.Mode_of_Transportation == "Air")
                 	{
                 		transMode = "air";
                 	}
                 	else if(rec.Mode_of_Transportation == "Ship")
                 	{
                 		transMode = "ship";
                 	}
                 	dataMap = Map();
                 	dataMap.put("transaction_type","regular");
                 	dataMap.put("transportation_mode",transMode);
                 	dataMap.put("distance",ifnull(rec.Distance_in_Km,0));
                 	dataMap.put("vehicle_number",rec.Vehicle_No);
                 	dataMap.put("sub_supply_type","supply");
                 	dataMap.put("vehicle_type","regular");
                 	if(rec.Transporter_s_Doc_Date != null)
                 	{
                 		dataMap.put("transporter_document_date",rec.Transporter_s_Doc_Date.toString("yyyy-MM-dd"));
                 	}
                 	dataMap.put("transporter_document_number",ifnull(rec.Transporter_s_Doc_No,""));
                 	dataMap.put("entity_id",inv.ZohoBooks_Invoice_ID);
                 	dataMap.put("entity_type","invoice");
                 	dataMap.put("action","save_generate");
                 	info "========== DATA MAP ==========";
                 	info dataMap;
                 	reqMap = Map();
                 	reqMap.put("JSONString",dataMap.toString());
                 	info "========== FINAL REQUEST ==========";
                 	info reqMap;
                 	urlStr = "https://www.zohoapis.in/books/v3/ewaybills?organization_id=" + orgId;
                 	resp = invokeurl
                 	[
                 		url :urlStr
                 		type :POST
                 		parameters:reqMap
                 		connection:"zoho_books_connection"
                 	];
                 	info "========== RESPONSE ==========";
                 	info resp;
                 	if(resp != null && resp.containKey("code") && resp.get("code") == 0)
                 	{
                 		info "E-WAY BILL GENERATED SUCCESSFULLY";
                 		if(resp.containKey("ewaybill"))
                 		{
                 			ewayMap = resp.get("ewaybill");
                 			if(ewayMap.containKey("ewaybill_number"))
                 			{
                 				rec.Eway_Bill_Number=ewayMap.get("ewaybill_number").toString();
                 				inv.Eway_Bill_Number=ewayMap.get("ewaybill_number").toString();
                 				info "Eway Bill Number : " + inv.Eway_Bill_Number;
                 			}
                 			if(ewayMap.containKey("ewaybill_id"))
                 			{
                 				rec.Zoho_EwayBill_ID=ewayMap.get("ewaybill_id").toString();
                 			}
                 			if(ewayMap.containKey("distance"))
                 			{
                 				rec.Eway_Distance=ewayMap.get("distance").toString();
                 			}
                 			if(ewayMap.containKey("ewaybill_status"))
                 			{
                 				rec.Eway_Bill_Status=ewayMap.get("ewaybill_status").toString();
                 				inv.Eway_Bill_Status=ewayMap.get("ewaybill_status").toString();
                 			}
                 			if(ewayMap.containKey("ewaybill_date"))
                 			{
                 				try 
                 				{
                 					rec.Eway_Bill_Generated_DateTime=ewayMap.get("ewaybill_date").toDateTime("yyyy-MM-dd HH:mm");
                 					inv.Eway_Bill_Date=rec.Eway_Bill_Generated_DateTime;
                 				}				catch (e)
                 				{
                 					info "Eway Bill Date Parse Failed";
                 					info e;
                 					inv.Eway_Bill_Date=zoho.currentdate;
                 				}
                 			}
                 			else
                 			{
                 				inv.Eway_Bill_Date=zoho.currentdate;
                 			}
                 			if(ewayMap.containKey("ewaybill_expiry_date"))
                 			{
                 				try 
                 				{
                 					rec.Eway_Bill_Expiry_DateTime=ewayMap.get("ewaybill_expiry_date").toDateTime("yyyy-MM-dd HH:mm");
                 					inv.Eway_Bill_Expiry_DateTime=rec.Eway_Bill_Expiry_DateTime;
                 				}				catch (e)
                 				{
                 					info "Eway Bill Expiry Date Parse Failed";
                 					info e;
                 				}
                 			}
                 			if(ewayMap.containKey("vehicle_number"))
                 			{
                 				rec.Vehicle_No=ewayMap.get("vehicle_number").toString();
                 				inv.Eway_Vehicle_No=ewayMap.get("vehicle_number").toString();
                 			}
                 			else
                 			{
                 				inv.Eway_Vehicle_No=rec.Vehicle_No;
                 			}
                 			// ================= SAVE QR CODE VALUE =================
                 			if(ewayMap.containKey("qr_code"))
                 			{
                 				rec.Eway_Bill_QR_Code=ewayMap.get("qr_code").toString();
                 				info "Eway Bill QR Code saved from qr_code";
                 			}
                 			else if(ewayMap.containKey("qr_link"))
                 			{
                 				rec.Eway_Bill_QR_Code=ewayMap.get("qr_link").toString();
                 				info "Eway Bill QR Code saved from qr_link";
                 			}
                 			else if(ewayMap.containKey("ewaybill_qr_code"))
                 			{
                 				rec.Eway_Bill_QR_Code=ewayMap.get("ewaybill_qr_code").toString();
                 				info "Eway Bill QR Code saved from ewaybill_qr_code";
                 			}
                 			else if(ewayMap.containKey("ewaybill_number"))
                 			{
                 				rec.Eway_Bill_QR_Code=ewayMap.get("ewaybill_number").toString();
                 				info "Eway Bill QR Code saved using ewaybill_number";
                 			}
                 			else
                 			{
                 				info "Eway Bill QR Code value not available";
                 			}
                 		}
                 		if(inv.Eway_Bill_Number == null || inv.Eway_Bill_Number == "")
                 		{
                 			info "Eway Bill generated but number not received from Zoho Books.";
                 			info "Generate Eway Bill record not deleted.";
                 			info "========== EWAY BILL END ==========";
                 			return false;
                 		}
                 		if(inv.Eway_Vehicle_No == null || inv.Eway_Vehicle_No == "")
                 		{
                 			inv.Eway_Vehicle_No=rec.Vehicle_No;
                 		}
                 		info "Generate Eway Bill record kept. Not deleted after generation.";
                 		info "========== EWAY BILL END ==========";
                 		return true;
                 	}
                 	else
                 	{
                 		info "E-WAY BILL GENERATION FAILED";
                 		if(resp != null && resp.containKey("message"))
                 		{
                 			info "Error Message : " + resp.get("message");
                 		}
                 		if(resp != null && resp.containKey("error_info"))
                 		{
                 			info "Error Info : " + resp.get("error_info");
                 		}
                 		info "========== EWAY BILL END ==========";
                 		return false;
                 	}
                 }
				 void books.pushDeliveryChallanToZohoBooks(int dcId)
                 {
                 	dc = GRN_Delivery[ID == dcId];
                 	if(dc == null)
                 	{
                 		info "Delivery Challan not found";
                 		return;
                 	}
                 	if(dc.ZohoBooks_DC_ID != null && dc.ZohoBooks_DC_ID != "")
                 	{
                 		info "Delivery Challan already synced to Zoho Books";
                 		return;
                 	}
                 	// ================= SETTINGS =================
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null || intg.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Organization ID missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	// ================= CUSTOMER =================
                 	cust = Vendor1[ID == dc.Vendors1];
                 	if(cust == null)
                 	{
                 		info "Customer missing";
                 		return;
                 	}
                 	customer_id = cust.Zoho_Books_Vendor_ID;
                 	if(customer_id == null || customer_id == "")
                 	{
                 		thisapp.books.createOrUpdateCustomerInBooks(cust.ID);
                 		cust = Vendor1[ID == cust.ID];
                 		customer_id = cust.Zoho_Books_Vendor_ID;
                 		if(customer_id == null || customer_id == "")
                 		{
                 			info "Customer sync failed";
                 			return;
                 		}
                 	}
                 	// ================= CATEGORY ITEM =================
                 	cat = Category_Type1[ID == dc.Category_Type1];
                 	if(cat == null)
                 	{
                 		info "Category Type missing";
                 		return;
                 	}
                 	main_item_id = cat.Books_Item_ID;
                 	if(main_item_id == null || main_item_id == "")
                 	{
                 		itemSearchResp = zoho.books.getRecords("items",orgId,"name=" + cat.Category_Type_Name,"zoho_books_connection");
                 		if(itemSearchResp != null && itemSearchResp.get("code") == 0 && itemSearchResp.get("items") != null && itemSearchResp.get("items").size() > 0)
                 		{
                 			main_item_id = itemSearchResp.get("items").get(0).get("item_id");
                 		}
                 		else
                 		{
                 			itemMapCreate = Map();
                 			itemMapCreate.put("name",cat.Category_Type_Name);
                 			itemMapCreate.put("rate",0);
                 			itemMapCreate.put("unit","Nos");
                 			createItemResp = zoho.books.createRecord("items",orgId,itemMapCreate,"zoho_books_connection");
                 			if(createItemResp != null && createItemResp.get("code") == 0)
                 			{
                 				main_item_id = createItemResp.get("item").get("item_id");
                 			}
                 			else
                 			{
                 				info "Books Item creation failed";
                 				return;
                 			}
                 		}
                 		cat.Books_Item_ID=main_item_id;
                 	}
                 	// ================= TAX MASTER =================
                 	taxResp = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/books/v3/settings/taxes?organization_id=" + orgId
                 		type :GET
                 		connection:"zoho_books_connection"
                 	];
                 	if(taxResp.get("code") != 0)
                 	{
                 		info taxResp;
                 		return;
                 	}
                 	taxList = taxResp.get("taxes");
                 	lineItems = List();
                 	// ================= LOOP SUBFORM =================
                 	for each  row in Delivery_Challan_Subform[Delivery_Challan == dc.ID]
                 	{
                 		if(row.Requested_Qty == null)
                 		{
                 			continue;
                 		}
                 		if(row.Hsn_Code == null)
                 		{
                 			info "HSN Code missing in one of the rows";
                 			return;
                 		}
                 		itemLine = Map();
                 		itemLine.put("item_id",main_item_id);
                 		itemLine.put("quantity",row.Requested_Qty);
                 		itemLine.put("rate",ifnull(row.Price,0));
                 		itemLine.put("hsn_or_sac",row.Hsn_Code.Hsn_Code);
                 		if(row.Item != null && row.Item != "")
                 		{
                 			itemLine.put("description",row.Item);
                 			itemLine.put("name",row.Item);
                 		}
                 		taxApplied = false;
                 		if(row.Gst != null)
                 		{
                 			gstRec = Gst[ID == row.Gst];
                 			if(gstRec.count() > 0)
                 			{
                 				gstPercent = gstRec.Gst.toDecimal();
                 				headerGstType = dc.GST_TYPE.gst_type;
                 				for each  t in taxList
                 				{
                 					tPercent = t.get("tax_percentage").toDecimal();
                 					tType = t.get("tax_type");
                 					if(headerGstType == "IGST")
                 					{
                 						if(tType == "tax" && tPercent == gstPercent)
                 						{
                 							itemLine.put("tax_id",t.get("tax_id"));
                 							taxApplied = true;
                 							break;
                 						}
                 					}
                 					if(headerGstType == "CGST & SGST")
                 					{
                 						if(tType == "tax_group" && tPercent == gstPercent)
                 						{
                 							itemLine.put("tax_id",t.get("tax_id"));
                 							taxApplied = true;
                 							break;
                 						}
                 					}
                 				}
                 			}
                 		}
                 		if(taxApplied == false)
                 		{
                 			itemLine.put("tax_exemption_code","gst_exempt");
                 		}
                 		lineItems.add(itemLine);
                 	}
                 	if(lineItems.size() == 0)
                 	{
                 		info "No valid line items";
                 		return;
                 	}
                 	// ================= CREATE DELIVERY CHALLAN =================
                 	dcMap = Map();
                 	dcMap.put("customer_id",customer_id);
                 	dcMap.put("date",dc.Date_field.toString("yyyy-MM-dd"));
                 	dcMap.put("reference_number","DC" + dc.Auto_Number);
                 	dcMap.put("line_items",lineItems);
                 	info dcMap;
                 	createResp = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/books/v3/deliverychallans?organization_id=" + orgId
                 		type :POST
                 		parameters:{"JSONString":dcMap.toString()}
                 		connection:"zoho_books_connection"
                 	];
                 	info createResp;
                 	if(createResp.get("code") != 0)
                 	{
                 		info "Delivery Challan creation failed";
                 		info createResp;
                 		return;
                 	}
                 	dc.ZohoBooks_DC_ID=createResp.get("deliverychallan").get("deliverychallan_id");
                 	info "Delivery Challan pushed successfully";
                 }
				 void books.pushInvoiceToZohoBooks(int invoiceId)
                 {
                 	inv = Invoice[ID == invoiceId];
                 	if(inv == null)
                 	{
                 		return;
                 	}
                 	if(inv.ZohoBooks_Invoice_ID != null && inv.ZohoBooks_Invoice_ID != "")
                 	{
                 		info "Invoice already synced to Zoho Books";
                 		return;
                 	}
                 	// ===== AUTO ENABLE CUSTOMER IN BOOKS IF DISABLED =====
                 	inv = Invoice[ID == invoiceId];
                 	if(inv != null)
                 	{
                 		cust = Vendor1[ID == inv.Customer_Name];
                 		if(cust != null && cust.Zoho_Books_Vendor_ID != null && cust.Zoho_Books_Vendor_ID != "")
                 		{
                 			updateMap = Map();
                 			updateMap.put("contact_type","customer");
                 			resp = zoho.books.updateRecord("contacts",Zoho_Books_Setting[ID != null].Zoho_Books_Organization_ID,cust.Zoho_Books_Vendor_ID,updateMap,"zoho_books_connection");
                 		}
                 	}
                 	// ================= SETTINGS =================
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null || intg.Zoho_Books_Organization_ID == null)
                 	{
                 		info "Zoho Books Organization ID missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	// ================= FETCH INVOICE =================
                 	inv = Invoice[ID == invoiceId];
                 	if(inv == null)
                 	{
                 		info "Invoice not found";
                 		return;
                 	}
                 	if(inv.ZohoBooks_Invoice_ID != null && inv.ZohoBooks_Invoice_ID != "")
                 	{
                 		info "Already pushed";
                 		return;
                 	}
                 	// ================= CUSTOMER =================
                 	cust = Vendor1[ID == inv.Customer_Name];
                 	if(cust == null)
                 	{
                 		info "Customer missing";
                 		return;
                 	}
                 	customer_id = cust.Zoho_Books_Vendor_ID;
                 	if(customer_id == null || customer_id == "")
                 	{
                 		thisapp.books.createOrUpdateCustomerInBooks(cust.ID);
                 		cust = Vendor1[ID == cust.ID];
                 		customer_id = cust.Zoho_Books_Vendor_ID;
                 		if(customer_id == null || customer_id == "")
                 		{
                 			info "Customer sync failed";
                 			return;
                 		}
                 	}
                 	if(inv.Shipping_address1 != null)
                 	{
                 		shipRec = Shipping_address[ID == inv.Shipping_address1];
                 		if(shipRec != null && shipRec.Zoho_Books_Shipping_Address_ID == null || shipRec.Zoho_Books_Shipping_Address_ID == "")
                 		{
                 			thisapp.books.syncVendorShippingAddresses(cust.ID);
                 			shipRec = Shipping_address[ID == inv.Shipping_address1];
                 		}
                 	}
                 	shippingMap = Map();
                 	if(inv.Shipping_address1 != null)
                 	{
                 		shipRec = Shipping_address[ID == inv.Shipping_address1];
                 		if(shipRec != null)
                 		{
                 			shippingMap.put("address",ifnull(shipRec.Address.address_line_1,""));
                 			shippingMap.put("city",shipRec.Address.district_city);
                 			stateName = "";
                 			if(cust.Registered_Gst_State != null)
                 			{
                 				stateName = cust.Registered_Gst_State.customer_s_registered_Gst_State;
                 			}
                 			if(stateName == "")
                 			{
                 				info "Registered GST State missing for customer";
                 				return;
                 			}
                 			shippingMap.put("state",stateName);
                 			shippingMap.put("zip",shipRec.Address.postal_Code);
                 			shippingMap.put("country",shipRec.Address.country);
                 		}
                 	}
                 	// ================= HEADER ITEM =================
                 	cat = Category_Type1[ID == inv.Category_Type1];
                 	if(cat == null)
                 	{
                 		info "Category Type missing";
                 		return;
                 	}
                 	main_item_id = cat.Books_Item_ID;
                 	// ================= AUTO CREATE / BACK UPDATE ITEM =================
                 	if(main_item_id == null || main_item_id == "")
                 	{
                 		itemSearchResp = zoho.books.getRecords("items",orgId,"name=" + cat.Category_Type_Name,"zoho_books_connection");
                 		if(itemSearchResp != null && itemSearchResp.get("code") == 0 && itemSearchResp.get("items") != null && itemSearchResp.get("items").size() > 0)
                 		{
                 			main_item_id = itemSearchResp.get("items").get(0).get("item_id");
                 		}
                 		else
                 		{
                 			itemMapCreate = Map();
                 			itemMapCreate.put("name",cat.Category_Type_Name);
                 			itemMapCreate.put("rate",0);
                 			itemMapCreate.put("unit","Nos");
                 			createItemResp = zoho.books.createRecord("items",orgId,itemMapCreate,"zoho_books_connection");
                 			if(createItemResp != null && createItemResp.get("code") == 0)
                 			{
                 				main_item_id = createItemResp.get("item").get("item_id");
                 			}
                 			else
                 			{
                 				info "Books Item creation failed";
                 				return;
                 			}
                 		}
                 		// ================= BACK UPDATE CATEGORY =================
                 		cat.Books_Item_ID=main_item_id;
                 	}
                 	// ================= FETCH TAX MASTER =================
                 	taxResp = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/books/v3/settings/taxes?organization_id=" + orgId
                 		type :GET
                 		connection:"zoho_books_connection"
                 	];
                 	if(taxResp.get("code") != 0)
                 	{
                 		info taxResp;
                 		return;
                 	}
                 	taxList = taxResp.get("taxes");
                 	lineItems = List();
                 	// ================= LOOP SUBFORM =================
                 	for each  row in inv.Sales_Invoice_Subform
                 	{
                 		if(row.Qty == null || row.Price == null)
                 		{
                 			continue;
                 		}
                 		// HSN VALIDATION
                 		if(row.Hsn_Code == null)
                 		{
                 			info "HSN Code missing in one of the rows";
                 			return;
                 		}
                 		itemLine = Map();
                 		itemLine.put("item_id",main_item_id);
                 		itemLine.put("quantity",row.Qty);
                 		itemLine.put("rate",row.Price);
                 		itemLine.put("hsn_or_sac",row.Hsn_Code.Hsn_Code);
                 		if(row.Item != null && row.Item != "")
                 		{
                 			itemLine.put("description",row.Item);
                 		}
                 		// ================= HEADER GST =================
                 		taxApplied = false;
                 		if(row.Gst != null)
                 		{
                 			gstRec = Gst[ID == row.Gst];
                 			if(gstRec.count() > 0)
                 			{
                 				gstPercent = gstRec.Gst.toDecimal();
                 				headerGstType = inv.GST_TYPE1.gst_type;
                 				for each  t in taxList
                 				{
                 					tPercent = t.get("tax_percentage").toDecimal();
                 					tType = t.get("tax_type");
                 					if(headerGstType == "IGST")
                 					{
                 						if(tType == "tax" && tPercent == gstPercent)
                 						{
                 							itemLine.put("tax_id",t.get("tax_id"));
                 							taxApplied = true;
                 							break;
                 						}
                 					}
                 					if(headerGstType == "CGST & SGST")
                 					{
                 						if(tType == "tax_group" && tPercent == gstPercent)
                 						{
                 							itemLine.put("tax_id",t.get("tax_id"));
                 							taxApplied = true;
                 							break;
                 						}
                 					}
                 				}
                 			}
                 		}
                 		if(taxApplied == false)
                 		{
                 			itemLine.put("tax_exemption_code","gst_exempt");
                 		}
                 		lineItems.add(itemLine);
                 	}
                 	if(lineItems.size() == 0)
                 	{
                 		info "No valid line items";
                 		return;
                 	}
                 	// ================= CREATE INVOICE =================
                 	invoiceMap = Map();
                 	invoiceMap.put("customer_id",customer_id);
                 	invoiceMap.put("date",inv.Invoice_Date.toString("yyyy-MM-dd"));
                 	invoiceMap.put("invoice_number",inv.Invoice_No1);
                 	invoiceMap.put("line_items",lineItems);
                 	// SHIPPING ADDRESS AUTO
                 	if(inv.Shipping_address1 != null)
                 	{
                 		shipRec = Shipping_address[ID == inv.Shipping_address1];
                 		if(shipRec == null)
                 		{
                 			info "Shipping Address missing";
                 			return;
                 		}
                 		if(shipRec.Zoho_Books_Shipping_Address_ID == null || shipRec.Zoho_Books_Shipping_Address_ID == "")
                 		{
                 			info "Shipping Address not synced to Zoho Books";
                 			return;
                 		}
                 		if(shipRec != null && shipRec.Zoho_Books_Shipping_Address_ID != null && shipRec.Zoho_Books_Shipping_Address_ID != "")
                 		{
                 			invoiceMap.put("shipping_address_id",shipRec.Zoho_Books_Shipping_Address_ID);
                 		}
                 		else
                 		{
                 			invoiceMap.put("shipping_address",shippingMap);
                 		}
                 	}
                 	createResp = zoho.books.createRecord("invoices",orgId,invoiceMap,"zoho_books_connection");
                 	if(createResp.get("code") == 101007)
                 	{
                 		cust.Zoho_Books_Vendor_ID="";
                 		for each  ship in Shipping_address[Vendor1 == cust.ID]
                 		{
                 			ship.Zoho_Books_Shipping_Address_ID="";
                 		}
                 		thisapp.books.createOrUpdateCustomerInBooks(cust.ID);
                 		cust = Vendor1[ID == cust.ID];
                 		if(cust.Zoho_Books_Vendor_ID == null || cust.Zoho_Books_Vendor_ID == "")
                 		{
                 			info "Customer recreation failed";
                 			return;
                 		}
                 		thisapp.books.syncVendorShippingAddresses(cust.ID);
                 		info "Customer was missing in Books. Re-sync completed. Run invoice sync again.";
                 		return;
                 	}
                 	else if(createResp.get("code") != 0)
                 	{
                 		info createResp;
                 		return;
                 	}
                 	inv.ZohoBooks_Invoice_ID=createResp.get("invoice").get("invoice_id");
                 	info "Invoice pushed successfully";
                 }
				 void books.syncVendorShippingAddresses(int vendorId)
                 {
                 	info "========== SHIPPING ADDRESS SYNC START ==========";
                 	info "Vendor ID = " + vendorId;
                 	intg = Zoho_Books_Setting[ID != null];
                 	if(intg == null)
                 	{
                 		info "Settings missing";
                 		return;
                 	}
                 	orgId = intg.Zoho_Books_Organization_ID;
                 	v = Vendor1[ID == vendorId];
                 	if(v == null)
                 	{
                 		info "Vendor not found";
                 		return;
                 	}
                 	info "Loaded Vendor ID = " + v.ID;
                 	info "Loaded Vendor Name = " + v.Vendor_Name;
                 	info "Loaded Books Contact ID = " + v.Zoho_Books_Vendor_ID;
                 	if(v.Zoho_Books_Vendor_ID == null || v.Zoho_Books_Vendor_ID == "")
                 	{
                 		info "Books Contact ID missing";
                 		return;
                 	}
                 	contactId = v.Zoho_Books_Vendor_ID;
                 	shippingList = Shipping_address[Vendor1 == v.ID];
                 	info "Shipping Address Count = " + shippingList.count();
                 	for each  shipRec in shippingList
                 	{
                 		info "Processing Shipping Address ID = " + shipRec.ID;
                 		addressMap = Map();
                 		addressMap.put("attention",ifnull(v.Vendor_Name,""));
                 		addressMap.put("address",ifnull(shipRec.Address.address_line_1,""));
                 		addressMap.put("street2",ifnull(shipRec.Address.address_line_2,""));
                 		addressMap.put("city",ifnull(shipRec.Address.district_city,""));
                 		stateName = "";
                 		if(v.Registered_Gst_State != null)
                 		{
                 			stateName = v.Registered_Gst_State.customer_s_registered_Gst_State;
                 		}
                 		if(stateName == "")
                 		{
                 			info "Registered GST State missing for customer";
                 			return;
                 		}
                 		addressMap.put("state",stateName);
                 		addressMap.put("zip",ifnull(shipRec.Address.postal_Code,""));
                 		addressMap.put("country",ifnull(shipRec.Address.country,""));
                 		if(shipRec.Shipping_Address_Display_Name != null && shipRec.Shipping_Address_Display_Name != "")
                 		{
                 			addressMap.put("address_name",shipRec.Shipping_Address_Display_Name);
                 		}
                 		if(shipRec.Shipping_GST != null && shipRec.Shipping_GST != "")
                 		{
                 			addressMap.put("gst_no",shipRec.Shipping_GST);
                 		}
                 		info addressMap;
                 		if(shipRec.Zoho_Books_Shipping_Address_ID == null || shipRec.Zoho_Books_Shipping_Address_ID == "")
                 		{
                 			resp = invokeurl
                 			[
                 				url :"https://www.zohoapis.in/books/v3/contacts/" + contactId + "/address?organization_id=" + orgId
                 				type :POST
                 				parameters:addressMap.toString()
                 				connection:"zoho_books_connection"
                 			];
                 			info resp;
                 			if(resp.get("code") == 0)
                 			{
                 				addressInfo = resp.get("address_info");
                 				if(addressInfo != null)
                 				{
                 					addressId = addressInfo.get("address_id");
                 					if(addressId != null)
                 					{
                 						shipRec.Zoho_Books_Shipping_Address_ID=addressId;
                 						info "Created Address ID = " + addressId;
                 					}
                 				}
                 			}
                 		}
                 	}
                 }
