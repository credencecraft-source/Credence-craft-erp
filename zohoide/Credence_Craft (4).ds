			buyer_price_validation as "buyer price validation"
			{
				type =  form
				form = Add_Quick_RawMaterial

				record event = on add

				on user input of Raw_Material_List.Buyer_Price
				{
					actions 
					{
						custom deluge script
						(
											// Check if Buyer Price is negative
										if(row.Buyer_Price < 0)
										{
											alert "Please enter a valid Buyer Price!";
										}
										else
										{
											// Get all matching vendor price records
											vendor_prices = Vendor_Wise_Price_List[Vendor_Master == row.Vendor1 && Raw_Material_Name == row.Raw_Material_Name];
											latest_time = null;
											latest_price = 0.0;
											latest_status = "";
											for each  v in vendor_prices
											{
												if(latest_time == null || v.Added_Time > latest_time)
												{
													latest_time = v.Added_Time;
													latest_price = v.Stock_UOM_Price;
													latest_status = v.Status;
												}
											}
											if(row.Buyer_Price < latest_price)
											{
												msg = "Warning: Entered Buyer Price (" + row.Buyer_Price + ") is lower than the latest vendor price (" + latest_price + ").";
												if(latest_status == "Draft")
												{
													msg = msg + "\n⚠️ NOTE: Latest vendor price is still in DRAFT status. Double-check before proceeding!";
												}
												alert msg;
											}
										}
						)
					}
				}

			}
