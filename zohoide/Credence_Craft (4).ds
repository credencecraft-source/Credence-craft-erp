			displayname = "Finished Goods Size wise"
			success message = "Data Added Successfully!"
			feature property = 128
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_No
			(
				type = picklist	
				displayname = "Order No"
				values  = Create_Order.ID
    			bidirectional = Finished_Goods_Size_wise
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 300px
			)
			Buyer_Size
			(
				type = picklist	
				displayname = "Buyer Size"
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
    			description
    			[
    				type = help_text
    			 	message = "Only change if buyer following diffrent size"
    			]
	 			row = 1
	 			column = 1   
				width = 100px
			)
			Ratio
			(
				type = number
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Size
			(
				type = picklist	
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Factory Size or pattern size"
    			]
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Before_Excess_Qty
			(
				type = number
				displayname = "Before Excess Qty"
    			description
    			[
    				type = tooltip
    			 	message = "Enter the Order Qty"
    			]
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Buyer_Po_Price
			(
				type = decimal
				displayname = "Buyer Po Price"
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Exchange_Price
			(
				type = decimal
				displayname = "Exchange Price"
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Price_In_INR
			(
				displayname = "Price In INR"
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = 100px
			)
			must have Excess
			(
    			type = percentage
				displayname = "Excess %"
	 			row = 1
	 			column = 1   
				width = 80px
			)
			must have Excess_Qty
			(
				type = number
				displayname = "Excess Qty"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = 80px
			)
			Total_Qty
			(
				type = number
				displayname = "Total Qty"
	 			row = 1
	 			column = 1   
				width = 80px
			)
			Plan_Qty
			(
				type = decimal
				displayname = "Plan Qty"
	 			row = 1
	 			column = 1   
				width = 80px
			)
			must have Currency_Type
			(
				type = picklist	
				displayname = "Currency Type"
				values  = Currency_Type.ID
    			displayformat = [Currency]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 100px
			)
			Cut_Qty
			(
				type = decimal
				displayname = "Cut Qty"
	 			row = 1
	 			column = 1   
				width = 80px
			)
			Finised_Goods_Barcode
			(
    			type = text
				displayname = "Finised Goods Barcode"
	 			row = 1
	 			column = 2   
				width = 200px
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Order_No}"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Backend_Data
			(
				type = section
				displayname = "Backend Data"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Work_Order_Status
			(
				type = picklist
				displayname = "Work Order Status"
				maxchar = 100
				values = {"Partially Created","Fully Created","Not Create"}
				initial value = "Not Create"
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Bulk_Order
			(
				type = picklist	
				displayname = "Bulk Order"
				values  = Bulk_Order.ID
    			displayformat = [EO_No]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Gold_Seal
			(
				type = picklist	
				displayname = "Gold Seal"
				values  = Gold_Seal.ID
    			displayformat = [Gold_Seals_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Season
			(
				type = picklist	
				values  = Season.ID
    			displayformat = [Seasi]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Buyer1
			(
				type = picklist	
				displayname = "Buyer"
				values  = Buyer1.ID
    			displayformat = [Buyer_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Style_Name
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Colors
			(
				type = picklist	
				values  = Colors.ID
    			displayformat = [Colors]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 200px
			)
			Value
			(
				type = INR
				format = commadotwestern
	 			row = 2
	 			column = 1   
				width = 200px
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
