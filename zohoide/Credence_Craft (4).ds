				 void calculateMonthlyAttendanceSummary(int attendanceMasterId)
                 {
                 	// ================= FETCH MASTER =================
                 	att = Attendance_Master[ID == attendanceMasterId];
                 	if(att == null || att.Employee_No1 == null || att.Month_Master == null || att.Yearmasterlookup == null)
                 	{
                 		return;
                 	}
                 	// ================= GET EMPLOYEE NUMBER FROM LOOKUP =================
                 	empRec = Employee_Name[ID == att.Employee_No1];
                 	if(empRec == null || empRec.Employee_No == null)
                 	{
                 		return;
                 	}
                 	empNo = empRec.Employee_No;
                 	// ================= DATE RANGE =================
                 	selMonth = att.Month_Master.Month_Name;
                 	selYear = att.Yearmasterlookup.Year_field.toLong();
                 	startDate = ("01-" + selMonth + "-" + selYear).toDate("dd-MMMM-yyyy");
                 	endDate = startDate.addMonth(1).addDay(-1);
                 	// ================= STATUS COUNTS =================
                 	present_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Present"].count();
                 	absent_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Absent"].count();
                 	leave_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Leave"].count();
                 	holiday_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Holiday"].count();
                 	weeklyoff_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Weekly_Off"].count();
                 	latein_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Late_In"].count();
                 	earlyout_count = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate && Status == "Early_Out"].count();
                 	att.Present=present_count;
                 	att.Absent=absent_count;
                 	att.Leave=leave_count;
                 	att.Holiday=holiday_count;
                 	att.Weakly_Off=weeklyoff_count;
                 	// ================= PENALTY =================
                 	total_penalty = latein_count + earlyout_count;
                 	att.Total_Penalty=total_penalty;
                 	att.Present_Due_to_Penalty=floor(total_penalty / 2);
                 	// ================= TOTAL DAYS =================
                 	total_days = ((endDate.toLong() - startDate.toLong()) / 86400000).toLong() + 1;
                 	att.Total_Number_of_days=total_days;
                 	recorded_days = present_count + absent_count + leave_count + holiday_count + weeklyoff_count;
                 	no_records = total_days - recorded_days;
                 	if(no_records < 0)
                 	{
                 		no_records = 0;
                 	}
                 	att.No_Records=no_records;
                 	// ================= GRAND TOTAL =================
                 	grandPresent = present_count + att.Present_Due_to_Penalty;
                 	if(grandPresent > total_days)
                 	{
                 		grandPresent = total_days;
                 	}
                 	att.Grand_Total_Present1=grandPresent;
                 	att.Grand_Total_Absent1=total_days - grandPresent;
                 	// ================= TOTAL FINAL DURATION =================
                 	totalMinutes = 0;
                 	logs = Attendance_Logs[Employee_Id == empNo && Date_field >= startDate && Date_field <= endDate];
                 	for each  l in logs
                 	{
                 		if(l.Final_Duration != null && l.Final_Duration.toString() != "")
                 		{
                 			fdStr = l.Final_Duration.toString();
                 			h = fdStr.subString(0,2).toLong();
                 			m = fdStr.subString(3,5).toLong();
                 			totalMinutes = totalMinutes + h * 60 + m;
                 		}
                 	}
                 	if(totalMinutes > 0)
                 	{
                 		att.Total_Duration2=(totalMinutes / 60.0).round(2);
                 	}
                 	else
                 	{
                 		att.Total_Duration2=0;
                 	}
                 	// ================= DAILY SNAPSHOT =================
                 	logText = "";
                 	for each  l in logs
                 	{
                 		line = l.Date_field.toString("dd-MM-yyyy") + " | ";
                 		if(l.In_Time != null)
                 		{
                 			line = line + l.In_Time.toString("HH:mm");
                 		}
                 		else
                 		{
                 			line = line + "00:00";
                 		}
                 		line = line + " | ";
                 		if(l.Out_Time != null)
                 		{
                 			line = line + l.Out_Time.toString("HH:mm");
                 		}
                 		else
                 		{
                 			line = line + "00:00";
                 		}
                 		if(l.Status != null)
                 		{
                 			line = line + " | " + l.Status;
                 		}
                 		logText = logText + line + "\n";
                 	}
                 	att.Attedence_Logs=logText;
                 }
				 void check_size_consistency_by_group(int gm_id)
                 {
                 	// Initialize list to store child sizes
                 	sizeList = List();
                 	// Fetch the Group_Measurements record by ID
                 	gmRec = Group_Measurements[ID == gm_id];
                 	if(gmRec != null)
                 	{
                 		// Loop through all child rows in the Students subform
                 		for each  row in gmRec.Students
                 		{
                 			if(row.Size != null)
                 			{
                 				sizeList.add(row.Size.toString());
                 			}
                 		}
                 		// Only proceed if there are sizes
                 		if(sizeList.size() > 0)
                 		{
                 			firstTxt = sizeList.get(0);
                 			allSame = true;
                 			// Check if all sizes are identical
                 			for each  s in sizeList
                 			{
                 				if(s != firstTxt)
                 				{
                 					allSame = false;
                 					break;
                 				}
                 			}
                 			// Update header Size field
                 			if(allSame)
                 			{
                 				gmRec.Size=firstTxt;
                 			}
                 			else
                 			{
                 				gmRec.Size=null;
                 			}
                 		}
                 	}
                 	else
                 	{
                 		info "Group_Measurements record not found for ID: " + gm_id;
                 	}
                 }
