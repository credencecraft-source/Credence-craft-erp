			GRN_Allocation_C_E_Succes as "GRN Allocation (C/E)-Success"
			{
				type =  form
				form = GRN_Allocation

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											get_gate_entry_subform = Gate_Entry_Subform[ID == input.GRN_Verification.Rm_Unique_Id];
										if(get_gate_entry_subform.ID != null)
										{
											sum_of_allocate_qty = GRN_Allocation[GRN_Verification.Rm_Unique_Id == get_gate_entry_subform.ID].sum(Verification_Allocated);
											get_gate_entry_subform.Allocated=sum_of_allocate_qty;
										}
										for each  each_location in input.Material_Allocation
										{
											thisapp.order_controllar.update_raw_material_allocation(each_location.Grouping_Subform_ID.Order_Raw_material_ID);
										}
						)
					}
				}

			}
			GRN_Allocation_C_Validati as "GRN Allocation (C)-Validation"
			{
				type =  form
				form = GRN_Allocation

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grn_allocation = GRN_Allocation[GRN_Verification_Subform_ID == input.GRN_Verification_Subform_ID];
										if(get_grn_allocation.ID != null)
										{
											alert "The system does not allow to allocate duplicate grn verification.";
											cancel submit;
										}
										if(input.Allocated_Qty != input.Verification_Allocated)
										{
											alert "Mismatch between allocated and verified qty.";
											cancel submit;
										}
										else
										{
											for each  each_allocation in input.Material_Allocation
											{
												sum_of_already_allocate = Style_Wise_Inventory[Grouping_Subform_ID == each_allocation.Grouping_Subform_ID && GRN_Allocation_ID != null].sum(Allocate);
												total_allocate = sum_of_already_allocate + ifnull(each_allocation.Allocate,0);
												if(total_allocate > each_allocation.Grouping_Subform_ID.Grouped_Qty)
												{
													alert "Total allocation exceeds allowed Grouped Quantity for " + each_allocation.Grouping_Subform_ID.Grouped_Qty + ", please refersh and check it.";
													cancel submit;
													break;
												}
											}
										}
						)
					}
				}

			}
