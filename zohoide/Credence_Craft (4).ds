				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size_Wise_Concemption
			(
    			type = checkbox
				displayname = "Size Wise Concemption"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size_Wise_Consemption_Master
			(
				type = picklist	
				displayname = "Size Wise Consemption Master"
				values  = Size_Wise_Consemption_Master.ID
    			displayformat = [Bom_Template_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Brand1
			(
				type = list	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Show_All1
			(
    			type = checkbox
				displayname = "Show All"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Workdrive_Image_ID
			(
    			type = text
				displayname = "Workdrive Image ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Buyer_Item_Code
			(
    			type = text
				displayname = "Buyer Item Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image_Url
			(
    			type = url
				displayname = "Image Url"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Code
			(
    			type = text
				displayname = "Item Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Colour
			(
				type = picklist	
				values  = Colors.ID
    			displayformat = [Colors]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Create_open_stock
			(
				type = radiobuttons
				maxchar = 100
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Open_Stock
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Open_Stock_Price
			(
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor_Wise_Price_List
			(
				type = grid
				displayname = "Vendor Wise Price List"
				values  = Vendor_Wise_Price_List.ID
    			bidirectional = Raw_Material_Name
				viewtype = list
	 			row = 2
	 			column = 1   
				width = medium
			)
			Backend_Data
			(
				type = section
				displayname = "Backend Data"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			RM_Support_No
			(
    			type = autonumber
				displayname = "RM Support No"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Is_This_Size_wise
			(
				type = picklist	
				displayname = "Is This Size wise"
				values  = Size_Group.ID
    			displayformat = [Size_Group]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			RM_No
			(
    			type = formula
				displayname = "RM No"
				value =  "RM0" + input.RM_Support_No
				visibility = false
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Approved","Rejected"}
				initial value = "Draft"
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
