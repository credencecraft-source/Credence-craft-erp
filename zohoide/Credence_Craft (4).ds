			Approve_in_Lower_Buyer_Co as "Approve in Lower Buyer Consumption"
			{
				type =  functions
				form = Approve_Internal_Consumption_Subform
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						get_order_raw = Order_Raw_material[Raw_Material_Name == input.Approve_internal_consumption_and_price_ID.Raw_Material && Order_No == input.Order_No];
										if(get_order_raw.ID != null)
										{
											input.Buyer_Consumption_Approve_Status = "Approved";
											get_order_raw.Buyer_Consumption_Status="Approved";
											if(get_order_raw.Internal_Consumption_Status == "Approved" && get_order_raw.Buyer_Consumption_Status == "Approved" && get_order_raw.Price_Status == "Approved")
											{
												get_order_raw.Raw_material_Status="Approved";
											}
											else
											{
												get_order_raw.Raw_material_Status="Draft";
											}
											get_order_raw.Buyer_Consumption=input.Buyer_Consumption1;
											get_order_raw.Buyer_Price=input.Buyer_Price;
											thisapp.order_controllar.order_raw_material_field_calculate(get_order_raw.ID);
											thisapp.costing_controllar.create_costing(input.Order_No);
											thisapp.order_controllar.update_eo_no_level(input.Order_No.Eo_No_and_Name,input.Order_No.Article);
										}
										// 	thisapp.order_controllar.create_costing(each_item.Order_No);
										// 	thisapp.order_controllar.update_eo_no_level(each_item.Order_No.Eo_No_and_Name,each_item.Order_No.Gold_Seal);
					)
					}
				}
			}
