				 void add_raw_material(Create_Order order_list)
                 {
                 	selected_count = order_list.count();
                 	rec = Pricing[Month_field == month(zoho.currentdate) && Year_field == year(zoho.currentdate)];
                 	if(rec.count() == 0)
                 	{
                 		info "No active plan found. Please activate a plan.";
                 		return;
                 	}
                 	for each  r in rec
                 	{
                 		if(r.Plan_Features == null)
                 		{
                 			info "No plan selected. Please select a plan in Pricing.";
                 			return;
                 		}
                 		current_plan = r.Plan_Features.Plan_Name;
                 		// ===== HARD CODE PLAN LIMITS =====
                 		limit_value = 0;
                 		if(current_plan == "Free")
                 		{
                 			limit_value = 2;
                 		}
                 		else if(current_plan == "Basic")
                 		{
                 			limit_value = 5;
                 		}
                 		else if(current_plan == "Professional")
                 		{
                 			limit_value = 40;
                 		}
                 		else if(current_plan == "Enterprises")
                 		{
                 			limit_value = 50;
                 		}
                 		else
                 		{
                 			info "Plan not recognized.";
                 			return;
                 		}
                 		if(selected_count > limit_value)
                 		{
                 			info "Your current plan (" + current_plan + ") allows maximum " + limit_value + " Bulk BOM updates.";
                 			return;
                 		}
                 	}
                 	openUrl("#Form:Add_Quick_RawMaterial?Order_No=" + order_list.ID.getall(),"popup window","height=100%,width=100%");
                 }
				 void Adjust_leaveto_employes(int empId, date attDate)
                 {
                 	info "DEBUG: Adjust_leaveto_employes | Emp=" + empId + " | Date=" + attDate;
                 	yr = attDate.getYear();
                 	// 1) find main leave balance record
                 	leave_rec = Leave_Balance[Employee_Id == empId];
                 	if(leave_rec == null)
                 	{
                 		info "⚠️ No Leave_Balance record for Emp=" + empId;
                 		return;
                 	}
                 	// 2) read values
                 	credited_val = ifnull(leave_rec.Credited,0);
                 	utilised_val = ifnull(leave_rec.Utilised,0);
                 	balance_val = ifnull(leave_rec.Balance,credited_val - utilised_val);
                 	if(balance_val <= 0)
                 	{
                 		info "⚠️ No balance available for Emp=" + empId;
                 		return;
                 	}
                 	// 3) adjust balance
                 	new_utilised = utilised_val + 1;
                 	new_balance = credited_val - new_utilised;
                 	if(new_balance < 0)
                 	{
                 		new_balance = 0;
                 	}
                 	leave_rec.Utilised=new_utilised;
                 	leave_rec.Balance=new_balance;
                 	// 4) update subform (Applied_On is multiline text)
                 	found_row = false;
                 	for each  row in leave_rec.Leave_Subform
                 	{
                 		if(row.Year_form == yr)
                 		{
                 			applied_str = ifnull(row.Applied_On,"");
                 			if(applied_str != "")
                 			{
                 				// Append with newline instead of comma for better readability
                 				applied_str = applied_str + "\n" + attDate.toString("dd-MMM-yyyy");
                 			}
                 			else
                 			{
                 				applied_str = attDate.toString("dd-MMM-yyyy");
                 			}
                 			row.Applied_On=applied_str;
                 			found_row = true;
                 			break;
                 		}
                 	}
                 	if(found_row == false)
                 	{
                 		new_row = Map();
                 		new_row.put("Year_form",yr);
                 		new_row.put("Applied_On",attDate.toString("dd-MMM-yyyy"));
                 		leave_rec.Leave_Subform.insert(new_row);
                 	}
                 	info "✅ Leave consumed | Emp=" + empId + " | Year=" + yr + " | Utilised=" + new_utilised + " | Balance=" + new_balance;
                 }
