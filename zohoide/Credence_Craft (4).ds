						custom deluge script
						(
											get_all_raw_material_order = Order_Raw_material[Order_No == input.Order_No && Raw_Material_Name == row.Raw_Material_Name];
										if(get_all_raw_material_order.ID != null)
										{
											alert "The system does not allow duplicate raw material (please check order)..!";
											row.Raw_Material_Name=null;
										}
										else
										{
											getRawMaterial = {};
											for each  rec in input.Raw_Material_List
											{
												checkVal = rec.Raw_Material_Name;
												if(!getRawMaterial.contains(checkVal))
												{
													getRawMaterial.add(checkVal);
												}
												else
												{
													alert "The system does not allow duplicate raw material..!";
													row.Raw_Material_Name=null;
													break;
												}
											}
										}
										/* ? AUTO UPDATE FROM RAW MATERIAL */
										if(row.Raw_Material_Name != null)
										{
											row.Uom=row.Raw_Material_Name.Stock_Uom1;
											row.Category_Type1=row.Raw_Material_Name.Category_Type;
											row.Category=row.Raw_Material_Name.Category;
											// Optional safety: align subcategory with selected raw material
											if(row.Subcategory1 == null)
											{
												row.Subcategory1=row.Raw_Material_Name.Subcategory;
											}
										}
						)
					}
				}

			}
