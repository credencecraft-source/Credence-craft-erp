				 float order_controllar.calculate_size_wise_consumption(int order_id, int size_wise_master_id)
                 {
                 	total_qty = 0.0;
                 	total_consumption = 0.0;
                 	// ORDER SIZE QTY
                 	get_order_sizes = Finished_Goods_Size_wise[Order_No == order_id];
                 	for each  each_size in get_order_sizes
                 	{
                 		order_qty = ifnull(each_size.Total_Qty,0);
                 		size_consumption = 0.0;
                 		// MASTER CONSUMPTION
                 		get_master = Size_Wise_Consemption_Master_subfrom[Size_Wise_Consemption_Master.ID == size_wise_master_id && Size.ID == each_size.Size.ID];
                 		for each  each_master in get_master
                 		{
                 			size_consumption = ifnull(each_master.Consemption,0);
                 			break;
                 		}
                 		total_qty = total_qty + order_qty;
                 		total_consumption = total_consumption + order_qty * size_consumption;
                 	}
                 	final_avg_consumption = 0.0;
                 	if(total_qty > 0)
                 	{
                 		final_avg_consumption = total_consumption / total_qty;
                 	}
                 	return final_avg_consumption;
                 }
				 void order_controllar.create_check_list(int order_id)
                 {
                 	get_order = Create_Order[ID == order_id];
                 	if(get_order.ID != null)
                 	{
                 		get_brand = Brand1[ID == get_order.Brand];
                 		if(get_brand.ID != null)
                 		{
                 			for each  each_check_list in get_brand.Pre_Order_Checklist1
                 			{
                 				get_order_check_list = Order_Pre_Order_Check_List[Create_Order == get_order.ID && Check_List_Name1 == each_check_list.ID];
                 				if(get_order_check_list.ID == null)
                 				{
                 					insert_checklist = insert into Order_Pre_Order_Check_List
                 					[
                 						Create_Order=get_order.ID
                 						Check_List_Name1=each_check_list.ID
                 						Status="Draft"
                 						Added_User=zoho.loginuser
                 					];
                 				}
                 			}
                 		}
                 	}
                 }
				 void order_controllar.detectOnlineOrderChanges(int work_order_id)
                 {
                 	// -------------------------------
                 	// FETCH WORK ORDER
                 	// -------------------------------
                 	get_wo = Work_Order_New[ID == work_order_id];
                 	if(get_wo.ID == null || get_wo.Create_Order == null)
                 	{
                 		return;
                 	}
                 	// -------------------------------
                 	// FETCH CREATE ORDER
                 	// -------------------------------
                 	get_order = Create_Order[ID == get_wo.Create_Order];
                 	if(get_order.ID == null)
                 	{
                 		return;
                 	}
                 	// -------------------------------
                 	// FETCH ONLINE ORDER
                 	// -------------------------------
                 	online_rec = Online_Order_Create_order[Order_No == get_order.ID];
                 	if(online_rec.ID == null)
                 	{
                 		return;
                 	}
                 	changesFound = false;
                 	changeMsg = "";
                 	// ---------- CREATE ORDER HEADER CHECK ----------
                 	if(online_rec.Price != get_order.Fob)
                 	{
                 		changesFound = true;
                 		changeMsg = changeMsg + "\n• Price changed : " + online_rec.Price + " → " + get_order.Fob;
                 	}
                 	if(online_rec.Qty != get_order.Order_Qty)
                 	{
                 		changesFound = true;
                 		changeMsg = changeMsg + "\n• Order Qty changed : " + online_rec.Qty + " → " + get_order.Order_Qty;
                 	}
                 	if(online_rec.Style_Name != get_order.Style_Name)
                 	{
                 		changesFound = true;
                 		changeMsg = changeMsg + "\n• Style changed : " + online_rec.Style_Name + " → " + get_order.Style_Name;
                 	}
                 	if(online_rec.Entity1 != get_order.Entity_Name.Entity_Name)
                 	{
                 		changesFound = true;
                 		changeMsg = changeMsg + "\n• Entity changed : " + online_rec.Entity1 + " → " + get_order.Entity_Name.Entity_Name;
                 	}
                 	// ---------- SIZE-WISE CHECK ----------
                 	wo_sizes = Wo_Order_Size_Wise_Qty[Work_Order_No == get_wo.ID];
                 	for each  ws in wo_sizes
                 	{
                 		found = false;
                 		for each  os in online_rec.SubForm
                 		{
                 			if(os.Size == ws.Size.Size)
                 			{
                 				found = true;
                 				if(os.Qty != ws.Work_Order_Qty)
                 				{
                 					changesFound = true;
                 					changeMsg = changeMsg + "\n• Size " + ws.Size.Size + " qty changed : " + os.Qty + " → " + ws.Work_Order_Qty;
                 				}
                 				break;
                 			}
                 		}
                 		if(found == false)
                 		{
                 			changesFound = true;
                 			changeMsg = changeMsg + "\n• New size added : " + ws.Size.Size + " (Qty " + ws.Work_Order_Qty + ")";
                 		}
                 	}
                 	// ---------- RAW MATERIAL COUNT CHECK ----------
                 	onlineRmCount = 0;
                 	for each  orow in online_rec.SubForm1
                 	{
                 		onlineRmCount = onlineRmCount + 1;
                 	}
                 	rmCount = 0;
                 	for each  rm in Order_Raw_material[Order_No == get_order.ID]
                 	{
                 		rmCount = rmCount + 1;
                 	}
                 	if(onlineRmCount != rmCount)
                 	{
                 		changesFound = true;
                 		changeMsg = changeMsg + "\n• Raw material details updated";
                 	}
                 	// ---------- FINAL RESULT ----------
                 	if(changesFound == true)
                 	{
                 		online_rec.Changes_Availale=true;
                 		online_rec.Date_Time=zoho.currenttime;
                 		info "⚠ Changes detected. Please review and approve to apply updates." + changeMsg;
                 	}
                 	else
                 	{
                 		info "✅ No changes detected. Online Order is already up to date.";
                 	}
                 }
				 void order_controllar.excess_status_update(int order_raw_material_id)
                 {
                 	get_order_raw_material = Order_Raw_material[ID == order_raw_material_id];
                 	if(get_order_raw_material.ID != null)
                 	{
                 		get_grn = Gate_Entry_Subform[Grn_Status_Item_Wise.Order_Raw_Material_ID.contains(get_order_raw_material.ID) && Gate_Entry_No1 != null];
                 		get_excess = Excess_Inventory[RM_Unique == get_grn.ID.getall()];
                 		if(get_excess.ID != null)
