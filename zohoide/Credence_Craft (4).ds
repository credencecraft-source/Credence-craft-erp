                 {
                 }
				 void work_order_controllar.DeletePick(int idVal)
                 {
                 	getPackList = Centralized_Pick_list[WO_No == idVal];
                 	if(getPackList.count() > 0)
                 	{
                 		woSub = Work_Order_Rawmateril[Work_Order_No == idVal && Raw_Materil_Name != getPackList.Raw_Material1];
                 	}
                 	else
                 	{
                 		woSub = Work_Order_Rawmateril[Work_Order_No == idVal];
                 	}
                 	for each  rec in woSub
                 	{
                 		rec.Requested=0;
                 		rec.Balance_To_Request=rec.Wo_Required - rec.Requested;
                 		if(ifnull(rec.Wo_Required,0) == ifnull(rec.Balance_To_Request,0))
                 		{
                 			rec.Pick_Status="Not Requested";
                 		}
                 		else if(rec.Balance_To_Request == 0)
                 		{
                 			rec.Pick_Status="Fully Requested";
                 		}
                 		else if(ifnull(rec.Wo_Required,0) > ifnull(rec.Balance_To_Request,0))
                 		{
                 			rec.Pick_Status="Partially Requested";
                 		}
                 	}
                 }
				 void work_order_controllar.finished_item_work_order_status_update(int finished_style_item_id)
                 {
                 	get_finished_style_item = Finished_Goods_Size_wise[ID == finished_style_item_id];
                 	if(get_finished_style_item.ID != null)
                 	{
                 		sum_of_work_order_qty = Wo_Order_Size_Wise_Qty[Finished_Goods_Size_ID == get_finished_style_item.ID && Work_Order_No != null].sum(Work_Order_Qty);
                 		if(sum_of_work_order_qty >= get_finished_style_item.Total_Qty)
                 		{
                 			get_finished_style_item.Work_Order_Status="Fully Created";
                 		}
                 		else
                 		{
                 			if(sum_of_work_order_qty > 0)
                 			{
                 				get_finished_style_item.Work_Order_Status="Partially Created";
                 			}
                 			else
                 			{
                 				get_finished_style_item.Work_Order_Status="Not Create";
                 			}
                 		}
                 	}
                 }
				 void work_order_controllar.recalculate_wo_required_qty()
                 {
                 }
				 void work_order_controllar.updateWorkOrderStatus(int idVal)
                 {
                 	rmPlanSheet = Rm_Plan_Sheet[ID == input.idVal];
                 	for each  rec in rmPlanSheet.SubForm
                 	{
                 		createPick = insert into Centralized_Pick_list
                 		[
                 			Added_User=zoho.loginuser
                 			Style_No=rec.Style_Name
                 			Order_No=rec.Order_No
                 			Brand1=rec.Order_No.Brand
                 			Buyer1=rec.Order_No.Buyer1
                 			Category1=rec.Raw_Material1.Category
                 			Raw_Material1=rec.Raw_Material1
                 			WO_No=rec.Work_Order_No
                 			Create_Eo_No=rec.Order_No.Eo_No_and_Name
                 			Factory=rmPlanSheet.Factory
                 			Planned_Dispatch_Date=rmPlanSheet.Planned_Dispatch_Date
                 			Planned_Cut_Date=rmPlanSheet.Planned_Cut_Date
                 			Subcategory1=rec.Subcategory1
                 			RM_No=rec.Raw_Material1
                 			Requested=rec.Balance_to_Request
                 			Status="Draft"
                 			Source="From Work Order"
                 		];
                 		createRec = insert into Pick_List_Subform
                 		[
                 			Added_User=zoho.loginuser
                 			RMA_No=createPick
                 			Entity_Delivery_Address=rec.Entity_Delivery_Address
                 			Rack=rec.Rack
                 			Allocated=rec.Wo_Required
                 			Stock_Available_in_Allocated=rec.Wo_Required
                 			Warehouse_Location=rec.Warehouse_Location
                 			Raw_Material1=rec.Raw_Material1
                 			Style_Name=rec.Style_Name
                 			Rack_Bin=rec.Rack_Bin
                 			Order_No1=rec.Order_No
                 		];
                 		// 		getPickList = Pick_List_Subform[ID == createRec];
                 		thisapp.work_order_controllar.woSubStatus(createPick);
                 	}
                 	thisapp.work_order_controllar.woStatus(rmPlanSheet.Wo_Order_No);
                 }
				 void work_order_controllar.woStatus(int idVal)
                 {
                 	// ---- Work Order ----
                 	getWorkOrder = Work_Order_New[ID == idVal];
                 	if(getWorkOrder.ID == null)
                 	{
                 		return;
                 	}
                 	// ---- Work Order Raw Materials ----
                 	getWOSubStatus = Work_Order_Rawmateril[Work_Order_No == idVal];
                 	// ---- NULL SAFE SUMS ----
                 	totalRequired = ifnull(getWOSubStatus.sum(Wo_Required),0);
                 	totalRequested = ifnull(getWOSubStatus.sum(Requested),0);
                 	// ---- NULL SAFE SUBTRACTION ----
                 	Balance = totalRequired - totalRequested;
                 	// ---- Status Update ----
                 	if(totalRequired > 0 && Balance == 0)
                 	{
                 		getWorkOrder.Pick_List_Status="Fully Requested";
                 	}
                 	else if(Balance == totalRequired)
                 	{
                 		getWorkOrder.Pick_List_Status="Not Requested";
                 	}
                 	else if(totalRequired > Balance)
                 	{
                 		getWorkOrder.Pick_List_Status="Partially Requested";
                 	}
                 }
				 void work_order_controllar.woSubStatus(int pickList)
                 {
                 	getPackList = Centralized_Pick_list[ID == pickList];
                 	woSub = Work_Order_Rawmateril[Work_Order_No = getPackList.WO_No && Raw_Materil_Name == getPackList.Raw_Material1];
                 	getPackSub = Pick_List_Subform[RMA_No == pickList];
                 	getWOSub = Work_Order_Rawmateril[Work_Order_No == getPackList.WO_No && Raw_Materil_Name == getPackList.Raw_Material1];
                 	getWOSub.Requested=getPackSub.Allocated;
                 	getWOSub.Balance_To_Request=ifnull(woSub.Wo_Required,0) - ifnull(getWOSub.Requested,0);
                 	if(ifnull(getWOSub.Wo_Required,0) == ifnull(getWOSub.Balance_To_Request,0))
                 	{
                 		getWOSub.Pick_Status="Not Requested";
                 	}
                 	else if(getWOSub.Balance_To_Request == 0)
                 	{
                 		getWOSub.Pick_Status="Fully Requested";
                 	}
                 	else if(ifnull(getWOSub.Requested,0) > ifnull(getWOSub.Balance_To_Request,0))
                 	{
                 		getWOSub.Pick_Status="Partially Requested";
                 	}
                 }
				 void work_order_controllar.Wo_Style_Wise_Inveroey(int idVal)
                 {
                 	getStyle = Style_Wise_Inventory[ID == idVal];
                 	getStyleSub = Style_wise_inventory_Subfrom_out_word[Style_Wise_Inventory == getStyle.ID].sum(Picked_Qty);
                 	getStyle.Already_Allocated=getStyleSub;
                 	getStyle.Balance_To_Allocate=ifnull(getStyle.Allocate,0) - getStyleSub;
                 	getStyle.Stock_Available_In_Allocated=ifnull(getStyle.Allocate,0) - getStyle.Already_Allocated;
                 	getStyle.Picked=getStyleSub;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Create_Or_Edit2 as "Create Or Edit"
			{
				type =  form
				form = Employes_Measurements

				record event = on add or edit

				on user input of Measurement_Chart_template
				{
					actions 
					{
						custom deluge script
						(
											// Clear existing subform rows
										clear Employes_Measurements_subform;
										if(input.Measurement_Chart_template != null)
										{
											templateRec = Measurement_Chart[ID == input.Measurement_Chart_template];
											// Areas picked at the template (multi-select)
											selected_measurement_areas = templateRec.Measurement_Area;
											// All rows in the template's chart subform (has Area, Size, Min, Max)
											chartRows = templateRec.Measurement_Chart_subform;
											// Build rows in Employees subform
											for each  each_area in selected_measurement_areas
											{
												// Compute Min (overall min of mins) and Max (overall max of maxes) for this area
												minVal = null;
												maxVal = null;
												for each  cr in chartRows
												{
													if(cr.Measurement_Area == each_area)
													{
														if(cr.Min != null && minVal == null || cr.Min < minVal)
														{
															minVal = cr.Min;
														}
														if(cr.Max != null && maxVal == null || cr.Max > maxVal)
														{
															maxVal = cr.Max;
														}
													}
												}
												newrow = Employes_Measurements.Employes_Measurements_subform();
												newrow.Measurement_Area2=each_area;
												// ? Replace with your exact field names if needed
												newrow.Min=minVal;
												newrow.Max=maxVal;
												rows = Collection();
												rows.insert(newrow);
												input.Employes_Measurements_subform.insert(rows);
											}
										}
						)
					}
				}

			}
			Create_or_Edit3 as "Create or Edit"
			{
				type =  form
				form = Measurement_Chart

				record event = on add or edit

				on user input of Size_Group
				{
					actions 
					{
						custom deluge script
						(
											// Clear existing subform rows
										clear Measurement_Chart_subform;
										// Disable Measurement Area once Size Group is selected
										if(input.Size_Group != null)
										{
											disable Measurement_Area;
										}
										// Fetch sizes for selected Size_Group
										get_size_all = Size_Group_Subform[Size_Group_ID == input.Size_Group] sort by Sort_No asc;
										// Get Measurement Areas (multi-select field at header level)
										selected_measurement_areas = input.Measurement_Area;
										// Loop through each Measurement Area
										for each  each_area in selected_measurement_areas
										{
											// Loop through each size
											for each  each_size in get_size_all
											{
												newrow = Measurement_Chart.Measurement_Chart_subform();
												newrow.Measurement_Area=each_area;
												newrow.Size=each_size.Size_No;
												rows = Collection();
												rows.insert(newrow);
												input.Measurement_Chart_subform.insert(rows);
											}
										}
						)
					}
				}

			}
			predict as "predict"
			{
				type =  form
				form = Employes_Measurements

				record event = on add or edit

				on user input of Employes_Measurements_subform.Input_field
				{
					actions 
					{
						custom deluge script
						(
											if(row.Input_field != null && row.Measurement_Area2 != null && input.Measurement_Chart_template != null)
										{
											// Fetch the selected Measurement Chart
											templateRec = Measurement_Chart[ID == input.Measurement_Chart_template];
											if(templateRec.ID != null)
											{
												chartRows = templateRec.Measurement_Chart_subform;
												matchSize = null;
												// Loop through chart rows
												for each  cr in chartRows
												{
													if(cr.Measurement_Area == row.Measurement_Area2 && row.Input_field >= cr.Min && row.Input_field <= cr.Max)
													{
														matchSize = cr.Size;
														break;
													}
												}
												// Update size prediction
												if(matchSize != null)
												{
													row.Size_Prediction=matchSize;
												}
												else
												{
													row.Size_Prediction=null;
													// no matching size found
												}
											}
										}
						)
					}
				}

			}
			Submit as "Submit"
			{
				type =  form
				form = Employes_Measurements

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ? On Submit: summarize header size status
										allSizes = List();
										// Collect all Size_Prediction values from subform
										for each  row in input.Employes_Measurements_subform
										{
											if(row.Size_Prediction != null)
											{
												// ✅ since it's a Number field
												allSizes.add(row.Size_Prediction);
												// keep as number
											}
										}
										// Remove duplicates
										uniqueSizes = allSizes.distinct();
										// Update header based on uniqueness
										if(uniqueSizes.size() == 1 && allSizes.size() > 0)
										{
											input.Size = uniqueSizes.get(0);
											// assign the size
											input.Status = "Perfect Fit";
										}
										else
										{
											input.Size = null;
											input.Status = "Mismatch";
										}
						)
					}
				}

			}
