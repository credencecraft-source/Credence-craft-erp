			Price1 as "Price"
			{
				type =  form
				form = Purchase_Bill

				record event = on add or edit

				on user input of Bills.Price
				{
					actions 
					{
						custom deluge script
						(
											// ================= ROW LEVEL =================
										row.Before_Tax=ifnull(row.Qty,0) * ifnull(row.Price,0);
										gst_percent = 0;
										if(row.Gst != null)
										{
											gst_percent = ifnull(row.Gst.Gst,0);
										}
										row.Tax=(row.Before_Tax * gst_percent) / 100;
										// Vendor GST type
										vendor_gst_type = "";
										if(input.Vendor1 != null)
										{
											vendor_gst_type = ifnull(input.Vendor1.New_GST_Type.gst_type,"");
										}
										// GST split
										if(vendor_gst_type == "CGST & SGST")
										{
											row.CGST=row.Tax / 2;
											row.SGST=row.Tax / 2;
											row.IGST=0;
										}
										else if(vendor_gst_type == "IGST")
										{
											row.CGST=0;
											row.SGST=0;
											row.IGST=row.Tax;
										}
										else
										{
											row.CGST=0;
											row.SGST=0;
											row.IGST=0;
										}
										// With Tax
										row.With_Tax=ifnull(row.Before_Tax,0) + ifnull(row.Tax,0);
										// ================= HEADER TOTALS =================
										before_tax_total = 0;
										tax_total = 0;
										cgst_total = 0;
										sgst_total = 0;
										igst_total = 0;
										with_tax_total = 0;
										for each  r in input.Bills
										{
											before_tax_total = before_tax_total + ifnull(r.Before_Tax,0);
											tax_total = tax_total + ifnull(r.Tax,0);
											cgst_total = cgst_total + ifnull(r.CGST,0);
											sgst_total = sgst_total + ifnull(r.SGST,0);
											igst_total = igst_total + ifnull(r.IGST,0);
											with_tax_total = with_tax_total + ifnull(r.With_Tax,0);
										}
										input.Before_Tax = before_tax_total;
										input.TAX = tax_total;
										input.CGST = cgst_total;
										input.SGST = sgst_total;
										input.IGST = igst_total;
										input.Total = with_tax_total;
										input.Grand_Total1 = with_tax_total + ifnull(input.Other_charges,0);
										// ================= NET PAYABLE CALCULATION =================
										total_debit = ifnull(input.Auto_Debit_Note,0) + ifnull(input.Manual_Debit_Note,0);
										input.Total_Debit_Note = total_debit;
										// SAFE CALCULATION
										if(input.Grand_Total1 != null)
										{
											input.Net_Payable = input.Grand_Total1 - total_debit;
										}
										else
										{
											input.Net_Payable = 0;
										}
										// ================= NET PAYABLE AFTER TDS =================
										input.Net_Payable_After_TDS1 = ifnull(input.Net_Payable,0) - ifnull(input.Tds,0);
						)
					}
				}

			}
