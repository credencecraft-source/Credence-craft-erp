			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='22%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Scan_Packs'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '15px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Picked'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='21%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Inner_Carton'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '15px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Inner Carton'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'OUTER_CARTON_Report'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '15px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Outer Carton'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Packing_List_Headers'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '15px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FEC9D6'\n    borderWidth = '0px'\n\n\t  value = 'Packing List'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet10' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet10()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{margin:0;padding:0;box-sizing:border-box;}\n.form-action-container{display:none;}\n\n.tabs{\n    height:100vh;\n    font-family:Arial, sans-serif;\n}\n\n.tabs .tab{float:left;}\n.tabs input[type=&quot;radio&quot;]{display:none;}\n\n/* BIG TABS */\n.tabs label{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 28px;\n    font-size:16px;\n    cursor:pointer;\n    font-weight:bold;\n    color:#333;\n    border-bottom:4px solid transparent;\n    transition:0.3s;\n}\n\n.tabs label i{font-size:18px;}\n\n.tabs label:hover{background:#f2f2f2;}\n\n.tabs input:checked + label{\n    color:#0a7a35;\n    border-bottom:4px solid #0a7a35;\n    background:#eef8f1;\n}\n\n.tabs .content{\n    position:absolute;\n    top:50px;\n    left:0;\n    width:100%;\n    height:calc(100vh - 50px);\n    opacity:0;\n    z-index:0;\n}\n\n.tabs input:checked ~ .content{\n    opacity:1;\n    z-index:1;\n}\n\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n&lt;!-- SCAN --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;pack_tabs&quot; checked id=&quot;pack_tab1&quot;&gt;\n&lt;label for=&quot;pack_tab1&quot;&gt;\n&lt;i class=&quot;fa-solid fa-qrcode&quot;&gt;&lt;/i&gt; Scan\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe \n  src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;form-embed/Scan_Pack&quot;&gt;\n&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- PACK --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;pack_tabs&quot; id=&quot;pack_tab2&quot;&gt;\n&lt;label for=&quot;pack_tab2&quot;&gt;\n&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;/i&gt; Pack\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe \n  src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/All_Scan_Packs&quot;&gt;\n&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- INNER CARTON --&gt;\n&lt;li class=&quot;tab&quot;&gt;\n&lt;input type=&quot;radio&quot; name=&quot;pack_tabs&quot; id=&quot;pack_tab3&quot;&gt;\n&lt;label for=&quot;pack_tab3&quot;&gt;\n&lt;i class=&quot;fa-solid fa-box-open&quot;&gt;&lt;/i&gt; Inner\n&lt;/label&gt;\n&lt;div class=&quot;content&quot;&gt;\n&lt;iframe \n  src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/All_Inner_Carton&quot;&gt;\n&lt;/iframe&gt;\n&lt;/div&gt;\n&lt;/li&gt;\n\n&lt;!-- OUTER CARTON --&gt;\n&lt;li class=&qu