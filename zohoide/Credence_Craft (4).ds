				Added_User as "Added User"
				Added_Time as "Added Time"
				Total_Qty as "Total Qty"
				CGST
				SGST
				IGST
				Total_Before_Gst as "Total Before Gst"
				Total_Tax as "Total Tax"
				Total_With_Tax as "Total With Tax"
