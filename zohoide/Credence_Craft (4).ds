= 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Approved_PO'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Approved PO'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='16%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'theme'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Issued'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Purchase Orders'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet11' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet11()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\n/* Hide Creator default buttons */\n.form-action-container{\n    display:none;\n}\n\n.tabs{\n    display:block;\n    height:100vh;\n    position:relative;\n    font-family:Arial, sans-serif;\n}\n\n.tabs .tab{\n    float:left;\n    display:block;\n}\n\n/* Hide radio buttons */\n.tabs .tab &gt; input[type=&quot;radio&quot;]{\n    position:absolute;\n    top:-9999px;\n    left:-9999px;\n}\n\n/* Tab labels */\n.tabs .tab &gt; label{\n    display:block;\n    padding:6px 30px;\n    font-size:13px;\n    text-transform:uppercase;\n    cursor:pointer;\n    position:relative;\n    font-weight:bold;\n    background:transparent;\n    color:#303030;\n}\n\n/* Active underline */\n.tabs .tab &gt; label::after{\n    content:&quot;&quot;;\n    position:absolute;\n    left:0;\n    bottom:0;\n    width:0;\n    height:3px;\n    background:green;\n    transition:width 0.3s ease;\n}\n\n/* Active tab underline */\n.tabs &gt; .tab &gt; [id^=&quot;tab&quot;]:checked + label::after{\n    width:100%;\n}\n\n/* Content container */\n.tabs .content{\n    z-index:0;\n    overflow:hidden;\n    position:absolute;\n    top:27px;\n    left:0;\n    width:100%;\n    height:calc(100vh - 27px);\n    opacity:0;\n    transition:opacity 400ms ease-out;\n}\n\n/* Show active content */\n.tabs &gt; .tab &gt; [id^=&quot;tab&quot;]:checked ~ [id^=&quot;tab-content&quot;]{\n    z-index:1;\n    opacity:1;\n}\n\n/* iframe */\n.tabs iframe{\n    width:100%;\n    height:100%;\n    border:0;\n    display:block;\n}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n  &lt;!-- ================= DRAFT ================= --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; checked=&quot;checked&quot; id=&quot;tab1&quot; /&gt;\n    &lt;label for=&quot;tab1&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-file-lines&quot;&gt;&lt;/i&gt; DRAFT\n    &lt;/label&gt;\n\n    &lt;div id=&quot;tab-content1&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        name=&quot;draft_po&quot;\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Draft_PO?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ================= APPROVED ================= --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab2&quot; /&gt;\n    &lt;label for=&quot;tab2&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-circle-check&quot;&gt;&lt;/i&gt; APPROVED\n    &lt;/label&gt;\n\n    &lt;div id=&quot;tab-content2&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        name=&quot;approved_po&quot;\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Approved_PO?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ================= ISSUED ================= --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab3&quot; /&gt;\n    &lt;label for=&quot;tab3&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-hourglass-half&quot;&gt;&lt;/i&gt; ISSUED\n    &lt;/label&gt;\n\n    &lt;div id=&quot;tab-content3&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        name=&quot;issued_po&quot;\n        zc_MobileView=&quot;inline&quot;\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Issued?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n&lt;/ul&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
