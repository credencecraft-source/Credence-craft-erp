			Validate2 as "Validate"
			{
				type =  form
				form = Salary_Master

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ================= EMPLOYEE UNIQUE VALIDATION =================
										if(input.Employee_ID != null)
										{
											dupEmp = Salary_Master[Employee_ID.ID == input.Employee_ID.ID && ID != input.ID];
											if(dupEmp.count() > 0)
											{
												alert "Salary Master already exists for this Employee. Duplicate not allowed.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			On_submit6 as "On submit"
			{
				type =  form
				form = Employee_Name

