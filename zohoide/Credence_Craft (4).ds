			Approve_Internal_Consumpt as "Approve Internal Consumption"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Type_field == "Consumption")
										{
											input.Subcategory1 = input.Raw_Material.Subcategory;
											clear Approve_Consumption_and_price;
											validation_falg = false;
											validate_flag_internal_consumption = false;
											if(input.Order_No.size() > 0)
											{
												for each  each_order in input.Order_No
												{
													get_raw_materials = Order_Raw_material[Order_No == each_order];
													for each  rec in get_raw_materials
													{
														if(rec.ID != null)
														{
															newrow = Approve_internal_consumption_and_price.Approve_Consumption_and_price();
															newrow.Order_Raw_material=rec.ID;
															newrow.Order_No=rec.Order_No;
															newrow.Internal_Consumption=rec.Internal_Consumption;
															newrow.Internal_Price=rec.Internal_Price;
															newrow.Buyer_Price=rec.Buyer_Price;
															newrow.Buyer_Consumption1=rec.Buyer_Consumption;
															newrow.Gold_Seal=rec.Gold_Seal;
															newrow.Internal_Consumption_Approve_Status="Draft";
															newrow.Buyer_Consumption_Approve_Status="Draft";
															newrow.Products=rec.Products;
															newrow.Placements=rec.Placements;
															rows = Collection();
															rows.insert(newrow);
															input.Approve_Consumption_and_price.insert(rows);
															if(rec.Buyer_Consumption == null || rec.Buyer_Consumption == 0)
															{
																validation_falg = true;
															}
															if(rec.Internal_Consumption == null || rec.Internal_Consumption == 0)
															{
																validate_flag_internal_consumption = true;
															}
														}
													}
												}
											}
											if(validation_falg == true)
											{
												disable Validate_Buyer_Consumption;
											}
											if(validate_flag_internal_consumption == true)
											{
												disable Validate_Internal_Consumption;
											}
										}
										else
										{
											clear Approve_Consumption_and_price;
											rawMaterialList = {};
											if(input.Order_No.size() > 0)
											{
												for each  each_order in input.Order_No
												{
													get_raw_materials = Order_Raw_material[Order_No == each_order];
													for each  rec in get_raw_materials
													{
														checkVal = rec.Raw_Material_Name + "-" + rec.Placements;
														if(!rawMaterialList.contains(checkVal))
														{
															rawMaterialList.add(checkVal);
															newrow = Approve_internal_consumption_and_price.Approve_Consumption_and_price();
															newrow.Raw_Material1=rec.Raw_Material_Name;
															newrow.Order_Raw_material=rec.ID;
															newrow.Buyer_Price=rec.Buyer_Price;
															newrow.Placements=rec.Placements;
															newrow.Buyer_Consumption1=rec.Buyer_Consumption;
															newrow.Internal_Consumption=rec.Internal_Consumption;
															rows = Collection();
															rows.insert(newrow);
															input.Approve_Consumption_and_price.insert(rows);
														}
													}
												}
											}
										}
						)
					}
				}

			}
