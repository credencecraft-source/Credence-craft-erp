			Order_No4 as "Order No"
			{
				type =  form
				form = Forword_Booking

				record event = on add or edit

				on user input of Order_No
				{
					actions 
					{
						custom deluge script
						(
											orderRec = Create_Order[ID == input.Order_No];
										if(orderRec != null)
										{
											// ✅ Entity mapping
											input.Entity_Name = orderRec.Entity_Name;
											input.Style_Name = input.Order_No;
											input.Price = orderRec.Fob;
											input.Colors = orderRec.Colors;
											input.Available_Qty = orderRec.Order_Qty;
											input.SubForm.clear();
											totalBooked = 0;
											for each  sizeRow in orderRec.Finished_Goods_Size_wise
											{
												row = Forword_Booking.SubForm();
												row.Size=sizeRow.Size;
												row.Order_Qty=sizeRow.Total_Qty;
												// Already Booked
												alreadyBookedQty = 0;
												fbList = Forword_Booking[Order_No == input.Order_No];
												for each  fb in fbList
												{
													for each  sf in fb.SubForm
													{
														if(sf.Size.ID == sizeRow.Size.ID)
														{
															alreadyBookedQty = alreadyBookedQty + ifnull(sf.Booked,0);
														}
													}
												}
												row.Already_Booked=alreadyBookedQty;
												// Default Booked
												row.Booked=1;
												// Balance
												row.Balance=ifnull(row.Order_Qty,0) - ifnull(row.Already_Booked,0);
												// if negative balance → reset booked
												if(row.Balance <= 0)
												{
													row.Booked=0;
												}
												totalBooked = totalBooked + row.Booked;
												input.SubForm.insert(row);
											}
											// ✅ Total Booked Qty
											input.Booked = totalBooked;
											// ✅ TOTAL CALCULATION ADDED
											if(input.Price != null)
											{
												input.Total = totalBooked * input.Price;
											}
											else
											{
												input.Total = 0;
											}
										}
						)
					}
				}

			}
			Booked as "Booked"
			{
				type =  form
				form = Forword_Booking

				record event = on add or edit

				on user input of SubForm.Booked
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.SubForm.Booked,0) + ifnull(input.SubForm.Already_Booked,0) > ifnull(input.SubForm.Order_Qty,0))
										{
											alert "Total booked (including already booked) cannot exceed available qty";
											input.SubForm.Booked = 0;
										}
										// ✅ Balance validation
										balance = ifnull(input.SubForm.Order_Qty,0) - ifnull(input.SubForm.Already_Booked,0);
										if(balance <= 0)
										{
											alert "No balance available for this size";
											input.SubForm.Booked = 0;
										}
										// AUTO TOTAL
										total = 0;
										for each  rec in input.SubForm
										{
											total = total + ifnull(rec.Booked,0);
										}
										input.Booked = total;
						)
					}
				}

			}
