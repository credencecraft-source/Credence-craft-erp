			Master_Group_C_E_Success as "Master Group (C/E)-Success"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Costing_Execute = false;
										input.Eligible_Po = "Not Eligible";
										// Get the IDs of all linked grouping records
										get_linked_group_ids = input.Grouping_Purchase_Request_No;
										// Loop through each linked grouping record and reset its eligibility
										for each  group_id in get_linked_group_ids
										{
											update_grouping = Grouping_Purchase_Request[ID == group_id];
											update_grouping.Eligible_Po="Not Eligible";
										}
										// Update details from master group
										thisapp.groping_controllar.update_grouping_details_from_maser_group(input.ID);
										// Redirect after submit
										//openUrl("#Page:Purchase_Orders1","same window");
						)
					}
				}

			}
			Purchase_Order_C_Onload as "Purchase Order (C)-Onload"
			{
				type =  form
				form = Purchase_Order

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =======================
										// ON LOAD
										// =======================
										// ---------- GpoID → PR_IDS ----------
										if(GpoID != null && GpoID.size() > 0)
										{
											PR_IDS = input.GpoID;
										}
										// =======================
										// DEFAULT HEADER AUTO FILL
										// =======================
										// Entity Name → if only one
										entity_count = 0;
										single_entity = null;
										for each  ent in Entity_Name
										{
											entity_count = entity_count + 1;
											if(entity_count == 1)
											{
												single_entity = ent;
											}
											else
											{
												break;
											}
										}
										if(entity_count == 1 && single_entity != null)
										{
											input.Entity_Name = single_entity.ID;
										}
										// Year → current year
										current_year = zoho.currentdate.getYear();
										year_rec = Year_form[Year_field == current_year];
										if(year_rec != null)
										{
											input.Year_form = year_rec.ID;
										}
										// Month → current month
										current_month = zoho.currentdate.getMonth();
										month_rec = Month_Master[Month_No == current_month];
										if(month_rec != null)
										{
											input.Month_Master = month_rec.ID;
										}
										// =======================
										// IF FROM PURCHASE REQUEST
										// =======================
										if(PR_IDS != null && PR_IDS.size() > 0)
										{
											input.Po_Type = "General";
											input.Po_Sub_Form.clear();
											rowsPR = Collection();
											for each  pr_id in PR_IDS
											{
												prRec = Purchase_Request[ID == pr_id];
												if(prRec != null)
												{
													row = Purchase_Order.Po_Sub_Form();
													row.Raw_Material1=prRec.Raw_Material1;
													row.Subcategory1=prRec.Subcategory1;
													// Item Nature + UOM FIX
													if(prRec.Raw_Material1 != null)
													{
														input.Item_Nature = prRec.Raw_Material1.Category_Type;
														if(prRec.Raw_Material1.Stock_Uom1 != null)
														{
															uomConv = Uom_Convert[Stock_Uom1 == prRec.Raw_Material1.Stock_Uom1];
															if(uomConv != null)
															{
																row.Uom=uomConv.ID;
															}
														}
													}
													// GST + HSN
													row.Gst11=prRec.Subcategory1.Gst;
													row.Hsn_Code=prRec.Subcategory1.Hsn_Code;
													// PRICE + DEFAULT DISCOUNT
													row.Po_Price=prRec.Price;
													row.Discount=0;
													// CALCULATIONS
													row.After_Discount=ifnull(row.Po_Price,0) - ifnull(row.Discount,0);
													row.Gross_Amount=ifnull(prRec.Qty,0) * ifnull(row.After_Discount,0);
													gst_per = 0;
													if(row.Gst11 != null)
													{
														gst_per = ifnull(row.Gst11.Gst,0);
													}
													tax_val = row.Gross_Amount * gst_per / 100;
													row.Tax=tax_val;
													row.IGST=tax_val;
													row.SGST=tax_val / 2;
													row.CGST=tax_val / 2;
													row.Total_With_Tax=row.Gross_Amount + row.Tax;
													row.Grand_Toltal=row.Total_With_Tax;
													row.Po_Qty=prRec.Qty;
													rowsPR.insert(row);
												}
											}
											input.Po_Sub_Form.insert(rowsPR);
											// =======================
											// HEADER TOTAL CALC
											// =======================
											sum_of_amount = 0;
											sum_of_tax = 0;
											sum_of_other_charges = 0;
											sum_of_total = 0;
											for each  each_item in input.Po_Sub_Form
											{
												sum_of_amount = sum_of_amount + ifnull(each_item.Gross_Amount,0);
												sum_of_tax = sum_of_tax + ifnull(each_item.Tax,0);
												sum_of_other_charges = sum_of_other_charges + ifnull(each_item.Other_Charges,0);
												sum_of_total = sum_of_total + ifnull(each_item.Grand_Toltal,0);
											}
											input.Total = sum_of_amount;
											input.Tax = sum_of_tax;
											if(input.Vendor_Name != null && input.Vendor_Name.New_GST_Type != null && input.Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
											{
												input.CGST1 = sum_of_tax / 2;
												input.SGST1 = sum_of_tax / 2;
												input.IGST1 = 0;
											}
											else
											{
												input.CGST1 = 0;
												input.SGST1 = 0;
												input.IGST1 = sum_of_tax;
											}
											input.Other_Charges = sum_of_other_charges;
											input.Grand_Total = sum_of_total;
										}
										// =======================
										// ELSE FLOW (UNCHANGED)
										// =======================
										else
										{
											has_master_group = false;
											for each  mg in input.Master_Group_ID
											{
												has_master_group = true;
												break;
											}
											if(has_master_group == true)
											{
												input.Po_Type = "Against Order";
												disable Vendor_Name;
												input.Item_Nature = input.Master_Group_ID.Category_Type1;
												input.Vendor_Name = input.Master_Group_ID.Vendor;
												input.Po_Sub_Form.clear();
												rows1 = Collection();
												for each  each_group in input.Master_Group_ID
												{
													row2 = Purchase_Order.Po_Sub_Form();
													row2.Master_Group=each_group.ID;
													row2.Raw_Material1=each_group.Raw_Material;
													row2.Subcategory1=each_group.Subcategory1;
													row2.Hsn_Code=each_group.Subcategory1.Hsn_Code;
													row2.Gst11=each_group.Subcategory1.Gst;
													row2.Other_Charges=each_group.Other_Charges_INR;
													row2.Po_Qty=each_group.Buying_Qty_Total;
													// UOM FIX
													if(each_group.Raw_Material != null && each_group.Raw_Material.Stock_Uom1 != null)
													{
														uomConv2 = Uom_Convert[Stock_Uom1 == each_group.Raw_Material.Stock_Uom1];
														if(uomConv2 != null)
														{
															row2.Uom=uomConv2.ID;
														}
													}
													row2.Order_Raw_Material_ID=each_group.Order_Raw_material_ID;
													row2.Po_Price=each_group.Vendor_Price_INR;
													row2.Discount=0;
													row2.After_Discount=ifnull(each_group.Vendor_Price_INR,0);
													row2.Gross_Amount=ifnull(row2.Po_Qty,0) * ifnull(row2.After_Discount,0);
													gst_per = 0;
													if(row2.Gst11 != null)
													{
														gst_per = ifnull(row2.Gst11.Gst,0);
													}
													tax_val = row2.Gross_Amount * gst_per / 100;
													row2.Tax=tax_val;
													row2.IGST=tax_val;
													row2.SGST=tax_val / 2;
													row2.CGST=tax_val / 2;
													row2.Total_With_Tax=row2.Gross_Amount + row2.Tax;
													row2.Grand_Toltal=row2.Total_With_Tax + ifnull(row2.Other_Charges,0);
													rows1.insert(row2);
												}
												input.Po_Sub_Form.insert(rows1);
												sum_of_amount = 0;
												sum_of_tax = 0;
												sum_of_other_charges = 0;
												sum_of_total = 0;
												for each  each_item in input.Po_Sub_Form
												{
													sum_of_amount = sum_of_amount + ifnull(each_item.Gross_Amount,0);
													sum_of_tax = sum_of_tax + ifnull(each_item.Tax,0);
													sum_of_other_charges = sum_of_other_charges + ifnull(each_item.Other_Charges,0);
													sum_of_total = sum_of_total + ifnull(each_item.Grand_Toltal,0);
												}
												input.Total = sum_of_amount;
												input.Tax = sum_of_tax;
												if(Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
												{
													input.CGST1 = sum_of_tax / 2;
													input.SGST1 = sum_of_tax / 2;
													input.IGST1 = 0;
												}
												else
												{
													input.CGST1 = 0;
													input.SGST1 = 0;
													input.IGST1 = sum_of_tax;
												}
												input.Other_Charges = sum_of_other_charges;
												input.Grand_Total = sum_of_total;
											}
											else
											{
												input.Po_Type = "General";
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											thisapp.purchase_order_controller.calculate_gst_and_totals(input.ID);
						)
					}
				}

			}
			Discount_in_Purchase_Orde as "Discount in Purchase Order"
