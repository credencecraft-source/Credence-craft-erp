		form Group_Measurements
		{
			displayname = "Group Measurements"
			success message = "Group Measurement Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Group_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size
			(
				type = picklist	
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Count_field
			(
				type = number
				displayname = "Count"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Students
			(
				type = grid
				values  = Employes_Measurements.ID
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Grouping_Purchase_Request
		{
			displayname = "Grouping Purchase Request"
			success message = "Grouping Purchase Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Note
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Grouping
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Required_Qty_Raw_Material
			(
				type = decimal
				displayname = "Total Required Qty (Raw Material)"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Total_Grouped_Qty
			(
				type = decimal
				displayname = "Total Grouped Qty"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Raw_Material1
			(
				type = picklist	
				displayname = "Raw Material"
				values  = Raw_Material1.ID
    			displayformat = [Raw_Material_Name]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have No_of_Styles
			(
				type = number
				displayname = "No of Styles"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Show_Style_Details
			(
    			type = checkbox
				displayname = "Show Style Details"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Po_Status1
			(
				type = list	
				displayname = "Po_Status"
				values  = Master_Group.ID
    			bidirectional = Grouping_Purchase_Request_No
    			displayformat = [Po_Status]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 3   
				width = medium
			)
			Backend_Data
			(
				type = section
				displayname = "Backend Data"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Vendor_Auto_Set
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Po_status
			(
				type = picklist
				maxchar = 100
				values = {"Created","Not Created"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Current_Stock
			(
				type = decimal
				displayname = "Current Stock"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Grouping_Support_No
			(
    			type = autonumber
				displayname = "Grouping Support No"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Grouping_Number1
			(
    			type = formula
				displayname = "Grouping Number"
				value =  "GRP00" + input.Grouping_Support_No
				visibility = false
				display type = text
				format = plaintext
	 			row = 3
	 			column = 1   
				width = medium
			)
			Vender_Price_per_order_per_pcs_stock_uom
			(
				type = decimal
				displayname = "Vender Price per order per pcs (stock uom)"
				decimalplace = 4
	 			row = 3
	 			column = 1   
				width = medium
			)
			Other_charges_per_order_per_pcs_stock_uom
			(
				displayname = "Other charges per order per  pcs (stock uom)"
				type = INR
				format = commadotindian
				decimalplace = 5
	 			row = 3
	 			column = 1   
				width = medium
			)
			Vender_Price_Other_Charges
			(
				displayname = "Vender Price + Other Charges"
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Eligible_Po
			(
				type = picklist
				displayname = "Eligible Po"
				maxchar = 100
				values = {"Eligible","Not Eligible"}
				initial value = "Not Eligible"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Order_Raw_Material_ID
			(
				type = list	
				displayname = "Order Raw Material ID"
				values  = Order_Raw_material.ID
    			displayformat = [ID]
				sortorder = ascending
				height = 60px
	 			row = 3
	 			column = 2   
				width = medium
			)
			Validate_Costing
			(
    			type = checkbox
				displayname = "Validate Costing"
				initial value = false
