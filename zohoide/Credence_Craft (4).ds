				auto width = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Work_Order_Raw_materil
			(
				type = grid
				displayname = "Work Order Raw materil"
				values  = Work_Order_Rawmateril.ID
    			bidirectional = Work_Order_No
	 			row = 3
	 			column = 1   
				width = medium
			)
			Backend_Data
			(
				type = section
				displayname = "Backend Data"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Work_Order_Support_No
			(
    			type = autonumber
				displayname = "Work Order Support No"
				start index = 1
