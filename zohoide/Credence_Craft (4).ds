			Po_Number_in_Gate_Entry as "Po Number in Gate Entry"
			{
				type =  form
				form = Gate_Entry

				record event = on add

				on user input of Po_Number
				{
					actions 
					{
						custom deluge script
						(
											clear Gate_Entry_Subfrom;
										input.PO_Type = input.Po_Number.Po_Type;
										input.Vendor1 = input.Po_Number.Vendor_Name;
										if(input.PO_Type == "General")
										{
											hide Gate_Entry_Subfrom.Master_Group;
										}
										get_line_item = Po_Subform[Purchase_Order_ID == input.Po_Number && Grn_Line_Status != "Fully Received"];
										if(get_line_item.ID != null)
										{
											for each  each_po in get_line_item
											{
												row1 = Gate_Entry.Gate_Entry_Subfrom();
												row1.Master_Group=each_po.Master_Group;
												row1.Raw_Material1=each_po.Raw_Material1;
												row1.Uom_Convert=each_po.Uom;
												row1.Grn_Status_Item_Wise=each_po.ID;
												row1.Purchase_NO=input.Po_Number;
												row1.Vendor1=input.Vendor1;
												row1.Po_Qty=each_po.Po_Qty;
												row1.Po_Price=each_po.Po_Price;
												row1.Entity_Delivery_Address=input.Delivery_Address;
												rows = Collection();
												rows.insert(row1);
												input.Gate_Entry_Subfrom.insert(rows);
											}
										}
						)
					}
				}

			}
