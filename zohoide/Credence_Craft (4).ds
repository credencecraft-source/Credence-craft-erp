			on_submit7 as "on submit"
			{
				type =  form
				form = Salary_Master

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ================= CHECK PAYMENT TYPE =================
										if(input.Payment_Type != "Monthly")
										{
											return;
										}
										// ================= HEADER VALIDATION =================
										if(input.Monthly_Salary == null || input.Monthly_Salary <= 0)
										{
											alert "Please enter Monthly Salary";
											return;
										}
										// ================= INSERT SALARY HIKE ONLY IF SALARY CHANGED =================
										if(input.Monthly_Salary_old != null && input.Monthly_Salary != input.Monthly_Salary_old)
										{
											insert into Salary_Hike
											[
												Employee_ID=input.Employee_ID
												Employee_Name1=input.Employee_Name
												Date_field=input.Effective_date
												New_Salary=input.Monthly_Salary
												Salary_Master=input.ID
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
			on_sucess as "on sucess"
			{
				type =  form
				form = Salary_Master

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Get existing record (for Edit)
										oldRec = Salary_Master[ID == input.ID];
										if(oldRec != null && oldRec.Monthly_Salary != input.Monthly_Salary)
										{
											insert into Salary_Hike
											[
												Employee_ID=input.Employee_ID
												Employee_Name1=input.Employee_Name
												Date_field=input.Effective_date
												New_Salary=input.Monthly_Salary
												Salary_Master=input.ID
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
			on_validate2 as "on validate"
			{
				type =  form
				form = Employee_Name

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											missingMsg = "";
										// Name
										if(input.Name == null || input.Name == "")
										{
											missingMsg = missingMsg + "\n• Name";
										}
										// Attendance Rule
										if(input.Attendance_Rule == null)
										{
											missingMsg = missingMsg + "\n• Attendance Rule";
										}
										// Department
										if(input.Department == null)
										{
											missingMsg = missingMsg + "\n• Department";
										}
										// Employee Type
										if(input.Employee_Type == null)
										{
											missingMsg = missingMsg + "\n• Employee Type";
										}
										// Designation
										if(input.Designation == null)
										{
											missingMsg = missingMsg + "\n• Designation";
										}
										// Batch
										if(input.Batch == null)
										{
											missingMsg = missingMsg + "\n• Batch";
										}
										// Date Of Join
										if(input.Date_Of_Join1 == null)
										{
											missingMsg = missingMsg + "\n• Date Of Joining";
										}
										// FINAL CHECK
										if(missingMsg != "")
										{
											alert "Please fill the following mandatory fields:" + missingMsg;
											cancel submit;
										}
						)
					}
				}

			}
