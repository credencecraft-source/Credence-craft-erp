	 			row = 3
	 			column = 3   
				width = medium
			)
			Vendor_Price
			(
				displayname = "Vendor Price"
				type = INR
				format = commadotindian
				initial value = 0
				decimalplace = 3
	 			row = 3
	 			column = 3   
				width = medium
			)
			Convert_Value
			(
				type = decimal
				displayname = "Convert Value"
				decimalplace = 4
	 			row = 3
	 			column = 3   
				width = medium
			)
			Buying_Uom
