		form Create_Support_Ticket
		{
			displayname = "Create Support Ticket"
			success message = "Support Ticket Created Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Subject_field
			(
    			type = text
				displayname = "Subject"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Priority
			(
				type = picklist
				maxchar = 100
				values = {"Low","Urgent","Top Urgent"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","In Progress","Completed"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Currency_Type
		{
			displayname = "Currency Type"
			success message = "Currency Type Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Currency
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Exchange_Price
			(
				type = decimal
				displayname = "Exchange Price"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form customer_s_registered_Gst_State
		{
			displayname = "customer’s registered Gst State"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			customer_s_registered_Gst_State
			(
    			type = text
				displayname = "Registered Gst State"
	 			row = 1
	 			column = 1   
				width = medium
			)
			State_Code
			(
    			type = text
				displayname = "State_Code "
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Daily_OutPut_Process_Header
		{
			displayname = "Daily OutPut Process Header"
			success message = "Daily Output Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_No
			(
				type = picklist	
				values  = Create_Order.ID
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Approved","Alter","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process_Master
			(
				type = picklist	
