			Purchase_Order_C_E_Succes as "Purchase Order (C/E)-Success"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.GpoID != null && input.GpoID.size() > 0)
										{
											for each  pr_id in input.GpoID
											{
												prRec = Purchase_Request[ID == pr_id];
												if(prRec != null)
												{
													prRec.PO_Created=true;
													prRec.PO_ID=input.ID;
													// lookup
													prRec.PO_Number=input.ID;
													// lookup (same PO record)
												}
											}
										}
										// Fetch the Setting record (assuming only one record exists)
										settingRecord = Setting[ID != null];
										// Check if PO Approval is Auto Approve
										if(settingRecord.PO_Approval == "Auto Approve")
										{
											// Update the current record's PO_Status to Issued
											input.Po_Status = "Issued";
										}
										// Your existing code continues here
										for each  each_po in input.Master_Group_ID
										{
											thisapp.groping_controllar.po_status_update(each_po.ID);
										}
										// Redirect to Create_po page
										openUrl("#Page:Purchase_Orders1","same window");
						)
					}
				}

			}
			Purchase_Order_Deleted_va as "Purchase Order (Deleted)-validation"
			{
				type =  form
				form = Purchase_Order

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grn = Gate_Entry[Po_Number == input.ID];
										if(get_grn.ID != null)
										{
											alert "Found a Gate Entry associated with this Purchase Order so, please delete the Gate Entry first.";
											cancel delete;
										}
										else
										{
											// ? REVERSE PO_CREATED IN PR
											prList = Purchase_Request[PO_ID == input.ID];
											for each  pr in prList
											{
												pr.PO_Created=false;
												pr.PO_ID=null;
											}
											delete from Po_Subform[Purchase_Order_ID == input.ID];
											delete from Po_Subform[Purchase_Order_ID == null];
											for each  each_po in input.Master_Group_ID
											{
												thisapp.groping_controllar.po_status_update(each_po.ID);
											}
										}
						)
					}
				}

			}
