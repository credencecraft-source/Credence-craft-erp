				fields = [GRN_Status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (GRN_Status == "Not Received")
				fields = [GRN_Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting"
				{
				condition = (GRN_Status == "Partially Received")
				fields = [GRN_Status]
				format = "color:#333;background-color:#f1c40f;"
				}
