			Increase_Budgeted_Cost_C_ as "Increase Budgeted Cost (C)-Onload"
			{
				type =  form
				form = In_Crease_Budgeted_Cost

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Revised_User_Email_Id = zoho.loginuserid;
										get_costing = Costing[Order_No == input.Create_Order];
										if(get_costing.ID != null)
										{
											get_costing_center = Order_Cost_Center[Costing_ID == get_costing.ID];
											for each  each_item in get_costing_center
											{
												get_sussested = ifnull(each_item.Diffrence,0) / ifnull(get_costing.Order_Qty1,0);
												if(get_sussested < 0)
												{
													get_sussested = get_sussested * -1;
												}
												else
												{
													get_sussested = 0;
												}
												row2 = In_Crease_Budgeted_Cost.In_Crease_Budgeted_Cost();
												row2.Category1=each_item.Category;
												row2.Order_Cost_Center_ID=each_item.ID;
												row2.Current_Difference=each_item.Diffrence;
												row2.Order_Qty=get_costing.Order_Qty1;
												row2.Suggested=get_sussested;
												row2.Current_Maximum_Allowed=each_item.Maximum_Allowed;
												row2.New_Budget=ifnull(row2.Suggested,0) + ifnull(each_item.Maximum_Allowed,0);
												if(row2.Suggested < 0)
												{
													row2.Operation="Increase";
												}
												else
												{
													row2.Operation="No Need";
												}
												rows1 = Collection();
												rows1.insert(row2);
												input.In_Crease_Budgeted_Cost.insert(rows1);
											}
										}
						)
					}
				}

			}
