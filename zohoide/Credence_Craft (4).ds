			on_successfull1 as "on successfull"
			{
				type =  form
				form = Work_Order_New

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Create_Order != null)
										{
											// 1️⃣ CALCULATE TOTAL WO QTY
											woQty = 0;
											for each  s in input.Work_Order_Size_Wise_Qty
											{
												woQty = woQty + ifnull(s.Work_Order_Qty,0);
											}
											if(woQty <= 0)
											{
												return;
											}
											// 2️⃣ CREATE WORK ORDER PROCESSES + JOB ORDERS
											thisapp.create_work_order_processes(input.ID);
											// 3️⃣ UPDATE FINISHED GOODS STATUS (SIZE LEVEL)
											for each  s in input.Work_Order_Size_Wise_Qty
											{
												thisapp.work_order_controllar.finished_item_work_order_status_update(s.Finished_Goods_Size_ID);
											}
											// 4️⃣ UPDATE ORDER WORK ORDER STATUS
											thisapp.order_controllar.work_order_status_update(input.Create_Order);
											// 5️⃣ DETECT ONLINE ORDER CHANGES
											thisapp.order_controllar.detectOnlineOrderChanges(input.ID);
											// 6️⃣ GET ORDER RECORD
											orderRec = Create_Order[ID == input.Create_Order];
											if(orderRec.count() == 0)
											{
												return;
											}
											// 7️⃣ GET PROCESS TEMPLATE DIRECTLY FROM ORDER
											templateRec = Process_Template[ID == orderRec.Process_Template];
											if(templateRec.count() == 0)
											{
												return;
											}
											// 8️⃣ GET FIRST PROCESS FROM TEMPLATE
											firstProcessRec = Process_Master[ID == templateRec.First_Process];
											if(firstProcessRec.count() == 0)
											{
												return;
											}
											// 9️⃣ INSERT FIRST PROCESS MOVEMENT
											thisapp.auto_create_first_process_movement(input.ID);
										}
						)
					}
				}

			}
