                 	}
                 }
				 void Plancheck.CreateDefaultPlans()
                 {
                 	info "Creating Default Plan Master Records...";
                 	plan_list = {"Free","Basic","Professional","Enterprises"};
                 	for each  plan_name in plan_list
                 	{
                 		existing = Plan_Master[Plan_Name == plan_name];
                 		if(existing.count() == 0)
                 		{
                 			insert into Plan_Master
                 			[
                 				Plan_Name=plan_name
                 				Added_User=zoho.loginuser
                 			]
                 			info plan_name + " plan created.";
                 		}
                 		else
                 		{
                 			info plan_name + " already exists.";
                 		}
                 	}
                 	info "Default Plan Master Setup Completed.";
                 }
				 void Plancheck.Transactio_CurrentMonthOnly()
                 {
                 	info "Starting CURRENT MONTH transaction update";
                 	curr_month = month(zoho.currentdate);
                 	curr_year = year(zoho.currentdate);
                 	// -------------------------------
                 	// DELETE OLD TRANSACTIONS
                 	// -------------------------------
                 	for each  t in Transactions
                 	{
                 		if(t.Month_field1 != curr_month || t.Year_field != curr_year)
                 		{
                 			delete from Transactions[ID == t.ID];
                 		}
                 	}
                 	// -------------------------------
                 	// COUNTS
                 	// -------------------------------
                 	gate_count = 0;
                 	for each  ge in Gate_Entry
                 	{
                 		if(month(ge.Invoice_Date) == curr_month && year(ge.Invoice_Date) == curr_year)
                 		{
                 			gate_count = gate_count + 1;
                 		}
                 	}
                 	po_count = 0;
                 	for each  po in Purchase_Order
                 	{
                 		if(month(po.Po_Created) == curr_month && year(po.Po_Created) == curr_year)
                 		{
                 			po_count = po_count + 1;
                 		}
                 	}
                 	pb_count = 0;
                 	for each  pb in Purchase_Bill
                 	{
                 		if(month(pb.Bill_Date) == curr_month && year(pb.Bill_Date) == curr_year)
                 		{
                 			pb_count = pb_count + 1;
                 		}
                 	}
                 	dc_count = 0;
                 	for each  dc in GRN_Delivery
                 	{
                 		if(month(dc.Date_field) == curr_month && year(dc.Date_field) == curr_year)
                 		{
                 			dc_count = dc_count + 1;
                 		}
                 	}
                 	order_count = 0;
                 	for each  co in Create_Order
                 	{
                 		if(month(co.Added_Time) == curr_month && year(co.Added_Time) == curr_year)
                 		{
                 			order_count = order_count + 1;
                 		}
                 	}
                 	job_bill_count = 0;
                 	for each  jb in Job_Order_Bill
                 	{
                 		if(month(jb.Created_date) == curr_month && year(jb.Created_date) == curr_year)
                 		{
                 			job_bill_count = job_bill_count + 1;
                 		}
                 	}
                 	quotation_count = 0;
                 	for each  q in Quotation1
                 	{
                 		if(month(q.Date_field) == curr_month && year(q.Date_field) == curr_year)
                 		{
                 			quotation_count = quotation_count + 1;
                 		}
                 	}
                 	invoice_count = 0;
                 	for each  inv in Invoice
                 	{
                 		if(month(inv.Invoice_Date) == curr_month && year(inv.Invoice_Date) == curr_year)
                 		{
                 			invoice_count = invoice_count + 1;
                 		}
                 	}
                 	payroll_count = 0;
                 	for each  pr in Payroll
                 	{
                 		if(month(pr.Added_Time) == curr_month && year(pr.Added_Time) == curr_year)
                 		{
                 			payroll_count = payroll_count + 1;
                 		}
                 	}
                 	dpr_count = 0;
                 	for each  pbm in Process_Bundle_Movement
                 	{
                 		if(month(pbm.Added_Time) == curr_month && year(pbm.Added_Time) == curr_year)
                 		{
                 			dpr_count = dpr_count + 1;
                 		}
                 	}
                 	total_count = gate_count + po_count + pb_count + dc_count + order_count + job_bill_count + quotation_count + invoice_count + payroll_count + dpr_count;
                 	// -------------------------------
                 	// UPDATE / INSERT TRANSACTIONS
                 	// -------------------------------
                 	existing = Transactions[Month_field1 == curr_month && Year_field == curr_year];
                 	if(existing.count() > 0)
                 	{
                 		for each  rec in existing
                 		{
                 			rec.GRN=gate_count;
                 			rec.Purchase_Order=po_count;
                 			rec.Purchase_Bill=pb_count;
                 			rec.Delivery_Challan=dc_count;
                 			rec.Orders=order_count;
                 			rec.Job_Work_Bill=job_bill_count;
                 			rec.Quotation=quotation_count;
                 			rec.Invoice=invoice_count;
                 			rec.Payroll=payroll_count;
                 			rec.Dpr1=dpr_count;
                 			rec.Total_Transaction=total_count;
                 		}
                 	}
                 	else
                 	{
                 		insert into Transactions
                 		[
                 			Month_field1=curr_month
                 			Year_field=curr_year
                 			GRN=gate_count
                 			Purchase_Order=po_count
                 			Purchase_Bill=pb_count
                 			Delivery_Challan=dc_count
                 			Orders=order_count
                 			Job_Work_Bill=job_bill_count
                 			Quotation=quotation_count
                 			Invoice=invoice_count
                 			Payroll=payroll_count
                 			Dpr1=dpr_count
                 			Total_Transaction=total_count
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	// -------------------------------
                 	// UPDATE / INSERT PRICING
                 	// -------------------------------
                 	pricing_rec = Pricing[Year_field == curr_year && Month_field == curr_month];
                 	if(pricing_rec.count() > 0)
                 	{
                 		for each  p in pricing_rec
                 		{
                 			p.Count_field=total_count;
                 		}
                 	}
                 	else
                 	{
                 		old_pricing = Pricing[ID != 0];
                 		old_otp = "";
                 		if(old_pricing.count() > 0)
                 		{
                 			for each  op in old_pricing
                 			{
                 				old_otp = op.OTP;
                 				delete from Pricing[ID == op.ID];
                 			}
                 		}
                 		free_plan = Plan_Master[Plan_Name == "Free"];
                 		if(free_plan.count() > 0)
                 		{
                 			for each  fp in free_plan
                 			{
                 				insert into Pricing
                 				[
                 					Year_field=curr_year
                 					Month_field=curr_month
                 					Count_field=total_count
                 					Maximum=50
                 					Transaction_Plan="FREE"
                 					Key="Default_FREE"
                 					Plan_Features=fp.ID
                 					OTP=old_otp
                 					Added_User=zoho.loginuser
                 				]
                 			}
                 		}
                 	}
                 	info "CURRENT MONTH transaction update completed successfully";
                 }
				 void process_controllar.add_process_to_costing(int rec_id)
                 {
                 	// Fetch the process record
                 	proc = Order_Process_Controler[ID == rec_id];
                 	if(proc == null)
                 	{
                 		info "⚠ Process record not found.";
                 		return;
                 	}
                 	// ✅ ADD THIS BLOCK (SETTING CHECK)
                 	setting_rec = Setting[ID != 0];
                 	if(setting_rec.Process_Cost_Centers != "Yes")
                 	{
                 		info "⚠ Process Cost Centers is disabled in Settings.";
                 		return;
                 	}
                 	// Check if record already exists in Process_Cost_Center
                 	existing = Process_Cost_Center[Order_ID == proc.Order_No && Process_Name == proc.Process_Name && Costing == proc.Costing_ID];
                 	if(existing.count() > 0)
                 	{
                 		info "⚠ Process already exists in Process_Cost_Center.";
                 		return;
                 	}
                 	// Insert into Process_Cost_Center
                 	new_row = insert into Process_Cost_Center
                 	[
                 		Order_ID=proc.Order_No
                 		Process_Name=proc.Process_Name
                 		Costing=proc.Costing_ID
                 		Bom_Price=proc.Bom_Price
                 		Actual=proc.Actual_Price
                 		Added_User=zoho.loginuser
                 	];
                 	//info "✅ Process added to Process_Cost_Center with Costing_ID.";
                 }
				 void purchase_order_controller.calculate_gst_and_totals(int po_id)
                 {
                 	get_po = Purchase_Order[ID == po_id];
                 	if(get_po.ID == null)
                 	{
                 		return;
                 	}
                 	sum_of_amount = 0;
                 	sum_of_tax = 0;
                 	sum_of_other_charges = 0;
                 	sum_of_total = 0;
                 	for each  row in get_po.Po_Sub_Form
                 	{
                 		row.Gross_Amount=ifnull(row.Po_Qty,0) * ifnull(row.After_Discount,0);
                 		gst_per = 0;
                 		if(row.Gst11 != null)
                 		{
                 			gst_per = ifnull(row.Gst11.Gst,0);
                 		}
                 		get_tax_value = row.Gross_Amount * gst_per / 100;
                 		row.Tax=get_tax_value;
                 		row.IGST=get_tax_value;
                 		row.SGST=get_tax_value / 2;
                 		row.CGST=get_tax_value / 2;
                 		row.Total_With_Tax=row.Gross_Amount + row.Tax;
                 		row.Grand_Toltal=row.Total_With_Tax + ifnull(row.Other_Charges,0);
                 		sum_of_amount = sum_of_amount + row.Gross_Amount;
                 		sum_of_tax = sum_of_tax + row.Tax;
                 		sum_of_other_charges = sum_of_other_charges + ifnull(row.Other_Charges,0);
                 		sum_of_total = sum_of_total + row.Grand_Toltal;
                 	}
                 	get_po.Total=sum_of_amount;
                 	get_po.Tax=sum_of_tax;
                 	if(get_po.Vendor_Name != null && get_po.Vendor_Name.New_GST_Type != null && get_po.Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
                 	{
                 		get_po.CGST1=sum_of_tax / 2;
                 		get_po.SGST1=sum_of_tax / 2;
                 		get_po.IGST1=0;
                 	}
                 	else
                 	{
                 		get_po.CGST1=0;
                 		get_po.SGST1=0;
                 		get_po.IGST1=sum_of_tax;
                 	}
                 	get_po.Other_Charges=sum_of_other_charges;
                 	get_po.Grand_Total=sum_of_total;
                 }
