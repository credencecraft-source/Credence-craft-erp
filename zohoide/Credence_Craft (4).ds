			Purchase_Order_Edit_Valid as "Purchase Order (Edit)-Validation"
			{
				type =  form
				form = Purchase_Order

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grn = Gate_Entry[Po_Number == input.ID];
										if(get_grn != null && get_grn.ID != null)
										{
											alert "A Gate Entry is associated with this Purchase Order. Editing is not allowed.";
											cancel submit;
										}
						)
					}
				}

			}
			Gate_Entry_C_E_Success as "Gate Entry (C/E)-Success"
			{
				type =  form
				form = Gate_Entry

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  each_line_item in input.Gate_Entry_Subfrom
										{
											thisapp.grn_controllar.grn_line_item_status_update_in_po(each_line_item.Grn_Status_Item_Wise);
											thisapp.debit_note_controllar.create_debite_notes(each_line_item.ID);
										}
										thisapp.grn_controllar.grn_status_update_in_po(input.Po_Number);
						)
					}
				}

			}
			Gate_Entry_C_Validation as "Gate Entry (C)-Validation"
			{
				type =  form
				form = Gate_Entry

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_grn_number = Gate_Entry[Po_Number == input.Po_Number] sort by Added_Time desc;
										if(input.Po_Number.GRN_Status == "Received")
										{
											alert "Can't submit – goods already received from another GRN (" + get_grn_number.GRN_No + ").";
											cancel submit;
										}
										else
										{
											for each  each_line_item in input.Gate_Entry_Subfrom
											{
												sum_of_invoice_qty = Gate_Entry_Subform[Grn_Status_Item_Wise == each_line_item.Grn_Status_Item_Wise && Gate_Entry_No1 != null].sum(Invoice_Qty);
												if(sum_of_invoice_qty >= each_line_item.Grn_Status_Item_Wise.Po_Qty)
												{
													alert "Can't submit – goods already received from another GRN, please refersh and check it.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
			Gate_Entry_Deleted_Valida as "Gate Entry (Deleted)-Validation"
			{
				type =  form
				form = Gate_Entry

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_purchase_bill = Purchase_Bill[Gate_Entry.contains(input.ID)];
										if(get_purchase_bill.ID != null)
										{
											alert "Purchase Bill found for the given Gate Entry.";
											cancel delete;
										}
										else
										{
											delete from Excess_Inventory[Gate_Entry == {input.ID,null}];
											get_gate_entry = Gate_Entry_Subform[Gate_Entry_No1 == input.ID];
											for each  each_line_item in get_gate_entry
											{
												each_line_item.Invoice_Qty=0;
												each_line_item.Verified_Qty=0;
												each_line_item.Approved_Qty=0;
												each_line_item.Rejected_Qty=0;
												each_line_item.Verified_User_Id="";
												each_line_item.Allocated=0;
												each_line_item.Excess_General=0;
												each_line_item.Verification_Status="Not Verify";
												thisapp.grn_controllar.grn_line_item_status_update_in_po(each_line_item.Grn_Status_Item_Wise);
												thisapp.grn_controllar.update_po_qty_in_verification(each_line_item.Grn_Status_Item_Wise);
												get_purchase_request_raw_material = Po_Subform[ID == each_line_item.Grn_Status_Item_Wise];
												if(get_purchase_request_raw_material.ID != null)
												{
													for each  each_order_raw_material_id in get_purchase_request_raw_material.Order_Raw_Material_ID
													{
														thisapp.order_controllar.excess_status_update(each_order_raw_material_id.ID);
													}
												}
											}
											get_allocation_subform = Style_Wise_Inventory[GRN_Allocation_ID.Gate_Entry_No == input.ID];
											for each  each_location in get_allocation_subform
											{
												each_location.Allocate=0;
												thisapp.order_controllar.update_raw_material_allocation(each_location.Grouping_Subform_ID.Order_Raw_material_ID);
											}
											delete from Style_Wise_Inventory[GRN_Allocation_ID.Gate_Entry_No == {input.ID,null}];
											delete from GRN_Allocation[Gate_Entry_No == {input.ID,null}];
											delete from GRN_Yet_to_Allocate[GRN_Verification_ID.Grn_No == {input.ID,null}];
											delete from GRN_Verification[Grn_No == {input.ID,null}];
											delete from Gate_Entry_Subform[Gate_Entry_No1 == {input.ID,null}];
											delete from Debit_Note[Debit_Note_Header_ID.Gate_Entry == {input.ID,null}];
											delete from Debit_Note_Header[Gate_Entry == {input.ID,null}];
											thisapp.grn_controllar.grn_status_update_in_po(input.Po_Number);
										}
						)
					}
				}

			}
