			Order_Qty_Ratio as "Order Qty Ratio"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Ratio_Order_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(input.Size_Group != null && input.Ratio_Order_Qty != null)
										{
											// ✅ SHOW RATIO BEFORE POPULATE
											if(input.have_Size_Ratio == true)
											{
												show Finished_Goods_Size_wise.Ratio;
											}
											total_ratio = 0;
											size_rows = Size_Group_Subform[Size_Group_ID == input.Size_Group] sort by Sort_No asc;
											for each  r in size_rows
											{
												total_ratio = total_ratio + ifnull(r.Ratio,0);
											}
											if(total_ratio == 0)
											{
												return;
											}
											unit_qty = input.Ratio_Order_Qty / total_ratio;
											for each  row in input.Finished_Goods_Size_wise
											{
												for each  r in size_rows
												{
													if(row.Size != null && r.Size_No != null && row.Size.ID == r.Size_No.ID)
													{
														row.Ratio=ifnull(r.Ratio,0);
														before_qty = (r.Ratio * unit_qty).toLong();
														row.Before_Excess_Qty=before_qty;
														total_qty = before_qty;
														excess_qty = 0;
														if(input.Exces != null)
														{
															excess_qty = ((before_qty * input.Exces) / 100).toLong();
															total_qty = before_qty + excess_qty;
														}
														row.Excess_Qty=excess_qty;
														row.Total_Qty=total_qty;
													}
												}
											}
											total_order_qty = 0;
											total_before_qty = 0;
											for each  fg in input.Finished_Goods_Size_wise
											{
												total_order_qty = total_order_qty + ifnull(fg.Total_Qty,0);
												total_before_qty = total_before_qty + ifnull(fg.Before_Excess_Qty,0);
											}
											input.Order_Qty = total_order_qty;
											input.Order_Qty_with_out_Excess = total_before_qty;
										}
						)
					}
				}

			}
