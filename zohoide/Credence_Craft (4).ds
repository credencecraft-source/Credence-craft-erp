		{
			report Issued
			{
				quickview
				(
					layout
					(
		 				type = 9
						datablock1
						(
			 				display type = auto
							layout type = 31
							fields
							(
								PO_Number as "PO Number"
								Po_Status as "Po Status"
								Po_Type as "Po Type"
								Vendor_Name as "Vendor Name"
							)
						)
					)
						menu
						(
							header
							(
								Delete 
								Edit 
							)
						)
    				action
    				(
						on tap
						(
							View Record   	   
    					)
						on long press
						(
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
