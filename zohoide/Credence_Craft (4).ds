				Payment_Terms as "Payment Terms"
				Po_Terms as "Po Terms"
				PO_Support_No as "PO Support No"
				PO_Number as "PO Number"
				(
					width = 193px
				)
				GRN_Status as "GRN Status"
				(
					width = 251px
				)
