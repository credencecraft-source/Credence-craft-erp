			Grouping_Purchase_Request2 as "Grouping Purchase Request (C/E)-Success"
			{
				type =  form
				form = Grouping_Purchase_Request

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											delete from Grouping_Subform[Grouping_Purchase_Request_ID == null];
										for each  each_item in input.Order_Raw_Material_ID
										{
											thisapp.groping_controllar.update_group_status_in_order_raw_material(each_item.ID);
											get_costing = Costing[Order_No == each_item.Order_No];
											if(get_costing.ID != null)
											{
												thisapp.costing_controllar.referesh_costing(get_costing.ID,true);
											}
										}
										// Redirect user to the Page "Create_po"
										//openUrl("#Page:Create_po","same window");
						)
					}
				}

			}
			Grouping_Purchase_Request3 as "Grouping Purchase Request (Deleted)-Validation"
			{
				type =  form
				form = Grouping_Purchase_Request

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_master_group = Master_Group[Grouping_Purchase_Request_No.contains(input.ID)];
										if(get_master_group.ID != null)
										{
											alert "Found a Master Group associated with this Purchase Request so, please delete the Master Group first.";
											cancel delete;
										}
										else
										{
											get_grouping_item = Grouping_Subform[Grouping_Purchase_Request_ID == input.ID];
											if(get_grouping_item.ID != null)
											{
												for each  each_item in get_grouping_item
												{
													each_item.Grouped_Qty=0;
													thisapp.groping_controllar.update_group_status_in_order_raw_material(each_item.Order_Raw_material_ID);
												}
											}
											delete from Grouping_Subform[Grouping_Purchase_Request_ID == input.ID];
											delete from Grouping_Subform[Grouping_Purchase_Request_ID == null];
										}
						)
					}
				}

			}
