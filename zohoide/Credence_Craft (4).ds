		form Bundle_transfer_GRN_subform
		{
			displayname = "Bundle transfer GRN subform"
			success message = "Good Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Qty_To_be_Produced
			(
				type = number
				displayname = "Qty To be  Produced "
	 			row = 1
	 			column = 1   
				width = 100px
			)
			Process_Name
			(
				type = picklist	
				displayname = "Process Name"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Bundles_From
			(
				type = picklist	
				displayname = "Bundles From"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Operation
			(
				type = picklist	
				values  = Operation[Process_Master.ID == input.Process_Name].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 200px
			)
			Issued
			(
				type = number
	 			row = 1
	 			column = 1   
				width = 100px
			)
			Bundles_To
			(
				type = picklist	
				displayname = "Bundles To"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Price
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = 100px
			)
			Billable_Qty
			(
				type = number
				displayname = "Billable Qty"
	 			row = 1
	 			column = 2   
				width = 100px
			)
			Grn
			(
				type = number
	 			row = 1
	 			column = 2   
				width = 100px
			)
			Back_End
			(
				type = section
				displayname = "Back End"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Source
			(
				type = picklist
				maxchar = 100
				values = {"Q-app","Direct"}
				initial value = "Direct"
	 			row = 2
	 			column = 1   
				width = 100px
			)
			Grn_Status
			(
				type = picklist
				displayname = "Grn Status"
				maxchar = 100
				values = {"Draft","Submited"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = 100px
			)
			Bundle_No
			(
    			type = formula
				displayname = "Bundle  No"
				value =  "BND" + input.Auto_Number
				visibility = false
				display type = text
				format = plaintext
	 			row = 2
	 			column = 1   
				width = 100px
			)
			Process_Bundle_GRN
			(
				type = picklist	
				values  = Process_Bundle_GRN.ID
    			bidirectional = SubForm
    			displayformat = [ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 100px
			)
			Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = 100px
			)
			Vendor
