			Load_Data as "Load Data"
			{
				type =  form
				form = Rm_Plan_Sheet

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Requested_Dated = zoho.currentdate;
										input.SubForm.clear();
										for each  rec in Work_Order_Rawmateril[Work_Order_No == input.Wo_Order_No]
										{
											// ---- Work Order Required ----
											woRequiredQty = ifnull(rec.Work_Order_Qty_Rawmateril_Level,0);
											// ---- Requested (LIVE from Centralized Pick List HEADER) ----
											requestedQty = ifnull(Centralized_Pick_list[Order_No == rec.Order_No && Raw_Material1 == rec.Raw_Materil_Name && WO_No == input.Wo_Order_No].sum(Requested),0);
											// ---- Inventory (optional, unchanged) ----
											AllocatedQty = Style_Wise_Inventory[Order_No1 == rec.Order_No && Raw_Material1 == rec.Raw_Materil_Name];
											allocatedSum = ifnull(AllocatedQty.sum(Allocate),0);
											// ---- Insert RM Plan Row ----
											getRM = Rm_Plan_Sheet.SubForm();
											getRM.Order_No=rec.Order_No;
											getRM.Raw_Material1=rec.Raw_Materil_Name;
											getRM.RM=rec.Raw_Materil_Name;
											getRM.Category1=rec.cen;
											getRM.Subcategory1=rec.Subcategory1;
											getRM.Style_Name=rec.Order_No;
											getRM.Work_Order_No=input.Wo_Order_No;
											getRM.Wo_Order_Required=woRequiredQty;
											getRM.Requested=requestedQty;
											// ---- Balance = Required - Requested ----
											getRM.Balance_to_Request=ifnull(woRequiredQty,0) - ifnull(requestedQty,0);
											getRM.Allocated=allocatedSum;
											getRM.Entity_Delivery_Address=AllocatedQty.Entity_Delivery_Address;
											getRM.Warehouse_Location=AllocatedQty.Warehouse_Location.getall();
											getRM.Rack=AllocatedQty.Rack.getall();
											getRM.Rack_Bin=AllocatedQty.Rack_Bin1.getall();
											input.SubForm.insert(getRM);
										}
						)
					}
				}

			}
