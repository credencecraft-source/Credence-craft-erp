		form Purchase_Request
		{
			displayname = "Purchase Request"
			success message = "Purchase Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Raw_Material1
			(
				type = picklist	
				displayname = "Raw Material"
				values  = Raw_Material1.ID
    			displayformat = [Raw_Material_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			PO_Number
			(
				type = picklist	
				values  = Purchase_Order.ID
    			displayformat = [PO_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Uom
			(
				type = picklist	
				values  = Stock_Uom.ID
    			displayformat = [Stock_Uom]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Price
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			PO_Created
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			PO_ID
			(
				type = picklist	
				values  = Purchase_Order.ID
    			bidirectional = GpoID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category1
			(
				type = picklist	
				displayname = "Category"
				values  = Category1.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subcategory1
			(
				type = picklist	
				displayname = "Subcategory"
				values  = Subcategory1.ID
    			displayformat = [Subcategory_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Qty
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Quatation_From_Factory
