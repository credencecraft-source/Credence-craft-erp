				Po_Type as "Po Type"
				(
					width = 211px
				)
				Entity_Delivery_Address as "Entity-Delivery Address"
				Approved_Date_and_Time as "Approved Date and Time"
				Approved_By as "Approved By"
				Po_Status as "Po Status"
				(
					width = 175px
				)
