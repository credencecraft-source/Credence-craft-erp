                 		html = html + "<td style='padding:8px;border:1px solid #ccc;'>" + ifnull(rec.Style_No,"") + "</td>";
                 		html = html + "<td style='padding:8px;border:1px solid #ccc;'>" + ifnull(rec.Qty,0) + "</td>";
                 		html = html + "<td style='padding:8px;border:1px solid #ccc;'>" + ifnull(rec.Price,0) + "</td>";
                 		html = html + "<td style='padding:8px;border:1px solid #ccc;'>" + ifnull(rec.Total,0) + "</td>";
                 		html = html + "</tr>";
                 	}
                 	html = html + "</table>";
                 	html = html + "<br><b>Total Qty:</b> " + ifnull(quo.Total_Qty,0);
                 	html = html + "<br><b>Grand Total:</b> " + ifnull(quo.Total,0);
                 	// ===== SEND MAIL =====
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :email_to
                 		subject :"Quotation - " + quo.QuotationNo
                 		message :html
                 	]
                 	info "Quotation Email Sent";
                 }
				 void syncWOToOrder(int orderID)
                 {
                 	orderProcesses = Order_Process_Controler[Order_No == orderID];
                 	for each  op in orderProcesses
                 	{
                 		woProcesses = Wo_Making_Charges[Order_No == orderID && Process_Name == op.Process_Name];
                 		totalIn = 0;
                 		totalOut = 0;
                 		totalCompleted = 0;
                 		for each  wp in woProcesses
                 		{
                 			totalIn = totalIn + ifnull(wp.In_Put,0);
                 			totalOut = totalOut + ifnull(wp.Out_Put,0);
                 			totalCompleted = totalCompleted + ifnull(wp.Completed_Qty1,0);
                 		}
                 		op.In_Put=totalIn;
                 		op.Out_Put=totalOut;
                 		op.Completed_Qty1=totalCompleted;
                 		wipVal = totalIn - totalOut;
                 		if(wipVal < 0)
                 		{
                 			wipVal = 0;
                 		}
                 		op.WIP_or_Missing1=wipVal;
                 	}
                 }
