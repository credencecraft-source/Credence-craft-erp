			Request_Activate as "Request Activate"
			{
				type =  functions
				form = Pricing
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						rec = Pricing[ID == input.ID];
										if(rec.count() > 0)
										{
											for each  r in rec
											{
												r.BackendOTP="";
												random_str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
												len = random_str.length().toLong();
												now_ms = zoho.currenttime.toLong();
												// ===== PLAN LIST =====
												plan_list = {"FREE_25","100","100_PROFESSIONAL_ACCESS","100_FULL_ENTERPRISE_ACCESS","200","200_PROFESSIONAL_ACCESS","200_FULL_ENTERPRISE_ACCESS","UNLIMITED_FULL_ENTERPRISE_ACCESS","UNLIMITED","UNLIMITED_PROFESSIONAL_ACCESS"};
												otp_list = "";
												free_otps = "";
												basic_otps = "";
												professional_otps = "";
												enterprise_otps = "";
												counter = 0;
												for each  plan in plan_list
												{
													// ===== RANDOM GENERATION =====
													seed = now_ms + counter * 173;
													i1 = ((seed + 5) % len).toLong();
													i2 = ((seed + 19) % len).toLong();
													i3 = ((seed + 31) % len).toLong();
													i4 = ((seed + 47) % len).toLong();
													i5 = ((seed + 59) % len).toLong();
													i6 = ((seed + 73) % len).toLong();
													i7 = ((seed + 89) % len).toLong();
													i8 = ((seed + 101) % len).toLong();
													block1 = random_str.substring(i1,i1 + 1) + random_str.substring(i2,i2 + 1) + random_str.substring(i3,i3 + 1) + random_str.substring(i4,i4 + 1);
													block2 = random_str.substring(i5,i5 + 1) + random_str.substring(i6,i6 + 1) + random_str.substring(i7,i7 + 1) + random_str.substring(i8,i8 + 1);
													full_otp = block1 + "-" + block2 + "-" + plan;
													// ===== STORE OTP LIST =====
													if(counter == 0)
													{
														otp_list = full_otp;
													}
													else
													{
														otp_list = otp_list + "," + full_otp;
													}
													// ===== GROUPING =====
													if(plan == "FREE_25")
													{
														free_otps = free_otps + full_otp + "<br>";
													}
													else if(plan.isNumber() || plan == "UNLIMITED")
													{
														basic_otps = basic_otps + full_otp + "<br>";
													}
													else if(plan.contains("PROFESSIONAL_ACCESS"))
													{
														professional_otps = professional_otps + full_otp + "<br>";
													}
													else if(plan.contains("FULL_ENTERPRISE_ACCESS"))
													{
														enterprise_otps = enterprise_otps + full_otp + "<br>";
													}
													counter = counter + 1;
												}
												// ===== SAVE ALL OTPs =====
												r.BackendOTP=otp_list;
												// ===== EMAIL TABLE =====
												html_table = "<h3 style='font-family:Arial;'>Your OTP Plans</h3>" + "<table style='border-collapse:collapse;font-family:Arial;width:100%;text-align:center;'>" + "<tr style='background:#f2f2f2;'>" + "<th style='padding:10px;border:1px solid #ccc;'>FREE</th>" + "<th style='padding:10px;border:1px solid #ccc;'>BASIC</th>" + "<th style='padding:10px;border:1px solid #ccc;'>PROFESSIONAL</th>" + "<th style='padding:10px;border:1px solid #ccc;'>ENTERPRISE</th>" + "</tr>" + "<tr>" + "<td style='padding:12px;border:1px solid #ccc;'>" + free_otps + "</td>" + "<td style='padding:12px;border:1px solid #ccc;'>" + basic_otps + "</td>" + "<td style='padding:12px;border:1px solid #ccc;'>" + professional_otps + "</td>" + "<td style='padding:12px;border:1px solid #ccc;'>" + enterprise_otps + "</td>" + "</tr>" + "</table>";
												sendmail
												[
													from :zoho.adminuserid
													to :"credencecraft@gmail.com"
													subject :"Your Plan Activation OTP Details"
													message :html_table
												]
												info "OTP Generated & Email Sent Successfully";
											}
										}
										else
										{
											info "Record not found.";
										}
					)
					}
				}
			}
