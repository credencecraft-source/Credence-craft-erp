			{
				type =  form
				form = Order_Process_Controler

				record event = on add or edit

				on user input of job_order.Bom_Price1
				{
					actions 
					{
						custom deluge script
						(
											// On User Input of Bom_Price in SubForm
										bom_total = 0;
										for each  each_row in input.job_order
										{
											if(each_row.Bom_Price1 != null)
											{
												bom_total = bom_total + each_row.Bom_Price1;
											}
										}
										// update parent form header field Bom_Price
										input.Bom_Price = bom_total;
						)
					}
				}

			}
			On_Load5 as "On Load"
			{
				type =  form
				form = Excess_Inventory_Request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set header field
										input.From = "Excess_Inventory";
										// Clear existing subform rows
										input.SubForm.clear();
										// Loop through selected Excess Inventory records
										for each  rec in input.Excess_Inventory
										{
											excess_rec = Excess_Inventory[ID == rec];
											getRM = Excess_Inventory_Request.SubForm();
											getRM.Raw_Material1=excess_rec.Raw_Material1;
											getRM.Category1=excess_rec.Category1;
											getRM.Subcategory1=excess_rec.Subcategory1;
											getRM.Stock_Uom=excess_rec.Stock_Uom;
											input.SubForm.insert(getRM);
										}
						)
					}
				}

			}
			PICKED as "PICKED"
			{
				type =  form
				form = Centralized_Pick_list

				record event = on edit

				on user input of SubForm.Picked
				{
					actions 
					{
						custom deluge script
						(
											totalPickedVal = ifnull(row.Already_Picked,0) + ifnull(row.Picked,0);
										if(totalPickedVal <= ifnull(row.Allocated,0))
										{
											row.Stock_Available_in_Allocated=ifnull(row.Allocated,0) - totalPickedVal;
											getAllPicked = input.SubForm.sum(Picked) + input.SubForm.sum(Already_Picked);
											getAvAllo = input.SubForm.sum(Stock_Available_in_Allocated);
											input.Picked = ifnull(getAllPicked,0);
											input.Balance_Required = ifnull(input.Requested,0) - ifnull(input.Picked,0);
											input.Stock_Available_in_Allocated = getAvAllo;
										}
										else
										{
											info "Please Enter Valid Value";
											row.Picked=null;
										}
						)
					}
				}

			}
			Update_Status as "Update Status"
			{
				type =  form
				form = Centralized_Pick_list

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Balance_to_Create_Box = ifnull(input.Picked,0) - ifnull(input.Boxed_Qty,0);
										if(ifnull(input.Picked,0) == 0)
										{
											input.Status = "Draft";
										}
										else if(ifnull(input.Requested,0) > ifnull(input.Picked,0))
										{
											input.Status = "Partially Picked";
										}
										else if(ifnull(input.Requested,0) == ifnull(input.Picked,0))
										{
											input.Status = "Picked";
										}
										for each  rec in input.SubForm
										{
											rec.Already_Picked=ifnull(rec.Already_Picked,0) + rec.Picked;
											getStyle = Style_Wise_Inventory[Order_No1 == input.Order_No && Raw_Material1 == input.Raw_Material1];
											addStyle = Style_Wise_Inventory.SubForm();
											addStyle.Centralized_Pick_list=input.ID;
											addStyle.Style_No=input.Order_No;
											addStyle.Order_No=input.Order_No;
											addStyle.Picked_Qty=rec.Picked;
											addStyle.Picked_Email_id=zoho.loginuserid;
											addStyle.Picked_Date_And_Time=input.Added_Time;
											addStyle.Work_Order_New=input.WO_No;
											addStyle.Style_Wise_Inventory=getStyle.ID;
											getStyle.Already_Allocated=ifnull(getStyle.Already_Allocated,0) + rec.Picked;
											getStyle.Balance_To_Allocate=ifnull(getStyle.Allocate,0) - getStyle.Already_Allocated;
											getStyle.Stock_Available_In_Allocated=ifnull(getStyle.Allocate,0) - getStyle.Already_Allocated;
											getStyle.Picked=ifnull(getStyle.Picked,0) + rec.Picked;
											getStyle.SubForm.insert(addStyle);
											rec.Picked=null;
											thisapp.work_order_controllar.Wo_Style_Wise_Inveroey(getStyle.ID);
										}
										// 		getPickList = Pick_List_Subform[ID == createRec];
						)
					}
				}

			}
