				 void Carton.Innerbox(Scan_Pack idVal)
                 {
                 	// Collect distinct values for validation
                 	orderList = (idVal.Order_No1.getall()).distinct();
                 	styleList = (idVal.Style_Name.getall()).distinct();
                 	factoryList = (idVal.Factory.getall()).distinct();
                 	// Validation — ensure all are same
                 	if(orderList.size() > 1 || styleList.size() > 1 || factoryList.size() > 1)
                 	{
                 		info "All selected records must have the same Order No, Style Name, and Factory.";
                 	}
                 	else
                 	{
                 		// Step 1 — Calculate total Picked Qty
                 		totalQty = 0;
                 		for each  rec in idVal
                 		{
                 			if(rec.Picked != null)
                 			{
                 				totalQty = totalQty + rec.Picked;
                 			}
                 		}
                 		// Step 2 — Create new Inner_Carton record
                 		createBox = insert into Inner_Carton
                 		[
                 			Added_User=zoho.loginuser
                 			Brand1=factoryList.get(0)
                 			Order_No=orderList.get(0)
                 			Style_No=styleList.get(0)
                 			Qty=totalQty
                 			Status="Fully Boxed"
                 		];
                 		// Step 3 — Update all selected Scan_Pack records
                 		for each  rec in idVal
                 		{
                 			getPickList = Scan_Pack[ID == rec.ID];
                 			getPickList.Box_Status="Fully Boxed";
                 		}
                 		info "Inner_Carton created successfully. Total Qty: " + totalQty;
                 	}
                 }
				 void costing_controllar.create_costing(int order_id)
                 {
                 	get_order = Create_Order[ID == order_id];
                 	if(get_order.ID != null)
                 	{
                 		get_rm = Order_Raw_material[Order_No == get_order.ID && Category_Master.Create_Cost_Center == true && Raw_material_Status == "Approved"];
                 		if(ifnull(get_rm.sum(Value_Per_Garment_Rm),0) > 0)
                 		{
                 			get_margin_value = ifnull(get_order.Fob,0) - ifnull(get_rm.sum(Value_Per_Garment_Rm),0);
                 		}
                 		else
                 		{
                 			get_margin_value = 0;
                 		}
                 		get_order_costing = Costing[Order_No == get_order.ID];
                 		if(get_order_costing.ID == null)
                 		{
                 			insert_costing = insert into Costing
                 			[
                 				Fob1=get_order.Fob
                 				Order_Qty1=get_order.Order_Qty
                 				Style_Name1=get_order.Style_Name
                 				Brand=get_order.Brand
                 				Buyer=get_order.Buyer1
                 				Season=get_order.Season
                 				Gold_Seal=get_order.Article
                 				Create_Eo_No=get_order.Eo_No_and_Name
                 				Order_No=get_order.ID
                 				Cost_garment_RM=get_rm.sum(Value_Per_Garment_Rm)
                 				Exp_Margin=get_margin_value
                 				Added_User=zoho.loginuser
                 				Costing_Status="Draft"
                 			];
                 		}
                 		else
                 		{
                 			get_order_costing.Fob1=get_order.Fob;
                 			get_order_costing.Order_Qty1=get_order.Order_Qty;
                 			get_order_costing.Style_Name1=get_order.Style_Name;
                 			get_order_costing.Brand=get_order.Brand;
                 			get_order_costing.Buyer=get_order.Buyer1;
                 			get_order_costing.Season=get_order.Season;
                 			get_order_costing.Gold_Seal=get_order.Article;
                 			get_order_costing.Create_Eo_No=get_order.Eo_No_and_Name;
                 			get_order_costing.Order_No=get_order.ID;
                 			get_order_costing.Cost_garment_RM=get_rm.sum(Value_Per_Garment_Rm);
                 			get_order_costing.Exp_Margin=get_margin_value;
                 		}
                 		get_costing_id = ifnull(get_order_costing.ID,insert_costing);
                 		// 			delete from Order_Cost_Center[Costing_ID == get_costing_id];
                 		get_all_category = Category1[Create_Cost_Center == true].ID.getAll();
                 		get_category_list = get_all_category.tolist().distinct();
                 		for each  each_category in get_category_list
                 		{
                 			get_categpry = Category1[ID == each_category];
                 			if(get_categpry.ID != null)
                 			{
                 				get_costing_category = Order_Cost_Center[Category == get_categpry.ID && Costing_ID == get_costing_id];
                 				sum_of_bom_value = Order_Raw_material[Order_No == get_order.ID && Category_Master == get_categpry.ID].sum(Value_Per_Garment_Rm);
                 				if(get_costing_category.ID == null)
                 				{
                 					insert_costing_cen = insert into Order_Cost_Center
                 					[
                 						Category=get_categpry.ID
                 						Category_Type=get_categpry.Category_Type_Master
                 						Bom_Total=sum_of_bom_value
                 						Maximum_Allowed=0
                 						Total_Spend=0
                 						Diffrence=0
                 						Costing_ID=get_costing_id
                 						Added_User=zoho.loginuser
                 					];
                 				}
                 				else
                 				{
                 					get_costing_category.Bom_Total=sum_of_bom_value;
                 				}
                 			}
                 		}
                 	}
                 }
				 void costing_controllar.create_costing_history(int costing_order_center_id)
                 {
                 	get_costing_order = Order_Cost_Center[ID == costing_order_center_id];
                 	if(get_costing_order.ID != null)
                 	{
                 		get_costing_history = Costing_History[Order_Cost_Center_ID == get_costing_order.ID] sort by Support_No desc;
                 		if(get_costing_history.ID != null)
                 		{
                 			get_old_bom_price = get_costing_history.Maximum_Allowed;
                 			get_maximum_allowed = get_costing_order.Maximum_Allowed;
                 		}
                 		else
                 		{
                 			get_old_bom_price = 0;
                 			get_maximum_allowed = get_costing_order.Bom_Total;
                 		}
                 		insert_costing_history = insert into Costing_History
                 		[
                 			Costing_ID=get_costing_order.Costing_ID
                 			Added_User=zoho.loginuser
                 			Approved_Date_Time=zoho.currenttime
                 			Approved_By=zoho.loginuserid
                 			Order_No=get_costing_order.Costing_ID.Order_No
                 			Order_Cost_Center_ID=get_costing_order.ID
                 			Old_BOM_Price=get_old_bom_price
                 			Maximum_Allowed=get_maximum_allowed
                 			Category1=get_costing_order.Category
                 		];
                 	}
                 }
				 float costing_controllar.referesh_costing(int costing_id, bool get_flag)
                 {
                 	get_costing = Costing[ID == costing_id];
                 	if(get_costing.ID == null)
                 	{
                 		return 0;
                 	}
                 	get_return_value = 0;
                 	// ================= CATEGORY LEVEL COSTING =================
                 	get_costing_category = Order_Cost_Center[Costing_ID == get_costing.ID];
                 	for each  each_costing_category in get_costing_category
                 	{
                 		// --------- BOM RM / GARMENT ----------
                 		sum_of_bom_value = Order_Raw_material[Order_No == get_costing.Order_No && Category_Master == each_costing_category.Category].sum(Value_Per_Garment_Rm);
                 		each_costing_category.Bom_Total=ifnull(sum_of_bom_value,0);
                 		if(get_flag == true)
                 		{
                 			// -------- ACTUAL SPEND (GRN + Bills) ----------
                 			sum_of_total_spend = Grouping_Subform[Order_Raw_material_ID.Order_No == get_costing.Order_No && Raw_Material1.Category == each_costing_category.Category].sum(Total_Spend_With_Other_Charges);
                 			each_costing_category.Total_Spend=ifnull(sum_of_total_spend,0);
                 			// ? GOLD SEAL FREEZE
                 			if(get_costing.Costing_Status == "Approved" || get_costing.Costing_Status == "Submitted")
                 			{
                 				if(each_costing_category.Maximum_Allowed == null || each_costing_category.Maximum_Allowed == 0)
                 				{
                 					each_costing_category.Maximum_Allowed=each_costing_category.Bom_Total;
                 				}
                 			}
                 			// -------- ORDER LEVEL BUDGET ----------
                 			each_costing_category.Order_Total=ifnull(each_costing_category.Maximum_Allowed,0) * ifnull(get_costing.Order_Qty1,0);
                 			// -------- VARIANCE ----------
                 			each_costing_category.Diffrence=ifnull(each_costing_category.Order_Total,0) - ifnull(each_costing_category.Total_Spend,0);
                 			if(each_costing_category.Diffrence < 0)
                 			{
                 				get_return_value = each_costing_category.Diffrence;
                 			}
                 			else if(get_return_value >= 0)
                 			{
                 				get_return_value = 0;
                 			}
                 		}
                 	}
                 	// ================= HEADER LEVEL RM =================
                 	total_rm = Order_Cost_Center[Costing_ID == get_costing.ID].sum(Bom_Total);
                 	get_costing.Cost_garment_RM=ifnull(total_rm,0);
                 	// ================= HEADER LEVEL CM =================
                 	sum_of_cm = Process_Cost_Center[Costing == get_costing.ID].sum(Bom_Price);
                 	get_costing.Cost_garment_CM=ifnull(sum_of_cm,0);
                 	// ================= EXPECTED MARGIN =================
                 	if(get_costing.Cost_garment_RM > 0)
                 	{
                 		get_costing.Exp_Margin=ifnull(get_costing.Fob1,0) - ifnull(get_costing.Cost_garment_RM,0) - ifnull(get_costing.Cost_garment_CM,0);
                 	}
                 	else
                 	{
                 		get_costing.Exp_Margin=0;
                 	}
                 	return get_return_value;
                 }
				 void debit_note_controllar.create_debite_notes(int grn_raw_material_id)
                 {
                 	get_grn_raw_material = Gate_Entry_Subform[ID == grn_raw_material_id];
                 	if(get_grn_raw_material.ID != null)
                 	{
                 		get_debit_note_header = Debit_Note_Header[Gate_Entry == get_grn_raw_material.Gate_Entry_No1];
                 		if(get_debit_note_header.ID == null)
                 		{
                 			insert_debit_note = insert into Debit_Note_Header
                 			[
                 				Invoice_No1=get_grn_raw_material.Gate_Entry_No1.Invoice_No
                 				Gate_Entry=get_grn_raw_material.Gate_Entry_No1
                 				Invoice_Date1=get_grn_raw_material.Gate_Entry_No1.Invoice_Date
                 				Vendor1=get_grn_raw_material.Gate_Entry_No1.Vendor1
                 				Status="Draft"
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 		else
                 		{
                 			get_debit_note_header.Invoice_No1=get_grn_raw_material.Gate_Entry_No1.Invoice_No;
                 			get_debit_note_header.Invoice_Date1=get_grn_raw_material.Gate_Entry_No1.Invoice_Date;
                 			get_debit_note_header.Vendor1=get_grn_raw_material.Gate_Entry_No1.Vendor1;
                 		}
                 		get_po_and_invoice_price_different = ifnull(get_grn_raw_material.Invoice_Price1,0) - ifnull(get_grn_raw_material.Po_Price,0);
                 		if(get_po_and_invoice_price_different < 0)
                 		{
                 			get_po_and_invoice_price_different = 0;
                 		}
                 		get_invoice_qty_and_po_qty_different = ifnull(get_grn_raw_material.Grn_Status_Item_Wise.Sum_Of_Invoice_Qty,0) - ifnull(get_grn_raw_material.Po_Qty,0);
                 		if(get_invoice_qty_and_po_qty_different < 0)
                 		{
                 			get_invoice_qty_and_po_qty_different = 0;
                 		}
                 		get_invoice_and_verification_qty = ifnull(get_grn_raw_material.Invoice_Qty,0) - ifnull(get_grn_raw_material.Verified_Qty,0);
                 		if(get_invoice_and_verification_qty < 0)
                 		{
                 			get_invoice_and_verification_qty = 0;
                 		}
                 		get_1st_debit_note_price = ifnull(get_po_and_invoice_price_different,0) * ifnull(get_grn_raw_material.Invoice_Qty,0);
                 		get_over_supply = get_invoice_qty_and_po_qty_different * ifnull(get_grn_raw_material.Po_Price,0);
                 		get_missing_value = get_invoice_and_verification_qty * ifnull(get_grn_raw_material.Po_Price,0);
                 		get_rejected_qty_price = ifnull(get_grn_raw_material.Rejected_Qty,0) * ifnull(get_grn_raw_material.Po_Price,0);
                 		get_total_debit_amount = get_1st_debit_note_price + get_over_supply + get_missing_value + get_rejected_qty_price;
                 		get_gst_value = (get_total_debit_amount * ifnull(get_grn_raw_material.Grn_Status_Item_Wise.Gst11.Gst,0)) / 100;
                 		get_debit_note = Debit_Note[RM_Uniqie_Number == get_grn_raw_material.ID];
                 		if(get_debit_note.ID == null)
                 		{
                 			insert_debit_note_subform = insert into Debit_Note
                 			[
                 				RM_Number1=get_grn_raw_material.Raw_Material1.RM_No
                 				Subcategory1=get_grn_raw_material.Raw_Material1.Subcategory
                 				Category_Type1=get_grn_raw_material.Raw_Material1.Category_Type
                 				Total_Debit_Value=get_total_debit_amount
                 				PO_Price=ifnull(get_grn_raw_material.Po_Price,0)
                 				Verification_Qty=ifnull(get_grn_raw_material.Verified_Qty,0)
                 				RM_Uniqie_Number=get_grn_raw_material.ID
                 				Rejected_Qty=ifnull(get_grn_raw_material.Rejected_Qty,0)
                 				Category1=get_grn_raw_material.Raw_Material1.Category
                 				Price_Debit_Amount=get_1st_debit_note_price
                 				Invoice_Qty2=ifnull(get_grn_raw_material.Po_Qty,0)
                 				Invoice_Price=ifnull(get_grn_raw_material.Invoice_Price1,0)
                 				Invoice_Qty1=ifnull(get_grn_raw_material.Invoice_Qty,0)
                 				Missing_Value=get_missing_value
                 				Rejected_Qty_po_Price=get_rejected_qty_price
                 				Gst=get_grn_raw_material.Grn_Status_Item_Wise.Gst11
                 				Gst_Amount=get_gst_value
                 				Total_Debit_Amount=get_total_debit_amount + get_gst_value
                 				Po_vs_Invoice_Debit=get_invoice_qty_and_po_qty_different
                 				Po_Vs_Invoice_Price=get_po_and_invoice_price_different
                 				Invoice_Qty=ifnull(get_grn_raw_material.Grn_Status_Item_Wise.Sum_Of_Invoice_Qty,0)
                 				Over_Supply_Value=get_over_supply
                 				Raw_Material1=get_grn_raw_material.Raw_Material1
                 				Gate_Entry=get_grn_raw_material.Gate_Entry_No1
                 				Invoice_Vs_verification_missing=get_invoice_and_verification_qty
                 				Purchase_Order=get_grn_raw_material.Purchase_NO
                 				Po_Qty=get_grn_raw_material.Po_Qty
                 				Debit_Note_Header_ID=ifnull(get_debit_note_header.ID,insert_debit_note)
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 		else
                 		{
                 			get_debit_note.Total_Debit_Value=get_total_debit_amount;
                 			get_debit_note.PO_Price=get_grn_raw_material.Po_Price;
                 			get_debit_note.Verification_Qty=ifnull(get_grn_raw_material.Verified_Qty,0);
                 			get_debit_note.Rejected_Qty=ifnull(get_grn_raw_material.Rejected_Qty,0);
                 			get_debit_note.Price_Debit_Amount=get_1st_debit_note_price;
                 			get_debit_note.Invoice_Qty2=ifnull(get_grn_raw_material.Po_Qty,0);
                 			get_debit_note.Invoice_Price=ifnull(get_grn_raw_material.Invoice_Price1,0);
                 			get_debit_note.Invoice_Qty1=ifnull(get_grn_raw_material.Invoice_Qty,0);
                 			get_debit_note.Missing_Value=get_missing_value;
                 			get_debit_note.Rejected_Qty_po_Price=get_rejected_qty_price;
                 			get_debit_note.Po_vs_Invoice_Debit=get_invoice_qty_and_po_qty_different;
                 			get_debit_note.Po_Vs_Invoice_Price=get_po_and_invoice_price_different;
                 			get_debit_note.Invoice_Qty=ifnull(get_grn_raw_material.Grn_Status_Item_Wise.Sum_Of_Invoice_Qty,0);
                 			get_debit_note.Over_Supply_Value=get_over_supply;
                 			get_debit_note.Gst=get_grn_raw_material.Grn_Status_Item_Wise.Gst11;
                 			get_debit_note.Gst_Amount=get_gst_value;
                 			get_debit_note.Total_Debit_Amount=get_total_debit_amount + get_gst_value;
                 			get_debit_note.Invoice_Vs_verification_missing=get_invoice_and_verification_qty;
                 			get_debit_note.Po_Qty=get_grn_raw_material.Po_Qty;
                 		}
                 		get_debit_note_header1 = Debit_Note_Header[ID == ifnull(get_debit_note_header.ID,insert_debit_note)];
                 		if(get_debit_note_header1.ID != null)
                 		{
                 			sum_of_debit_amount = Debit_Note[Debit_Note_Header_ID == get_debit_note_header1.ID].sum(Total_Debit_Amount);
                 			get_debit_note_header1.Total_Debit=sum_of_debit_amount;
                 		}
                 	}
                 }
				 void delivery_controller.create_dc_from_packing_list(Packing_List_Header packList)
                 {
                 	// ===============================
                 	// SAFETY CHECK
                 	// ===============================
                 	if(packList == null || packList.count() == 0)
                 	{
                 		info "Select at least one Packing List";
                 		return;
                 	}
                 	// ===============================
                 	// DUPLICATE DC CHECK
                 	// ===============================
                 	for each  pl in packList
                 	{
                 		if(pl.Delivery_Challan != null)
                 		{
                 			info "Delivery Challan already created for Packing List : " + pl.ID;
                 			return;
                 		}
                 	}
                 	// ===============================
                 	// SINGLE BRAND / VENDOR CHECK
                 	// ===============================
                 	brandList = List();
                 	vendorList = List();
                 	for each  pl in packList
                 	{
                 		if(pl.Brand11 != null)
                 		{
                 			brandList.add(pl.Brand11);
                 		}
                 		if(pl.Vendor1 != null)
                 		{
                 			vendorList.add(pl.Vendor1);
                 		}
                 	}
                 	brandList = brandList.distinct();
                 	vendorList = vendorList.distinct();
                 	if(vendorList.size() == 0)
                 	{
                 		info "Vendor is missing in Packing List";
                 		return;
                 	}
                 	if(brandList.size() == 0)
                 	{
                 		info "Brand is missing in Packing List";
                 		return;
                 	}
                 	if(brandList.size() > 1)
                 	{
                 		info "Multiple Brands not allowed in one DC";
                 		return;
                 	}
                 	if(vendorList.size() > 1)
                 	{
                 		info "Multiple Vendors not allowed in one DC";
                 		return;
                 	}
                 	// ===============================
                 	// CREATE DELIVERY CHALLAN HEADER
                 	// ===============================
                 	dc_id = insert into GRN_Delivery
                 	[
                 		Vendors1=vendorList.get(0)
                 		Date_field=zoho.currentdate
                 		Is_this_Returnable=false
                 		Source="Packing List"
                 		Added_User=zoho.loginuser
                 	];
                 	// ===============================
                 	// INSERT DC ITEMS
                 	// ===============================
                 	for each  pl in packList
                 	{
                 		plRows = Packing_List[Packing_List_Header == pl.ID];
                 		for each  r in plRows
                 		{
                 			item_text = "";
                 			// ✅ FIX: Use Outer Carton Number instead of ID
                 			if(r.OUTER_CARTON1 != null)
                 			{
                 				item_text = item_text + r.OUTER_CARTON1.Outer_Carton_No;
                 			}
                 			if(r.Size != null)
                 			{
                 				item_text = item_text + " | " + r.Size;
                 			}
                 			if(r.Details != null)
                 			{
                 				item_text = item_text + " | " + r.Details;
                 			}
                 			insert into Delivery_Challan_Subform
                 			[
                 				Delivery_Challan=dc_id
                 				Item=item_text
                 				Requested_Qty=ifnull(r.Qty,0)
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 		// ===============================
                 		// UPDATE PACKING LIST STATUS
                 		// ===============================
                 		pl.Delivery_Challan=dc_id;
                 		pl.Status="DC Created";
                 	}
                 	info "Delivery Challan created successfully. DC ID : " + dc_id;
                 }
				 void delivery_controller.create_dc_from_pick_boxes(RM_PICK_BOX pickBoxList)
                 {
                 	// ===== PREVENT DUPLICATE DC =====
                 	for each  pb in pickBoxList
                 	{
                 		if(pb.Delivery_Challan != null)
                 		{
                 			info "Delivery Challan already created. DC ID : " + pb.Delivery_Challan;
                 			return;
                 		}
                 	}
                 	// ===== GET BASE VENDOR =====
                 	baseVendor = null;
                 	for each  pb in pickBoxList
                 	{
                 		baseVendor = pb.Vendor1;
                 		break;
                 	}
                 	if(baseVendor == null)
                 	{
                 		info "Vendor is missing in selected Pick Box";
                 		return;
                 	}
                 	// ===== SINGLE VENDOR CHECK =====
                 	for each  pb in pickBoxList
                 	{
                 		if(pb.Vendor1 != baseVendor)
                 		{
                 			info "Multiple vendors not allowed in one Delivery Challan";
                 			return;
                 		}
                 	}
                 	// ===== CREATE ONE DELIVERY CHALLAN =====
                 	dc_id = insert into GRN_Delivery
                 	[
                 		Vendors1=baseVendor
                 		Date_field=zoho.currentdate
                 		Is_this_Returnable=false
                 		Source="Work order style"
                 		Added_User=zoho.loginuser
                 	];
                 	// ===== LOOP PICK BOXES =====
                 	for each  pb in pickBoxList
                 	{
                 		// ? INDEPENDENT SUBFORM FETCH
                 		box_rows = Rm_Pick_Box_Subform[RM_PICK_BOX == pb.ID];
                 		for each  box_row in box_rows
                 		{
                 			if(ifnull(box_row.Packed,0) > 0)
                 			{
                 				item_text = "";
                 				// Box Number (FROM PARENT VIA LOOKUP)
                 				if(box_row.RM_PICK_BOX != null && box_row.RM_PICK_BOX.Box_Number1 != null)
                 				{
                 					item_text = box_row.RM_PICK_BOX.Box_Number1;
                 				}
                 				// Order No
                 				if(box_row.Order_No != null)
                 				{
                 					item_text = item_text + " - " + box_row.Order_No.Order_No;
                 				}
                 				// Style Name
                 				if(box_row.Create_Order1 != null)
                 				{
                 					item_text = item_text + " - " + box_row.Create_Order1.Style_Name;
                 				}
                 				// Raw Material
                 				if(box_row.Rawmateril != null)
                 				{
                 					item_text = item_text + " - " + box_row.Rawmateril.Raw_Material_Name;
                 				}
                 				insert into Delivery_Challan_Subform
                 				[
                 					Delivery_Challan=dc_id
                 					Item=item_text
                 					Requested_Qty=box_row.Packed
                 					Added_User=zoho.loginuser
                 				]
                 			}
                 		}
                 		// ===== UPDATE PICK BOX HEADER =====
                 		pb.Delivery_Challan=dc_id;
                 		pb.Status="DC Created";
                 	}
                 	info "Delivery Challan created successfully. DC ID : " + dc_id;
                 }
				 void excess_invenory_controllar.create_excess_from_verification(int grn_line_item_id)
                 {
                 	get_grn_item = Gate_Entry_Subform[ID == grn_line_item_id];
                 	if(get_grn_item.ID != null)
                 	{
                 		get_excess_inventory = Excess_Inventory[Gate_Entry == get_grn_item.Gate_Entry_No1 && Raw_Material1 == get_grn_item.Raw_Material1];
                 		if(get_excess_inventory.ID != null)
                 		{
                 			get_excess_inventory.Category1=get_grn_item.Raw_Material1.Category;
                 			get_excess_inventory.Subcategory1=get_grn_item.Raw_Material1.Subcategory;
                 			get_excess_inventory.Total_Qty=get_grn_item.Excess_General;
                 			get_excess_inventory.Fresh_Excess=get_grn_item.Fresh_Excess;
                 			get_excess_inventory.Po_Price=get_grn_item.Po_Price;
                 			get_excess_inventory.Invoice_Price=ifnull(get_grn_item.Invoice_Price1,0);
                 			get_excess_inventory.RM_Unique=get_grn_item.ID;
                 			get_excess_inventory.Stock_Uom=get_grn_item.Raw_Material1.Stock_Uom1;
                 		}
                 		else
                 		{
                 			insert_excess_inventory = insert into Excess_Inventory
                 			[
                 				Added_User=zoho.loginuser
                 				Gate_Entry=get_grn_item.Gate_Entry_No1
                 				RM_Unique=get_grn_item.ID
                 				Raw_Material1=get_grn_item.Raw_Material1
                 				Raw_Material_No=get_grn_item.Raw_Material1.RM_No
                 				Vendor1=get_grn_item.Vendor1
                 				Category1=get_grn_item.Raw_Material1.Category
                 				Subcategory1=get_grn_item.Raw_Material1.Subcategory
                 				Source="Through GRN"
                 				Fresh_Excess=get_grn_item.Fresh_Excess
                 				Rejected_Excess=get_grn_item.Excess_General - get_grn_item.Fresh_Excess
                 				Total_Qty=get_grn_item.Excess_General
                 				Po_Price=get_grn_item.Po_Price
                 				Invoice_Price=ifnull(get_grn_item.Invoice_Price1,0)
                 				Stock_Uom=get_grn_item.Raw_Material1.Stock_Uom1
                 			];
                 		}
                 	}
                 }
				 void Fabric_Module.Create_Fab_Module(int rawMaterial, int eoNo)
                 {
                 	getOrder = Create_Order[Eo_No_and_Name == eoNo].ID.getAll();
                 	getBodyFabric = Order_Raw_material[Raw_Material_Name == input.rawMaterial && Order_No in getOrder && Verification_Status == "Approved" && Subcategory.Subcategory_Name == "Body Fabric"];
                 	createFabModule = insert into Fab_Module
                 	[
                 		Added_User=zoho.loginuser
                 		Raw_Material1=rawMaterial
                 		Eo_No=eoNo
                 	];
                 	for each  rec in getBodyFabric
                 	{
                 		createFabModuleSub = insert into Fab_Module_Subform
                 		[
                 			Added_User=zoho.loginuser
                 			Create_Order=rec.Order_No
                 			Fab_Module=createFabModule
                 		];
                 	}
                 }
				 void finance.generateMonthlyBudget()
                 {
                 	m = zoho.currentdate.getMonth();
                 	y = zoho.currentdate.getYear();
                 	for each  t in General_Po_Budget[Status == "Active"]
                 	{
                 		existing = General_Po_Budget[Subcategory1 == t.Subcategory1 && Month_Master == m && Financial_Year == y];
                 		if(existing.ID == null)
                 		{
                 			insert into General_Po_Budget
                 			[
                 				Financial_Year=y
                 				Month_Master=m
                 				Subcategory1=t.Subcategory1
                 				Budget_Amount=t.Monthly_Budget
                 				Used_Amount=0
                 				Balance_Amount=t.Monthly_Budget
                 				Status="Open"
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 	}
                 }
				 bool finance.validateGeneralPOBudget(int poId)
                 {
                 	po = Purchase_Order[ID == poId];
                 	if(po.ID == null)
                 	{
                 		return true;
                 	}
                 	if(po.Po_Type != "General")
                 	{
                 		return true;
                 	}
                 	m = po.Month_Master;
                 	y = po.Year_form;
                 	for each  row in Po_Subform[Purchase_Order_ID == po.ID]
                 	{
                 		amt = ifnull(row.Grand_Toltal,0);
                 		budget = General_Po_Budget[Subcategory1 == row.Subcategory1 && Month_Master == m && Financial_Year == y && Status == "Open"];
                 		if(budget.ID == null)
                 		{
                 			return false;
                 		}
                 		available = budget.Budget_Amount - ifnull(budget.Used_Amount,0);
                 		if(amt > available)
                 		{
                 			return false;
                 		}
                 	}
                 	return true;
                 }
				 void grn_controllar.grn_line_item_status_update_in_po(int purchase_order_line_item_id)
                 {
                 	get_purchase_order_line_item = Po_Subform[ID == purchase_order_line_item_id];
                 	if(get_purchase_order_line_item.ID != null)
                 	{
                 		thisapp.grn_controllar.update_po_qty_in_verification(get_purchase_order_line_item.ID);
                 		sum_of_invoice_qty = Gate_Entry_Subform[Grn_Status_Item_Wise == get_purchase_order_line_item.ID && Gate_Entry_No1 != null].sum(Invoice_Qty);
                 		if(get_purchase_order_line_item.Po_Qty <= sum_of_invoice_qty)
                 		{
                 			get_purchase_order_line_item.Grn_Line_Status="Fully Received";
                 		}
                 		else
                 		{
                 			if(sum_of_invoice_qty > 0)
                 			{
                 				get_purchase_order_line_item.Grn_Line_Status="Partially Received";
                 			}
                 			else
                 			{
                 				get_purchase_order_line_item.Grn_Line_Status="Not Received";
                 			}
                 		}
                 	}
                 }
				 void grn_controllar.grn_status_update_in_po(int purchase_order_id)
                 {
                 	get_po = Purchase_Order[ID == purchase_order_id];
                 	if(get_po.ID != null)
                 	{
                 		get_po_line_item_count = Po_Subform[Purchase_Order_ID == get_po.ID].count();
                 		get_po_fully_received_count = Po_Subform[Purchase_Order_ID == get_po.ID && Grn_Line_Status == "Fully Received"].count();
                 		if(get_po_fully_received_count == get_po_line_item_count)
                 		{
                 			get_po.GRN_Status="Received";
                 		}
                 		else
                 		{
                 			get_po_partially_received_count = Po_Subform[Purchase_Order_ID == get_po.ID && Grn_Line_Status == "Partially Received"].count();
                 			if(get_po_partially_received_count > 0 || get_po_partially_received_count > 0)
                 			{
                 				get_po.GRN_Status="Partially Received";
                 			}
                 			else
                 			{
                 				get_po.GRN_Status="Not Received";
                 			}
                 		}
                 	}
                 }
				 void grn_controllar.update_po_qty_in_verification(int po_line_item_id)
                 {
                 	get_po_line_item = Po_Subform[ID == po_line_item_id];
                 	if(get_po_line_item.ID != null)
                 	{
                 		get_po_line_item.Sum_Of_Invoice_Qty=Gate_Entry_Subform[Grn_Status_Item_Wise == get_po_line_item.ID && Gate_Entry_No1 != null].sum(Invoice_Qty);
                 		get_po_line_item.Sum_Of_Accepted_Qty1=Gate_Entry_Subform[Grn_Status_Item_Wise == get_po_line_item.ID && Gate_Entry_No1 != null].sum(Approved_Qty);
                 	}
                 }
				 void groping_controllar.create_groping_button_action_in_order_raw_material(Order_Raw_material get_all_raw_material)
                 {
                 	get_order_raw_material_list = get_all_raw_material.Raw_Material_Name.getall();
                 	if(get_order_raw_material_list.tolist().distinct().size() > 1)
                 	{
                 		info "The system does not allow duplicate Raw Material.";
                 	}
                 	else if(get_order_raw_material_list.size() > 10)
                 	{
                 		info "Maximum 10 styles are allowed.";
                 	}
                 	else
                 	{
                 		openUrl("#Form:Grouping_Purchase_Request?Order_Raw_Material_ID=" + get_all_raw_material.ID.getall(),"popup window","height=100%,width=100%");
                 	}
                 }
				 void groping_controllar.create_grouping_direct(Order_Raw_material get_all_raw_material)
                 {
                 	// =================================================
                 	// VALIDATION
                 	// =================================================
                 	rec_count = get_all_raw_material.count();
                 	if(rec_count > 25)
                 	{
                 		info "Maximum 25 styles are allowed.";
                 		return;
                 	}
                 	// =================================================
                 	// GET DISTINCT RAW MATERIALS
                 	// =================================================
                 	rm_all = get_all_raw_material.Raw_Material_Name.getall();
                 	raw_material_list = rm_all.tolist().distinct();
                 	// =================================================
                 	// LOOP RAW MATERIAL
                 	// =================================================
                 	for each  rm_val in raw_material_list
                 	{
                 		// ---------- GET DISTINCT VENDORS ----------
                 		vendor_list = List();
                 		for each  rm in get_all_raw_material
                 		{
                 			if(rm.Raw_Material_Name == rm_val && rm.Vendor_Master != null)
                 			{
                 				if(!vendor_list.contains(rm.Vendor_Master))
                 				{
                 					vendor_list.add(rm.Vendor_Master);
                 				}
                 			}
                 		}
                 		// =================================================
                 		// LOOP VENDOR
                 		// =================================================
                 		for each  vendor_val in vendor_list
                 		{
                 			grouping_rows = Collection();
                 			sum_of_qty = 0;
                 			// ---------- FILTER ORDER RAW MATERIAL ----------
                 			for each  rm in get_all_raw_material
                 			{
                 				if(rm.Raw_Material_Name == rm_val && rm.Vendor_Master == vendor_val)
                 				{
                 					already_grouped = 0;
                 					grp_sum = Grouping_Subform[Order_Raw_material_ID == rm.ID && Grouping_Purchase_Request_ID != null].sum(Grouped_Qty);
                 					if(grp_sum != null)
                 					{
                 						already_grouped = grp_sum;
                 					}
                 					req_qty = ifnull(rm.Required_Qty,0);
                 					actual_qty = req_qty - already_grouped;
                 					if(actual_qty > 0)
                 					{
                 						row = Grouping_Purchase_Request.Grouping_Subform();
                 						row.Raw_Material1=rm.Raw_Material_Name;
                 						row.Create_Order=rm.Order_No;
                 						row.Subform_Catagery=rm.Category_Master;
                 						row.Gold_Seal=rm.Gold_Seal;
                 						row.Style_No=rm.Style_Name;
                 						row.Vendor1=rm.Vendor_Master;
                 						row.Create_Eo_No=rm.Order_No.Eo_No_and_Name;
                 						row.Required_Qty=actual_qty;
                 						row.Grouped_Qty=actual_qty;
                 						row.Internal_Price_bom=rm.Internal_Price;
                 						row.Order_Raw_material_ID=rm.ID;
                 						grouping_rows.insert(row);
                 						sum_of_qty = sum_of_qty + actual_qty;
                 					}
                 				}
                 			}
                 			row_size = grouping_rows.size();
                 			if(row_size == 0)
                 			{
                 				continue;
                 			}
                 			// =================================================
                 			// CREATE GROUPING MASTER
                 			// =================================================
                 			grouping_id = insert into Grouping_Purchase_Request
                 			[
                 				Order_Raw_Material_ID=get_all_raw_material.ID.getall()
                 				Grouping_Subform=grouping_rows
                 				Raw_Material1=rm_val
                 				Vendor1=vendor_val
                 				Master_Grouping_Status="Yet to Group"
                 				Total_Required_Qty_Raw_Material=sum_of_qty
                 				Total_Grouped_Qty=sum_of_qty
                 				No_of_Styles=row_size
                 				Added_User=zoho.loginuser
                 			];
                 			if(grouping_id == null)
                 			{
                 				continue;
                 			}
                 			// =================================================
                 			// UPDATE HEADER FIELDS
                 			// =================================================
                 			group = Grouping_Purchase_Request[ID == grouping_id];
                 			order_list = (get_all_raw_material.Order_No.getall()).tolist().distinct();
                 			group.Order_Number=order_list;
                 			group.Eo_No=group.Order_Number.Eo_No_and_Name;
                 			group.Gold_Seal=group.Order_Number.Article;
                 			group.Subcategory1=get_all_raw_material.Subcategory;
                 			group.Category_Type1=get_all_raw_material.Category_Type_Master;
                 			group.Category1=get_all_raw_material.Category_Master;
                 			group.Brand1=get_all_raw_material.Brand1;
                 			group.Stock_Uom=group.Raw_Material1.Stock_Uom1;
                 			// =================================================
                 			// POST SUBMIT ACTIONS (NO LOGS)
                 			// =================================================
                 			for each  rm in get_all_raw_material
                 			{
                 				if(rm.Raw_Material_Name == rm_val && rm.Vendor_Master == vendor_val)
                 				{
                 					thisapp.groping_controllar.update_group_status_in_order_raw_material(rm.ID);
                 					get_costing = Costing[Order_No == rm.Order_No];
                 					if(get_costing.ID != null)
                 					{
                 						thisapp.costing_controllar.referesh_costing(get_costing.ID,true);
                 					}
                 				}
                 			}
                 		}
                 	}
                 	// =================================================
                 	// REDIRECT (ABSOLUTE LAST LINE)
                 	// =================================================
                 	openUrl("#Page:Purchase_Orders1","same window");
                 	return;
                 }
				 void groping_controllar.po_status_update(int master_grouping_id)
                 {
                 	get_master_group = Master_Group[ID == master_grouping_id];
                 	if(get_master_group.ID != null)
                 	{
                 		get_prucahse_order = Po_Subform[Master_Group == get_master_group.ID];
                 		if(get_prucahse_order.ID != null)
                 		{
                 			get_master_group.Po_Status="Created";
                 		}
                 		else
                 		{
                 			get_master_group.Po_Status="Not Create";
                 		}
                 	}
                 }
				 void groping_controllar.update_grouping_details_from_maser_group(int master_groing_id)
                 {
                 	// ================= GET SETTING =================
                 	get_setting = Setting[ID != null];
                 	isAutoApprove = false;
                 	if(get_setting.ID != null && get_setting.Validate_Costing_In_Master_Po == "Auto Approve")
                 	{
                 		isAutoApprove = true;
                 	}
                 	// ================= GET MASTER GROUP =================
                 	get_master_gorup = Master_Group[ID == master_groing_id];
                 	if(get_master_gorup.ID == null)
                 	{
                 		return;
                 	}
                 	// ================= LOOP MASTER GROUP SUBFORM =================
                 	get_grouping_sunform = Master_Group_Subform[Master_Group_ID == get_master_gorup.ID];
                 	for each  each_master_gorup in get_grouping_sunform
                 	{
                 		get_purchase_gorup = Grouping_Purchase_Request[ID == each_master_gorup.Grouping_Purchase_Request];
                 		if(get_purchase_gorup.ID == null)
                 		{
                 			continue;
                 		}
                 		// ================= BASIC UPDATES =================
                 		get_purchase_gorup.Master_Grouping_Status="Grouped";
                 		get_purchase_gorup.Vendor_Price=each_master_gorup.Vendor_Price;
                 		get_purchase_gorup.Other_Charges_Per_item=each_master_gorup.Other_Charges_Per_item;
                 		get_purchase_gorup.Convert_Value=get_master_gorup.Convert_Value;
                 		get_purchase_gorup.Total_Extra=each_master_gorup.Total_Extra;
                 		// ================= MOQ CALC =================
                 		get_purcahse_gorup_item = Grouping_Subform[Grouping_Purchase_Request_ID == get_purchase_gorup.ID];
                 		if(get_purcahse_gorup_item.count() > 0)
                 		{
                 			get_purchase_gorup.Per_Order_Moq=ifnull(get_purchase_gorup.Total_Extra,0) / get_purcahse_gorup_item.count();
                 		}
                 		else
                 		{
                 			get_purchase_gorup.Per_Order_Moq=0;
                 		}
                 		// ================= CONVERSION CALC =================
                 		if(get_master_gorup.Convert_Value > 0)
                 		{
                 			get_purchase_gorup.Vender_Price_per_order_per_pcs_stock_uom=ifnull(get_purchase_gorup.Vendor_Price,0) / get_master_gorup.Convert_Value;
                 			get_purchase_gorup.Other_charges_per_order_per_pcs_stock_uom=ifnull(get_purchase_gorup.Other_Charges_Per_item,0) / get_master_gorup.Convert_Value;
                 		}
                 		else
                 		{
                 			get_purchase_gorup.Vender_Price_per_order_per_pcs_stock_uom=0;
                 			get_purchase_gorup.Other_charges_per_order_per_pcs_stock_uom=0;
                 		}
                 		get_purchase_gorup.Vender_Price_Other_Charges=ifnull(get_purchase_gorup.Vender_Price_per_order_per_pcs_stock_uom,0) + ifnull(get_purchase_gorup.Other_charges_per_order_per_pcs_stock_uom,0);
                 		// ================= COSTING ELIGIBILITY =================
                 		if(isAutoApprove)
                 		{
                 			get_purchase_gorup.Eligible_Po="Eligible";
                 		}
                 		// Validate mode → DO NOTHING
                 	}
                 	// ================= MASTER GROUP FLAG =================
                 	if(isAutoApprove)
                 	{
                 		get_master_gorup.Costing_Execute=true;
                 		// ✅ ONLY AUTO MODE SHOULD CHECK ELIGIBILITY
                 		thisapp.master_group_controllar_check_eligibility_new(get_master_gorup.ID);
                 	}
                 }
				 void groping_controllar.update_grouping_purchase_item(int purchase_group_id)
                 {
                 	get_purchase_gorup = Grouping_Purchase_Request[ID == purchase_group_id];
                 	get_purcahse_gorup_item = Grouping_Subform[Grouping_Purchase_Request_ID == get_purchase_gorup.ID];
                 	if(get_purcahse_gorup_item.ID != null)
                 	{
                 		for each  each_grouping_item in get_purcahse_gorup_item
                 		{
                 			each_grouping_item.Vender_price_per_order_per_ps_Stock_Uom1=get_purchase_gorup.Vender_Price_per_order_per_pcs_stock_uom;
                 			each_grouping_item.Other_Charges_per_order_per_pcs_stock_uom=get_purchase_gorup.Other_charges_per_order_per_pcs_stock_uom;
                 			each_grouping_item.Vender_Price_Other_Charges=get_purchase_gorup.Vender_Price_Other_Charges;
                 			get_actual_qty = ifnull(each_grouping_item.Moq_Alloation,0) + ifnull(each_grouping_item.Grouped_Qty,0);
                 			each_grouping_item.Total_Spend_With_Other_Charges=get_actual_qty * ifnull(each_grouping_item.Vender_Price_Other_Charges,0);
                 			each_grouping_item.Total_Spend_With_out_Other_Charges=get_actual_qty * ifnull(each_grouping_item.Vender_price_per_order_per_ps_Stock_Uom1,0);
                 			get_costing = Costing[Order_No == each_grouping_item.Create_Order];
                 			if(get_costing.ID != null)
                 			{
                 				get_value = thisapp.costing_controllar.referesh_costing(get_costing.ID,true);
                 				if(get_value < 0)
                 				{
                 					each_grouping_item.Eligible_For_Po="Not Eligible";
                 				}
                 				else
                 				{
                 					each_grouping_item.Eligible_For_Po="Eligible";
                 				}
                 			}
                 		}
                 		get_purcahse_gorup_item_not_eligble_po = Grouping_Subform[Grouping_Purchase_Request_ID == get_purchase_gorup.ID && Eligible_For_Po == "Not Eligible"];
                 		if(get_purcahse_gorup_item_not_eligble_po.ID != null)
                 		{
                 			get_purchase_gorup.Eligible_Po="Not Eligible";
                 		}
                 		else
                 		{
                 			get_purchase_gorup.Eligible_Po="Eligible";
                 		}
                 	}
                 }
				 void groping_controllar.update_group_status_in_order_raw_material(int order_raw_mtaerial_id)
                 {
                 	get_order_raw_mtaerial = Order_Raw_material[ID == order_raw_mtaerial_id];
                 	if(get_order_raw_mtaerial.ID != null)
                 	{
                 		sum_of_grouped_qty = Grouping_Subform[Order_Raw_material_ID == get_order_raw_mtaerial.ID && Grouping_Purchase_Request_ID != null].sum(Grouped_Qty);
                 		info sum_of_grouped_qty;
                 		get_order_raw_mtaerial.Grouped_Qty=sum_of_grouped_qty;
                 		get_order_raw_mtaerial.Balance_to_Groupe=ifnull(get_order_raw_mtaerial.Total_Required_Qty,0) - ifnull(get_order_raw_mtaerial.Grouped_Qty,0);
                 		if(get_order_raw_mtaerial.Grouped_Qty >= get_order_raw_mtaerial.Total_Required_Qty)
                 		{
                 			get_order_raw_mtaerial.Grouping_Status="Fully Grouped";
                 		}
                 		else
                 		{
                 			if(get_order_raw_mtaerial.Grouped_Qty > 0)
                 			{
                 				get_order_raw_mtaerial.Grouping_Status="Partial Grouped";
                 			}
                 			else
                 			{
                 				get_order_raw_mtaerial.Grouping_Status="Not Grouped";
                 			}
                 		}
                 	}
                 }
				 void joborder.createJobOrderBill(Job_Work_GRN idVal)
                 {
                 	// ---------- PRE-CHECK: Ensure all selected GRNs have the same Vendor ----------
                 	vendorSet = list();
                 	for each  recCheck in idVal
                 	{
                 		if(!vendorSet.contains(recCheck.Vendor.ID))
                 		{
                 			vendorSet.add(recCheck.Vendor.ID);
                 		}
                 	}
                 	// ---------- PRE-CHECK: Ensure all selected GRNs have the same Employee ----------
                 	empSet = list();
                 	for each  recEmp in idVal
                 	{
                 		if(!empSet.contains(recEmp.Employee_Name))
                 		{
                 			empSet.add(recEmp.Employee_Name);
                 		}
                 	}
                 	if(vendorSet.size() > 1 || empSet.size() > 1)
                 	{
                 		info "❌ Selected GRN(s) belong to different Vendors or Employees. Please select GRNs of the same Vendor and Employee.";
                 		return;
                 	}
                 	// ---------- CREATE BILL HEADER ----------
                 	createBill = insert into Job_Order_Bill
                 	[
                 		Added_User=zoho.loginuser
                 		Vendor1=idVal.Vendor
                 		Status="Draft"
                 		Employee_Name=idVal.Employee_Name
                 	];
                 	// ---------- LOOP THROUGH GRN RECORDS ----------
                 	for each  rec in idVal
                 	{
                 		// Calculate existing billed qty
                 		getBilledQty = job_order_bill_subform[Job_Work_GRN_ID == rec.ID && Job_Order_Bill.Status != "Cancelled"].sum(Total);
                 		updateBillQty = ifnull(rec.Balance_fresh_Yet_to_Bill,0);
                 		if(getBilledQty > 0)
                 		{
                 			updateBillQty = ifnull(rec.Balance_fresh_Yet_to_Bill,0) - getBilledQty;
                 		}
                 		// ---------- INSERT INTO BILL SUBFORM ----------
                 		if(updateBillQty > 0)
                 		{
                 			createBillSub = insert into job_order_bill_subform
                 			[
                 				Added_User=zoho.loginuser
                 				Job_Work_GRN_ID=rec.ID
                 				Price=rec.Price
                 				Process_Master=rec.Process_Master
                 				Operation=rec.Operation
                 				Order_No=rec.Order_No
                 				Style_name=rec.Create_Order
                 				Bundle_No=rec.Bundle_nolookup
                 				Bill_Ref_ID=rec.Job_Order_Bill
                 				Total=updateBillQty
                 				Job_Order_Bill=createBill
                 			];
                 			// ---------- UPDATE GRN ----------
                 			getGRN = Job_Work_GRN[ID == rec.ID];
                 			getGRN.Fresh_Billed=ifnull(getBilledQty,0) + updateBillQty;
                 			getGRN.Balance_fresh_Yet_to_Bill=ifnull(getGRN.Fresh_Grn,0) - ifnull(getGRN.Fresh_Billed,0);
                 			if(ifnull(getGRN.Fresh_Billed,0) == 0)
                 			{
                 				getGRN.Bill_Status="Draft";
                 			}
                 			else if(ifnull(getGRN.Fresh_Billed,0) < ifnull(getGRN.Fresh_Grn,0))
                 			{
                 				getGRN.Bill_Status="Partially Billed";
                 			}
                 			else if(ifnull(getGRN.Fresh_Billed,0) == ifnull(getGRN.Fresh_Grn,0))
                 			{
                 				getGRN.Bill_Status="Fully Billed";
                 			}
                 			getGRN.Job_Order_Bill=createBill;
                 		}
                 		// ---------- AUTO REFRESH BALANCE (RECALCULATE) ----------
                 		billSubRecs = job_order_bill_subform[Job_Work_GRN_ID == rec.ID && Job_Order_Bill.Status != "Cancelled"];
                 		totalQty = ifnull(rec.Fresh_Grn,0);
                 		billedQty = 0;
                 		if(billSubRecs.count() > 0)
                 		{
                 			for each  b in billSubRecs
                 			{
                 				billedQty = billedQty + ifnull(b.Total,0).toLong();
                 			}
                 		}
                 		if(billedQty > totalQty)
                 		{
                 			billedQty = totalQty;
                 		}
                 		rec.Fresh_Billed=billedQty;
                 		rec.Balance_fresh_Yet_to_Bill=totalQty - billedQty;
                 		rec.Bill_Status=if(rec.Balance_fresh_Yet_to_Bill <= 0,"Fully Billed","Draft");
                 		info "? GRN " + rec.ID + " → Recalculated (Billed: " + billedQty + ", Balance: " + rec.Balance_fresh_Yet_to_Bill + ")";
                 	}
                 	//info "✅ Job Order Bill created successfully → Bill ID: " + createBill.ID;
                 }
				 void jobWork.recalculateGRNBalance(Job_Work_GRN rec)
                 {
                 	if(rec == null)
                 	{
                 		info "⚠️ No GRN record found.";
                 		return;
                 	}
                 	// Fetch valid subform rows (ignore cancelled/deleted bills)
                 	billSubRecs = job_order_bill_subform[Job_Work_GRN_ID == rec.ID && Job_Order_Bill.Status != "Cancelled"];
                 	totalQty = ifnull(rec.Fresh_Grn,0);
                 	billedQty = 0;
                 	if(billSubRecs.count() > 0)
                 	{
                 		for each  b in billSubRecs
                 		{
                 			billedQty = billedQty + ifnull(b.Total,0).toLong();
                 		}
                 	}
                 	// Prevent over-billing
                 	if(billedQty > totalQty)
                 	{
                 		billedQty = totalQty;
                 	}
                 	// Update GRN fields (integer-safe)
                 	rec.Fresh_Billed=billedQty;
                 	rec.Balance_fresh_Yet_to_Bill=totalQty - billedQty;
                 	rec.Bill_Status=if(rec.Balance_fresh_Yet_to_Bill <= 0,"Fully Billed","Draft");
                 	info "✅ GRN " + rec.ID + " recalculated → Billed: " + billedQty + " | Balance: " + rec.Balance_fresh_Yet_to_Bill;
                 }
				 void master_group_controllar.create_master_group_from_purchase_group(Grouping_Purchase_Request get_all_purchase_request_id)
                 {
