			}
			Purchase_Bill_C_Onload as "Purchase Bill (C)-Onload"
			{
				type =  form
				form = Purchase_Bill

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ============================
										// AUTO SOURCE SETTING
										// ============================
										if(input.Source == "Gate Entry")
										{
											input.Source = "Gate Entry";
										}
										else if(input.Source == null || input.Source == "")
										{
											input.Source = "Direct";
										}
										// ============================
										// PURCHASE ORDER & TYPE
										// ============================
										if(input.Gate_Entry != null)
										{
											input.Purchase_Order = (input.Gate_Entry.Po_Number.getall()).tolist().distinct();
										}
										else
										{
											input.Purchase_Order = List();
										}
										get_po_tye = "General Purchase";
										po_type_list = (input.Purchase_Order.Po_Type.getall()).tolist().distinct();
										if(po_type_list != null && po_type_list.size() == 1 && po_type_list.get(0) == "Against Order")
										{
											get_po_tye = "Cost Of Goods Sold";
										}
										// ============================
										// BASIC HEADER VALUES
										// ============================
										if(input.Gate_Entry != null)
										{
											input.Vendor1 = input.Gate_Entry.Vendor1;
											inv_no_list = input.Gate_Entry.Invoice_No.getall();
											if(inv_no_list != null && inv_no_list.size() > 0)
											{
												input.Invoice_No = inv_no_list.get(0);
											}
											else
											{
												input.Invoice_No = null;
											}
											inv_date_list = input.Gate_Entry.Invoice_Date.getall();
											if(inv_date_list != null && inv_date_list.size() > 0)
											{
												input.Invoice_Date = inv_date_list.get(0);
											}
											else
											{
												input.Invoice_Date = null;
											}
										}
										// ============================
										// FETCH RAW MATERIALS
										// ============================
										distinct_raw_material_name = List();
										if(input.Gate_Entry != null)
										{
											get_raw_material_name = Gate_Entry_Subform[Gate_Entry_No1 == input.Gate_Entry].Raw_Material1.getAll();
											distinct_raw_material_name = get_raw_material_name.tolist().distinct();
										}
										// ============================
										// CLEAR OLD BILL LINES (CREATE ONLY)
										// ============================
										if(input.ID == null)
										{
											clear Bills;
										}
										// ============================
										// BILL LINE CREATION
										// ============================
										for each  each_raw_material in distinct_raw_material_name
										{
											get_raw_material = Raw_Material1[ID == each_raw_material];
											if(get_raw_material.ID == null)
											{
												continue;
											}
											get_grn_raw_material = Gate_Entry_Subform[Raw_Material1 == get_raw_material.ID && Gate_Entry_No1 == input.Gate_Entry];
											row2 = Purchase_Bill.Bills();
											row2.Item=get_raw_material.Raw_Material_Name;
											row2.RM_No=get_raw_material.RM_No;
											row2.Qty=ifnull(get_grn_raw_material.sum(Invoice_Qty),0);
											row2.Price=ifnull(get_grn_raw_material.Invoice_Price1,0);
											row2.Uom=get_raw_material.Stock_Uom1;
											row2.Subcategory1=get_raw_material.Subcategory;
											row2.Category_Type1=get_raw_material.Category_Type;
											row2.Category1=get_raw_material.Category;
											row2.Gst=get_grn_raw_material.Grn_Status_Item_Wise.Gst11;
											row2.Hsn_Code=get_raw_material.Subcategory.Hsn_Code;
											row2.Cost_of_Account=get_po_tye;
											row2.Before_Tax=row2.Qty * row2.Price;
											row2.Tax=(row2.Before_Tax * ifnull(row2.Gst.Gst,0)) / 100;
											row2.With_Tax=row2.Before_Tax + row2.Tax;
											rows = Collection();
											rows.insert(row2);
											input.Bills.insert(rows);
										}
										// ============================
										// ? RE-CALCULATE TOTALS ON LOAD
										// ============================
										before_tax_total = 0;
										tax_total = 0;
										with_tax_total = 0;
										for each  r in input.Bills
										{
											before_tax_total = before_tax_total + ifnull(r.Before_Tax,0);
											tax_total = tax_total + ifnull(r.Tax,0);
											with_tax_total = with_tax_total + ifnull(r.With_Tax,0);
										}
										input.Before_Tax = before_tax_total;
										input.TAX = tax_total;
										input.Total = with_tax_total;
										input.Grand_Total1 = with_tax_total + ifnull(input.Other_charges,0);
										// ============================
										// NET PAYABLE CALCULATION
										// ============================
										total_debit = ifnull(input.Auto_Debit_Note,0) + ifnull(input.Manual_Debit_Note,0);
										input.Total_Debit_Note = total_debit;
										input.Net_Payable = ifnull(input.Grand_Total1,0) - total_debit;
										// ============================
										// NET PAYABLE AFTER TDS
										// ============================
										input.Net_Payable_After_TDS1 = ifnull(input.Net_Payable,0) - ifnull(input.Tds,0);
						)
					}
					actions 
					{
						custom deluge script
						(
											hide CGST;
										hide SGST;
										hide IGST;
										hide TAX;
										hide Before_Tax;
										disable Bills.CGST;
										disable Bills.SGST;
										disable Bills.IGST;
										hide Bills.CGST;
										hide Bills.SGST;
										hide Bills.IGST;
										hide Bills.RM_No;
										hide Bills.Before_Tax;
										hide Bills.Tax;
						)
					}
				}

			}
