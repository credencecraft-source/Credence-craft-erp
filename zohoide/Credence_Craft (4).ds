			Approve_Internal_Consumpt5 as "Approve Internal Consumption (C/E)-Validation"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  each_consumption in input.Approve_Consumption_and_price
										{
											if(each_consumption.Buyer_Best_Consumption == "Better Consumption Available")
											{
												if(each_consumption.Remark == "")
												{
													alert "Please enter remark for Remark for buyer consumption is Lesser rows ..!";
													cancel submit;
												}
											}
											if(each_consumption.Internal_Best_Consumption == "Better Consumption Available")
											{
												if(each_consumption.Remarks_internal_consumption_is_higher == "")
												{
													alert "Please enter remark for Remarks internal consumption is higher rows ..!";
													cancel submit;
												}
											}
											get_order_raw_material = Order_Raw_material[Order_No == each_consumption.Order_No && Raw_Material_Name == input.Raw_Material];
											get_grouping_raw_material = Grouping_Subform[Order_Raw_material_ID == get_order_raw_material.ID && Grouping_Purchase_Request_ID != null];
											if(get_grouping_raw_material.ID != null)
											{
												if(get_order_raw_material.Internal_Consumption > each_consumption.Internal_Consumption)
												{
													alert "The grouping has been partially or fully completed; therefore, the system does not allow reduce Internal Consumption.";
													cancel submit;
													break;
												}
											}
										}
						)
					}
				}

			}
