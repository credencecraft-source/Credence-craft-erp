			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Order_Qty
			(
				type = number
				displayname = "Work_Order_Qty "
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Brand1
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand1.ID
    			displayformat = [Brand]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Buyer1
			(
				type = picklist	
				displayname = "Buyer"
				values  = Buyer1.ID
    			displayformat = [Buyer_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Date
			(
    			type = date
				displayname = "Delivery Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Outsource
			(
    			type = checkbox
				displayname = "Outsource "
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Entity_Name
			(
				type = picklist	
				displayname = "Entity Name"
				values  = Entity_Name.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Price
			(
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total
			(
				displayname = "Total Before Gst"
				type = INR
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			Gst
			(
				type = picklist	
				values  = Gst.ID
    			displayformat = [Gst]
				sortorder = ascending
	 			row = 1
	 			column = 3   
				width = medium
			)
			Gst_Amount
			(
				displayname = "Gst Amount"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			Total_With_Gst1
			(
				displayname = "Total With Gst"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 3   
				width = medium
			)
			Work_Order_Size_Wise_Qty
			(
				type = grid
				values  = Wo_Order_Size_Wise_Qty.ID
