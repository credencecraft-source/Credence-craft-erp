			Total_Debit_note as "Total Debit note"
			{
				type =  form
				form = Purchase_Bill

				record event = on add or edit

				on user input of Total_Debit_Note
				{
					actions 
					{
						custom deluge script
						(
											// ============================
										// NET PAYABLE CALCULATION
										// ============================
										total_debit = ifnull(input.Total_Debit_Note,0);
										// (optional sync back to fields)
										input.Auto_Debit_Note = ifnull(input.Auto_Debit_Note,0);
										input.Manual_Debit_Note = ifnull(input.Manual_Debit_Note,0);
										// Net Payable
										input.Net_Payable = ifnull(input.Grand_Total1,0) - total_debit;
						)
					}
				}

			}
