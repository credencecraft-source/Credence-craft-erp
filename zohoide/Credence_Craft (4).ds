				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			OrderNo
			(
				type = picklist	
				values  = Create_Order.ID
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Order_New
			(
				type = picklist	
				values  = Work_Order_New.ID
    			displayformat = [Work_Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Style_Name
			(
				type = picklist	
				displayname = "Style Name"
				values  = Create_Order.ID
    			displayformat = [Style_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor1
			(
				type = picklist	
				displayname = "Vendor"
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process_Master
			(
				type = picklist	
				displayname = "Process Master"
				values  = Process_Master.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Operation
			(
				type = picklist	
				values  = Operation.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Accept_Now
			(
				type = number
				displayname = "Accept Now"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Accepted_by
			(
    			type = text
				displayname = "Accepted by"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Backed
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Balance_to_accept1
			(
				type = number
				displayname = "Balance to accept "
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Accepted
			(
				type = number
				displayname = "Total Accepted"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Bundled1
			(
				type = number
				displayname = "Total Bundled"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
