			must have Wo_Status
			(
				type = picklist
				displayname = "Wo Status"
				maxchar = 100
				values = {"Draft","Approved"}
				initial value = "Draft"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Merchant
