			Refresh9 as "Refresh"
			{
				type =  functions
				form = Bank_Account_Number
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// ================================
										// BANK ACCOUNT – REFRESH COUNTS
										// ================================
										// reset counts
										paidCount = 0;
										unpaidCount = 0;
										// fetch payouts linked to this bank account
										payouts = Payout[ID != null];
										for each  p in payouts
										{
											for each  line in p.Payout_Lines
											{
												if(line.Account_No == input.Account_No && line.IFSC == input.Ifsc)
												{
													if(p.Status == "Paid")
													{
														paidCount = paidCount + 1;
													}
													else
													{
														unpaidCount = unpaidCount + 1;
													}
												}
											}
										}
										// update bank master
										input.No_of_paid = paidCount;
										input.No_of_Payments_Unpaid = unpaidCount;
					)
					}
				}
			}
