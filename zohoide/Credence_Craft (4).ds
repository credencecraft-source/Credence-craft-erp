			work_order_qty as "work order qty"
			{
				type =  form
				form = Work_Order_New

				record event = on add or edit

				on user input of Work_Order_Size_Wise_Qty.Work_Order_Qty
				{
					actions 
					{
						custom deluge script
						(
											// ---- Recalculate total work order qty ----
										total_work_order_qty = input.Work_Order_Size_Wise_Qty.sum(Work_Order_Qty);
										// ---- Loop raw material rows ----
										for each  rm_row in input.Work_Order_Raw_materil
										{
											final_qty_for_calculation = 0;
											if(rm_row.Is_Size_Mapped == true)
											{
												size_qty = 0;
												for each  size_row in input.Work_Order_Size_Wise_Qty
												{
													if(rm_row.Size.contains(size_row.Size))
													{
														size_qty = size_qty + ifnull(size_row.Work_Order_Qty,0);
													}
												}
												final_qty_for_calculation = size_qty;
											}
											else
											{
												final_qty_for_calculation = total_work_order_qty;
											}
											rm_row.Work_Order_Qty_Rawmateril_Level=final_qty_for_calculation;
											rm_row.Wo_Required=final_qty_for_calculation * ifnull(rm_row.Work_order_Consemption,0);
										}
						)
					}
				}

			}
			On_load11 as "On load"
			{
				type =  form
				form = Centralized_Pick_list

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ---- Reset header stock ----
										input.Stock_Available_in_Allocated = 0;
										totalStockAvailable = 0;
										// ---- Loop Pick List Subform ----
										for each  row in input.SubForm
										{
											// ---- MULTI-ROW inventory collection ----
											styleInvList = Style_Wise_Inventory[Order_No1 == row.Order_No1 && Raw_Material1 == row.Raw_Material1];
											// ---- SUM allocated from ALL rows ----
											allocatedQty = ifnull(styleInvList.sum(Allocate),0);
											alreadyPickedQty = ifnull(row.Already_Picked,0);
											// ---- FORCE field recalculation ----
											row.Allocated=allocatedQty;
											stockAvailable = allocatedQty - alreadyPickedQty;
											if(stockAvailable < 0)
											{
												stockAvailable = 0;
											}
											row.Stock_Available_in_Allocated=stockAvailable;
											// ---- Header accumulation ----
											totalStockAvailable = totalStockAvailable + stockAvailable;
										}
										// ---- Header total ----
										input.Stock_Available_in_Allocated = ifnull(totalStockAvailable,0);
						)
					}
				}

			}
