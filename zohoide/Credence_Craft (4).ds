			Verification_Allocated_in1 as "Verification Allocated in GRN Allocation"
			{
				type =  form
				form = GRN_Allocation

				record event = on add

				on user input of Verification_Allocated
				{
					actions 
					{
						custom deluge script
						(
											if(input.Verification_Allocated < 0)
										{
											alert "Please enter the valid required qty.";
											input.Verification_Allocated = 0;
										}
										else if(input.GRN_Verification_Subform_ID.Verification_Allocated < input.Verification_Allocated)
										{
											alert "Only " + input.GRN_Verification_Subform_ID.Verification_Allocated.toString() + "qty are available for allocation. You cannot request more.";
											input.Verification_Allocated = 0;
										}
										get_available_qty = ifnull(input.Verification_Allocated,0);
										sum_allocate_qty = 0;
										for each  each_allocation in input.Material_Allocation
										{
											if(each_allocation.Balance_To_Allocate < get_available_qty)
											{
												each_allocation.Allocate=each_allocation.Balance_To_Allocate;
												get_available_qty = get_available_qty - ifnull(each_allocation.Balance_To_Allocate,0);
											}
											else
											{
												each_allocation.Allocate=get_available_qty;
												get_available_qty = 0;
											}
											sum_allocate_qty = sum_allocate_qty + ifnull(each_allocation.Allocate,0);
										}
										input.Allocated_Qty = sum_allocate_qty;
						)
					}
				}

			}
