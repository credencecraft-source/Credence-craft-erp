			On_validate3 as "On validate"
			{
				type =  form
				form = Bank_Account_Number

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Bank_Account_Number - On Validate
										if(input.ID != null)
										{
											// Only on Edit
											refList = List();
											oldRec = Bank_Account_Number[ID == input.ID];
											if(oldRec != null && oldRec.Account_No != input.Account_No || oldRec.Ifsc != input.Ifsc)
											{
												for each  p in Payout
												{
													if(p.Source != "Purchase bill" || p.Status == "Paid")
													{
														continue;
													}
													for each  line in p.Payout_Lines
													{
														if(line.Reference_ID != null)
														{
															pb = Purchase_Bill[ID == line.Reference_ID.toLong()];
															if(pb.ID != null && pb.Vendor1 == input.Vendor1)
															{
																refList.add("Payout ID : " + p.ID);
																break;
															}
														}
													}
												}
												if(refList.size() > 0)
												{
													msg = "Cannot edit Account No / IFSC.\nPending payout requests:\n";
													for each  r in refList.distinct()
													{
														msg = msg + r + "\n";
													}
													alert msg;
													cancel submit;
												}
											}
										}
						)
					}
				}

			}
