				type = picklist	
				values  = Vendor1.ID
    			displayformat = [Vendor_Name]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = 100px
			)
			Employee_Name
			(
				type = picklist	
				displayname = "Employee Name"
				values  = Employee_Name.ID
    			displayformat = [Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = 200px
			)
			Job_Order_New
