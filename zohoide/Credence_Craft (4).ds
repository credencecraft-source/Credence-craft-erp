			Master_Group_C_Onload as "Master Group (C)-Onload"
			{
				type =  form
				form = Master_Group

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											sum_of_groupeed_qty = 0;
										order_raw_material_id_list = List();
										first_grouping = null;
										first_price = null;
										first_raw_material = null;
										is_price_same = true;
										is_raw_material_same = true;
										group_count = 0;
										// ===== LOOP GROUPING PURCHASE REQUESTS =====
										for each  each_grouping in input.Grouping_Purchase_Request_No
										{
											group_count = group_count + 1;
											if(first_grouping == null)
											{
												first_grouping = each_grouping;
												first_raw_material = each_grouping.Raw_Material1;
											}
											// ===== CHECK ALL INTERNAL PRICES =====
											for each  row in each_grouping.Grouping_Subform
											{
												if(first_price == null)
												{
													first_price = row.Internal_Price_bom;
												}
												else
												{
													if(row.Internal_Price_bom != first_price)
													{
														is_price_same = false;
													}
												}
											}
											// ===== RAW MATERIAL CHECK =====
											if(each_grouping.Raw_Material1 != first_raw_material)
											{
												is_raw_material_same = false;
											}
											order_raw_material_id_list.addAll(each_grouping.Order_Raw_Material_ID);
											row2 = Master_Group.Master_Group_Subform();
											row2.Grouping_Purchase_Request=each_grouping.ID;
											row2.Grouped_Qty=each_grouping.Total_Grouped_Qty;
											row2.Order_Raw_Material_ID=each_grouping.Order_Raw_Material_ID;
											rows1 = Collection();
											rows1.insert(row2);
											input.Master_Group_Subform.insert(rows1);
											sum_of_groupeed_qty = sum_of_groupeed_qty + ifnull(each_grouping.Total_Grouped_Qty,0);
										}
										// ===== HEADER VALUES =====
										if(first_grouping != null)
										{
											input.Grouped_Qty = sum_of_groupeed_qty;
											input.No_of_Group = group_count;
											input.Order_Raw_material_ID = order_raw_material_id_list.distinct();
											input.Raw_Material = first_raw_material;
											input.Category1 = first_grouping.Category1;
											input.Category_Type1 = first_grouping.Category_Type1;
											input.Subcategory1 = first_grouping.Subcategory1;
											input.Create_Eo_No = first_grouping.Eo_No;
											input.Gold_Seal = first_grouping.Gold_Seal;
											input.Vendor = first_grouping.Vendor1;
											// ===== CURRENCY FLOW =====
											if(input.Vendor != null)
											{
												input.Currency = input.Vendor.Currency_Type;
												if(input.Import_From_Other_Country == true && input.Currency != null)
												{
													input.Exchange_Price = ifnull(input.Currency.Exchange_Price,1);
												}
												else
												{
													input.Exchange_Price = 1;
												}
											}
											input.Hsn_Code = input.Subcategory1.Hsn_Code;
											input.Gst = input.Subcategory1.Gst;
											// ===== SET VENDOR & IMPORT PRICE IF ALL SAME =====
											if(is_price_same == true && first_price != null)
											{
												input.Vendor_Price_INR = first_price;
												input.Vendor_Price = first_price;
												for each  each_item in input.Master_Group_Subform
												{
													each_item.Vendor_Price=first_price;
												}
											}
											// ===== UOM CONVERT =====
											if(is_raw_material_same == true && input.Raw_Material != null)
											{
												stock_uom_name = input.Raw_Material.Stock_Uom1.Stock_Uom;
												if(stock_uom_name != null)
												{
													get_uom = Uom_Convert[Buying_Uom == stock_uom_name];
													if(get_uom.ID != null)
													{
														input.Uom_Convert = get_uom.ID;
													}
												}
											}
											input.Other_Charges_INR = 0;
											if(group_count > 0)
											{
												for each  each_item in input.Master_Group_Subform
												{
													each_item.Other_Charges_Per_item=ifnull(input.Other_Charges_INR,0) / group_count;
												}
											}
										}
						)
					}
				}

			}
