			Min as "Min"
			{
				type =  form
				form = Chart_SubForm

				record event = on add or edit

				on user input of Min
				{
					actions 
					{
						custom deluge script
						(
											// Subform: On User Input of Min (copy to Max too)
										thisMin = input.Min;
										thisMax = input.Max;
										if(thisMin != null && thisMax != null)
										{
											// 1) basic check
											if(thisMin > thisMax)
											{
												alert "Min must be less than or equal to Max.";
												input.Min = null;
												return;
											}
											// 2) get parent record and iterate its subform rows
											parentRec = Measurement_Chart[ID == input.ID];
											if(parentRec.ID != null)
											{
												for each  r in parentRec.Measurement_Chart_subform
												{
													if(r.ID != input.ID && r.Min != null && r.Max != null && r.Measurement_Area == input.Measurement_Area)
													{
														if((thisMin >= r.Min && thisMin <= r.Max) || (thisMax >= r.Min && thisMax <= r.Max) || (thisMin <= r.Min && thisMax >= r.Max))
														{
															alert "Overlap detected with existing range (" + r.Min + " - " + r.Max + ").";
															input.Min = null;
															input.Max = null;
															break;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			Max as "Max"
			{
				type =  form
				form = Chart_SubForm

				record event = on add or edit

				on user input of Max
				{
					actions 
					{
						custom deluge script
						(
											if(input.Min != null && input.Max != null)
										{
											// Min <= Max check
											if(input.Min > input.Max)
											{
												alert "Min must be less than or equal to Max.";
												input.Min = null;
												input.Max = null;
												return;
											}
											// Fetch parent form record
											parentRec = Measurement_Chart[ID == input.ID];
											// parent form
											if(parentRec.ID != null)
											{
												for each  r in parentRec.Measurement_Chart_subform
												{
													if(r.ID != input.ID && r.Min != null && r.Max != null && r.Measurement_Area == input.Measurement_Area)
													{
														if((input.Min >= r.Min && input.Min <= r.Max) || (input.Max >= r.Min && input.Max <= r.Max) || (input.Min <= r.Min && input.Max >= r.Max))
														{
															alert "Overlap detected for '" + input.Measurement_Area + "'. Conflicts with (" + r.Min + " - " + r.Max + ").";
															input.Min = null;
															input.Max = null;
															break;
														}
													}
												}
											}
										}
						)
					}
				}

			}
			validate as "validate"
			{
				type =  form
				form = Measurement_Chart

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											areaRanges = Map();
										for each  row in input.Measurement_Chart_subform
										{
											if(row.Min != null && row.Max != null)
											{
												// 1️⃣ Min vs Max check
												if(row.Min > row.Max)
												{
													alert "❌ Error in Measurement Area '" + row.Measurement_Area.toString() + "':\n" + "Min value (" + row.Min + ") cannot be greater than Max value (" + row.Max + ").";
													cancel submit;
												}
												// 2️⃣ Overlap check
												if(areaRanges.get(row.Measurement_Area) == null)
												{
													areaRanges.put(row.Measurement_Area,List());
												}
												existing = areaRanges.get(row.Measurement_Area);
												for each  ex in existing
												{
													if((row.Min >= ex.get("Min") && row.Min <= ex.get("Max")) || (row.Max >= ex.get("Min") && row.Max <= ex.get("Max")) || (row.Min <= ex.get("Min") && row.Max >= ex.get("Max")))
													{
														alert "⚠️ Overlap detected in Measurement Area '" + row.Measurement_Area.toString() + "':\n" + "New range (" + row.Min + " - " + row.Max + ") overlaps with existing range (" + ex.get("Min") + " - " + ex.get("Max") + ").\n\n" + "? Please adjust the values so that ranges do not overlap.";
														cancel submit;
													}
												}
												// 3️⃣ Save range in map
												newRange = Map();
												newRange.put("Min",row.Min);
												newRange.put("Max",row.Max);
												existing.add(newRange);
												areaRanges.put(row.Measurement_Area,existing);
											}
										}
						)
					}
				}

			}
