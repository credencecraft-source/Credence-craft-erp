			Raw_Material_Deleted_Vali as "Raw Material (Deleted)-Validation"
			{
				type =  form
				form = Raw_Material1

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_order_raw_material = Order_Raw_material[Raw_Material_Name == input.ID];
										get_po_subform = Po_Subform[Raw_Material1 == input.ID];
										if(get_order_raw_material.count() > 0)
										{
											alert "Found a Order Raw Material associated with this Raw Material so, please delete the Order Raw Material first.";
											cancel delete;
										}
										else if(get_po_subform.count() > 0)
										{
											po_numbers = List();
											for each  rec in get_po_subform
											{
												if(rec.Purchase_Order_ID != null)
												{
													po_numbers.add(rec.Purchase_Order_ID.PO_Number);
												}
											}
											alert "Purchase Order already created for this Raw Material. PO Number(s) : " + po_numbers.distinct().toString(", ");
											cancel delete;
										}
										else
										{
											delete from Vendor_Wise_Price_List[Raw_Material_Name == input.ID];
											delete from Vendor_Wise_Price_List[Raw_Material_Name == null];
										}
						)
					}
				}

			}
