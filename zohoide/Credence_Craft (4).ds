										{
											alert "Please enter the valid MOQ (Stock Uom)..!";
											input.Moq_stock_Uom = null;
										}
										if(input.Convert_Value > 0)
										{
											input.MOQ_Buying = ifnull(input.Moq_stock_Uom,0) / ifnull(input.Convert_Value,0);
										}
										else
										{
											input.MOQ_Buying = 0;
										}
										input.Extra_In_Buying_Uom = ifnull(input.MOQ_Buying,0) + ifnull(input.Difference_Round_Off_Buying_Qty,0);
										input.Buying_Qty_Total = ifnull(input.Buying_Qty1,0) + ifnull(input.Extra_In_Buying_Uom,0);
