		list Sample_Status
		{
			displayName = "Sample Status"
			show all rows from Sample_Allocation_Request    
			(
				Vendor1 as "Vendor"
				Garment_Type as "Garment Type"
				Requested_Date as "Requested Date"
				Requested_Quantity as "Requested Quantity"
				Notes_Comments as "Notes/Comments"
				Email
				Indent_Status as "Indent Status"
				Allocated_Count as "Allocated Count"
				Balance_Available
				Assigned_Date as "Assigned Date"
				Assigned_Quantity as "Assigned Quantity"
				Sample_Request_id
				Last_Date_to_Submit_Indent as "Last Date to Submit Indent"
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Indent_Status == "Pending")
				fields = [Indent_Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting"
				{
				condition = (Indent_Status == "Allocated")
				fields = [Indent_Status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (Indent_Status == "Rejected")
				fields = [Indent_Status]
				format = "text-decoration:line-through;color:#ffffff;background-color:#bd588b;"
				}
			)
		}
