			Create_Order_C_E_Success as "Create Order (C/E)-Success"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// --- Sync subform rows with header values & calculate row Value ---
										for each  row in input.Finished_Goods_Size_wise
										{
											row.Brand1=input.Brand;
											row.Buyer1=input.Buyer1;
											row.Season=input.Season;
											row.Gold_Seal=input.Article;
											row.Colors=input.Colors;
											row.Price_In_INR=input.Fob;
											row.Bulk_Order=input.Eo_No_and_Name;
											row.Style_Name=input.Style_Name;
											row.Colors=input.Colors;
											if(row.Total_Qty != null && row.Price_In_INR != null)
											{
												row.Value=row.Price_In_INR * row.Total_Qty;
											}
											else
											{
												row.Value=0;
											}
										}
										// --- Keep your existing backend logic ---
										get_raw_matweril = Order_Raw_material[Order_No == input.ID];
										for each  each_order_raw in get_raw_matweril
										{
											thisapp.order_controllar.order_raw_material_field_calculate(each_order_raw.ID);
										}
										// --- Setting based control ---
										settingRec = Setting[ID != 0];
										// Costing
										if(settingRec.Create_Order_Costng != "No")
										{
											thisapp.costing_controllar.create_costing(input.ID);
										}
										// Check List
										if(settingRec.Create_Order_Check_list != "No")
										{
											thisapp.order_controllar.create_check_list(input.ID);
										}
										// --- Remaining logic ---
										thisapp.order_controllar.update_eo_no_level(input.Eo_No_and_Name,input.Article);
										info "Order post-processing completed for Order: " + input.ID;
						)
					}
				}

			}
