			(
				type = picklist	
				values  = Rack.ID
    			displayformat = [Rack]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rack_Bin
			(
				type = picklist	
				displayname = "Rack Bin"
				values  = Rack_Bin.ID
    			displayformat = [Rack_Bin]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Packing_List_Header
			(
				type = picklist	
				displayname = "Packing List Header"
				values  = Packing_List_Header.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			PK_GRN
			(
				type = picklist	
				displayname = "PK GRN"
				values  = PK_GRN.ID
    			bidirectional = SubForm
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			OUTER_CARTON
			(
				type = picklist	
				values  = OUTER_CARTON.ID
    			displayformat = [Outer_Carton_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
