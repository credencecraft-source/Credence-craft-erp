			CUSTOMER_NAME_USER_INPUT as "CUSTOMER NAME USER INPUT"
			{
				type =  form
				form = Invoice

				record event = on add or edit
					status = inactive

				on user input of Customer_Name
				{
					actions 
					{
						custom deluge script
						(
											// Invoice -> On User Input of Vendor1
										if(input.Customer_Name != null)
										{
											vendor_gst_type = "";
											vendor_rec = Vendor1[ID == input.Customer_Name];
											if(vendor_rec.count() > 0)
											{
												// just store it in a variable (do NOT assign back to Vendor1)
												vendor_gst_type = vendor_rec.New_GST_Type.gst_type;
											}
											// loop through each row of subform
											for each  row in input.Sales_Invoice_Subform
											{
												tax_val = ifnull(row.Tax,0);
												if(vendor_gst_type == "CGST & SGST")
												{
													row.CGST=tax_val / 2;
													row.SGST=tax_val / 2;
													row.IGST=0;
												}
												else if(vendor_gst_type == "IGST")
												{
													row.CGST=0;
													row.SGST=0;
													row.IGST=tax_val;
												}
												else
												{
													row.CGST=0;
													row.SGST=0;
													row.IGST=0;
												}
											}
										}
						)
					}
				}

			}
