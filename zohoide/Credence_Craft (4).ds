					{
					on click
					(
						if(input.Grn_Status != "Submitted")
										{
											openUrl("#Form:Validate_Job_Work_GRN?" + "Create_Order=" + encodeUrl(input.Order_No.toText()) + "&Process_Name=" + encodeUrl(input.Process_Name.toText()) + "&Operation=" + encodeUrl(input.Operation.toText()) + "&Vendor=" + encodeUrl(if(input.Vendor != null,input.Vendor.ID.toText(),"")) + "&Employee_Name=" + encodeUrl(if(input.Employee_Name != null,input.Employee_Name.ID.toText(),"")) + "&Source=" + encodeUrl(if(input.Source != null,input.Source.toText(),"")) + "&Price=" + encodeUrl(input.Price.toText()) + "&Qty=" + encodeUrl(input.Qty_To_be_Produced.toText()) + "&Bundling_ID=" + encodeUrl(input.ID.toText()) + "&Bundle_No=" + encodeUrl(input.Bundle_No.toText()),"popup");
										}
										else
										{
											info "This record is already Submitted.";
										}
					)
					}
				}
			}
			Costing_New as "Costing New"
			{
				type =  functions
				form = Master_Group
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// ✅ Get setting
										get_setting = Setting[ID != null];
										if(get_setting.Validate_Costing_In_Master_Po != "Auto Approve")
										{
											// Existing validation logic
											get_all_linked_groups = Grouping_Purchase_Request[ID in input.Grouping_Purchase_Request_No];
											not_eligible_found = false;
											for each  grouping_rec in get_all_linked_groups
											{
												if(grouping_rec.Eligible_Po == "Not Eligible")
												{
													not_eligible_found = true;
													break;
												}
											}
											if(not_eligible_found)
											{
												info "Some linked groupings are not eligible for a PO. Please validate each grouping first using its 'Validate Costing (New)' button.";
												input.Eligible_Po = "Not Eligible";
												input.Costing_Execute = true;
											}
											else
											{
												// All linked groups are eligible, so call the new function to update the master group
												thisapp.master_group_controllar_check_eligibility_new(input.ID);
												input.Costing_Execute = true;
												info "All groupings are validated. This master group is now eligible for PO.";
											}
										}
										else
										{
											// Auto Approve → skip validation and mark Eligible
											input.Eligible_Po = "Eligible";
											input.Costing_Execute = true;
											info "Auto Approve is active. All groupings are automatically marked Eligible.";
										}
					)
					}
				}
			}
