			VALIDATE_ON_EDIT as "VALIDATE ON EDIT"
			{
				type =  form
				form = Invoice

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ================= STRONG EDIT VALIDATION =================
										isBooksSynced = false;
										isEInvoiceGenerated = false;
										// Books invoice already created
										if(input.ZohoBooks_Invoice_ID != null && input.ZohoBooks_Invoice_ID != "")
										{
											isBooksSynced = true;
										}
										// E-Invoice generated on Invoice form
										if(input.EInvoice_Generated == true)
										{
											isEInvoiceGenerated = true;
										}
										if(input.EInvoice_Status == "Generated")
										{
											isEInvoiceGenerated = true;
										}
										if(input.E_Invoice_No != null && input.E_Invoice_No != "")
										{
											isEInvoiceGenerated = true;
										}
										// E-Invoice record exists
										if(input.ID != null)
										{
											existingEInv = E_Invoice[Invoice == input.ID];
											if(existingEInv != null)
											{
												if(existingEInv.EInvoice_Generated == true || (existingEInv.IRN_Number != null && existingEInv.IRN_Number != ""))
												{
													isEInvoiceGenerated = true;
												}
											}
										}
										// Final block
										if(isEInvoiceGenerated == true)
										{
											alert "This invoice cannot be edited because E-Invoice / IRN is already generated.";
											cancel submit;
										}
										if(isBooksSynced == true)
										{
											alert "This invoice cannot be edited because it is already synced with Zoho Books.";
											cancel submit;
										}
						)
					}
				}

			}
		}






