			Approved_qty as "Approved qty"
			{
				type =  form
				form = GRN_Verification

				record event = on add or edit

				on user input of Approved_Qty
				{
					actions 
					{
						custom deluge script
						(
											// ======================================================
										// AUTO DISTRIBUTE AVAILABLE TO ALLOCATE INTO SUBFORM
										// ======================================================
										// Safety guard
										if(input.Verification.count() == 0)
										{
											return;
										}
										// Remaining qty from header (already calculated elsewhere)
										remaining_qty = ifnull(input.Available_To_Allocate,0);
										// ================= DISTRIBUTE QTY SAFELY =================
										for each  row in input.Verification
										{
											if(remaining_qty <= 0)
											{
												row.Verification_Allocated=0;
												continue;
											}
											row_max = ifnull(row.Total_Grouped_Qty,0);
											if(remaining_qty >= row_max)
											{
												row.Verification_Allocated=row_max;
												remaining_qty = remaining_qty - row_max;
											}
											else
											{
												row.Verification_Allocated=remaining_qty;
												remaining_qty = 0;
											}
										}
										// ======================================================
										// FORCE HEADER RECALC (SUBFORM WORKFLOW WILL NOT FIRE)
										// ======================================================
										grouped_total = 0;
										for each  row in input.Verification
										{
											grouped_total = grouped_total + ifnull(row.Verification_Allocated,0);
										}
										// Sync header fields
										input.Grouped_Allocated = grouped_total;
										input.Available_To_Allocate = grouped_total;
										// ======================================================
										// LOCK FIELD (NO MANUAL EDIT)
										// ======================================================
										disable Verification.Verification_Allocated;
						)
					}
				}

			}
