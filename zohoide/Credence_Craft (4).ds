			before_delete as "before delete"
			{
				type =  form
				form = Payroll

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ================= BLOCK DELETE IF IN PAYOUT =================
										linkedPayout = Payout[Payroll.contains(input.ID)];
										if(linkedPayout.count() > 0)
										{
											alert "❌ This Payroll is already used in a Payout (" + linkedPayout.Payout_No + "). It cannot be deleted.";
											cancel delete;
										}
						)
					}
				}

			}
			On_validate_General_Po_bu as "On validate General Po budget"
			{
				type =  form
				form = Purchase_Order

				record event = on add
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(!thisapp.finance.validateGeneralPOBudget(input.ID))
										{
											cancel submit;
										}
						)
					}
				}

			}
			vaidaton_n_form_submittio as "vaidaton n form submittion"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ================= GET FINANCE SETTING =================
										fs = Setting[ID != null];
										// assuming only 1 record
										// If no settings record, behave safely and validate
										doValidate = true;
										if(fs != null && fs.Validate_General_Po_Budget == "Dont validate")
										{
											doValidate = false;
										}
										// ================= RUN BUDGET CHECK ONLY IF REQUIRED =================
										if(doValidate == true)
										{
											isAllowed = thisapp.finance.validateGeneralPOBudget(input.ID);
											if(isAllowed == false)
											{
												alert "Monthly budget is not available or exceeded for one or more items.";
												cancel submit;
											}
										}
						)
					}
				}

			}
