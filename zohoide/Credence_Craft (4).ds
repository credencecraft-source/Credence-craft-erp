			On_sucess2 as "On sucess"
			{
				type =  form
				form = Process_Bundle_GRN

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "---- GRN START ----";
										grnQty = input.Received_Qty;
										info "GRN Qty: " + grnQty;
										if(input.Bundle_Transfer_No == null)
										{
											info "Bundle Transfer No is NULL";
											return;
										}
										// Get Bundle Movement
										bundleRec = Process_Bundle_Movement[ID == input.Bundle_Transfer_No];
										if(bundleRec == null)
										{
											info "Bundle record NOT found";
											return;
										}
										info "Order ID: " + bundleRec.Order_No;
										info "Work Order ID: " + bundleRec.Work_Order_New;
										info "From Process ID: " + bundleRec.From.ID;
										info "To Process ID: " + bundleRec.To.ID;
										// ======================================================
										// UPDATE GRN IN SUBFORM
										// ======================================================
										if(input.SubForm.count() > 0)
										{
											total_rows = input.SubForm.count();
											per_row = (grnQty / total_rows).toLong();
											for each  r in input.SubForm
											{
												r.Grn=per_row;
											}
										}
										// ======================================================
										// WORK ORDER LEVEL - FROM PROCESS
										// ======================================================
										woFromList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.From.ID];
										info "WO From List Count: " + woFromList.count();
										for each  woRec in woFromList
										{
											info "Updating WO FROM Process ID: " + woRec.ID;
											// OUTPUT
											woRec.Out_Put=ifnull(woRec.Out_Put,0) + grnQty;
											// COMPLETED QTY
											woRec.Completed_Qty=ifnull(woRec.Completed_Qty,0) + grnQty;
											// PROCESS END TIME
											if(woRec.E != null && woRec.End_Time == null)
											{
												woRec.End_Time=zoho.currenttime;
												diff = (zoho.currenttime - woRec.E);
												woRec.Waiting_Time=diff / (1000 * 60 * 60);
												// PER PCS TIME
												if(woRec.Completed_Qty > 0)
												{
													perPieceSeconds = (diff / 1000) / woRec.Completed_Qty;
													hrs = (perPieceSeconds / 3600).toLong();
													mins = ((perPieceSeconds % 3600) / 60).toLong();
													secs = (perPieceSeconds % 60).toLong();
													timeString = hrs + ":" + mins + ":" + secs;
													woRec.Actual_1_pcs=timeString;
												}
											}
											thisapp.updateWOProcessStatusByQty(woRec.ID);
										}
										// ======================================================
										// WORK ORDER LEVEL - TO PROCESS
										// ======================================================
										woToList = Wo_Making_Charges[Work_Order == bundleRec.Work_Order_New && Process_Name.ID == bundleRec.To.ID];
										info "WO To List Count: " + woToList.count();
										for each  woRec2 in woToList
										{
											info "Updating WO TO Process ID: " + woRec2.ID;
											// INPUT
											woRec2.In_Put=ifnull(woRec2.In_Put,0) + grnQty;
											// START TIME
											if(woRec2.E == null)
											{
												woRec2.E=zoho.currenttime;
											}
											thisapp.updateWOProcessStatusByQty(woRec2.ID);
										}
										// ======================================================
										// SYNC TO ORDER LEVEL
										// ======================================================
										info "Syncing WO totals to Order level...";
										thisapp.syncWOToOrder(bundleRec.Order_No.ID);
										// ======================================================
										// UPDATE BUNDLE MOVEMENT GRN
										// ======================================================
										bundleRec.GRN_Qty=ifnull(bundleRec.GRN_Qty,0) + grnQty;
										if(bundleRec.GRN_Qty > bundleRec.Issued)
										{
											info "GRN exceeds Issued Qty";
										}
										info "---- GRN END ----";
						)
					}
				}

			}
			On_User_In_Put as "On User In Put"
			{
				type =  form
				form = Process_Bundle_GRN

				record event = on add or edit

				on user input of Bundle_Transfer_No
				{
					actions 
					{
						custom deluge script
						(
											// ===== On User Input of Bundle_Transfer_No =====
										bt = Process_Bundle_Movement[ID == input.Bundle_Transfer_No];
										if(bt == null)
										{
											return;
										}
										input.Create_Order = bt.Order_No;
										input.From = bt.From;
										input.To = bt.To;
										input.Work_Order_New = bt.Work_Order_New;
										input.Batch = bt.Batch;
										// Clear existing subform
										clear SubForm;
										// Prepare collection
										rows = Collection();
										// Copy rows from Bundle Movement
										for each  rowRec in bt.Operation_Wise_Bundles
										{
											newRow = Process_Bundle_GRN.SubForm();
											newRow.Order_No=rowRec.Order_No;
											newRow.Brand1=rowRec.Brand1;
											newRow.Style_No=rowRec.Style_No;
											newRow.Process_Name=rowRec.Process_Name;
											newRow.Operation=rowRec.Operation;
											newRow.Qty_To_be_Produced=rowRec.Qty_To_be_Produced;
											newRow.Date_field=zoho.currentdate;
											newRow.Grn=0;
											rows.insert(newRow);
										}
										// Insert all rows once
										input.SubForm.insert(rows);
										input.Received_Qty = 0;
										// ===== On User Input of Received_Qty =====
										if(input.Received_Qty != null && input.SubForm.count() > 0)
										{
											total_rows = input.SubForm.count();
											per_row = (input.Received_Qty / total_rows).toLong();
											for each  r in input.SubForm
											{
												r.Grn=per_row;
											}
										}
						)
					}
				}

			}
			Validate5 as "Validate"
			{
				type =  form
				form = Process_Bundle_GRN

				record event = on delete
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											orderId = input.Create_Order;
										fromProc = input.From;
										toProc = input.To;
										grnQty = input.Received_Qty;
										toRec = Order_Process_Controler[Order_No == orderId && Process_Name == toProc];
										// ---------- VALIDATION ----------
										if(toRec != null)
										{
											currentIn = ifnull(toRec.In_Put,0);
											currentOut = ifnull(toRec.Out_Put,0);
											// qty that would remain after delete
											remainingIn = currentIn - grnQty;
											// if already issued more than remaining → block
											if(currentOut > remainingIn)
											{
												alert "Cannot delete this GRN. Qty already issued to next process.";
												cancel delete;
											}
										}
										// ---------- ROLLBACK ----------
										// reverse FROM process
										fromRec = Order_Process_Controler[Order_No == orderId && Process_Name == fromProc];
										if(fromRec != null)
										{
											fromRec.Out_Put=ifnull(fromRec.Out_Put,0) - grnQty;
											if(fromRec.Out_Put < 0)
											{
												fromRec.Out_Put=0;
											}
											fromRec.WIP_or_Missing1=ifnull(fromRec.In_Put,0) - ifnull(fromRec.Out_Put,0);
										}
										// reverse TO process
										if(toRec != null)
										{
											toRec.In_Put=ifnull(toRec.In_Put,0) - grnQty;
											if(toRec.In_Put < 0)
											{
												toRec.In_Put=0;
											}
											toRec.WIP_or_Missing1=ifnull(toRec.In_Put,0) - ifnull(toRec.Out_Put,0);
										}
						)
					}
				}

			}
			on_successfull as "on successfull"
			{
				type =  form
				form = Process_Bundle_GRN

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											orderId = input.Create_Order;
										fromProc = input.From;
										toProc = input.To;
										grnQty = input.Received_Qty;
										// ---------- GET PROCESS RECORDS ----------
										fromRec = Order_Process_Controler[Order_No == orderId && Process_Name == fromProc];
										toRec = Order_Process_Controler[Order_No == orderId && Process_Name == toProc];
										// ---------- IF FIRST PROCESS (NO IN_PUT YET) ----------
										if(fromRec != null && ifnull(fromRec.In_Put,0) == 0)
										{
											// first process always starts with full WO qty
											fromRec.In_Put=ifnull(fromRec.Wo_Qty,0);
										}
										// ---------- UPDATE FROM PROCESS (OUTPUT) ----------
										if(fromRec != null)
										{
											fromRec.Out_Put=ifnull(fromRec.Out_Put,0) + grnQty;
											fromRec.WIP_or_Missing1=ifnull(fromRec.In_Put,0) - ifnull(fromRec.Out_Put,0);
											thisapp.updateWOProcessStatusByQty(fromRec.ID);
										}
										// ---------- UPDATE TO PROCESS (INPUT ONLY) ----------
										if(toRec != null)
										{
											toRec.In_Put=ifnull(toRec.In_Put,0) + grnQty;
											toRec.WIP_or_Missing1=ifnull(toRec.In_Put,0) - ifnull(toRec.Out_Put,0);
											thisapp.updateWOProcessStatusByQty(toRec.ID);
										}
										bundleRec = Process_Bundle_Movement[ID == input.Bundle_Transfer_No];
										if(bundleRec != null)
										{
											bundleRec.GRN_Qty=ifnull(bundleRec.GRN_Qty,0) - grnQty;
											if(bundleRec.GRN_Qty < 0)
											{
												bundleRec.GRN_Qty=0;
											}
										}
						)
					}
				}

			}
			Operation as "Operation"
			{
				type =  form
				form = Order_Process_Controler

				record event = on add or edit

				on user input of Operation_Template
				{
					actions 
					{
						custom deluge script
						(
											if(input.Operation_Template != null)
										{
											templateRec = Operation_Template[ID == input.Operation_Template];
											if(templateRec != null && templateRec.Operation1 != null)
											{
												// 1️⃣ Set Header Operation
												input.Operation = templateRec.Operation1;
												// 2️⃣ Get Order Details
												orderRec = Create_Order[ID == input.Order_No];
												// 3️⃣ Clear Subform
												clear job_order;
												for each  opId in templateRec.Operation1
												{
													newrow = Order_Process_Controler.job_order();
													newrow.Order_No=input.Order_No;
													newrow.Style_Name=orderRec.Style_Name;
													newrow.Brand1=orderRec.Brand;
													newrow.Process_Name=input.Process_Name;
													newrow.Operation=opId;
													newrow.Order_Qty=orderRec.Order_Qty;
													newrow.Work_Order_Qty=input.Wo_Qty;
													newrow.Cut_Qty=input.Cut_Qty;
													rows = Collection();
													rows.insert(newrow);
													input.job_order.insert(rows);
												}
											}
											else
											{
												input.Operation.clear();
												clear job_order;
											}
										}
						)
					}
				}

			}
