				 void updateAttendanceDuration(int attendanceLogId)
                 {
                 	// ==========================================
                 	// FETCH RECORD
                 	// ==========================================
                 	rec = Attendance_Logs[ID == attendanceLogId];
                 	if(rec == null)
                 	{
                 		return;
                 	}
                 	// ==========================================
                 	// FETCH BREAK DURATION FROM ATTENDANCE RULE
                 	// ==========================================
                 	emp = Employee_Name[Employee_No == rec.Employee_Id];
                 	if(emp != null && emp.Attendance_Rule != null)
                 	{
                 		rule = Attendance_Rule[ID == emp.Attendance_Rule];
                 		if(rule != null)
                 		{
                 			rec.Break_Duration1=rule.Break_Duration;
                 		}
                 	}
                 	// ==========================================
                 	// VALIDATION
                 	// ==========================================
                 	if(rec.In_Time == null || rec.Out_Time == null)
                 	{
                 		rec.Total_Duration=null;
                 		rec.Final_Duration=null;
                 		return;
                 	}
                 	// ==========================================
                 	// NORMALIZE TIME STRING → HH:mm
                 	// ==========================================
                 	inStr = rec.In_Time.toString().subString(0,5);
                 	outStr = rec.Out_Time.toString().subString(0,5);
                 	// ==========================================
                 	// PARSE IN TIME
                 	// ==========================================
                 	inTotalMin = inStr.subString(0,2).toLong() * 60 + inStr.subString(3,5).toLong();
                 	// ==========================================
                 	// PARSE OUT TIME
                 	// ==========================================
                 	outTotalMin = outStr.subString(0,2).toLong() * 60 + outStr.subString(3,5).toLong();
                 	// ==========================================
                 	// NIGHT SHIFT HANDLING
                 	// ==========================================
                 	if(outTotalMin < inTotalMin)
                 	{
                 		outTotalMin = outTotalMin + 1440;
                 	}
                 	// ==========================================
                 	// TOTAL DURATION
                 	// ==========================================
                 	durationMin = outTotalMin - inTotalMin;
                 	// ==========================================
                 	// SAVE TOTAL DURATION
                 	// ==========================================
                 	tdHour = floor(durationMin / 60);
                 	tdMin = durationMin % 60;
                 	if(tdHour >= 24)
                 	{
                 		tdHour = 23;
                 		tdMin = 59;
                 	}
                 	rec.Total_Duration=(if(tdHour < 10,"0" + tdHour,tdHour) + ":" + if(tdMin < 10,"0" + tdMin,tdMin)).toTime("HH:mm");
                 	// ==========================================
                 	// FINAL DURATION = TOTAL - BREAK
                 	// ==========================================
                 	breakMin = 0;
                 	if(rec.Break_Duration1 != null)
                 	{
                 		breakMin = rec.Break_Duration1.getHour() * 60 + rec.Break_Duration1.getMinutes();
                 	}
                 	finalMin = durationMin - breakMin;
                 	if(finalMin < 0)
                 	{
                 		finalMin = 0;
                 	}
                 	fdHour = floor(finalMin / 60);
                 	fdMin = finalMin % 60;
                 	if(fdHour >= 24)
                 	{
                 		fdHour = 23;
                 		fdMin = 59;
                 	}
                 	rec.Final_Duration=(if(fdHour < 10,"0" + fdHour,fdHour) + ":" + if(fdMin < 10,"0" + fdMin,fdMin)).toTime("HH:mm");
                 }
				 void updateAttendanceStatus_Final(int attendanceLogId)
                 {
                 	l = Attendance_Logs[ID == attendanceLogId];
                 	if(l == null)
                 	{
                 		return;
                 	}
                 	// ================= GET TIME VALUES =================
                 	inHour = 0;
                 	inMin = 0;
                 	outHour = 0;
                 	outMin = 0;
                 	if(l.In_Time != null)
                 	{
                 		inHour = l.In_Time.getHour();
                 		inMin = l.In_Time.getMinutes();
                 	}
                 	if(l.Out_Time != null)
                 	{
                 		outHour = l.Out_Time.getHour();
                 		outMin = l.Out_Time.getMinutes();
                 	}
                 	// ================= BASE STATUS =================
                 	if(inHour == 0 && inMin == 0 && outHour == 0 && outMin == 0)
                 	{
                 		l.Status="Absent";
                 		return;
                 	}
                 	if(inHour == 0 && inMin == 0)
                 	{
                 		l.Status="In Punch Missing";
                 		return;
                 	}
                 	if(outHour == 0 && outMin == 0)
                 	{
                 		l.Status="Out Punch Missing";
                 		return;
                 	}
                 	l.Status="Present";
                 	// ================= APPLY RULES =================
                 	emp = Employee_Name[Employee_No == l.Employee_Id];
                 	if(emp == null || emp.Attendance_Rule == null)
                 	{
                 		return;
                 	}
                 	rule = Attendance_Rule[ID == emp.Attendance_Rule];
                 	if(rule == null)
                 	{
                 		return;
                 	}
                 	// -------- LATE IN --------
                 	if(rule.In_Time != null)
                 	{
                 		logInMin = inHour * 60 + inMin;
                 		ruleInMin = rule.In_Time.getHour() * 60 + rule.In_Time.getMinutes();
                 		if(logInMin > ruleInMin)
                 		{
                 			l.Status="Late_In";
                 		}
                 	}
                 	// -------- EARLY OUT --------
                 	if(rule.Out_Time != null)
                 	{
                 		logOutMin = outHour * 60 + outMin;
                 		ruleOutMin = rule.Out_Time.getHour() * 60 + rule.Out_Time.getMinutes();
                 		if(logOutMin < ruleOutMin)
                 		{
                 			l.Status="Early Out";
                 		}
                 	}
                 }
				 void updateEmployeeFirstLastPunchandstatus(int attendanceLogId)
                 {
                 	log = Attendance_Logs[ID == attendanceLogId];
                 	if(log == null || log.Employee_Id == null || log.Date_field == null)
                 	{
                 		return;
                 	}
                 	emp = Employee_Name[Employee_No == log.Employee_Id];
                 	if(emp == null)
                 	{
                 		return;
                 	}
                 	punchDate = log.Date_field;
                 	// ================= FIRST PUNCH =================
                 	if(emp.First_Punch == null || punchDate < emp.First_Punch)
                 	{
                 		emp.First_Punch=punchDate;
                 	}
                 	// ================= LAST PUNCH =================
                 	if(emp.Last_Punch == null || punchDate > emp.Last_Punch)
                 	{
                 		emp.Last_Punch=punchDate;
                 	}
                 	// ================= STATUS UPDATE =================
                 	// If Attendance Rule lookup is EMPTY -> New Join
                 	if(emp.Attendance_Rule == null)
                 	{
                 		emp.Status="New Join";
                 		return;
                 	}
                 	// If Attendance Rule is assigned -> Active
                 	emp.Status="Active";
                 	// Else calculate based on last punch vs current date
                 	if(emp.Last_Punch != null)
                 	{
                 		diffMillis = zoho.currenttime.toLong() - emp.Last_Punch.toLong();
                 		if(diffMillis < 0)
                 		{
                 			diffMillis = diffMillis * -1;
                 		}
                 		days = floor(diffMillis / 86400000);
                 		if(days <= 5)
                 		{
                 			emp.Status="Active";
                 		}
                 		else if(days <= 40)
                 		{
                 			emp.Status="Long Absent";
                 		}
                 		else
                 		{
                 			emp.Status="Inactive";
                 		}
                 	}
                 }
				 void updateMonthYearFromDate(int attendanceLogId)
                 {
                 	rec = Attendance_Logs[ID == attendanceLogId];
                 	if(rec == null || rec.Date_field == null)
                 	{
                 		return;
                 	}
                 	month_no = rec.Date_field.getMonth();
                 	// 1–12
                 	year_no = rec.Date_field.getYear();
                 	// 2025
                 	// Month lookup
                 	month_rec = Month_Master[Month_No == month_no];
                 	if(month_rec != null)
                 	{
                 		rec.Month_No=month_rec;
                 	}
                 	// Year lookup
                 	year_rec = Year_form[Year_field == year_no];
                 	if(year_rec == null)
                 	{
                 		year_rec = insert into Year_form
                 		[
                 			Year_field=year_no
                 			Added_User=zoho.loginuser
                 		];
                 	}
                 	rec.Year_Master=year_rec;
                 }
				 void updateWOProcessStatusByQty(int processID)
                 {
                 	rec = Wo_Making_Charges[ID == processID];
                 	if(rec.count() == 0)
                 	{
                 		return;
                 	}
                 	inQty = ifnull(rec.In_Put,0);
                 	outQty = ifnull(rec.Out_Put,0);
                 	// =====================================================
                 	// -------- OPERATION LEVEL CALCULATION ----------------
                 	// =====================================================
                 	ops = Wo_Making_Charges_Subform[Work_Order_Process_Controller == rec.ID];
                 	for each  job in ops
                 	{
                 		totalCompleted = 0;
                 		pbms = Process_Bundle_Movement[Work_Order_New == rec.Work_Order && Process_Master == rec.Process_Name];
                 		for each  p in pbms
                 		{
                 			for each  b in p.Operation_Wise_Bundles
                 			{
                 				if(b.Operation == job.Operation)
                 				{
                 					totalCompleted = totalCompleted + toLong(ifnull(b.Issued,0));
                 				}
                 			}
                 		}
                 		job.Operation_Wise_Completed_Qty=totalCompleted;
                 		jobQty = ifnull(job.Operation_Wise_Qty_To_be_Produced,0);
                 		if(totalCompleted >= jobQty && jobQty > 0)
                 		{
                 			job.Operation_Status="Completed";
                 		}
                 		else if(totalCompleted > 0)
                 		{
                 			job.Operation_Status="In Progress";
                 		}
                 		else
                 		{
                 			job.Operation_Status="Not Yet Started";
                 		}
                 	}
                 	// =====================================================
                 	// -------- PROCESS LEVEL CALCULATION ------------------
                 	// =====================================================
                 	procCompleted = 0;
                 	for each  job in ops
                 	{
                 		procCompleted = procCompleted + toLong(ifnull(job.Operation_Wise_Completed_Qty,0));
                 	}
                 	rec.Completed_Qty1=procCompleted;
                 	// ? Production Status based on OUT vs IN
                 	if(outQty == 0)
                 	{
                 		rec.Production_Status="Yet to Start";
                 	}
                 	else if(outQty > 0 && outQty < inQty)
                 	{
                 		rec.Production_Status="In Progress";
                 	}
                 	else if(outQty >= inQty && inQty > 0)
                 	{
                 		rec.Production_Status="Completed";
                 	}
                 	else
                 	{
                 		rec.Production_Status="Yet to Start";
                 	}
                 	// =====================================================
                 	// -------- WIP CALCULATION (STRICT IN - OUT) ----------
                 	// =====================================================
                 	wipVal = inQty - outQty;
                 	if(wipVal < 0)
                 	{
                 		wipVal = 0;
                 	}
                 	rec.WIP_or_Missing1=wipVal;
                 }
				 void updateWOStage(int woId)
                 {
                 	woRec = Work_Order_New[ID == woId];
                 	if(woRec == null)
                 	{
                 		return;
                 	}
                 	procs = Wo_Making_Charges[Work_Order == woId] sort by Process_No asc;
                 	stageText = "";
                 	lastProcName = "";
                 	for each  p in procs
                 	{
                 		wip = ifnull(p.WIP_or_Missing1,0);
                 		procName = p.Process_Name.Process_Name;
                 		lastProcName = procName;
                 		if(wip > 0)
                 		{
                 			startTime = p.E;
                 			days = 0;
                 			if(startTime != null)
                 			{
                 				diff = (zoho.currenttime - startTime);
                 				days = (diff / (1000 * 60 * 60 * 24)).toLong();
                 				if(days <= 0)
                 				{
                 					days = 1;
                 				}
                 			}
                 			else
                 			{
                 				days = 1;
                 			}
                 			stageText = stageText + wip + " pcs in " + procName + " (" + days + " days) | ";
                 		}
                 	}
                 	// CLEAN LAST PIPE
                 	if(stageText != "" && stageText.endsWith(" | "))
                 	{
                 		stageText = stageText.subString(0,stageText.length() - 3);
                 	}
                 	// FULL COMPLETE
                 	if(stageText == "")
                 	{
                 		if(lastProcName != "")
                 		{
                 			stageText = "Fully Completed (" + lastProcName + ")";
                 		}
                 		else
                 		{
                 			stageText = "Fully Completed";
                 		}
                 	}
                 	woRec.Stage=stageText;
                 }
				 void update_and_insert_raw_material(int quick_row_id)
                 {
                 	// ===== PLAN VALIDATION =====
                 	user_plan = Pricing[Added_User == zoho.loginuser];
                 	if(user_plan.count() == 0)
                 	{
                 		info "No active plan found.";
                 		return;
                 	}
                 	plan_name = "";
                 	if(user_plan.Plan_Features != null)
                 	{
                 		plan_name = user_plan.Plan_Features.Plan_Name;
                 	}
                 	if(plan_name != "Professional" && plan_name != "Enterprises")
                 	{
                 		info "This feature is available only for Professional or Enterprise Plan.";
                 		return;
                 	}
                 	// ===== ORIGINAL LOGIC =====
                 	row = Add_Quick_Raw_Material_Subform[ID == quick_row_id];
                 	if(row.ID == null)
                 	{
                 		return;
                 	}
                 	row.Status="Validating";
                 	// ---- Mandatory ----
                 	if(row.Raw_Material_Name == null || row.Order_No == null)
                 	{
                 		row.Status="Failed";
                 	}
                 	else
                 	{
                 		rm = Raw_Material1[ID == row.Raw_Material_Name];
                 		if(rm.ID == null)
                 		{
                 			row.Status="Failed";
                 		}
                 		else
                 		{
                 			order_rec = Create_Order[ID == row.Order_No];
                 			if(order_rec.ID == null)
                 			{
                 				row.Status="Failed";
                 			}
                 			else
                 			{
                 				// ---- Update from masters ----
                 				row.Uom=rm.Stock_Uom1;
                 				row.Category=rm.Category;
                 				row.Category_Type1=rm.Category_Type;
                 				row.Subcategory1=rm.Subcategory;
                 				row.Products=order_rec.Sub_Catagery;
                 				row.Size_Group_ID=order_rec.Size_Group;
                 				// ---- Duplicate check ----
                 				dup_list = Order_Raw_material[Order_No == order_rec.ID && Raw_Material_Name == row.Raw_Material_Name];
                 				if(dup_list.count() > 0)
                 				{
                 					row.Status="Inserted";
                 				}
                 				else
                 				{
                 					// ---- Settings ----
                 					get_setting = Setting[ID != 0];
                 					auto_approve = if(get_setting.Approve_Consemption == "Auto Approve",true,false);
                 					// ---- Size & Qty ----
                 					if(row.Size != null && row.Size.size() > 0)
                 					{
                 						get_size_mapped = true;
                 						sum_order_qty = Finished_Goods_Size_wise[Order_No == order_rec.ID && Size == row.Size].sum(Total_Qty);
                 					}
                 					else
                 					{
                 						get_size_mapped = false;
                 						sum_order_qty = Finished_Goods_Size_wise[Order_No == order_rec.ID].sum(Total_Qty);
                 					}
                 					// ---- Consumption ----
                 					get_internal_consum = if(auto_approve,ifnull(row.Consumption,0),0);
                 					get_req_qty = sum_order_qty * get_internal_consum;
                 					get_exess_qty = (get_req_qty * ifnull(row.Excess,0)) / 100;
                 					// ---- Insert ----
                 					insert_rec = insert into Order_Raw_material
                 					[
                 						Order_No=order_rec.ID
                 						Raw_Material_Name=row.Raw_Material_Name
                 						Item_Code=row.Raw_Material_Name
                 						Style_Name=order_rec.ID
                 						Vendor_Master=row.Vendor1
                 						Gold_Seal=order_rec.Article
                 						Season=order_rec.Season
                 						Brand1=order_rec.Brand
                 						Subcategory=row.Subcategory1
                 						Category_Master=row.Category
                 						Category_Type_Master=row.Category_Type1
                 						Buyer_Consumption=row.Consumption
                 						Buyer_Price=row.Buyer_Price
                 						Internal_Consumption=get_internal_consum
                 						Item_Wise_Excess_Persentage1=row.Excess
                 						Item_Wise_Excess_qty=get_exess_qty
                 						Required_Qty=get_req_qty
                 						Total_Required_Qty=get_req_qty + get_exess_qty
                 						Size=row.Size
                 						Is_Size_Mapped=get_size_mapped
                 						Sum_of_Size_wise_qty=sum_order_qty
                 						Internal_Price=if(auto_approve,row.Buyer_Price,0)
                 						Internal_Consumption_Status=if(auto_approve,"Approved","Draft")
                 						Buyer_Consumption_Status=if(auto_approve,"Approved","Draft")
                 						Raw_material_Status=if(auto_approve,"Approved","Draft")
                 						Price_Status=if(auto_approve,"Approved","Draft")
                 						Verification_Status=if(auto_approve,"Approved","Draft")
                 						Stock_Confirmation_status=if(auto_approve,"Approved","Yet To Check Stock")
                 						Grouping_Status=if(auto_approve,"Approved","Not Grouped")
                 						Products=row.Products
                 						Added_User=zoho.loginuser
                 					];
                 					if(insert_rec != null)
                 					{
                 						row.Status="Inserted";
                 						if(auto_approve)
                 						{
                 							thisapp.order_controllar.order_raw_material_field_calculate(insert_rec);
                 						}
                 					}
                 					else
                 					{
                 						row.Status="Failed";
                 					}
                 				}
                 			}
                 		}
                 	}
                 	// ---- FINAL DELETE ----
                 	if(row.Status == "Inserted")
                 	{
                 		delete from Add_Quick_Raw_Material_Subform[ID == quick_row_id];
                 	}
                 }
				 void Uplode_Bom_Temp(int upload_id)
                 {
                 	up = Uplode_Bom_Temp[ID == upload_id];
                 	if(up.ID == null)
                 	{
                 		return;
                 	}
                 	up.Validation_Status="Validating";
                 	// ---- Mandatory ----
                 	if(up.Raw_Material == null || up.Order_No == null)
                 	{
                 		up.Validation_Status="Missing Mandatory Data";
                 		return;
                 	}
                 	// ---- Vendor ----
                 	if(up.Vendor == null)
                 	{
                 		up.Validation_Status="Vendor Missing";
                 		return;
                 	}
                 	vend = null;
                 	for each  v in Vendor1
                 	{
                 		if(v.Vendor_Name != null && v.Vendor_Name.trim().toLowerCase() == up.Vendor.trim().toLowerCase())
                 		{
                 			vend = v;
                 			break;
                 		}
                 	}
                 	if(vend == null)
                 	{
                 		up.Validation_Status="Vendor Not Found";
                 		return;
                 	}
                 	// ---- Order ----
                 	each_order = Create_Order[Order_No == up.Order_No];
                 	if(each_order.ID == null)
                 	{
                 		up.Validation_Status="Order Not Found";
                 		return;
                 	}
                 	// ---- Raw Material ----
                 	rm = Raw_Material1[Raw_Material_Name == up.Raw_Material];
                 	if(rm.ID == null)
                 	{
                 		up.Validation_Status="Not Found in Master";
                 		return;
                 	}
                 	// ---- Size ----
                 	size_rec = null;
                 	if(up.Size != null && up.Size != "")
                 	{
                 		size_rec = Size[Size == up.Size];
                 		if(size_rec.ID == null)
                 		{
                 			up.Validation_Status="Invalid Size";
                 			return;
                 		}
                 		size_check = Finished_Goods_Size_wise[Order_No == each_order.ID && Size == size_rec.ID];
                 		if(size_check.count() == 0)
                 		{
                 			up.Validation_Status="Size Not Available for Order";
                 			return;
                 		}
                 	}
                 	// ---- Duplicate ----
                 	if(size_rec != null && size_rec.ID != null)
                 	{
                 		dup = Add_Quick_Raw_Material_Subform[Order_No == each_order.ID && Raw_Material_Name == rm.ID && Size == size_rec.ID];
                 	}
                 	else
                 	{
                 		dup = Add_Quick_Raw_Material_Subform[Order_No == each_order.ID && Raw_Material_Name == rm.ID && Size == null];
                 	}
                 	if(dup.count() > 0)
                 	{
                 		up.Validation_Status="Inserted";
                 		delete from Uplode_Bom_Temp[ID == upload_id];
                 		return;
                 	}
                 	// ---- Insert ----
                 	if(size_rec != null && size_rec.ID != null)
                 	{
                 		insert into Add_Quick_Raw_Material_Subform
                 		[
                 			Order_No=each_order.ID
                 			Raw_Material_Name=rm.ID
                 			Buyer_Price=up.Buyer_Price
                 			Consumption=up.Buyer_Consumption
                 			Size=size_rec.ID
                 			Vendor1=vend.ID
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	else
                 	{
                 		insert into Add_Quick_Raw_Material_Subform
                 		[
                 			Order_No=each_order.ID
                 			Raw_Material_Name=rm.ID
                 			Buyer_Price=up.Buyer_Price
                 			Consumption=up.Buyer_Consumption
                 			Vendor1=vend.ID
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	up.Validation_Status="Inserted";
                 	delete from Uplode_Bom_Temp[ID == upload_id];
                 }
				 void validateAddRMUserPermission(list orderList)
                 {
                 	for each  ord in orderList
                 	{
                 		orderRec = Create_Order[ID == ord];
                 		if(orderRec != null && orderRec.Final_Status == "Approved")
                 		{
                 			settingRec = Setting[ID != 0];
                 			if(settingRec != null)
                 			{
                 				userAllowed = false;
                 				for each  uid in settingRec.Add_Rawmateril_After_Order_Approve
                 				{
                 					userRec = User[ID == uid];
                 					if(userRec.Email == zoho.loginuser)
                 					{
                 						userAllowed = true;
                 						break;
                 					}
                 				}
                 				if(userAllowed == false)
                 				{
                 					info "You are not allowed to add Raw Material after Order Approval";
                 				}
                 			}
                 		}
                 	}
                 }
				 void bill_controllar.purchase_bill_status_update(int grn_id)
