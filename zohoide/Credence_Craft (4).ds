										{
											input.CGST1 = sum_of_tax / 2;
											input.SGST1 = sum_of_tax / 2;
											input.IGST1 = 0;
										}
										else
										{
											input.CGST1 = 0;
											input.SGST1 = 0;
											input.IGST1 = sum_of_tax;
										}
										input.Other_Charges = sum_of_other_charges;
										input.Grand_Total = sum_of_total;
						)
					}
				}

			}
			Price_in_Purchase_Order as "Price in Purchase Order"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of Po_Sub_Form.Po_Price
				{
					actions 
					{
						custom deluge script
						(
											if(row.Discount < 0 || row.Po_Price < row.Discount)
										{
											alert "Please enter the valid discount..!";
											row.Discount=null;
										}
										row.After_Discount=ifnull(row.Po_Price,0) - ifnull(row.Discount,0);
										row.Gross_Amount=ifnull(row.Po_Qty,0) * ifnull(row.After_Discount,0);
										get_tax_value = ifnull(row.Gross_Amount,0) * ifnull(row.Gst11.Gst,0) / 100;
										row.Tax=get_tax_value;
										row.IGST=get_tax_value;
										row.SGST=get_tax_value / 2;
										row.CGST=get_tax_value / 2;
										row.Total_With_Tax=ifnull(row.Gross_Amount,0) + ifnull(row.Tax,0);
										row.Grand_Toltal=ifnull(row.Total_With_Tax,0) + ifnull(row.Other_Charges,0);
										sum_of_amount = 0;
										sum_of_tax = 0;
										sum_of_other_charges = 0;
										sum_of_total = 0;
										for each  each_item in input.Po_Sub_Form
										{
											sum_of_amount = sum_of_amount + ifnull(each_item.Gross_Amount,0);
											sum_of_tax = sum_of_tax + ifnull(each_item.Tax,0);
											sum_of_other_charges = sum_of_other_charges + ifnull(each_item.Other_Charges,0);
											sum_of_total = sum_of_total + ifnull(each_item.Grand_Toltal,0);
										}
										input.Total = sum_of_amount;
										input.Tax = sum_of_tax;
										if(input.Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
										{
											input.CGST1 = sum_of_tax / 2;
											input.SGST1 = sum_of_tax / 2;
											input.IGST1 = 0;
										}
										else
										{
											input.CGST1 = 0;
											input.SGST1 = 0;
											input.IGST1 = sum_of_tax;
										}
										input.Other_Charges = sum_of_other_charges;
										input.Grand_Total = sum_of_total;
						)
					}
				}

			}
			Po_Vendor_In_Purchase_Ord as "Po Vendor In Purchase Order"
			{
				type =  form
				form = Purchase_Order

				record event = on add or edit

				on user input of Vendor_Name
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Name != null && input.Vendor_Name.New_GST_Type != null && input.Vendor_Name.New_GST_Type.gst_type == "CGST & SGST")
										{
											hide IGST1;
											hide Po_Sub_Form.IGST;
											show CGST1;
											show SGST1;
											show Po_Sub_Form.SGST;
											show Po_Sub_Form.CGST;
											input.IGST1 = 0;
											input.CGST1 = ifnull(input.Tax,0) / 2;
											input.SGST1 = ifnull(input.Tax,0) / 2;
										}
										else
										{
											hide CGST1;
											hide SGST1;
											hide Po_Sub_Form.SGST;
											hide Po_Sub_Form.CGST;
											show IGST1;
											show Po_Sub_Form.IGST;
											input.CGST1 = 0;
											input.SGST1 = 0;
											input.IGST1 = ifnull(input.Tax,0);
										}
						)
					}
				}

			}
