				 void pickList.createPickBox(Centralized_Pick_list idVal)
                 {
                 	if(idVal.Picked == idVal.Boxed_Qty)
                 	{
                 		info "All Picked Qty Box Created";
                 	}
                 	else
                 	{
                 		if(idVal.Box_Status.getall().contains("Fully Boxed"))
                 		{
                 			info "Some Records Already Box allocated";
                 		}
                 		else
                 		{
                 			if((idVal.Status.getall()).distinct().contains("Picked") || (idVal.Status.getall()).distinct().contains("Partially Picked"))
                 			{
                 				getVend = (idVal.Factory.getall()).distinct();
                 				if(getVend.size() > 1)
                 				{
                 					info "Multiple Vendor is not Allowed";
                 				}
                 				else
                 				{
                 					createBox = insert into RM_PICK_BOX
                 					[
                 						Added_User=zoho.loginuser
                 						Created=zoho.currentdate
                 						Created_User_Id=zoho.loginuserid
                 						Vendor1=idVal.Factory.getall()
                 						Status="Draft"
                 					];
                 					for each  rec in idVal
                 					{
                 						getBox = Rm_Pick_Box_Subform[Pick_ID == rec.ID && Rawmateril == rec.Raw_Material1].sum(Packed);
                 						updatePackVal = ifnull(rec.Picked,0);
                 						if(getBox > 0)
                 						{
                 							updatePackVal = ifnull(rec.Picked,0) - getBox;
                 						}
                 						createBoxSub = insert into Rm_Pick_Box_Subform
                 						[
                 							Added_User=zoho.loginuser
                 							Centralized_Pick_list=rec.ID
                 							Order_No=rec.Order_No
                 							Brand1=rec.Brand1
                 							Pick_ID=rec.ID
                 							Rawmateril=rec.Raw_Material1
                 							Create_Order1=rec.Order_No
                 							Packed=updatePackVal
                 							RM_PICK_BOX=createBox
                 						];
                 						// 					rec.Status="Box Created";
                 						getPickList = Centralized_Pick_list[ID == rec.ID];
                 						getPickList.Boxed_Qty=rec.Picked;
                 						getPickList.Balance_to_Create_Box=ifnull(getPickList.Picked,0) - ifnull(getPickList.Boxed_Qty,0);
                 						if(ifnull(getPickList.Boxed_Qty,0) == 0)
                 						{
                 							getPickList.Box_Status="Draft";
                 						}
                 						else if(ifnull(getPickList.Requested,0) > ifnull(getPickList.Boxed_Qty,0))
                 						{
                 							getPickList.Box_Status="Partially Created";
                 						}
                 						else if(ifnull(getPickList.Requested,0) == ifnull(getPickList.Boxed_Qty,0))
                 						{
                 							getPickList.Box_Status="Fully Boxed";
                 						}
                 					}
                 				}
                 			}
                 			else
                 			{
                 				info "Only Picked Records allow";
                 			}
                 		}
                 	}
                 }
				 void Place_Holder.replacePlaceholder(Order_Raw_material getRawmaterial)
                 {
                 	getBodyFabric = (getRawmaterial.Order_No.Body_Fabric1.getall()).distinct();
                 	getOrder = (getRawmaterial.Order_No.getall()).distinct();
                 	getRaw = (getRawmaterial.Raw_Material_Name.getall()).distinct();
                 	if(getBodyFabric.size() == 1)
                 	{
                 		openUrl("#Form:Replace_Place_Holder?Body_Fabric=" + getBodyFabric + "&Order_No=" + getOrder + "&Raw_Material=" + getRaw,"popup window","height=auto,width=auto");
                 	}
                 	else
