			Create_Order_Deleted_Vali as "Create Order (Deleted)-Validation"
			{
				type =  form
				form = Create_Order

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Grouping_Subform[Order_Raw_material_ID.Order_No == input.ID && Grouping_Purchase_Request_ID != null].count() > 0)
										{
											alert "Found a Grouping associated with this Order so, please delete the Grouping first.";
											cancel delete;
										}
										else
										{
											// ✅ Update EO_No at order level
											thisapp.order_controllar.order_dele_update_eo_no_level(input.Eo_No_and_Name,input.Article,input.ID);
											// ✅ Delete related records
											delete from Finished_Goods_Size_wise[Order_No == input.ID];
											delete from Finished_Goods_Size_wise[Order_No == null];
											delete from Order_Raw_material[Order_No == input.ID];
											delete from Order_Raw_material[Order_No == null];
											delete from Order_Cost_Center[Costing_ID.Order_No == input.ID];
											delete from Order_Cost_Center[Costing_ID.Order_No == null];
											delete from Costing[Order_No == input.ID];
											delete from Costing[Order_No == null];
											delete from Order_Pre_Order_Check_List[Create_Order == input.ID];
											delete from Order_Pre_Order_Check_List[Create_Order == null];
											delete from Approve_Internal_Consumption_Subform[Order_No == input.ID];
											delete from Approve_Internal_Consumption_Subform[Order_No == null];
											delete from Approve_internal_consumption_and_price[Order_No == input.ID];
											delete from Approve_internal_consumption_and_price[Order_No == null];
											delete from Order_Process_Controler[Order_No == input.ID];
											delete from Order_Job_Order_New[Order_No == input.ID];
										}
						)
					}
				}

			}
