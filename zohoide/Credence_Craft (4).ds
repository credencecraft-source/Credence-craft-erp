					{
						custom deluge script
						(
											disable Verification.Grouping_No;
										disable Verification.Total_Grouped_Qty;
										disable Verification.Balance_to_Allocate1;
										hide Verification.Allocation_Status;
										input.Purchase_Order = input.Rm_Unique_Id.Purchase_NO;
										if(input.Purchase_Order.Po_Type == "General")
