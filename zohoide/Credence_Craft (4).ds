			Mandate_on_submit as "Mandate on submit"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											missing_fields = List();
										// Check header fields
										if(input.Article == null)
										{
											missing_fields.add("Gold Seal");
										}
										if(input.Brand == null)
										{
											missing_fields.add("Brand");
										}
										if(input.Size_Group == null)
										{
											missing_fields.add("Size Group");
										}
										if(input.Buyer1 == null)
										{
											missing_fields.add("Buyer");
										}
										if(input.Season == null)
										{
											missing_fields.add("Season");
										}
										if(input.Fob == null)
										{
											missing_fields.add("Fob");
										}
										if(input.Style_Name == null)
										{
											missing_fields.add("Style");
										}
										if(input.Colors == null)
										{
											missing_fields.add("Colour");
										}
										// Check subform Finished_Goods_Size_wise
										if(input.Finished_Goods_Size_wise == null || input.Finished_Goods_Size_wise.isEmpty())
										{
											missing_fields.add("Finished Goods Size Wise (at least one row)");
										}
										else
										{
											row_index = 1;
											for each  each_sis in input.Finished_Goods_Size_wise
											{
												if(each_sis.Size == null)
												{
													missing_fields.add("Size in subform row " + row_index.toString());
												}
												row_index = row_index + 1;
											}
										}
										// Build alert message manually
										if(missing_fields.size() > 0)
										{
											msg = "Please fill the following fields before submitting:\n";
											for each  field_name in missing_fields
											{
												msg = msg + "- " + field_name + "\n";
											}
											alert msg;
											cancel submit;
										}
						)
					}
				}

			}
