			Approve_Internal_Consumpt2 as "Approve Internal Consumption (C)-Success"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  each_item in input.Approve_Consumption_and_price
										{
											get_order_raw = Order_Raw_material[Raw_Material_Name == input.Raw_Material && Order_No == each_item.Order_No];
											if(get_order_raw.ID != null)
											{
												if(each_item.Internal_Best_Consumption == "Yes")
												{
													get_order_raw.Internal_Consumption_Status="Approved";
													get_order_raw.Internal_Consumption=each_item.Internal_Consumption;
													get_order_raw.Internal_Price=each_item.Internal_Price;
													each_item.Internal_Consumption_Approve_Status="Approved";
												}
												if(each_item.Buyer_Best_Consumption == "Yes")
												{
													get_order_raw.Buyer_Consumption_Status="Approved";
													get_order_raw.Buyer_Consumption=each_item.Buyer_Consumption1;
													get_order_raw.Buyer_Price=each_item.Buyer_Price;
													each_item.Buyer_Consumption_Approve_Status="Approved";
												}
												thisapp.order_controllar.order_raw_material_field_calculate(get_order_raw.ID);
											}
											//	thisapp.order_controllar.create_costing(each_item.Order_No);
											//	thisapp.order_controllar.update_eo_no_level(each_item.Order_No.Eo_No_and_Name,each_item.Order_No.Gold_Seal);
										}
										openUrl("#Script:page.parent.refresh","same window");
						)
					}
				}

			}
