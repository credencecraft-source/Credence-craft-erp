			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='18%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'StatutoryComponentsEPF'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'EPF'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Statutory_Components_Esi_Report'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'ESI'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='19%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Statutory_Components_Professional_Tax_Report'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Professional Tax'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='12%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Statutory_Components_Labour_Welfare_Fund_Report'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Labour Welfare Fund'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='28%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Statutory_Components_Bonus_Report'\n\t\ttarget = 'same-window'\n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Statutory Bonus'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet8' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet8()\ncontent\n&lt;%{\n\t%&gt;\n&lt;link rel=&quot;stylesheet&quot;\n      href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css&quot;&gt;\n\n&lt;style&gt;\n*{margin:0;padding:0;box-sizing:border-box;}\n.form-action-container{display:none;}\n\n.tabs{display:block;height:100vh;position:relative;font-family:Arial, sans-serif;}\n.tabs .tab{float:left;display:block;}\n.tabs .tab &gt; input[type=&quot;radio&quot;]{position:absolute;top:-9999px;left:-9999px;}\n.tabs .tab &gt; label{\n    display:block;\n    padding:6px 30px;\n    font-size:13px;\n    text-transform:uppercase;\n    cursor:pointer;\n    position:relative;\n    font-weight:bold;\n    color:#303030;\n}\n.tabs .tab &gt; label::after{\n    content:&quot;&quot;;\n    position:absolute;\n    left:0;bottom:0;\n    width:0;height:3px;\n    background:green;\n    transition:width 0.3s ease;\n}\n.tabs &gt; .tab &gt; [id^=&quot;tab&quot;]:checked + label::after{width:100%;}\n.tabs .content{\n    z-index:0;overflow:hidden;\n    position:absolute;top:27px;left:0;\n    width:100%;height:calc(100vh - 27px);\n    opacity:0;transition:opacity 400ms ease-out;\n}\n.tabs &gt; .tab &gt; [id^=&quot;tab&quot;]:checked ~ [id^=&quot;tab-content&quot;]{\n    z-index:1;opacity:1;\n}\n.tabs iframe{width:100%;height:100%;border:0;display:block;}\n&lt;/style&gt;\n\n&lt;ul class=&quot;tabs&quot;&gt;\n\n  &lt;!-- ===== EPF ===== --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; checked=&quot;checked&quot; id=&quot;tab1&quot; /&gt;\n    &lt;label for=&quot;tab1&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-building-columns&quot;&gt;&lt;/i&gt; EPF\n    &lt;/label&gt;\n    &lt;div id=&quot;tab-content1&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/StatutoryComponentsEPF?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ===== ESI ===== --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab2&quot; /&gt;\n    &lt;label for=&quot;tab2&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-hospital&quot;&gt;&lt;/i&gt; ESI\n    &lt;/label&gt;\n    &lt;div id=&quot;tab-content2&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Statutory_Components_Esi_Report?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ===== PROFESSIONAL TAX ===== --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab3&quot; /&gt;\n    &lt;label for=&quot;tab3&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-file-invoice-dollar&quot;&gt;&lt;/i&gt; PROFESSIONAL TAX\n    &lt;/label&gt;\n    &lt;div id=&quot;tab-content3&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Statutory_Components_Professional_Tax_Report?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ===== LWF ===== --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab4&quot; /&gt;\n    &lt;label for=&quot;tab4&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-hand-holding-heart&quot;&gt;&lt;/i&gt; LWF\n    &lt;/label&gt;\n    &lt;div id=&quot;tab-content4&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Statutory_Components_Labour_Welfare_Fund_Report?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n  &lt;!-- ===== BONUS ===== --&gt;\n  &lt;li class=&quot;tab&quot;&gt;\n    &lt;input type=&quot;radio&quot; name=&quot;tabs&quot; id=&quot;tab5&quot; /&gt;\n    &lt;label for=&quot;tab5&quot;&gt;\n      &lt;i class=&quot;fa-solid fa-gift&quot;&gt;&lt;/i&gt; BONUS\n    &lt;/label&gt;\n    &lt;div id=&quot;tab-content5&quot; class=&quot;content&quot;&gt;\n      &lt;iframe\n        src=&quot;https://creatorapp.zoho.in&lt;%=zoho.appuri%&gt;report-embed/Statutory_Components_Bonus_Report?zc_Header=false&quot;&gt;\n      &lt;/iframe&gt;\n    &lt;/div&gt;\n  &lt;/li&gt;\n\n&lt;/ul&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
