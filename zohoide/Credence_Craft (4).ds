				type = picklist	
				values  = User.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 4
	 			column = 2   
				width = medium
			)
			Pick_List_Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Requested","Partially Requested","Fully Requested"}
				initial value = "Not Requested"
	 			row = 4
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
