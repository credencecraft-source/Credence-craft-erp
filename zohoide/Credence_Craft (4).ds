				 void createProcessOperationTemplates()
                 {
                 	processList = List();
                 	processList.add("Cutting");
                 	processList.add("Parts");
                 	processList.add("Assembly");
                 	processList.add("KajaButtoning");
                 	processList.add("Finishing");
                 	processList.add("Embroidery");
                 	processList.add("Washing");
                 	for each  pName in processList
                 	{
                 		// CREATE PROCESS
                 		proc = Process_Master[Process_Name == pName];
                 		if(proc.count() == 0)
                 		{
                 			insert into Process_Master
                 			[
                 				Process_Name=pName
                 				Added_User=zoho.loginuser
                 			]
                 			proc = Process_Master[Process_Name == pName];
                 		}
                 		procId = proc.ID;
                 		// CREATE OPERATION
                 		opName = pName + " Basic";
                 		op = Operation[Name == opName];
                 		if(op.count() == 0)
                 		{
                 			insert into Operation
                 			[
                 				Name=opName
                 				Process_Master=procId
                 				Price_Type="Fixed"
                 				Is_Mandatory=false
                 				Added_User=zoho.loginuser
                 			]
                 			op = Operation[Name == opName];
                 		}
                 		opId = op.ID;
                 		// CREATE OPERATION TEMPLATE
                 		temp = Operation_Template[Operation_Template_Name == opName];
                 		if(temp.count() == 0)
                 		{
                 			opIds = List();
                 			opIds.add(opId);
                 			insert into Operation_Template
                 			[
                 				Operation_Template_Name=opName
                 				Process_Master=procId
                 				Operation1=opIds
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 	}
                 }
				 void createQuotationFromForwardBooking(Forword_Booking bookings)
                 {
                 	if(bookings == null || bookings.count() == 0)
                 	{
                 		info "Select Booking";
                 		return;
                 	}
                 	// ✅ VALIDATION (Customer + User same + Status not Created)
                 	firstRec = null;
                 	for each  rec in bookings
                 	{
                 		firstRec = rec;
                 		break;
                 	}
                 	for each  rec in bookings
                 	{
                 		if(rec.Customer_Name != firstRec.Customer_Name || rec.User != firstRec.User)
                 		{
                 			info "All selected records must have same Customer and User";
                 			return;
                 		}
                 		if(rec.Status == "Created")
                 		{
                 			info "One or more selected records already Created";
                 			return;
                 		}
                 	}
                 	totalAmt = 0;
                 	totalQty = 0;
                 	// create header
                 	quoId = insert into Quotation1
                 	[
                 		Total=0
                 		Total_Qty=0
                 		Customer_Name=firstRec.Customer_Name.ID
                 		Email=firstRec.Customer_Name.Email
                 		User=firstRec.User
                 		Entity_Name=firstRec.Entity_Name
                 		Added_User=zoho.loginuser
                 	];
                 	quo = Quotation1[ID == quoId];
                 	for each  rec in bookings
                 	{
                 		qty = ifnull(rec.Booked,0);
                 		price = ifnull(rec.Price,0);
                 		amt = qty * price;
                 		totalQty = totalQty + qty;
                 		totalAmt = totalAmt + amt;
                 		sizeText = "";
                 		for each  s in rec.SubForm
                 		{
                 			if(s.Size != null && s.Booked != null)
                 			{
                 				line = s.Size.Size + " - " + s.Booked;
                 				if(sizeText == "")
                 				{
                 					sizeText = line;
                 				}
                 				else
                 				{
                 					sizeText = sizeText + ", " + line;
                 				}
                 			}
                 		}
                 		insert into Quoation_Subform
                 		[
                 			Quoation=quo
                 			Order_No1=rec.Order_No
                 			Style_No=rec.Style_Name
                 			Colors=rec.Colors
                 			Qty=qty
                 			Size=sizeText
                 			Price=price
                 			Total=amt
                 			Forword_Booking=rec.ID
                 			Added_User=zoho.loginuser
                 		]
                 	}
                 	if(quo != null)
                 	{
                 		update Quotation1[ID == quo.ID]
                 		[
                 			Total=totalAmt
                 			Total_Qty=totalQty
                 		];
                 	}
                 	for each  rec in bookings
                 	{
                 		update Forword_Booking[ID == rec.ID]
                 		[
                 			Status="Created"
                 		];
                 	}
                 	info "Done";
                 }
				 void Create_All_GST_States()
                 {
                 	states_list = {"Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"};
                 	for each  state_name in states_list
                 	{
                 		existing = customer_s_registered_Gst_State[customer_s_registered_Gst_State == state_name];
                 		if(existing.count() == 0)
                 		{
                 			insert into customer_s_registered_Gst_State
                 			[
                 				customer_s_registered_Gst_State=state_name
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 	}
                 }
				 void create_bill(Gate_Entry get_all_get_entry)
                 {
                 	// Check if any GRN item missing invoice qty or price
                 	get_grn_subform = Gate_Entry_Subform[Gate_Entry_No1 == get_all_get_entry.ID.getall() && Invoice_Qty == null || Invoice_Price1 == null];
                 	// Validation: Multiple PO types
                 	if((get_all_get_entry.Po_Number.Po_Type.getall()).tolist().distinct().size() > 1)
                 	{
                 		openUrl("#Page:GRN_Validate_Page?alert_variable=true","popup window");
                 	}
                 	// Validation: Multiple vendors
                 	else if((get_all_get_entry.Vendor1.getall()).tolist().distinct().size() > 1)
                 	{
                 		openUrl("#Page:GRN_Validate_Page?alert_variable=false","popup window");
                 	}
                 	// Validation: Missing Invoice Qty / Price
                 	else if(get_grn_subform.ID != null)
                 	{
                 		get_all_grn_number = Gate_Entry[ID == get_grn_subform.Gate_Entry_No1.getall()].GRN_No.getAll();
                 		openUrl("#Page:GRN_Validate_Page?alert_variable=Invoice-Qty&dyanmic_value=" + get_all_grn_number.tolist().distinct(),"popup window");
                 	}
                 	else
                 	{
                 		// OPEN PURCHASE BILL — PASSING Gate_Entry + Source = Gate Entry
                 		openUrl("#Form:Purchase_Bill?Gate_Entry=" + (get_all_get_entry.ID.getall()).tolist().distinct() + "&Source=Gate Entry","popup window","height=100%,width=100%");
                 	}
                 }
				 void create_dc(Process_Bundle_Movement recs)
                 {
                 	// ===============================
                 	// SAFETY CHECK
                 	// ===============================
                 	if(recs == null || recs.count() == 0)
                 	{
                 		info "Select at least one Bundle Movement";
                 		return;
                 	}
                 	// ===============================
                 	// VALIDATION
                 	// ===============================
                 	for each  rec in recs
                 	{
                 		if(rec.Delivery_Challan != null)
                 		{
                 			info "Some records already have Delivery Challan";
                 			return;
                 		}
                 	}
                 	// ===============================
                 	// GET FIRST RECORD
                 	// ===============================
                 	firstRec = null;
                 	for each  rec in recs
                 	{
                 		firstRec = rec;
                 		break;
                 	}
                 	// ===============================
                 	// CREATE DC HEADER
                 	// ===============================
                 	createDC = insert into GRN_Delivery
                 	[
                 		Vendors1=firstRec.Vendor1
                 		Date_field=zoho.currentdate
                 		Is_this_Returnable=true
                 		Source="Job Order"
                 		Added_User=zoho.loginuser
                 	];
                 	// ===============================
                 	// LOOP SELECTED RECORDS
                 	// ===============================
                 	for each  rec in recs
                 	{
                 		for each  bun in rec.Operation_Wise_Bundles
                 		{
                 			item_text = "";
                 			if(bun.Order_No != null)
                 			{
                 				item_text = item_text + bun.Order_No.Order_No;
                 			}
                 			if(bun.Style_No != null)
                 			{
                 				item_text = item_text + " | " + bun.Style_No;
                 			}
                 			if(bun.Bundles_To != null)
                 			{
                 				item_text = item_text + " | " + bun.Bundles_To.Process_Name;
                 			}
                 			insert into Delivery_Challan_Subform
                 			[
                 				Delivery_Challan=createDC
                 				Process_Bundle_Movement1=rec.ID
                 				Item=item_text
                 				Requested_Qty=ifnull(bun.Issued,0)
                 				Price=ifnull(bun.Price,0)
                 				Added_User=zoho.loginuser
                 			]
                 		}
                 		rec.Delivery_Challan=createDC;
                 		// ===============================
                 		// CREATE GRN
                 		// ===============================
                 		insert into Process_Bundle_GRN
                 		[
                 			Bundle_Transfer_No=rec.ID
                 			Work_Order_New=rec.Work_Order_New
                 			Create_Order=rec.Order_No
                 			Received_Qty=rec.Issued
                 			From=rec.From
                 			To=rec.To
                 			Batch=rec.Batch
                 			Received_Date=zoho.currenttime
                 			Bundle_Receaved_user_email1=zoho.loginuserid
                 			Added_User=zoho.loginuser
                 		]
                 		grnQty = ifnull(rec.Issued,0);
                 		rec.GRN_Qty=ifnull(rec.GRN_Qty,0) + grnQty;
                 		// ===============================
                 		// UPDATE OUTPUT
                 		// ===============================
                 		if(rec.From != null && rec.From != rec.To)
                 		{
                 			woFromList = Wo_Making_Charges[Work_Order == rec.Work_Order_New && Process_Name.ID == rec.From.ID];
                 			for each  woRec1 in woFromList
                 			{
                 				woRec1.Out_Put=ifnull(woRec1.Out_Put,0) + grnQty;
                 				thisapp.updateWOProcessStatusByQty(woRec1.ID);
                 			}
                 		}
                 		// ===============================
                 		// UPDATE INPUT
                 		// ===============================
                 		woToList = Wo_Making_Charges[Work_Order == rec.Work_Order_New && Process_Name.ID == rec.To.ID];
                 		for each  woRec2 in woToList
                 		{
                 			woRec2.In_Put=ifnull(woRec2.In_Put,0) + grnQty;
                 			thisapp.updateWOProcessStatusByQty(woRec2.ID);
                 		}
                 		// ===============================
                 		// ORDER SYNC
                 		// ===============================
                 		thisapp.syncWOToOrder(rec.Order_No.ID);
                 	}
                 }
				 void Create_Default_GST_Types()
                 {
                 	gst_list = {"CGST & SGST","IGST"};
                 	for each  gst_name in gst_list
                 	{
                 		existing = GST_TYPE[gst_type == gst_name];
                 		if(existing.count() == 0)
                 		{
                 			insert into GST_TYPE
                 			[
                 				Added_User=zoho.loginuser
                 				gst_type=gst_name
                 			]
                 		}
                 	}
                 }
