			Size_wise_fob as "Size wise fob"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on user input of Finished_Goods_Size_wise.Price_In_INR
				{
					actions 
					{
						custom deluge script
						(
											// --- Calculate row Value ---
										if(row.Total_Qty != null && row.Price_In_INR != null)
										{
											row.Value=row.Price_In_INR * row.Total_Qty;
										}
										else
										{
											row.Value=0;
										}
										// --- Calculate header-level Order Qty and Order Value ---
										sum_order_qty = 0;
										sum_order_value = 0;
										for each  each_row in input.Finished_Goods_Size_wise
										{
											sum_order_qty = sum_order_qty + ifnull(each_row.Total_Qty,0);
											sum_order_value = sum_order_value + ifnull(each_row.Value,0);
										}
										input.Order_Qty = sum_order_qty;
										input.Order_Value = sum_order_value;
										// --- Calculate header-level FOB ---
										if(input.Order_Qty != null && input.Order_Qty != 0)
										{
											input.Fob = input.Order_Value / input.Order_Qty;
										}
										else
										{
											input.Fob = 0;
										}
						)
					}
				}

			}
