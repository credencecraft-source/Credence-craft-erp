		form Work_Order_New
		{
			success message = "Work Order Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Create_Order
			(
				type = picklist	
				values  = Create_Order[Work_Order_Status != "Fully Created"].ID
    			displayformat = [Order_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Stage
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
