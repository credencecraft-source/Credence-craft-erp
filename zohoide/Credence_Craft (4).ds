			on_submi as "on submi"
			{
				type =  form
				form = Purchase_Bill

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// ===== AUTO COPY HEADER → SUBFORM (ON SUBMIT) =====
										for each  row in input.Bills
										{
											// Expense Month (LOOKUP)
											if(Expense_For_The_Month_of != null)
											{
												row.Expence_For_the_Month_of=input.Expense_For_The_Month_of;
											}
											// Year (LOOKUP)
											if(Year_form != null)
											{
												row.Year_form=input.Year_form;
											}
											// Source (DROPDOWN)
											if(Source != null)
											{
												row.Source=input.Source;
											}
											// Vendor (LOOKUP)
											if(Vendor1 != null)
											{
												row.Vendor1=input.Vendor1;
											}
											// Bill Date (DATE)
											if(Bill_Date != null)
											{
												row.Bill_Date=input.Bill_Date;
											}
											// Invoice No (SINGLE LINE)
											if(Invoice_No != null)
											{
												row.Invoice_no=input.Invoice_No;
											}
											// Invoice Date (DATE)
											if(Invoice_Date != null)
											{
												row.Invoice_Date=input.Invoice_Date;
											}
										}
						)
					}
				}

			}
			Subscription_Validation5 as "Subscription Validation"
			{
				type =  form
				form = Create_Order

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Subscription Validation (Simple Plan Check)
										plan_record = Pricing[Plan_Features != null];
										// adjust filter if you have Active field
										if(plan_record.count() > 0)
										{
											for each  p in plan_record
											{
												if(p.Count_field >= p.Maximum)
												{
													alert "You have reached your plan limit. Please upgrade your plan!";
													cancel submit;
												}
											}
										}
										else
										{
											alert "No active subscription plan found!";
											cancel submit;
										}
						)
					}
				}

			}
			Subscription_Validation6 as "Subscription Validation"
			{
				type =  form
				form = Quotation1

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Get current month and year
										current_year = year(zoho.currentdate);
										current_month = month(zoho.currentdate);
										// Fetch the Pricing record for current month and year
										pricing_records = Pricing[Year_field == current_year && Month_field == current_month];
										if(pricing_records.count() > 0)
										{
											for each  p in pricing_records
											{
												// Check if total count exceeds Maximum
												if(p.Count_field >= p.Maximum)
												{
													alert "You are reaching your limit, please upgrade your plan!";
													cancel submit;
													// stops form submission safely
												}
											}
										}
										else
										{
											alert "No Pricing record found for current month/year!";
											cancel submit;
											// stops form submission safely
										}
						)
					}
				}

			}
			On_load15 as "On load"
			{
				type =  form
				form = Payout

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// =====================================
										// PAYOUT – ON LOAD (HR + PURCHASE BILL)
										// =====================================
										// ================================
										// FORCE BIND LOOKUPS FROM URL
										// ================================
										if(input.ID == null)
										{
											if(input.Payroll != null && input.Payroll.size() > 0)
											{
												input.Payroll = input.Payroll;
												// ? VERY IMPORTANT (Zoho binding fix)
											}
											if(input.Purchase_Bill != null && input.Purchase_Bill.size() > 0)
											{
												input.Purchase_Bill = input.Purchase_Bill;
											}
											// ================================
											// RESET OLD LINES
											// ================================
											clear Payout_Lines;
											rows = Collection();
											totalAmt = 0;
											// ================================
											// HR / PAYROLL FLOW
											// ================================
											if(input.Source == "Hr" && input.Payroll != null && input.Payroll.size() > 0)
											{
												for each  p in input.Payroll
												{
													row = Payout.Payout_Lines();
													// Reference to Payroll
													row.Reference_No=p.Payroll_No;
													row.Reference_ID=p.ID.toString();
													// Real Employee Number
													if(p.Employee_Id != null)
													{
														empRec = Employee_Name[ID == p.Employee_Id];
														if(empRec.ID != null)
														{
															row.Refrence_No_2=empRec.Employee_No;
														}
													}
													// Amount = balance still to be requested
													amt = ifnull(p.Balanace_to_be_Requested,0);
													row.Requested=amt;
													// Payee & Bank
													if(p.Employee_Name != null)
													{
														row.Pay_to=p.Employee_Name.Name;
														bank = Bank_Account_Number[Employee_Name == p.Employee_Name];
														if(bank.ID != null)
														{
															row.Account_No=bank.Account_No;
															row.IFSC=bank.Ifsc;
														}
													}
													rows.insert(row);
													totalAmt = totalAmt + amt;
												}
											}
											// ================================
											// PURCHASE BILL FLOW
											// ================================
											else if(input.Source == "Purchase bill" && input.Purchase_Bill != null && input.Purchase_Bill.size() > 0)
											{
												for each  pb in input.Purchase_Bill
												{
													row = Payout.Payout_Lines();
													row.Reference_No=pb.Bill_No;
													row.Reference_ID=pb.ID.toString();
													amt = ifnull(pb.Balance_to_be_Requested,0);
													row.Requested=amt;
													if(pb.Vendor1 != null)
													{
														row.Pay_to=pb.Vendor1.Vendor_Name;
														bank = Bank_Account_Number[Vendor1 == pb.Vendor1];
														if(bank.ID != null)
														{
															row.Account_No=bank.Account_No;
															row.IFSC=bank.Ifsc;
														}
													}
													rows.insert(row);
													totalAmt = totalAmt + amt;
												}
											}
											// ================================
											// FINAL INSERT
											// ================================
											if(rows.size() > 0)
											{
												input.Payout_Lines.insert(rows);
												input.Total_Amount = totalAmt;
												input.Count_field = rows.size();
											}
										}
						)
					}
				}

			}
