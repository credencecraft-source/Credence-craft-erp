			Import_from_other_contry as "Import from other contry"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Import_From_Other_Country
				{
					actions 
					{
						custom deluge script
						(
											// Vendor Price INR always disabled
										disable Vendor_Price_INR;
										// Import Price always enabled
										enable Vendor_Price;
										if(input.Import_From_Other_Country == true)
										{
											show Currency;
											show Exchange_Price;
											enable Currency;
											enable Exchange_Price;
										}
										else
										{
											hide Currency;
											hide Exchange_Price;
											input.Exchange_Price = 1;
										}
						)
					}
				}

			}
			import_price as "import price"
			{
				type =  form
				form = Master_Group

				record event = on add or edit

				on user input of Vendor_Price
				{
