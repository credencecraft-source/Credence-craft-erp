			Buyer_Consumption_in_Appr as "Buyer Consumption in Approve Internal Consumption"
			{
				type =  form
				form = Approve_internal_consumption_and_price

				record event = on add or edit

				on user input of Approve_Consumption_and_price.Internal_Consumption
				{
					actions 
					{
						custom deluge script
						(
											enable Validate_Internal_Consumption;
										if(row.Internal_Consumption < 0)
										{
											alert "Please enter the valid Buyer Consumption..!";
											row.Internal_Consumption=null;
										}
										else
										{
											validation_falg = false;
											for each  each_item in input.Approve_Consumption_and_price
											{
												if(each_item.Internal_Consumption == null || each_item.Internal_Consumption == 0)
												{
													validation_falg = true;
												}
											}
											if(input.Validate_Internal_Consumption == true)
											{
												// 		get_all_order_internal_consumption = Order_Raw_material[Raw_Material_Name == input.Raw_Material1].Internal_Consumption.getAll();
												// 		get_all_order_internal_consumption.removeElement(null);
												// 		get_all_order_internal_consumption.add(row.Buyer_Consumption1);
												// 		if(get_all_order_internal_consumption.tolist().distinct().size() > 1)
												// 		{
												// 			row.Internal_Consumption="Better Consumption Available";
												// 		}
												// 		else
												// 		{
												// 			row.Internal_Consumption="Yes";
												// 		}
												get_all_order_internal_consumption = Order_Raw_material[Raw_Material_Name == input.Raw_Material && Gold_Seal == row.Gold_Seal && Order_No != input.Order_No && Internal_Consumption < row.Internal_Consumption && Internal_Consumption_Status == "Approved"];
												if(get_all_order_internal_consumption.ID != null)
												{
													row.Internal_Best_Consumption="Better Consumption Available";
												}
												else
												{
													row.Internal_Best_Consumption="Yes";
												}
												if(validation_falg = true)
												{
													disable Validate_Internal_Consumption;
													input.Validate_Internal_Consumption = false;
												}
											}
											else
											{
												if(validation_falg = true)
												{
													disable Validate_Internal_Consumption;
												}
											}
										}
						)
					}
				}

			}
