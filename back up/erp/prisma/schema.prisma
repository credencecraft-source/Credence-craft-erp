generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  profileName     String?           @unique
  passwordHash    String?
  isActive        Boolean           @default(true)
  isPlatformAdmin Boolean           @default(false)
  profileSettings Json?             @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     OrganizationUser[]
  moduleAccess    ModuleAccess[]
  createdOrganizations Organization[] @relation("OrganizationCreator")
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  otpRequests     OtpRequest[]
}

model BackendAdmin {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  passwordHash String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organizations Organization[]
}

model Role {
  id                    String            @id @default(cuid())
  organizationId        String?
  name                  String
  isSuperAdmin          Boolean           @default(false)
  canManageUsers        Boolean           @default(false)
  canManageSubscriptions Boolean          @default(false)
  canManageBackups      Boolean           @default(false)
  modulePermissions     Json?             @default("{}")
  tablePermissions      Json?             @default("{}")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships           OrganizationUser[]

  @@unique([organizationId, name])
}

model Organization {
  id          String            @id @default(cuid())
  workspaceId String?
  name        String
  shortCode   String?           @unique
  businessType String?
  location    String?
  status      String            @default("Active")
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator     User?             @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  memberships OrganizationUser[]
  subscriptions Subscription[]
  backups     BackupRecord[]
  roles       Role[]
  modules     ModuleDefinition[]
  auditLogs   AuditLog[]
  tenants     Tenant[]
  vendors     Vendor[]
  orders      Order[]
}

model OrganizationUser {
  id            String      @id @default(cuid())
  userId        String
  organizationId String
  roleId        String?
  isOwner       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, isOwner])
}

model Subscription {
  id             String      @id @default(cuid())
  organizationId String
  moduleName     String
  yearlyAmount   Float       @default(0)
  usersIncluded  Int         @default(5)
  extraUserPrice Float       @default(1000)
  billingCycle   String      @default("yearly")
  status         String      @default("active")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BackupRecord {
  id            String      @id @default(cuid())
  organizationId String
  label         String
  fileName      String?
  backupType    String      @default("manual")
  status        String      @default("completed")
  sizeInBytes   Int?        @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OtpRequest {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  otpCode    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model Tenant {
  id                   String          @id @default(cuid())
  organizationId       String
  name                 String
  logoUrl              String?
  gstRegisteredStateId String?
  gstNumber            String?
  email                String?
  phone                String?
  displayName          String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  latitude             Float?
  longitude            Float?
  flagField1           Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gstFetchUsages       GstFetchUsage[]
  gstRegisteredState   GstState?       @relation(fields: [gstRegisteredStateId], references: [id])
  vendors              Vendor[]
  orders              Order[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Vendor {
  id                   String    @id @default(cuid())
  organizationId       String
  tenantId             String
  gstNumber            String?
  currencyType         String    @default("INR")
  gstType              String?
  registeredGstStateId String?
  vendorName           String
  isThisCustomer       Boolean   @default(false)
  city                 String?
  addressLine1         String?
  addressLine2         String?
  stateProvince        String?
  postalCode           String?
  country              String?
  latitude             Float?
  longitude            Float?
  vendorSupportNo      Int       @default(0)
  zohoBooksVendorId    String?
  status               String    @default("Draft")
  fetchCount           Int       @default(0)
  fetchDate            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registeredGstState   GstState? @relation(fields: [registeredGstStateId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, vendorName])
  @@index([organizationId])
  @@index([tenantId])
}

model GstState {
  id      String   @id @default(cuid())
  name    String   @unique
  tenants Tenant[]
  vendors Vendor[]
}

model GstFetchUsage {
  id         String   @id @default(cuid())
  tenantId   String
  dateKey    String
  fetchCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateKey])
}

model Order {
  id                    String      @id @default(cuid())
  organizationId        String
  tenantId              String?
  entityName            String?
  category              String?
  subCategory           String?
  season                String?
  article               String?
  styleName             String?
  colors                String?
  buyer                 String?
  brand                 String?
  sizeGroup             String?
  typeField             String?     @default("Direct")
  fob                   Float?      @default(0)
  orderQty              Float?      @default(0)
  orderQtyWithoutExcess  Float?      @default(0)
  orderValue            Float?      @default(0)
  deliveryDate          DateTime?
  buyerPoDate           DateTime?
  buyerPoNo             String?
  merchandiser          String?
  orderVolume           String?     @default("Medium")
  gst                   String?
  hsnCode               String?
  sourceImportId        String?
  remarks               String?
  status                String      @default("Draft")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant                Tenant?     @relation(fields: [tenantId], references: [id])
  orderItems            OrderItem[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([buyer])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  size           String
  beforeExcessQty Float    @default(0)
  excess         Float    @default(0)
  excessQty      Float    @default(0)
  totalQty       Float    @default(0)
  buyerPoPrice   Float    @default(0)
  value          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ModuleDefinition {
  id              String               @id @default(cuid())
  organizationId   String
  parentModuleId  String?
  name            String
  slug            String
  description     String?
  isEnabled       Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentModule    ModuleDefinition?    @relation("ModuleHierarchy", fields: [parentModuleId], references: [id], onDelete: Cascade)
  childModules    ModuleDefinition[]   @relation("ModuleHierarchy")
  moduleAccesses  ModuleAccess[]       @relation("ModuleAccessModule")
  submoduleAccess ModuleAccess[]       @relation("ModuleAccessSubmodule")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentModuleId])
}

model ModuleAccess {
  id            String          @id @default(cuid())
  organizationId String
  userId        String
  moduleId      String?
  submoduleId   String?
  canRead       Boolean         @default(true)
  canWrite      Boolean         @default(false)
  canDelete     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        ModuleDefinition? @relation("ModuleAccessModule", fields: [moduleId], references: [id], onDelete: Cascade)
  submodule     ModuleDefinition? @relation("ModuleAccessSubmodule", fields: [submoduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, moduleId, submoduleId])
  @@index([organizationId, userId])
}

model AuditLog {
  id            String      @id @default(cuid())
  organizationId String?
  userId        String?
  action        String
  entityType    String?
  entityId      String?
  details       Json?
  createdAt     DateTime    @default(now())
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
