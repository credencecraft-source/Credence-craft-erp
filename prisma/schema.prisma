  raw_material_sub_category MasterRawMaterialSubCategory @relation("RawMaterialSubCategoryToRawMaterial", fields: [raw_material_sub_category_id], references: [id])
  stock_uom MasterUom @relation(fields: [stock_uom_id], references: [id])
