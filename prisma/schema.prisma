}

model MasterRawMaterialCategory {
  id String @id @default(cuid())
  value_id String @unique @default(uuid())
  organization_id String
  raw_material_type_id String?
  raw_material_category String @db.VarChar(255)
  is_active Boolean @default(false)
  sort_order Int @default(0)
  legacy_metadata Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  raw_material_type MasterRawMaterialType? @relation(fields: [raw_material_type_id], references: [id])
  sub_categories MasterRawMaterialSubCategory[]
  raw_materials MasterRawMaterial[] @relation("RawMaterialCategoryToRawMaterial")
  @@unique([organization_id, raw_material_category])
  @@index([organization_id, is_active])
  @@map("master_raw_material_categories")
}

model MasterRawMaterialSubCategory {
