  raw_material_name String @db.VarChar(255)
  raw_material_category_id String
  raw_material_sub_category_id String
  stock_uom_id String
  raw_material_type_id String?
  is_specific_for_brand Boolean @default(false)
  size_wise_consumption Boolean @default(false)
  size_wise_consumption_id String?
  brand_id String?
  show_all Boolean @default(false)
  workdrive_image_id String?
  buyer_item_code String?
  image_url String?
  item_code String?
  colour_id String?
  create_open_stock String?
  open_stock Decimal? @db.Decimal(12,2)
  open_stock_price Decimal? @db.Decimal(12,2)
  vendor_wise_price_list String?
  is_active Boolean @default(false)
  sort_order Int @default(0)
  legacy_metadata Json?
  created_at DateTime @default(now())
