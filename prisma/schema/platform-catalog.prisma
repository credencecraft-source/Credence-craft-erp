model Segment {
  id                         String                       @id @default(uuid())
  name                       String                       @unique @db.VarChar(100)
  description                String?                      @db.VarChar(500)
  sort_order                 Int                          @default(0)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime                     @updatedAt
  versionBusinessTypeSegments VersionBusinessTypeSegment[]
  versionTransactionRestrictions VersionTransactionRestriction[]

  @@index([is_active])
  @@map("segments")
}

enum PlatformVersionType {
  BEST_PRICE
  REGULAR_PRICE
  PREMIUM

  @@map("platform_version_type")
}

model PlatformVersion {
  id               String                @id @default(uuid())
  version_name     String                @unique @db.VarChar(100)
  version_type     PlatformVersionType   @default(REGULAR_PRICE)
  description      String?               @db.VarChar(500)
  is_active        Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  businessTypes    VersionBusinessType[]
  organizations    Organization[]
  transactionRestrictions VersionTransactionRestriction[]

  @@index([is_active])
  @@map("platform_versions")
}

model VersionBusinessType {
  id                String                       @id @default(cuid())
  version_id        String
  business_type_id  String
  is_free           Boolean                      @default(false)
  created_at        DateTime                     @default(now())
  version           PlatformVersion              @relation(fields: [version_id], references: [id], onDelete: Cascade)
  businessType      BusinessType                 @relation(fields: [business_type_id], references: [id], onDelete: Cascade)
  segments          VersionBusinessTypeSegment[]
  tags              VersionBusinessTypeTag[]

  @@unique([version_id, business_type_id])
  @@index([business_type_id])
  @@map("version_business_types")
}

model PlatformTag {
  id                     String                   @id @default(cuid())
  label                  String                   @unique @db.VarChar(100)
  is_active              Boolean                  @default(true)
  sort_order             Int                      @default(0)
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  versionBusinessTypes   VersionBusinessTypeTag[]

  @@index([is_active, sort_order])
  @@map("platform_tags")
}

model VersionBusinessTypeSegment {
  id                       String              @id @default(cuid())
  version_business_type_id String
  segment_id               String
  is_active                Boolean             @default(true)
  created_at               DateTime            @default(now())
  label                    String?             @db.VarChar(100)
  price                    Decimal?            @db.Decimal(12, 2)
  versionBusinessType      VersionBusinessType @relation(fields: [version_business_type_id], references: [id], onDelete: Cascade)
  segment                 Segment             @relation(fields: [segment_id], references: [id], onDelete: Cascade)
  restrictions            SegmentRestriction[]
  formRestrictions        SegmentFormRestriction[]
  locationLimit           VersionBusinessTypeSegmentLocationLimit?
  tags                    VersionBusinessTypeSegmentTag[]
  organizationPrices      OrganizationSegmentPrice[]

  @@unique([version_business_type_id, segment_id])
  @@index([segment_id])
  @@map("version_business_type_segments")
}

model OrganizationSegmentPrice {
  id                              String                     @id @default(cuid())
  organization_id                 String
  version_business_type_segment_id String
  snapshot_price                  Decimal?                   @db.Decimal(12, 2)
  custom_price                    Decimal?                   @db.Decimal(12, 2)
  updated_by_platform_admin_id    String?
  created_at                      DateTime                   @default(now())
  updated_at                      DateTime                   @updatedAt
  organization                    Organization               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versionBusinessTypeSegment      VersionBusinessTypeSegment @relation(fields: [version_business_type_segment_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, version_business_type_segment_id])
  @@index([organization_id, custom_price])
  @@index([version_business_type_segment_id])
  @@map("organization_segment_prices")
}

model VersionBusinessTypeSegmentLocationLimit {
  id                               String                     @id @default(cuid())
  version_business_type_segment_id String                     @unique
  max_locations                    Int
  created_at                       DateTime                   @default(now())
  updated_at                       DateTime                   @updatedAt
  assignment                       VersionBusinessTypeSegment @relation(fields: [version_business_type_segment_id], references: [id], onDelete: Cascade)

  @@map("version_business_type_segment_location_limits")
}

model VersionBusinessTypeTag {
  id                       String             @id @default(cuid())
  version_business_type_id String
  platform_tag_id          String
  created_at               DateTime           @default(now())
  versionBusinessType      VersionBusinessType @relation(fields: [version_business_type_id], references: [id], onDelete: Cascade)
  platformTag              PlatformTag         @relation(fields: [platform_tag_id], references: [id], onDelete: Restrict)

  @@unique([version_business_type_id, platform_tag_id])
  @@index([version_business_type_id])
  @@index([platform_tag_id])
  @@map("version_business_type_tags")
}

model VersionBusinessTypeSegmentTag {
  id                              String                       @id @default(cuid())
  version_business_type_segment_id String
  label                           String                       @db.VarChar(100)
  created_at                      DateTime                     @default(now())
  assignment                      VersionBusinessTypeSegment  @relation(fields: [version_business_type_segment_id], references: [id], onDelete: Cascade)

  @@unique([version_business_type_segment_id, label])
  @@index([version_business_type_segment_id])
  @@map("version_business_type_segment_tags")
}

model SegmentRestriction {
  restriction_id                 String                     @id @default(uuid())
  version_business_type_segment_id String
  master_module                  String
  main_module                    String
  sub_module                     String
  action_level                   String?
  url_pattern                    String?
  restriction_type               String                     @default("block")
  custom_message                 String?
  created_at                     DateTime                   @default(now())
  versionBusinessTypeSegment     VersionBusinessTypeSegment @relation(fields: [version_business_type_segment_id], references: [id], onDelete: Cascade)

  @@index([version_business_type_segment_id, restriction_type])
  @@map("segment_restrictions")
}

model SegmentFormRestriction {
  restriction_id                 String                     @id @default(uuid())
  version_business_type_segment_id String
  form_key                       String                     @db.VarChar(150)
  monthly_qty_limit              Int?
  monthly_entry_limit            Int?
  restricted_fields              String[]                   @default([])
  field_sum_limits               Json                       @default("{}")
  created_at                     DateTime                   @default(now())
  updated_at                     DateTime                   @updatedAt
  versionBusinessTypeSegment     VersionBusinessTypeSegment @relation(fields: [version_business_type_segment_id], references: [id], onDelete: Cascade)

  @@unique([version_business_type_segment_id, form_key])
  @@index([version_business_type_segment_id])
  @@map("segment_form_restrictions")
}

model VersionTransactionRestriction {
  restriction_id  String         @id @default(uuid())
  version_id      String
  segment_id      String
  form_key        String         @db.VarChar(150)
  monthly_entry_limit Int?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  version         PlatformVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  segment         Segment        @relation(fields: [segment_id], references: [id], onDelete: Cascade)

  @@unique([version_id, segment_id, form_key])
  @@index([version_id, segment_id])
  @@map("version_transaction_restrictions")
}
