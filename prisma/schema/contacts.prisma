enum ContactAddressUsage {
  BILLING
  SHIPPING
  BOTH
}

enum ContactTaxRegistrationType {
  REGULAR
  COMPOSITION
  SEZ_DEVELOPER
  SEZ_UNIT
  INPUT_SERVICE_DISTRIBUTOR
  TAX_DEDUCTOR
  TAX_COLLECTOR
  NON_RESIDENT
  OIDAR
  OTHER
}

enum ContactTaxRegistrationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Contact {
  id              String   @id @default(cuid())
  organization_id String
  code            String   @db.VarChar(40)
  legal_name      String   @db.VarChar(200)
  display_name    String?  @db.VarChar(200)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(40)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization           Organization                         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  roles                  ContactRoleAssignment[]
  tax_registrations      ContactTaxRegistration[]
  addresses              ContactAddress[]
  bank_accounts          ContactBankAccount[]
  purchase_orders        PurchaseOrder[]
  sales_orders           MerchandisingOrder[]
  legacy_vendors         MasterVendor[]
  legacy_buyers          MasterBuyer[]
  price_list_assignments PriceListContactAssignment[]
  distributor_mappings   ContactDistributorDealerAssignment[] @relation("DistributorContact")
  dealer_mappings        ContactDistributorDealerAssignment[] @relation("DealerContact")
  role_parent_mappings   ContactRoleMapping[]                 @relation("RoleMappingParent")
  role_mapped_contacts   ContactRoleMapping[]                 @relation("RoleMappingContact")

  @@unique([organization_id, id])
  @@unique([organization_id, code])
  @@index([organization_id, legal_name])
  @@index([organization_id, is_active, display_name])
  @@map("contacts")
}

model PriceListContactAssignment {
  id                  String   @id @default(cuid())
  organization_id     String
  price_list_value_id String   @map("sales_channel_value_id")
  contact_id          String
  created_at          DateTime @default(now())

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade, map: "scca_organization_fkey")
  price_list   MasterModuleValue @relation(fields: [price_list_value_id], references: [id], onDelete: Cascade, map: "scca_sales_channel_value_fkey")
  contact      Contact           @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade, map: "scca_organization_contact_fkey")

  @@unique([organization_id, price_list_value_id, contact_id], map: "scca_organization_channel_contact_key")
  @@index([organization_id, price_list_value_id, created_at], map: "scca_organization_channel_created_idx")
  @@index([organization_id, contact_id], map: "scca_organization_contact_idx")
  @@map("sales_channel_contact_assignments")
}

model ContactCodeCounter {
  organization_id String       @id
  current_value   Int          @default(0)
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("contact_code_counters")
}

model ContactRoleDefinition {
  code        String                  @id @db.VarChar(40)
  label       String                  @db.VarChar(100)
  is_active   Boolean                 @default(true)
  assignments ContactRoleAssignment[]

  @@map("contact_role_definitions")
}

model ContactRoleAssignment {
  organization_id String
  contact_id      String
  role_code       String   @db.VarChar(40)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  organization    Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact         Contact               @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  role            ContactRoleDefinition @relation(fields: [role_code], references: [code], onDelete: Restrict)
  purchase_orders PurchaseOrder[]
  sales_orders    MerchandisingOrder[]

  @@id([organization_id, contact_id, role_code])
  @@index([organization_id, role_code, is_active])
  @@map("contact_role_assignments")
}

model ContactDistributorDealerAssignment {
  id              String   @id @default(cuid())
  organization_id String
  distributor_id  String
  dealer_id       String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  distributor  Contact      @relation("DistributorContact", fields: [organization_id, distributor_id], references: [organization_id, id], onDelete: Cascade)
  dealer       Contact      @relation("DealerContact", fields: [organization_id, dealer_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, distributor_id, dealer_id])
  @@unique([organization_id, dealer_id], map: "contact_distributor_dealer_org_dealer_key")
  @@index([organization_id, distributor_id, created_at])
  @@index([organization_id, dealer_id])
  @@map("contact_distributor_dealer_assignments")
}

model ContactRoleMapping {
  id                    String   @id @default(cuid())
  organization_id       String
  parent_role_code      String   @db.VarChar(40)
  parent_contact_id     String
  mapped_contact_id     String
  commission_percentage Decimal  @default(0) @db.Decimal(5, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  parent_contact Contact      @relation("RoleMappingParent", fields: [organization_id, parent_contact_id], references: [organization_id, id], onDelete: Cascade)
  mapped_contact Contact      @relation("RoleMappingContact", fields: [organization_id, mapped_contact_id], references: [organization_id, id], onDelete: Cascade)

  @@unique([organization_id, parent_role_code, parent_contact_id, mapped_contact_id])
  @@unique([organization_id, parent_role_code, mapped_contact_id])
  @@index([organization_id, parent_role_code, parent_contact_id, created_at])
  @@map("contact_role_mappings")
}

model ContactTaxRegistration {
  id                String                       @id @default(cuid())
  organization_id   String
  contact_id        String
  gstin             String                       @db.VarChar(15)
  state_code        String                       @db.VarChar(2)
  legal_name        String                       @db.VarChar(200)
  registration_type ContactTaxRegistrationType   @default(REGULAR)
  status            ContactTaxRegistrationStatus @default(ACTIVE)
  verified_at       DateTime?
  created_at        DateTime                     @default(now())
  updated_at        DateTime                     @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      Contact          @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  addresses    ContactAddress[]

  @@unique([organization_id, gstin])
  @@unique([organization_id, contact_id, id])
  @@index([organization_id, contact_id, status])
  @@map("contact_tax_registrations")
}

model ContactAddress {
  id                  String              @id @default(cuid())
  organization_id     String
  contact_id          String
  tax_registration_id String?
  label               String?             @db.VarChar(80)
  usage               ContactAddressUsage
  address_line_1      String              @db.VarChar(200)
  address_line_2      String?             @db.VarChar(200)
  city                String              @db.VarChar(100)
  state_name          String              @db.VarChar(100)
  state_code          String?             @db.VarChar(2)
  postal_code         String              @db.VarChar(20)
  country_code        String              @default("IN") @db.Char(2)
  is_default_billing  Boolean             @default(false)
  is_default_shipping Boolean             @default(false)
  is_active           Boolean             @default(true)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  organization     Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact          Contact                 @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  tax_registration ContactTaxRegistration? @relation(fields: [organization_id, contact_id, tax_registration_id], references: [organization_id, contact_id, id], onDelete: Restrict)

  @@index([organization_id, contact_id, usage, is_active])
  @@index([organization_id, tax_registration_id])
  @@map("contact_addresses")
}

model ContactBankAccount {
  id                       String   @id @default(cuid())
  organization_id          String
  contact_id               String
  account_holder_name      String   @db.VarChar(200)
  account_number_encrypted String   @db.Text
  account_number_last4     String   @db.Char(4)
  ifsc_code                String   @db.Char(11)
  bank_name                String   @db.VarChar(120)
  branch                   String?  @db.VarChar(120)
  is_default               Boolean  @default(false)
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)

  @@index([organization_id, contact_id, is_active])
  @@map("contact_bank_accounts")
}
