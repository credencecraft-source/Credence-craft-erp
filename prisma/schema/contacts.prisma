enum ContactAddressUsage {
  BILLING
  SHIPPING
  BOTH
}

enum ContactTaxRegistrationType {
  REGULAR
  COMPOSITION
  SEZ_DEVELOPER
  SEZ_UNIT
  INPUT_SERVICE_DISTRIBUTOR
  TAX_DEDUCTOR
  TAX_COLLECTOR
  NON_RESIDENT
  OIDAR
  OTHER
}

enum ContactTaxRegistrationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Contact {
  id              String   @id @default(cuid())
  organization_id String
  code            String   @db.VarChar(40)
  legal_name      String   @db.VarChar(200)
  display_name    String?  @db.VarChar(200)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(40)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization     Organization                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  roles            ContactRoleAssignment[]
  tax_registrations ContactTaxRegistration[]
  addresses        ContactAddress[]
  bank_accounts    ContactBankAccount[]
  purchase_orders  PurchaseOrder[]
  sales_orders     MerchandisingOrder[]
  legacy_vendors   MasterVendor[]
  legacy_buyers    MasterBuyer[]

  @@unique([organization_id, id])
  @@unique([organization_id, code])
  @@index([organization_id, legal_name])
  @@index([organization_id, is_active, display_name])
  @@map("contacts")
}

model ContactCodeCounter {
  organization_id String       @id
  current_value   Int          @default(0)
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("contact_code_counters")
}

model ContactRoleDefinition {
  code             String  @id @db.VarChar(40)
  label            String  @db.VarChar(100)
  is_active        Boolean @default(true)
  assignments      ContactRoleAssignment[]

  @@map("contact_role_definitions")
}

model ContactRoleAssignment {
  organization_id String
  contact_id      String
  role_code       String   @db.VarChar(40)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      Contact               @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  role         ContactRoleDefinition @relation(fields: [role_code], references: [code], onDelete: Restrict)
  purchase_orders PurchaseOrder[]
  sales_orders    MerchandisingOrder[]

  @@id([organization_id, contact_id, role_code])
  @@index([organization_id, role_code, is_active])
  @@map("contact_role_assignments")
}

model ContactTaxRegistration {
  id                String                        @id @default(cuid())
  organization_id   String
  contact_id        String
  gstin             String                        @db.VarChar(15)
  state_code        String                        @db.VarChar(2)
  legal_name        String                        @db.VarChar(200)
  registration_type ContactTaxRegistrationType    @default(REGULAR)
  status            ContactTaxRegistrationStatus  @default(ACTIVE)
  verified_at       DateTime?
  created_at        DateTime                      @default(now())
  updated_at        DateTime                      @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      Contact          @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  addresses    ContactAddress[]

  @@unique([organization_id, gstin])
  @@unique([organization_id, contact_id, id])
  @@index([organization_id, contact_id, status])
  @@map("contact_tax_registrations")
}

model ContactAddress {
  id                   String              @id @default(cuid())
  organization_id      String
  contact_id           String
  tax_registration_id  String?
  label                String?             @db.VarChar(80)
  usage                ContactAddressUsage
  address_line_1       String              @db.VarChar(200)
  address_line_2       String?             @db.VarChar(200)
  city                 String              @db.VarChar(100)
  state_name           String              @db.VarChar(100)
  state_code           String?             @db.VarChar(2)
  postal_code          String              @db.VarChar(20)
  country_code         String              @default("IN") @db.Char(2)
  is_default_billing   Boolean             @default(false)
  is_default_shipping  Boolean             @default(false)
  is_active            Boolean             @default(true)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  organization     Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact          Contact                  @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)
  tax_registration ContactTaxRegistration?   @relation(fields: [organization_id, contact_id, tax_registration_id], references: [organization_id, contact_id, id], onDelete: Restrict)

  @@index([organization_id, contact_id, usage, is_active])
  @@index([organization_id, tax_registration_id])
  @@map("contact_addresses")
}

model ContactBankAccount {
  id                         String   @id @default(cuid())
  organization_id            String
  contact_id                 String
  account_holder_name        String   @db.VarChar(200)
  account_number_encrypted   String   @db.Text
  account_number_last4       String   @db.Char(4)
  ifsc_code                  String   @db.Char(11)
  bank_name                  String   @db.VarChar(120)
  branch                     String?  @db.VarChar(120)
  is_default                 Boolean  @default(false)
  is_active                  Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Cascade)

  @@index([organization_id, contact_id, is_active])
  @@map("contact_bank_accounts")
}
