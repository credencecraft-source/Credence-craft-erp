enum OrderShareStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model OrderShare {
  id                          String              @id @default(cuid())
  source_order_id             String
  source_organization_id      String
  target_organization_id      String?
  target_workspace_user_id    String?
  destination_organization_id String?
  shared_by_user_id           String
  accepted_by_user_id         String?
  status                      OrderShareStatus    @default(PENDING)
  accepted_order_id           String?
  accepted_at                 DateTime?
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt
  sourceOrder                 MerchandisingOrder  @relation("OrderShareSourceOrder", fields: [source_order_id], references: [id], onDelete: Cascade)
  sourceOrganization          Organization        @relation("OrderShareSourceOrganization", fields: [source_organization_id], references: [id], onDelete: Cascade)
  targetOrganization          Organization?       @relation("OrderShareTargetOrganization", fields: [target_organization_id], references: [id], onDelete: Cascade)
  targetWorkspaceUser         WorkspaceUser?      @relation("OrderShareTargetUser", fields: [target_workspace_user_id], references: [id], onDelete: Cascade)
  destinationOrganization     Organization?       @relation("OrderShareDestinationOrganization", fields: [destination_organization_id], references: [id], onDelete: SetNull)
  sharedBy                    WorkspaceUser       @relation("OrderShareCreator", fields: [shared_by_user_id], references: [id], onDelete: Cascade)
  acceptedBy                  WorkspaceUser?      @relation("OrderShareAccepter", fields: [accepted_by_user_id], references: [id], onDelete: SetNull)
  acceptedOrder               MerchandisingOrder? @relation("OrderShareAcceptedOrder", fields: [accepted_order_id], references: [id], onDelete: SetNull)

  @@unique([source_order_id, target_workspace_user_id])
  @@index([target_organization_id, status, created_at])
  @@index([target_workspace_user_id, status, created_at])
  @@index([source_order_id, status])
  @@map("order_shares")
}

