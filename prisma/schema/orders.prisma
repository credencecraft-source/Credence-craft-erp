model MerchandisingOrder {
  id              String                  @id @default(cuid())
  organization_id String?                 @map("organization_id")
  orderNo         String                  @unique @db.VarChar(100)
  entityName      String?                 @db.VarChar(255)
  category        String?                 @db.VarChar(255)
  subCategory     String?                 @db.VarChar(255)
  season          String?                 @db.VarChar(255)
  article         String?                 @db.VarChar(255)
  styleName       String?                 @db.VarChar(255)
  colors          String?                 @db.VarChar(255)
  buyer           String?                 @db.VarChar(255)
  brand           String?                 @db.VarChar(255)
  sizeGroup       String?                 @db.VarChar(255)
  haveSizeRatio   Boolean?
  ratioOrderQty   Int?
  orderQty        Int?
  deliveryDate    DateTime?
  finalStatus     String                  @default("Draft") @db.VarChar(100)
  processStatus   String?                 @db.VarChar(100)
  created_at      DateTime                @default(now()) @map("created_at")
  updated_at      DateTime                @updatedAt @map("updated_at")
  organization    Organization?           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  finishedGoods   FinishedGoodsSizeWise[]
  bomItems        BillOfMaterialItem[]

  @@index([organization_id])
  @@map("merchandising_orders")
}

model FinishedGoodsSizeWise {
  id              String             @id @default(cuid())
  order_id        String             @map("orderId")
  order           MerchandisingOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  buyerSize       String?            @db.VarChar(100)
  size            String?            @db.VarChar(100)
  beforeExcessQty Int?
  excess          Decimal?           @db.Decimal(10, 2)
  excessQty       Int?
  totalQty        Int?
  buyerPoPrice    Decimal?           @db.Decimal(12, 2)
  exchangePrice   Decimal?           @db.Decimal(12, 2)
  priceInInr      Decimal?           @db.Decimal(12, 2)
  created_at      DateTime           @default(now()) @map("created_at")
  updated_at      DateTime           @updatedAt @map("updated_at")

  @@index([order_id])
  @@map("finished_goods_size_wise")
}

model BillOfMaterialItem {
  id              String             @id @default(cuid())
  order_id        String             @map("orderId")
  order           MerchandisingOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  categoryType    String?            @db.VarChar(255)
  category        String?            @db.VarChar(255)
  subCategory     String?            @db.VarChar(255)
  rawMaterialName String?            @db.VarChar(255)
  size            String?            @db.VarChar(100)
  consumption     Decimal?           @db.Decimal(12, 2)
  requiredQty     Decimal?           @db.Decimal(12, 2)
  created_at      DateTime           @default(now()) @map("created_at")
  updated_at      DateTime           @updatedAt @map("updated_at")

  @@index([order_id])
  @@map("bill_of_material_items")
}

model Subscription {
  id                String    @id @default(cuid())
  organization_id   String
  organization_name String?
  business_type_id  String?
  plan_id           String
  start_date        DateTime  @default(now())
  end_date          DateTime?
  payment_status    String    @default("PAID") @db.VarChar(50)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([organization_id])
  @@index([plan_id])
  @@index([business_type_id])
  @@map("subscriptions")
}

model plan_restrictions {
  restriction_id   String   @id @default(uuid())
  plan_id          String
  master_module    String
  main_module      String
  sub_module       String
  action_level     String?
  url_pattern      String?
  restriction_type String   @default("block")
  custom_message   String?
  created_at       DateTime @default(now())

  @@map("plan_restrictions")
}